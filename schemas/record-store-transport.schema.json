{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advanced storage result transport, independent of stored format",
  "$defs": {
    "result": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "anyOf": [
            {
              "$ref": "#/$defs/operation"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/resultStatus"
        },
        "change_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "identity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "identity"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true,
          "maxItems": 65
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "$ref": "#/$defs/path"
                      },
                      "content": {
                        "anyOf": [
                          {
                            "$ref": "#/$defs/text"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "content"
                    ],
                    "additionalProperties": false
                  },
                  "uniqueItems": true,
                  "maxItems": 65
                }
              },
              "required": [
                "records"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "uniqueItems": true
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          },
          "uniqueItems": true
        },
        "transaction": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/text"
                },
                "recovery_identity": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/digest"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "recovery_identity"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "claim": {
          "const": "storage-only"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "status",
        "change_id",
        "revision",
        "files",
        "snapshot",
        "observations",
        "errors",
        "transaction",
        "claim"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "enum": [
        "inspect",
        "check",
        "record",
        "recover"
      ]
    },
    "resultStatus": {
      "type": "string",
      "enum": [
        "inspected",
        "valid",
        "saved",
        "unchanged",
        "recovered",
        "rejected",
        "conflict",
        "busy",
        "recovery-required"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[\\x20-\\x7e]+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/diagnosticCode"
        },
        "path": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false
    },
    "diagnosticCode": {
      "type": "string",
      "enum": [
        "invalid-input",
        "unsupported-contract",
        "unsafe-path",
        "broken-reference",
        "identity-conflict",
        "store-busy",
        "recovery-needed",
        "io-failure",
        "limit-exceeded",
        "absent-change",
        "subject-drift",
        "failed-evidence",
        "inconsistent-claim"
      ]
    }
  }
}
