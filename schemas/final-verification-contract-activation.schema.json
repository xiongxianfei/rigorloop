{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigorloop.dev/schemas/final-verification-contract-activation.schema.json",
  "title": "RigorLoop Final Verification Contract Activation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state",
    "activating_source_revision",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "preactivation",
        "active"
      ]
    },
    "activating_source_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "changes": {
      "type": "array",
      "maxItems": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "preactivation"
          }
        }
      },
      "then": {
        "properties": {
          "activating_source_revision": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "active"
          }
        }
      },
      "then": {
        "properties": {
          "activating_source_revision": {
            "type": "string"
          }
        }
      }
    }
  ]
}
