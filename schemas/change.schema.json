{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigorloop.dev/schemas/change.schema.json",
  "title": "RigorLoop Change Metadata",
  "description": "First-release machine-readable traceability for non-trivial changes.",
  "type": "object",
  "required": [
    "change_id",
    "title",
    "classification",
    "risk",
    "artifacts",
    "requirements",
    "tests",
    "validation",
    "changed_files",
    "review"
  ],
  "properties": {
    "lifecycle_contract": {
      "type": "string",
      "enum": [
        "stage-owned-change-local-v1",
        "stage-owned-change-local-v2"
      ]
    },
    "artifact_states": {
      "type": "object"
    },
    "review_packages": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "design",
          "delivery"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "authority",
          "correction_targets",
          "findings",
          "members",
          "outcome",
          "package_kind",
          "review_id",
          "review_round",
          "status",
          "upstream_review_id"
        ],
        "properties": {
          "authority": {
            "enum": [
              "granted",
              "withheld"
            ]
          },
          "correction_targets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "affected_artifact_ids",
                "evidence",
                "finding_id",
                "owning_stages",
                "required_outcome",
                "safe_resolution_path",
                "scope"
              ],
              "properties": {
                "affected_artifact_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "finding_id": {
                  "type": "string",
                  "minLength": 1
                },
                "owning_stages": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required_outcome": {
                  "type": "string",
                  "minLength": 1
                },
                "safe_resolution_path": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "enum": [
                    "artifact-local",
                    "cross-artifact",
                    "upstream-direction"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "members": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "enum": ["approved", "changes-requested", "blocked", "inconclusive"]
          },
          "package_kind": {
            "enum": [
              "design",
              "delivery"
            ]
          },
          "review_id": {
            "type": "string",
            "minLength": 1
          },
          "review_round": {
            "type": "string",
            "pattern": "^r[1-9][0-9]*$"
          },
          "status": {
            "enum": [
              "review-required",
              "approved",
              "changes-requested",
              "blocked",
              "inconclusive"
            ]
          },
          "upstream_review_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "workflow_state": {
      "type": "object"
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "unresolved_items"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "properties": {
        "automation": {
          "type": "object",
          "required": [],
          "properties": {
            "mechanism": {
              "type": "string",
              "enum": [
                "bounded-review-fix"
              ]
            },
            "schema_version": {
              "type": "integer",
              "minimum": 1
            },
            "run": {
              "type": "object",
              "required": [
                "run_id",
                "change_id",
                "status",
                "policy_version",
                "target"
              ],
              "properties": {
                "run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "change_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "paused",
                    "completed",
                    "cancelled"
                  ]
                },
                "policy_version": {
                  "type": "integer",
                  "minimum": 1
                },
                "target": {
                  "type": "object",
                  "required": [
                    "stage",
                    "occurrence",
                    "bound_at",
                    "completion"
                  ],
                  "properties": {
                    "stage": {
                      "type": "string",
                      "minLength": 1
                    },
                    "occurrence": {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1
                        },
                        "milestone_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "bound_at": {
                      "type": "string",
                      "minLength": 1
                    },
                    "completion": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "plan_identity": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "effective_capability_id": {
                  "type": "string",
                  "minLength": 1
                },
                "stop_reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "parent_authorizations": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "authorization_id",
                  "authorization_class",
                  "policy_version",
                  "change_id",
                  "authorized_by",
                  "authorized_at",
                  "maximum_target",
                  "allowed_capability_kinds",
                  "maximum_path_roots",
                  "maximum_mutation_categories",
                  "status",
                  "revocation",
                  "invalidation",
                  "external_actions"
                ],
                "additionalProperties": true
              }
            },
            "effective_capabilities": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "capability_id",
                  "capability_kind",
                  "parent_authorization_id",
                  "policy_version",
                  "change_id",
                  "stage",
                  "basis",
                  "scope",
                  "derived_at",
                  "status",
                  "invalidation"
                ],
                "additionalProperties": true
              }
            },
            "transition_receipts": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "migration_receipts": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "migration_id",
                  "source_mechanism",
                  "source_record_identity",
                  "migrated_at",
                  "unified_run_id",
                  "projection_result",
                  "legacy_read_only"
                ],
                "properties": {
                  "migration_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_mechanism": {
                    "type": "string",
                    "enum": [
                      "authoring-through-plan-review",
                      "bounded-review-fix",
                      "implementation-through-verify"
                    ]
                  },
                  "source_record_identity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "migrated_at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unified_run_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "projection_result": {
                    "type": "string",
                    "enum": [
                      "equivalent"
                    ]
                  },
                  "legacy_read_only": {
                    "const": true
                  }
                },
                "additionalProperties": false
              }
            },
            "observed_identities": {
              "type": "object",
              "additionalProperties": true
            },
            "canonical_position_source": {
              "type": "string",
              "minLength": 1
            },
            "latest_review_result": {
              "type": "object",
              "additionalProperties": true
            },
            "cancellation": {
              "type": "object",
              "additionalProperties": true
            },
            "external_actions": {
              "type": "string",
              "enum": [
                "prohibited"
              ]
            }
          },
          "additionalProperties": true
        },
        "autoprogression": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "off",
                "authoring-through-plan-review",
                "implementation-through-verify"
              ]
            },
            "authoring_through_plan_review": {
              "type": "object",
              "required": [
                "profile",
                "authorized_by",
                "authorized_at",
                "change_id"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "enum": [
                    "authoring-through-plan-review"
                  ]
                },
                "authorized_by": {
                  "type": "string",
                  "minLength": 1
                },
                "authorized_at": {
                  "type": "string",
                  "minLength": 1
                },
                "change_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "implementation_through_verify": {
              "type": "object",
              "required": [
                "profile",
                "phase",
                "state",
                "authorized_by",
                "authorized_at",
                "change_id"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "enum": [
                    "implementation-through-verify"
                  ]
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "off",
                    "armed",
                    "active",
                    "paused",
                    "completed",
                    "cancelled"
                  ]
                },
                "authorized_by": {
                  "type": "string",
                  "minLength": 1
                },
                "authorized_at": {
                  "type": "string",
                  "minLength": 1
                },
                "change_id": {
                  "type": "string",
                  "minLength": 1
                },
                "activation_baseline": {
                  "type": "string",
                  "minLength": 1
                },
                "cancellation": {
                  "type": "object",
                  "properties": {
                    "cancelled_by": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cancelled_at": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "review_fix": {
              "type": "object",
              "required": [
                "profile",
                "status",
                "target_stage",
                "armed_by",
                "armed_at",
                "current_stage",
                "current_review",
                "stop_reason",
                "last_updated_evidence",
                "change_id"
              ],
              "properties": {
                "profile": {
                  "type": "string",
                  "enum": [
                    "bounded-review-fix"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "off",
                    "armed",
                    "active",
                    "paused",
                    "completed",
                    "cancelled"
                  ]
                },
                "target_stage": {
                  "type": "string",
                  "enum": [
                    "proposal-review",
                    "spec",
                    "spec-review",
                    "architecture",
                    "architecture-review",
                    "design-review",
                    "plan",
                    "plan-review",
                    "test-spec",
                    "test-spec-review",
                    "delivery-review"
                  ]
                },
                "armed_by": {
                  "type": "string",
                  "minLength": 1
                },
                "armed_at": {
                  "type": "string",
                  "minLength": 1
                },
                "current_stage": {
                  "type": "string",
                  "minLength": 1
                },
                "current_review": {
                  "type": "string",
                  "minLength": 1
                },
                "stop_reason": {
                  "type": "string",
                  "minLength": 1
                },
                "last_updated_evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "change_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            },
            "authorized_by": {
              "type": "string",
              "minLength": 1
            },
            "authorized_at": {
              "type": "string",
              "minLength": 1
            },
            "change_id": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "minLength": 1
            },
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "request": {
              "type": "string",
              "minLength": 1
            },
            "activation_baseline": {
              "type": "string",
              "minLength": 1
            },
            "persistence_status": {
              "type": "string",
              "minLength": 1
            },
            "session_intent": {
              "type": "boolean"
            },
            "fallback_policy_path": {
              "type": "string",
              "minLength": 1
            },
            "cancellation": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle_contract": {"const": "stage-owned-change-local-v2"}
        },
        "required": ["lifecycle_contract"]
      },
      "then": {
        "properties": {
          "artifact_states": {
            "additionalProperties": {
              "not": {
                "properties": {"kind": {"const": "test-spec"}},
                "required": ["kind"]
              }
            }
          },
          "review_packages": {
            "properties": {
              "delivery": {
                "properties": {
                  "members": {
                    "maxProperties": 1,
                    "propertyNames": {"not": {"const": "test-spec"}}
                  }
                }
              }
            }
          },
          "workflow_state": {
            "properties": {
              "current_stage": {"not": {"enum": ["test-spec", "test-spec-review"]}},
              "next_stage": {"not": {"enum": ["test-spec", "test-spec-review"]}}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
