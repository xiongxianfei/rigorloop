      "id": "REL-EC-001",
      "title": "Closeout records independently observed public facts without changing unrelated evidence",
      "requirements": [
        "REL-SR-03",
        "REL-SR-04",
        "REL-SR-10",
        "REL-SR-13",
        "REL-SR-14",
        "REL-SR-15",
        "REL-SR-19",
        "REL-SR-24",
        "REL-SR-26"
      ],
      "technique": "state-transition",
      "risk": "Closeout fabricates public success, accepts inconsistent observations or overwrites evidence outside the selected release.",
      "target": {
        "path": "scripts/lib/release/release_transaction.py",
        "symbol": "close_release_publication"
      },
      "given": {
        "fixture": "publication",
        "conditions": [
          "Use publication with controlled GitHub/npm/smoke facts and snapshots of pending, earlier-release and unrelated files. Vary provider values independently of the generated expectations.",
          "Use explicit fixture mode only for fixture evidence; historical-reader is a separate immutable input and cannot qualify a current routine profile."
        ]
      },
      "when": [
        "Run real closeout and the documented public version/target smoke commands.",
        "Repeat with unavailable facts, failed smoke, wrong serialized command/hash scope or a missing target; establish a successful baseline before corrupting evidence.",
        "Invoke closeout check mode and inspect the filesystem."
      ],
      "then": [
        "Successful evidence records observed version, intended tag/integrity, asset hashes and both target smoke results; it never substitutes prepared expectations.",
        "Unavailable facts or failed smoke preserve pending/unrelated bytes and report the failure. Invalid serialized evidence rejects; earlier evidence stays byte-identical.",
        "Fixture evidence requires explicit mode at function and CLI boundaries. Check mode reports planned output without finalizing it.",
        "The admitted historical reader does not admit its old target population as a new routine profile."
      ],
