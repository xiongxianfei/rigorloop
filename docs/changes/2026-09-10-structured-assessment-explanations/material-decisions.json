    {
      "actor": {
        "id": "codex-design-author",
        "role": "design"
      },
      "id": "conditional-verification-basis",
      "rationale": "RC-SR-20 retains the existing conditional Git/PR basis requirement; RF-SR-11 supplies its closed optional v3 object. Non-Git Verify omits it. CLI-SR-25 requires complete reassessment to change/remove it, preserving the distinction from explanation-only edits. Existing v2 narrative representation remains unchanged for continuation.",
