{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RigorLoop Module",
  "description": "Draft architecture authoring profile. Shape validation does not establish relationship resolution, architectural adequacy, approval, or implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "status",
    "description",
    "responsibilities",
    "owned_state",
    "scope",
    "provides",
    "consumes",
    "design_limits",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MOD-[0-9]+$",
      "not": {
        "pattern": "\\s"
      }
    },
    "type": {
      "type": "string",
      "const": "module"
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "const": "draft"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "owned_state": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includes",
        "excludes"
      ],
      "properties": {
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IF-[0-9]+$",
        "not": {
          "pattern": "\\s"
        }
      }
    },
    "consumes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^IF-[0-9]+$",
        "not": {
          "pattern": "\\s"
        }
      }
    },
    "design_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "locator",
          "basis"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "\\S"
          },
          "locator": {
            "type": "string",
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
