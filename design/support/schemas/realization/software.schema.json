{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RigorLoop Software realization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "software_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\S"
              },
              "role": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "production_paths": {
          "description": "Attributed production mappings. Input and transformation paths identify repository sources; output paths describe candidate-relative layouts or templates, not observed generated bytes.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "inputs",
              "transformation",
              "outputs"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "role"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "role": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "transformation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "description"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "description": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "role"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "role": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "locator",
              "basis"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "\\S"
              },
              "locator": {
                "type": "string",
                "pattern": "\\S"
              },
              "basis": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "public_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "group",
              "purpose",
              "source_path",
              "contract"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "group": {
                "type": "string",
                "pattern": "\\S"
              },
              "purpose": {
                "type": "string",
                "pattern": "\\S"
              },
              "source_path": {
                "type": "string",
                "pattern": "\\S",
                "description": "Exact repository-relative source file; local semantic checks enforce containment and existence without reading skill instructions."
              },
              "contract": {
                "type": "string",
                "pattern": "^[^#\\s]+\\.md(?:#[^#\\s]+)?$",
                "not": {
                  "pattern": "\\s"
                },
                "description": "Repository-relative Markdown contract path with an optional heading fragment."
              }
            }
          },
          "description": "Observed public names and sources; Function correspondence is a separate proposed claim. Display groups do not create architectural ownership."
        },
        "test_groups": {
          "description": "Attributed bounded organization of tests assessing this Module. These subordinate groups are distinct from implementation units, coverage/satisfaction judgments and executed evidence. Shared execution references retain their declared contract owner.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "contract",
              "test_sources",
              "observation_boundary",
              "fixtures",
              "execution",
              "required_artifacts",
              "limits"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "contract": {
                "type": "string",
                "pattern": "^[^#\\s]+\\.md(?:#[^#\\s]+)?$",
                "not": {
                  "pattern": "\\s"
                },
                "description": "Exact repository-relative Markdown owner contract, with an optional heading fragment; semantic checks resolve contained files."
              },
              "test_sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/test_source_reference"
                }
              },
              "observation_boundary": {
                "type": "string",
                "pattern": "\\S"
              },
              "fixtures": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/test_source_reference"
                }
              },
              "execution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner_contract",
                  "selection",
                  "runners",
                  "entrypoints"
                ],
                "properties": {
                  "owner_contract": {
                    "type": "string",
                    "pattern": "^[^#\\s]+\\.md(?:#[^#\\s]+)?$",
                    "not": {
                      "pattern": "\\s"
                    },
                    "description": "Exact repository-relative Markdown owner contract, with an optional heading fragment; semantic checks resolve contained files."
                  },
                  "selection": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/test_source_reference"
                    }
                  },
                  "runners": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/test_source_reference"
                    }
                  },
                  "entrypoints": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/test_source_reference"
                    }
                  }
                }
              },
              "required_artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "limits": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      },
      "minProperties": 2
    },
    "proposed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "rationale",
          "alternatives",
          "consequences",
          "revisit_when"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "pattern": "\\S"
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "consequences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "revisit_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "public_entry_mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry",
                "functions",
                "limits"
              ],
              "properties": {
                "entry": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "functions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "function",
                      "relation",
                      "contribution"
                    ],
                    "properties": {
                      "function": {
                        "type": "string",
                        "pattern": "^FUNC-[0-9]+$",
                        "not": {
                          "pattern": "\\s"
                        }
                      },
                      "relation": {
                        "type": "string",
                        "enum": [
                          "guides",
                          "invokes",
                          "realizes"
                        ]
                      },
                      "contribution": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  }
                },
                "limits": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "functions": {
                      "minItems": 1
                    }
                  }
                },
                {
                  "properties": {
                    "limits": {
                      "minItems": 1
                    }
                  }
                }
              ]
            },
            "description": "Reasoned proposed Function correspondence for observed entries, with explicit unmapped scope. Does not establish implementation conformance or transfer Function allocation."
          }
        }
      }
    },
    "deferred": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "minProperties": 1,
  "description": "Optional subordinate architecture facet, owned by directory containment. Observed facts require attribution; proposals retain reasoning and limits. The file has no independent engineering identity or lifecycle. Shape validation does not establish architectural adequacy or implementation conformance.",
  "$defs": {
    "test_source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S",
          "description": "Exact repository-relative existing file. Semantic checks reject globs, aliases and escaped or missing paths without executing or reading the target."
        },
        "role": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
