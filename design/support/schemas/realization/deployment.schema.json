{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RigorLoop Deployment realization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "packaging": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "locator",
              "basis"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "\\S"
              },
              "locator": {
                "type": "string",
                "pattern": "\\S"
              },
              "basis": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "location",
              "modules",
              "paths",
              "constraints"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "location": {
                "type": "string",
                "pattern": "\\S"
              },
              "modules": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^MOD-[0-9]+$",
                  "not": {
                    "pattern": "\\s"
                  }
                }
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "constraints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          "description": "Named source-observed placements of implementation or owned data, with Module accountability and qualified location/path templates. Paths are not evidence of existing artifacts or platform support. Separate placements do not assert transfer, network communication, or physical-host separation."
        },
        "physical_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "execution",
              "package",
              "accesses",
              "constraints"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "execution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "name"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "pattern": "^MOD-[0-9]+$",
                    "not": {
                      "pattern": "\\s"
                    }
                  },
                  "name": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              "package": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "facet",
                  "name"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "pattern": "^MOD-[0-9]+$",
                    "not": {
                      "pattern": "\\s"
                    }
                  },
                  "facet": {
                    "type": "string",
                    "enum": [
                      "deployment",
                      "persistence"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              "accesses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "participant",
                    "placement",
                    "mode",
                    "purpose",
                    "conditions"
                  ],
                  "properties": {
                    "participant": {
                      "type": "string",
                      "pattern": "^MOD-[0-9]+$",
                      "not": {
                        "pattern": "\\s"
                      }
                    },
                    "placement": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "owner",
                        "facet",
                        "name"
                      ],
                      "properties": {
                        "owner": {
                          "type": "string",
                          "pattern": "^MOD-[0-9]+$",
                          "not": {
                            "pattern": "\\s"
                          }
                        },
                        "facet": {
                          "type": "string",
                          "enum": [
                            "deployment",
                            "persistence"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      }
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "read",
                        "write",
                        "read-write"
                      ]
                    },
                    "purpose": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "conditions": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              },
              "constraints": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          },
          "description": "Observed package-to-execution mapping and participant-specific access to existing qualified placements. References resolve by owner/facet/name; package content and runtime participation remain authored once. Access conditions do not make every execution path touch every target or equate the targets' root selectors."
        },
        "production_placement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "workspace",
            "output",
            "constraints"
          ],
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "facet",
                "name"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "pattern": "^MOD-[0-9]+$",
                  "not": {
                    "pattern": "\\s"
                  }
                },
                "facet": {
                  "type": "string",
                  "enum": [
                    "deployment",
                    "persistence"
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "workspace": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "facet",
                "name"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "pattern": "^MOD-[0-9]+$",
                  "not": {
                    "pattern": "\\s"
                  }
                },
                "facet": {
                  "type": "string",
                  "enum": [
                    "deployment",
                    "persistence"
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "output": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "facet",
                "name"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "pattern": "^MOD-[0-9]+$",
                  "not": {
                    "pattern": "\\s"
                  }
                },
                "facet": {
                  "type": "string",
                  "enum": [
                    "deployment",
                    "persistence"
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "constraints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "description": "Distinct named source, preparation, and output placements for candidate production, linked to existing placement facts. Distinct references alone do not assert distinct hosts, runtime processes, physical devices, or transfer/publication."
        },
        "location_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "relation",
              "placements",
              "conditions",
              "rationale"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "disjoint",
                  "same-filesystem"
                ]
              },
              "placements": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "owner",
                    "facet",
                    "name"
                  ],
                  "properties": {
                    "owner": {
                      "type": "string",
                      "pattern": "^MOD-[0-9]+$",
                      "not": {
                        "pattern": "\\s"
                      }
                    },
                    "facet": {
                      "type": "string",
                      "enum": [
                        "deployment",
                        "persistence"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "rationale": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "description": "Conditional pairwise location constraints. Disjoint means declared containment scopes do not overlap; same-filesystem means the inspected operation requires both selected placements on one filesystem. Neither relation transfers data or asserts machine identity. References remain exact owner/facet/name selections."
        }
      },
      "minProperties": 2
    },
    "proposed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "rationale",
          "alternatives",
          "consequences",
          "revisit_when"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "pattern": "\\S"
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "consequences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "revisit_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "deferred": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "minProperties": 1,
  "description": "Optional subordinate architecture facet, owned by directory containment. Observed facts require attribution; proposals retain reasoning and limits. The file has no independent engineering identity or lifecycle. Shape validation does not establish architectural adequacy or implementation conformance."
}
