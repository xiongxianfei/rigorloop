256:b1f763a877947390ed6a24448c159dd370da5b341fbeca38e090291360c20a08","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-082-require-one-whole-change-review-gate-after-checked-implementation/sr.json"},{"identity":"sha256:b506771574be31c9d33ef38b8f27fa5c83b03ceefdcf8975eecc405eadf634b6","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/sr.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:f8fa34126526a01fb8243692317664d0bd6c08ca94c7172cd8479374e4596bea","path":"design/requirements/scenarios/SCN-050-choose-the-right-capability-for-an-engineering-task.json"},{"identity":"sha256:ad6614a6bb8310e00be68db5fd44eceba534c809e53d92d5a80348c4f726566d","path":"design/requirements/scenarios/SCN-051-start-portable-work-in-a-customer-project.json"},{"identity":"sha256:f60f67b331f0e449b8ed8cf380e397b3309f4fcf03b8ff20371396f1ba4ac09e","path":"design/requirements/scenarios/SCN-052-obtain-the-complete-guidance-required-by-a-selected-path.json"},{"identity":"sha256:37218fceae718a00aa4098f326e0a598aa864d20dad72a2546209d541084514c","path":"design/requirements/scenarios/SCN-053-produce-a-usable-result-through-specialist-guidance.json"},{"identity":"sha256:0c1a5799fddeb358e853a424c93df29daee33388f4dd7aadabe23ec97fffb896","path":"design/requirements/scenarios/SCN-054-receive-a-scoped-independent-engineering-assessment.json"},{"identity":"sha256:25119c6158e04ad05f02b304fe49080e5ff4b2f77964aeb0b646481bb8c58f8b","path":"design/requirements/scenarios/SCN-055-hand-off-completed-work-without-overstating-readiness.json"},{"identity":"sha256:a6a92ffd6a680ff2850d3b708d816e7df3e0d4dfc674020b35682a538d634575","path":"design/requirements/scenarios/SCN-056-record-a-governed-activity-through-the-supported-procedure.json"},{"identity":"sha256:fc4741477bf090569c26f8f1260e4b4a6e78024a02a229e25f4fc630fc46bee9","path":"design/requirements/scenarios/SCN-057-recognize-a-recording-obligation-discovered-during-portable-work.json"},{"identity":"sha256:70a4616f23ca9fdf75a6dde55442266bdc7ffb1cd641dac6b3d14b588183eb71","path":"design/requirements/scenarios/SCN-075-reconcile-a-request-already-covered-by-existing-requirements.json"},{"identity":"sha256:0e8b09dabe31b2558ddb289c2b3903cc1b6e158ffd56108ead22707ea57b8fd5","path":"design/requirements/scenarios/SCN-076-approve-a-requirement-basis-before-detailed-design-exists.json"},{"identity":"sha256:1f72dfaf51a009397a6f33aaceec7d28a6c0ce571a312e3165ae48266d2b6a42","path":"design/requirements/scenarios/SCN-077-assess-logical-and-architectural-design-as-one-integrated-basis.json"},{"identity":"sha256:7d470899577acef11e8e9c0f817be868bbd4bee6e887107016dd1fee42ef3684","path":"design/requirements/scenarios/SCN-078-continue-authorized-implementation-after-a-checked-milestone.json"},{"identity":"sha256:a0a8d9afad839383f499dade6bd9418dc4998e69d59dd5c25c5596159244ae77","path":"design/requirements/scenarios/SCN-079-obtain-interim-advice-without-establishing-lifecycle-approval.json"},{"identity":"sha256:9b0bc205d3a89b4ed9faca138332e721a2360f841d2b7e3beec50a17f27bf2e9","path":"design/requirements/scenarios/SCN-080-reassess-corrections-within-one-whole-change-review-gate.json"},{"identity":"sha256:c492cf51bc2038dc8c0f48248d2b5af0282faa8d76adf4ece53cc7cae0d20a81","path":"design/requirements/scenarios/SCN-081-resolve-a-verification-problem-through-its-responsible-owner.json"},{"identity":"sha256:97b6e7c46e0bcf4d0a9c623173659796be5d8838634b3de5339367e1907eca8f","path":"design/requirements/scenarios/SCN-082-adopt-the-requirement-first-workflow-for-active-work.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:6d82acd0a1443577c34296308b2c0cddf22e29b7fbc5324ab52a759914a634fe","path":"design/architecture/modules/MOD-017-engineering-governance/test-design.md"},{"identity":"sha256:536af7f9e97979b7afd41f8f5b66296e6091a243f1dfd3f9019f0ed2d3554782","path":"design/requirements/sources.md"},{"identity":"sha256:8d5fd4b8c33d938deca10af6cfb9ae6cc22a2e554a02d2b62b0b9c737851eb5f","path":"design/system/functions/FUNC-078-prepare-and-reconcile-workflow-adoption.json"}],"summary":"Design Covered against the explicitly refined adoption obligation; original negative assessment is preserved. No implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Canonical-source production, declared transformations and actual packed-consumer qualification connect authored behavior to acquired artifacts. Isolated output and exact inventory prevent generated manifests or checkout-only checks from masquerading as a complete product.","number":1,"state":"covered"},{"explanation":"Bundled trust, complete destination preflight, exact force/retirement scope, no-clobber publication and outside-discovery originals preserve unrelated work. Preliminary dry-run and actual partial results remain distinct; fresh retry never grants hidden restoration or workflow adoption.","number":2,"state":"covered"},{"explanation":"Reviewed version intent and allowed deterministic preparation lead to a sealed candidate bound to one authorized start. Exact retained-byte publication, fresh public identity/consumer observations and durable evidence connect intent to the publicly obtained product without a second routine approval or fabricated success.","number":3,"state":"covered"},{"explanation":"Installation preserves detached originals and reports actual partial units; release preserves candidate/effects, inspects authoritative destinations before retry and never overwrites a version. Reporting repair cannot republish product bytes; special recovery needs applicable authority and retains failure evidence.","number":4,"state":"covered"},{"explanation":"The declared exact generator/profile/engine/renderer/reader configuration is packaged and qualified through independent customer generation and copied offline reading. Trusted isolated-prefix acquisition protects model/snapshot content; reference-site evidence and release authority remain separate from reusable-product qualification.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-010\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Obtain trustworthy compatible RigorLoop tools\",\n  \"status\": \"draft\",\n  \"statement\": \"Project users need to obtain compatible, complete RigorLoop command-line tooling, portable skills and architecture browser capability without losing unrelated work, and product maintainers need to deliver identifiable qualified versions whose public availability and limitations can be established from actual evidence.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Correct engineering guidance and behavior are unusable when distributed artifacts are incomplete, incompatible, untrusted, unsafe to install, or merely assumed to have been published.\",\n      \"desired_outcome\": \"Users can acquire and use identifiable compatible product artifacts, while maintainers can produce, qualify, publish, and inspect those exact artifacts under existing authority and recovery rules.\"\n    },\n    \"why\": {\n      \"rationale\": \"The published CLI, skills and reusable architecture browser are product delivery surfaces. Their artifact integrity, installation effects, version compatibility, and observed availability require obligations beyond generic model authoring, change authority, and evidence storage.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project users installing and using published RigorLoop tooling\",\n        \"Maintainers preparing and publishing RigorLoop releases\",\n        \"Reviewers and decision owners assessing artifact compatibility, qualification, and release authority\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a product candidate is built or qualified, a user plans or performs installation, a compatible version is released, or an uncertain or failed operation is investigated.\",\n        \"When supported targets, package contents, artifact formats, or public behavior change, before affected compatibility and publication claims are made.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The boundary from canonical product sources through candidate CLI packages and target skill archives to installed customer tooling and externally published artifacts.\",\n        \"Customer browser generation resources and portable reading artifacts, distinct from RigorLoop reference documentation.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Generate faithful candidates from canonical sources, preserve artifact identities and trusted metadata, qualify the actual packed product, and install only verified candidate units under explicit destination rules. Select release scope and compatibility from existing reviewed decisions, prepare and qualify the exact candidate, apply its publication authorization, observe public results, and preserve failure and recovery evidence. Reuse IR-003 authority and provenance and IR-004 evidence/applicability rather than treating generation, approval, or a local check as publication. Qualify browser resources with an independent customer model and offline reader; declare generator/profile/environment compatibility and protect customer content during acquisition and update.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The existing Packaging, CLI Installation, and Release Designs define the selected RigorLoop product profile and detailed formats. Their current two-target direction is Codex and Claude Code; historical three-target records retain their original scope, and adoption is not inferred from these new drafts. The npm CLI and separately versioned skill archives remain distinct artifacts. Individual portable skill use does not acquire a CLI prerequisite; the selected CLI installation method does. No automatic managed upgrade, project-state migration, unsupported target, new release workflow, new distribution service, public availability SLA, or storage-disaster guarantee is introduced. This analysis does not inspect a registry, publish, install, or claim that every selected source design is already implemented. The browser capability extends the product scope; package layout, generation entry and supported environments require downstream design. Existing skill targets and installation contracts are not implicitly expanded to browser assets.\"\n    }\n  },\n  \"assumptions\": [\n    \"Publication destinations, credentials, and release protection required by the selected supported path are established prerequisites; missing setup stops the affected operation rather than authorizing a substitute.\"\n  ],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FEAT-018\",\n    \"FEAT-019\",\n    \"FEAT-020\",\n    \"SCN-060\",\n    \"SCN-061\",\n    \"SCN-062\",\n    \"SCN-063\",\n    \"SCN-064\",\n    \"SCN-065\",\n    \"SCN-066\",\n    \"SCN-067\",\n    \"SCN-068\",\n    \"SCN-069\",\n    \"SCN-087\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-03\",\n      \"basis\": \"Existing product candidate, public archive, and executable completeness needs justify this IR without making their implementation choices requirements of REM itself.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-06\",\n      \"basis\": \"Existing product candidate, public archive, and executable completeness needs justify this IR without making their implementation choices requirements of REM itself.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-23\",\n      \"basis\": \"Existing product candidate, public archive, and executable completeness needs justify this IR without making their implementation choices requirements of REM itself.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-07\",\n      \"basis\": \"Existing trusted acquisition and safe scoped installation duties protect users obtaining the product.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-10\",\n      \"basis\": \"Existing trusted acquisition and safe scoped installation duties protect users obtaining the product.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-14\",\n      \"basis\": \"Existing trusted acquisition and safe scoped installation duties protect users obtaining the product.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-02\",\n      \"basis\": \"Existing controlled delivery and observed public availability duties justify maintainer-facing scope; source applicability and transition qualifications remain explicit.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-13\",\n      \"basis\": \"Existing controlled delivery and observed public availability duties justify maintainer-facing scope; source applicability and transition qualifications remain explicit.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-22\",\n      \"basis\": \"Existing controlled delivery and observed public availability duties justify maintainer-facing scope; source applicability and transition qualifications remain explicit.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#Distribution support transition\",\n      \"basis\": \"Existing controlled delivery and observed public availability duties justify maintainer-facing scope; source applicability and transition qualifications remain explicit.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"IR-010\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    }\n  ]\n}\n","identity":"sha256:9b413889888a68c6eaf4a8e644d4c2bdda702de75b35f9db8a766f3f37ebcc08","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/ir.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised.","These five outcome criteria are explicit reviewer-derived stakeholder interpretations, not acceptance criteria in the IR schema and not a rollup from child counts.","No public availability, release start, remote protection change, customer installation or workflow adoption is executed or authorized by this Design assessment."],"outcome_basis":{"identity":"sha256:9aa4c9c44ddc6d96afd0715d9a535009723e8f67b3bcad4bada4831f8fe90064","outcomes":[{"number":1,"sources":[{"identity":"sha256:9b413889888a68c6eaf4a8e644d4c2bdda702de75b35f9db8a766f3f37ebcc08","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/ir.json"},{"identity":"sha256:cbf30a221903f1016f77f0a81efb4f49c111893e7202caea97a7d012a63b5cc4","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-060-produce-faithful-supported-product-candidates/sr.json"},{"identity":"sha256:1f8dc88c1b12604fef36e8533494341dfcc8471c6f6c69310375909224a5451c","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-061-generate-candidates-deterministically-outside-active-installations/sr.json"},{"identity":"sha256:ddbfe78793fae0b5cd04e22c731478d04af4520a97fef8be6fd5685e48f9469d","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-062-bind-artifact-metadata-to-actual-candidate-bytes/sr.json"},{"identity":"sha256:6cd35c19d5af82277b2a3e77e2681066960d98604241c68504babf6aae6ca4af","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-063-qualify-the-actual-executable-cli-package/sr.json"},{"identity":"sha256:73ff3e3062b71339125a07c062cbb554e5751ff5f1d7c1847fc363f5c2496302","path":"design/requirements/scenarios/SCN-060-build-a-faithful-candidate-from-reviewed-product-sources.json"},{"identity":"sha256:fdd6b4bce5854ed8fbbef211ebc0c865df4c8f7608e26c9ad636ae0e97b6af70","path":"design/requirements/scenarios/SCN-061-assess-the-actual-packed-cli-before-release.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"}],"text":"Users obtain complete faithful tools whose product contents and compatibility are identifiable."},{"number":2,"sources":[{"identity":"sha256:9b413889888a68c6eaf4a8e644d4c2bdda702de75b35f9db8a766f3f37ebcc08","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/ir.json"},{"identity":"sha256:0e7929ae307f0ca8a2bc70ecaad50862a26496fcb1faabcbc2f262291f6f2fd9","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-064-acquire-and-verify-a-supported-installation-candidate/sr.json"},{"identity":"sha256:812be496b53e4811a6fa386aaf35491507edd8a121a4838c674310849ff47733","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-065-install-verified-units-within-explicit-safe-replacement-boundaries/sr.json"},{"identity":"sha256:66e8c0aa1cf0ad06d5490a7902bdb615220b0eec386116c46d419235f5a993cc","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-066-report-installation-plans-and-outcomes-without-exposing-private-data/sr.json"},{"identity":"sha