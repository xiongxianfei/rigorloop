es/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:b506771574be31c9d33ef38b8f27fa5c83b03ceefdcf8975eecc405eadf634b6","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/sr.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:8826cafce61e450491f674a84da5ba1bcc8717a2f3328f2e6a2db1c29bccce23","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/module.json"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:97b6e7c46e0bcf4d0a9c623173659796be5d8838634b3de5339367e1907eca8f","path":"design/requirements/scenarios/SCN-082-adopt-the-requirement-first-workflow-for-active-work.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Within the selected v4 contract, MOD-011 atomically retains related current work, review, evidence and Verify facts without mandatory milestone approval or an activity ledger.","number":1,"state":"covered"},{"explanation":"Qualified adoption/import preserves original meaning and current dependencies; ordinary comparable replacement/compaction retain required support and reject unknown or mixed contracts. Governance decides dependency-specific activation, while MOD-011 supplies actual compatibility/migration facts and guarded publication.","number":2,"state":"covered"},{"explanation":"Guarded current revisions, coherent transaction/payload publication and truthful recovery preserve actual outcomes without inventing approval or editing engineering model files.","number":3,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-040\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve work and assessment facts through workflow record changes\",\n  \"status\": \"draft\",\n  \"statement\": \"The Work record storage Module shall preserve work and assessment facts through workflow record changes within its accountable boundary so that SR-083 can be satisfied without transferring another owner's decisions or state authority.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"The SR-083 obligation crosses guidance, governance or publication boundaries; an unowned contribution can make a locally valid step appear sufficient for the whole workflow.\",\n      \"desired_outcome\": \"Validate and publish explicit work, gate, attempt and Verify facts under the selected supported record contract without requiring approval per milestone.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-011 owns the behavior or state needed for this contribution; separating it preserves one accountable owner while allowing the parent SR to compose several contributors.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants relying on Work record storage\",\n        \"Authors, reviewers and project decision owners\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When the selected requirement-first workflow exercises SR-083 or reassesses its affected basis.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The MOD-011 responsibility boundary and its declared logical Interfaces.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the allocated criteria through the constrained Functions and explicit contract inputs/outcomes; preserve actual actor decisions, subject identity and known limitations.\"\n    },\n    \"how_much\": {\n      \"scope\": \"This allocated contribution to SR-083; other contributors, independent assessment, physical recording implementation and product activation remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Publish coherent current work, review, evidence and Verify accounts under the selected contract without mandatory milestone approval or an activity ledger.\",\n    \"During workflow adoption preserve required original source meaning and reconcile active dependencies. During normal work permit explicit current-account replacement and selective compaction; reject unknown or mixed contracts before mutation.\",\n    \"Use fresh guarded coherent publication and truthful recovery outcomes; persistence must not infer semantic approval or alter engineering model files.\"\n  ],\n  \"assumptions\": [\n    \"The selected project contract, scope and required counterpart contributions are identifiable; absence is reported rather than inferred.\"\n  ],\n  \"constraints\": [\n    \"This draft allocation neither activates replacement runtime contracts nor proves implementation or satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-011\",\n  \"constrains\": [\n    \"FUNC-044\",\n    \"FUNC-045\",\n    \"FUNC-046\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-083; AR-040\",\n      \"basis\": \"Draft integrated design from the accepted requirement-first basis. This defines target responsibility and cooperation, not installed capability, design approval, runtime evidence or SQLite adoption.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"AR-040\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ]\n}\n","identity":"sha256:eae1e871e668ba0d51aa531282711f58e55056a49f71382fe736baa4f6bb668e","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/AR-040-preserve-work-and-assessment-facts-through-workflow-record-changes.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-040","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 3 canonical AR-040 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:08ebb8b4277641cf25e8a4513093c053cc6ddc5740fdb9c6fb53660f8f27ede8","path":"design/system/functions/FUNC-044-validate-registered-recording-candidates-and-preservation-rules.json"},{"identity":"sha256:727fa9085fec8f