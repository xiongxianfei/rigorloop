ified-skill-installation-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"},{"identity":"sha256:a8ac526c74661c00b6594c1d9a546b02bd870b5e8d79e66696fdf4cefb0f1d0e","path":"design/system/features/FEAT-019-install-verified-skills-for-a-selected-supported-target.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qual