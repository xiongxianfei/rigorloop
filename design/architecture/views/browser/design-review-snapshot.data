84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:b506771574be31c9d33ef38b8f27fa5c83b03ceefdcf8975eecc405eadf634b6","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/sr.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:8826cafce61e450491f674a84da5ba1bcc8717a2f3328f2e6a2db1c29bccce23","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/module.json"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:97b6e7c46e0bcf4d0a9c623173659796be5d8838634b3de5339367e1907eca8f","path":"design/requirements/scenarios/SCN-082-adopt-the-requirement-first-workflow-for-active-work.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-014 requires explicit supported target/profile plus force for bounded replacement, preflights the complete unit set and preserves unrelated files and detached originals outside discovery.","number":1,"state":"covered"},{"explanation":"Per-unit completed/partial/failed outcomes and fresh retry checks preserve actual effects without claiming multi-unit rollback; separate Governance determines coherent activation and current authority.","number":2,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-042\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Apply replacement guidance without falsely activating workflow\",\n  \"status\": \"draft\",\n  \"statement\": \"The Skill installation Module shall apply replacement guidance without falsely activating workflow within its accountable boundary so that SR-083 can be satisfied without transferring another owner's decisions or state authority.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"The SR-083 obligation crosses guidance, governance or publication boundaries; an unowned contribution can make a locally valid step appear sufficient for the whole workflow.\",\n      \"desired_outcome\": \"Apply only explicitly selected supported installation units, preserving unrelated files and reporting actual per-unit effects.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-014 owns the behavior or state needed for this contribution; separating it preserves one accountable owner while allowing the parent SR to compose several contributors.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants relying on Skill installation\",\n        \"Authors, reviewers and project decision owners\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When the selected requirement-first workflow exercises SR-083 or reassesses its affected basis.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The MOD-014 responsibility boundary and its declared logical Interfaces.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the allocated criteria through the constrained Functions and explicit contract inputs/outcomes; preserve actual actor decisions, subject identity and known limitations.\"\n    },\n    \"how_much\": {\n      \"scope\": \"This allocated contribution to SR-083; other contributors, independent assessment, physical recording implementation and product activation remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Apply only explicitly selected supported installation units, preserving unrelated files and reporting actual per-unit effects.\",\n    \"An incomplete or conflicting replacement cannot establish workflow activation; report installed identities for the separate adoption decision rather than claiming atomic project rollback.\"\n  ],\n  \"assumptions\": [\n    \"The selected project contract, scope and required counterpart contributions are identifiable; absence is reported rather than inferred.\"\n  ],\n  \"constraints\": [\n    \"This draft allocation neither activates replacement runtime contracts nor proves implementation or satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-014\",\n  \"constrains\": [\n    \"FUNC-064\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-083; AR-042\",\n      \"basis\": \"Draft integrated design from the accepted requirement-first basis. This defines target responsibility and cooperation, not installed capability, design approval, runtime evidence or SQLite adoption.\"\n    }\n  ]\n}\n","identity":"sha256:ad9bc82663c72c9750e1920183812043a2d1778a9d7a253fd4834b9644b0d502","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/AR-042-apply-replacement-guidance-without-falsely-activating-workflow.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-042","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 2 canonical AR-042 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e49