7-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:b506771574be31c9d33ef38b8f27fa5c83b03ceefdcf8975eecc405eadf634b6","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/sr.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:8826cafce61e450491f674a84da5ba1bcc8717a2f3328f2e6a2db1c29bccce23","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/module.json"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:97b6e7c46e0bcf4d0a9c623173659796be5d8838634b3de5339367e1907eca8f","path":"design/requirements/scenarios/SCN-082-adopt-the-requirement-first-workflow-for-active-work.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"FUNC-079/080/081 and MOD-004 Input, Five-view, Shared engine and Reusable template contracts explicitly accept the fixed supported model format with arbitrary project IDs, supply all five entry points and treat RigorLoop panels/catalogues as optional project data.","number":1,"state":"covered"},{"explanation":"IF-001 capture binds membership, bytes and profile to immutable selected input; MOD-004 snapshot identity/reader data and MOD-010 browser-v1 results carry project/profile, content and generator/renderer/resource identities and generation scope.","number":2,"state":"covered"},{"explanation":"FUNC-079 and IF-001 require a demonstrably immutable selection or captured export with complete membership/digests; unstable/insufficient capture rejects before publication.","number":3,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-043\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Capture attributable customer model inputs\",\n  \"status\": \"draft\",\n  \"statement\": \"The Definition storage Module shall capture attributable customer model inputs within its accountable browser contribution to SR-084, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Capture attributable customer model inputs.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-001 owns the behavior necessary for the selected SR-084 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-001 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-084 criteria 1, 2, 4. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A minimal supported customer model using its own entity IDs can produce Logical, Process, Development, Physical and Scenario entry points without RigorLoop-specific records, contribution tables or local operational history.\",\n    \"The result identifies selected project, declared profile, input content identity, generator version and generation scope. A Git revision alone does not identify changed working-tree content.\",\n    \"If input changes during collection, either use a demonstrably coherent captured selection or report failure; never combine different states under one unqualified identity.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-001\",\n  \"constrains\": [\n    \"FUNC-079\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-043; SR-084 criteria 1, 2, 4\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:6edf5726ab6d760956942141036b874a21934635a926169cb18d036c5303485f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-043-capture-attributable-customer-model-inputs.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-043","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 3 canonical AR-043 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:04d46256b799f5ba92f3481ef6692ca5ecbab5c632ea507dc8f7fbcaa32f132a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/sr.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:d63539c2f78036f0df7d6ef45a9cf1cb726c55d1b833bd273be2192e8a48b2e4","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-044-interpret-the-selected-browser-model-profile.json"},{"identity":"sha256:7fbb360f4c9304bea3481d357750eff651b24061a4c702a317aae0c4dea94266","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-045-compose-customer-architecture-snapshot-content.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"IF-002 interpretation and AR-044 retain declared-profile meaning and explicit unsupported/missing/ambiguous outcomes.","number":1,"state":"covered"},{"explanation":"FUNC-080 and MOD-004 input/view/data contracts distinguish optional missing realization/explanation from invalid required data.","number":2,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-044\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Interpret the selected browser model profile\",\n  \"status\": \"draft\",\n  \"statement\": \"The Interpretation and validation Module shall interpret the selected browser model profile within its accountable browser contribution to SR-084, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Interpret the selected browser model profile.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-003 owns the behavior necessary for the selected SR-084 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-003 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-084 criteria 3, 5. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Missing, ambiguous or unsupported profile selection yields a specific diagnostic without silently applying another profile; invalid required content prevents publication of a successful snapshot.\",\n    \"An absent optional view fact remains an explicit absence or limitation rather than making the supported minimal model invalid.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-003\",\n  \"constrains\": [\n    \"FUNC-012\",\n    \"FUNC-013\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-044; SR-084 criteria 3, 5\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:d63539c2f78036f0df7d6ef45a9cf1cb726c55d1b833bd273be2192e8a48b2e4","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-044-interpret-the-selected-browser-model-profile.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-044","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 2 canonical AR-044 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:04d46256b799f5ba92f3481ef6692ca5ecbab5c632ea507dc8f7fbcaa32f132a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/sr.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:6edf5726ab6d760956942141036b874a21934635a926169cb18d036c5303485f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-043-capture-attributable-customer-model-inputs.json"},{"identity":"sha256:7fbb360f4c9304bea3481d357750eff651b24061a4c702a317aae0c4dea94266","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-045-compose-customer-architecture-snapshot-content.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"FUNC-079/080/081 and MOD-004 Input, Five-view, Shared engine and Reusable template contracts explicitly accept the fixed supported model format with arbitrary project IDs, supply all five entry points and treat RigorLoop panels/catalogues as optional project data.","number":1,"state":"covered"},{"explanation":"IF-001 capture binds membership, bytes and profile to immutable selected input; MOD-004 snapshot identity/reader data and MOD-010 browser-v1 results carry project/profile, content and generator/renderer/resource identities and generation scope.","number":2,"state":"covered"},{"explanation":"FUNC-080 and MOD-004 input/view/data contracts distinguish optional missing realization/explanation from invalid required data.","number":3,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-045\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Compose customer architecture snapshot content\",\n  \"status\": \"draft\",\n  \"statement\": \"The Views and traceability Module shall compose customer architecture snapshot content within its accountable browser contribution to SR-084, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Compose customer architecture snapshot content.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-004 owns the behavior necessary for the selected SR-084 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-004 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-084 criteria 1, 2, 5. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A minimal supported customer model using its own entity IDs can produce Logical, Process, Development, Physical and Scenario entry points without RigorLoop-specific records, contribution tables or local operational history.\",\n    \"The result identifies selected project, declared profile, input content identity, generator version and generation scope. A Git revision alone does not identify changed working-tree content.\",\n    \"An absent optional view fact remains an explicit absence or limitation rather than making the supported minimal model invalid.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-004\",\n  \"constrains\": [\n    \"FUNC-080\",\n    \"FUNC-081\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-045; SR-084 criteria 1, 2, 5\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:7fbb360f4c9304bea3481d357750eff651b24061a4c702a317aae0c4dea94266","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-045-compose-customer-architecture-snapshot-content.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-045","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 3 canonical AR-045 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:04d46256b799f5ba92f3481ef6692ca5ecbab5c632ea507dc8f7fbcaa32f132a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/sr.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:6edf5726ab6d760956942141036b874a21934635a926169cb18d036c5303485f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-043-capture-attributable-customer-model-inputs.json"},{"identity":"sha256:d63539c2f78036f0df7d6ef45a9cf1cb726c55d1b833bd273be2192e8a48b2e4","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-044-interpret-the-selected-browser-model-profile.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"FUNC007 separates definition completeness from rationale availability/applicability. FUNC009 defines typed navigation; FUNC081 supplies readable keyboard overview/detail navigation. MOD004 Reader questions, Module page content, Rationale/source disclosure and reusable template define concrete reading flow.","number":1,"state":"covered"},{"explanation":"FUNC080 and MOD004 five-view contract keep logical, runtime, software and physical bases distinct; parent/direct and descendant allocation are separate.","number":2,"state":"covered"},{"explanation":"FUNC080 admits ordered interaction only from established semantics; MOD004 Process distinguishes topology, interactions and state, explicitly preserving unavailable/unsupported behavioral details as text.","number":3,"state":"covered"},{"explanation":"FUNC080 keys topic by owner/facet/qualification/kind/local name; MOD004 reading/source contract preserves qualification in listings/details/deep links and source identity.","number":4,"state":"covered"},{"explanation":"MOD004 Scenario contract and FUNC009 separate stakeholder situation/declared participation from reachability, coverage, approval or satisfaction.","number":5,"state":"covered"},{"explanation":"FUNC007/009/080 preserve missing/incomplete/unsupported distinctions; MOD004 browser-data and Module-content rules distinguish absent optional detail, missing required explanation and invalid required output.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-046\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve meaning and attribution across browser views\",\n  \"status\": \"draft\",\n  \"statement\": \"The Views and traceability Module shall preserve meaning and attribution across browser views within its accountable browser contribution to SR-085, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Preserve meaning and attribution across browser views.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-004 owns the behavior necessary for the selected SR-085 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-004 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-085 criteria 1, 2, 3, 4, 5, 6. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Readers can navigate each available view from an overview to relevant definitions, relationships and applicable rationale, using readable labels and keyboard-accessible navigation.\",\n    \"Logical ownership and containment remain distinct from execution and deployment; a shared source file does not merge logical responsibilities.\",\n    \"Process topology does not imply execution order or concurrency. Selected activity, interaction and lifecycle details appear only where authoritative semantics establish them.\",\n    \"Proposed and observed facts remain distinguishable in overviews and details, even when names are identical; each detail exposes its selected-state source basis.\",\n    \"Scenario navigation retains stakeholder meaning and identified architecture participation without turning reachability or rendering into coverage, approval or satisfaction.\",\n    \"Missing required explanation and incomplete selections remain explicit; absent details are not fabricated and view success does not establish a complete design.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-004\",\n  \"constrains\": [\n    \"FUNC-007\",\n    \"FUNC-009\",\n    \"FUNC-080\",\n    \"FUNC-081\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-046; SR-085 criteria 1, 2, 3, 4, 5, 6\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:1dee4e8814f45c1943675afcd28d2facd53586f7e18bb85d9d7caca8b269233f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-085-preserve-engineering-meaning-across-architecture-views/AR-046-preserve-meaning-and-attribution-across-browser-views.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Target coherent capture/traversal is not proved by repository navigation or schemas; system proof composes MOD-001/003/004/010.","AR-046 historical delivery remains unchanged and may be stale. SR-084/086/087/088 capture, portability, publication and qualification stay separate."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-046","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 6 canonical AR-046 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:bd4a159c76fca8c27594707ebd2d95bd43a07a76b27b0e06f022b823beaa9f94","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-085-preserve-engineering-meaning-across-architecture-views/sr.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:98c94da392584be5a65a45b09120621d96fa4d26e157ae0e7294414d3b64ddb3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-tree.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:45912f18331be67d938c93c65e5b28d8ac182799d9355e522c7c3cbd3a106162","path":"design/system/README.md"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:2469f00338b83e9a8a666c90c83cb079a52ea834241f9d0ec01c010066a50951","path":"design/system/functions/FUNC-007-present-current-engineering-definition-and-applicable-rationale.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:c4d3e474cac43a225dc240a6b4032d69d61c7e7b445653eafac232a232986f24","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/browser-views.toml"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:ee1303ac9c01e11d53b3d6af2c47fc915d37488f8db490d9de524c106bc7f9f3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-delivery-format.md"},{"identity":"sha256:915876f00dba078b8ffefdcd17f951997f444485c5545548d679d2f2d1d2f477","path":"design/support/requirement-delivery-v2.schema.json"},{"identity":"sha256:740c7e8a8398bce4a2046ef49f685d37bf516875e7d562ae102464bff8579f1b","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-evaluation.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"FUNC-081 and MOD-004 assembly/template/Physical contracts package complete local resources and copied version roots, embed required model/diagram/explanation content and keep all navigation in the browser.","number":1,"state":"covered"},{"explanation":"MOD-004 source/rationale disclosure and browser-data contracts include required definitions, explanation, diagrams, qualification and source identity within the artifact.","number":2,"state":"covered"},{"explanation":"The reader receives static HTML/CSS/JavaScript and admitted self-contained SVG/resources. FUNC-081, MOD-004 technical/physical design and MOD-013 boundary exclude Node/Rust/Python/D2, remote fonts/CDNs, a hosted service and operational database from reading.","number":3,"state":"covered"},{"explanation":"Snapshot/manifest identity covers project/profile, exact model membership/content and tool/resource provenance.","number":4,"state":"covered"},{"explanation":"The reader changes only local reading state and has no mutation/generator service connection. Capture/publication contracts forbid source modification or upload. Copying/opening does not grant external publication authority; release/publication remains separately explicit.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-047\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Provide portable offline architecture reading\",\n  \"status\": \"draft\",\n  \"statement\": \"The Views and traceability Module shall provide portable offline architecture reading within its accountable browser contribution to SR-086, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Provide portable offline architecture reading.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-004 owns the behavior necessary for the selected SR-086 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-004 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-086 criteria 1, 2, 3, 4, 5. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Copy the complete output to another supported reading environment, make the source checkout unavailable and disable network access; required navigation, diagrams, definitions and included rationale remain usable.\",\n    \"The snapshot contains the reading resources and source detail needed to understand its selected scope; unavailable optional external links do not replace required explanations.\",\n    \"Reading requires no generator, rendering compiler, remote fonts or script CDN, hosted service or local operational database.\",\n    \"The reader can identify project/profile, input content identity and generator provenance; the snapshot does not claim live freshness without a fresh comparison.\",\n    \"Opening or copying the snapshot does not alter engineering sources or grant permission to publish customer information.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-004\",\n  \"constrains\": [\n    \"FUNC-081\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-047; SR-086 criteria 1, 2, 3, 4, 5\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:7cc7f61a3b2c12b5606b03c8ecf3ed719744b62cd23495e7cfe18b850109e7d6","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-086-read-portable-architecture-snapshots-offline/AR-047-provide-portable-offline-architecture-reading.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-047","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 5 canonical AR-047 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:a449de0f92f9099ffef32cf3f6b42e39f06f6569ceedccfd2736a1487152ac39","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-086-read-portable-architecture-snapshots-offline/sr.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:ee1303ac9c01e11d53b3d6af2c47fc915d37488f8db490d9de524c106bc7f9f3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-delivery-format.md"},{"identity":"sha256:915876f00dba078b8ffefdcd17f951997f444485c5545548d679d2f2d1d2f477","path":"design/support/requirement-delivery-v2.schema.json"},{"identity":"sha256:740c7e8a8398bce4a2046ef49f685d37bf516875e7d562ae102464bff8579f1b","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-evaluation.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"FUNC-082 and MOD-004 Physical publication contract reject input/output overlap, symlink escape, installation-root writes, unknown ownership and unexpected output files before publication.","number":1,"state":"covered"},{"explanation":"Preparation fully validates candidate resources before publication. Immutable versions preserve existing readable assets; exclusive ownership and one atomic entry switch define commit, with directory durability before success. Recovery inspects exact old/candidate/entry identities, preserves bytes and reports unknown state instead of claiming completion or blindly retrying.","number":2,"state":"covered"},{"explanation":"IF-001/FUNC-079 capture only profile-declared members and selected permitted explanation from immutable input; private operational history, credentials and unrelated workspace traversal are excluded.","number":3,"state":"covered"},{"explanation":"MOD-004 diagram admission, browser-data and engine protocol constrain source-owned D2, escape text, admit structured safe links and sanitized self-contained SVG, reject source/output escapes and external resources, and never launch model-supplied commands.","number":4,"state":"covered"},{"explanation":"FUNC-082 and IF-012 are local derived-output responsibilities and explicitly perform no external upload.","number":5,"state":"covered"},{"explanation":"Snapshot identity and stable serialization/rendering bind ordered membership/content, declared profile, generator/renderer/resources and options while excluding machine paths, wall-clock timestamps and random operation IDs from deterministic content.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-048\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve source and output boundaries during snapshot publication\",\n  \"status\": \"draft\",\n  \"statement\": \"The Views and traceability Module shall preserve source and output boundaries during snapshot publication within its accountable browser contribution to SR-087, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Preserve source and output boundaries during snapshot publication.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-004 owns the behavior necessary for the selected SR-087 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-004 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-087 criteria 1, 2, 3, 4, 5, 6. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Reject an output selection overlapping authoritative input or requiring replacement of unrelated files before mutation; replacement is confined to explicitly selected generated output.\",\n    \"For invalid input, rendering failure or interrupted generation, preserve the prior complete readable snapshot or restore it through the declared recovery procedure before reporting successful replacement; an unresolved partial state is reported and never called complete.\",\n    \"Generation leaves canonical model bytes unchanged and includes only selected model content and necessary reading resources, excluding unrelated workspace content and private operational history.\",\n    \"Hostile text, links and paths cannot execute supplied script, escape the selected output boundary or cause undeclared resource acquisition.\",\n    \"Generation and reading do not publish or upload content. Publication requires a separate explicit action and applicable authority.\",\n    \"Equivalent declared inputs and tool versions produce equivalent declared snapshot content; actual provenance observations are identified separately from deterministic content.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-004\",\n  \"constrains\": [\n    \"FUNC-081\",\n    \"FUNC-082\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-048; SR-087 criteria 1, 2, 3, 4, 5, 6\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:8c4e30b58e355580d1693a2c0fca19a572d660b2c1419f24887fd3c958533d4c","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-087-generate-architecture-snapshots-within-safe-output-boundaries/AR-048-preserve-source-and-output-boundaries-during-snapshot-publication.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-048","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 6 canonical AR-048 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:2844f7d466b58a52365f9e337cdb07f46da798a17e8edf3a64ca81b241d3b0f3","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-087-generate-architecture-snapshots-within-safe-output-boundaries/sr.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-013's browser candidate contract declares exact generator, fixed profile, template/data resources, Rust engine, D2 binaries/licenses and configuration identities in the actual CLI inventory under IF-005.","number":1,"state":"covered"},{"explanation":"FUNC-083 qualifies the installed candidate with an independent minimal model through the public command boundary, without checkout imports, Python/Cargo, install hooks or undeclared acquisition; the reference repository is an additional first-project case.","number":2,"state":"covered"},{"explanation":"Qualification copies a complete snapshot and exercises offline reading in declared browsers. MOD-010 checks platform/resources before writer acquisition and preserves incompatibility or response-loss outcomes instead of claiming success.","number":3,"state":"covered"},{"explanation":"Browser acquisition/update uses the existing trusted package-manager path into an isolated tool prefix, outside model/output roots. No hooks rewrite snapshots; clean-prefix negative cases observe actual effects and content preservation.","number":4,"state":"covered"},{"explanation":"The first Linux x86-64/Node24/engine/D2 target freezes exact runtime and reader versions per candidate; combined dependency/protocol/filesystem qualification is mandatory and other configurations remain unsupported.","number":5,"state":"covered"},{"explanation":"MOD-013/015 distinguish reusable candidate and reference snapshot identities and evidence. Source-tree tests or a hosted sample establish neither complete customer support nor public availability.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-049\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Qualify complete browser product resources\",\n  \"status\": \"draft\",\n  \"statement\": \"The Package production Module shall qualify complete browser product resources within its accountable browser contribution to SR-088, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Qualify complete browser product resources.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-013 owns the behavior necessary for the selected SR-088 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-013 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-088 criteria 1, 2, 3, 4, 5, 6. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The candidate inventory identifies generator, supported profile definitions, projection and reading resources, relevant licenses and all required generation/runtime dependencies, bound to actual artifact identity.\",\n    \"In a clean declared generation environment, the acquired candidate generates views for a minimal customer project without the RigorLoop source checkout, undeclared build steps or hidden downloads.\",\n    \"Qualification includes reading a copied output offline in the declared browser environment; dependency and profile incompatibilities produce explicit diagnostics rather than a false successful result.\",\n    \"Acquisition or update verifies the selected artifact through the declared trust/integrity mechanism and preserves customer engineering definitions, unrelated files and existing shared snapshots; failed operations report actual effects and recovery limits.\",\n    \"Generator, profile, reading environment and dependency compatibility are declared and assessed together for each supported configuration; unsupported configurations are not implied by a generic download.\",\n    \"The reusable tool artifact and RigorLoop reference-documentation snapshot have separately identifiable content and qualification. A hosted sample or successful local build does not establish customer-tool support or public availability.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-013\",\n  \"constrains\": [\n    \"FUNC-060\",\n    \"FUNC-061\",\n    \"FUNC-083\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-049; SR-088 criteria 1, 2, 3, 4, 5, 6\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:5394828ba4abc2042ce94228db1eb66e7391b05164a2f96bd808861c46271ffe","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/AR-049-qualify-complete-browser-product-resources.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-049","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 6 allocated criteria, preserving MOD-013 contribution and collaborating owners under SR-088.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:e54e6164b2031abaad4a91defa6784121b05573c5e2bbba2a9dc5114ce8565bd","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/sr.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:d71c9c7b3fe1dac754cb00c3f8ac78a8af838bc345aa4eff004b59c7412d988c","path":"design/system/functions/FUNC-060-build-supported-product-candidates.json"},{"identity":"sha256:d5a10410e8ad94a7c146d73ddabfaa18ac048ff056a918c46276c8fe38305a36","path":"design/system/functions/FUNC-061-derive-artifact-integrity-metadata.json"},{"identity":"sha256:ae5ea04bf84064fdccca4a7330ccd69fb35e7b79b8b3629c2151c5ce97e7353d","path":"design/system/functions/FUNC-083-qualify-browser-candidates-for-customer-generation-and-reading.json"}],"summary":"The existing browser allocation is covered by explicit assembly, command admission, qualification and separately authorized publication cooperation."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-013/015 distinguish reusable candidate and reference snapshot identities and evidence. Source-tree tests or a hosted sample establish neither complete customer support nor public availability.","number":1,"state":"covered"},{"explanation":"MOD-015 consumes exact browser qualification through IF-005 and applies existing immutable-candidate authority, public observation and recovery rules. Qualification itself grants no publication permission.","number":2,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-050\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Keep browser qualification and publication authority distinct\",\n  \"status\": \"draft\",\n  \"statement\": \"The Release coordination Module shall keep browser qualification and publication authority distinct within its accountable browser contribution to SR-088, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Keep browser qualification and publication authority distinct.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-015 owns the behavior necessary for the selected SR-088 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-015 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-088 criteria 6, 7. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The reusable tool artifact and RigorLoop reference-documentation snapshot have separately identifiable content and qualification. A hosted sample or successful local build does not establish customer-tool support or public availability.\",\n    \"Publication remains governed by the existing exact-candidate authorization and observed-outcome obligations; no public release is implied by qualification.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-015\",\n  \"constrains\": [\n    \"FUNC-068\",\n    \"FUNC-070\",\n    \"FUNC-071\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-050; SR-088 criteria 6, 7\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:a7903402d24d6ecc6e59c26c8cf88fa42884caaee6152c367c5cfe96ee1c4e50","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/AR-050-keep-browser-qualification-and-publication-authority-distinct.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-050","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 2 allocated criteria, preserving MOD-015 contribution and collaborating owners under SR-088.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:e54e6164b2031abaad4a91defa6784121b05573c5e2bbba2a9dc5114ce8565bd","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/sr.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:2cdcd8449d7d5073d9a4b63879ab8acd2d91010979590d50f90ada2dbe8d8041","path":"design/system/functions/FUNC-068-assess-release-preflight-and-qualification.json"},{"identity":"sha256:417e1053c8fcafcdcf5ddf7a4f8a71958763c3215ff64419e675bee117d5cfe3","path":"design/system/functions/FUNC-070-publish-an-authorized-retained-candidate.json"},{"identity":"sha256:e70013a4f8fb30f56ecee6c674167b9fb4345ed8990094bd7c589fe8e24c3c26","path":"design/system/functions/FUNC-071-observe-public-release-and-record-closeout.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"}],"summary":"The existing browser allocation is covered by explicit assembly, command admission, qualification and separately authorized publication cooperation."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"FUNC-083 qualifies the installed candidate with an independent minimal model through the public command boundary, without checkout imports, Python/Cargo, install hooks or undeclared acquisition; the reference repository is an additional first-project case.","number":1,"state":"covered"},{"explanation":"Qualification copies a complete snapshot and exercises offline reading in declared browsers. MOD-010 checks platform/resources before writer acquisition and preserves incompatibility or response-loss outcomes instead of claiming success.","number":2,"state":"covered"},{"explanation":"The first Linux x86-64/Node24/engine/D2 target freezes exact runtime and reader versions per candidate; combined dependency/protocol/filesystem qualification is mandatory and other configurations remain unsupported.","number":3,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-051\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Reject unsupported browser invocation environments\",\n  \"status\": \"draft\",\n  \"statement\": \"The Command handling Module shall reject unsupported browser invocation environments within its accountable browser contribution to SR-088, retaining the stated limits of collaborating owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A locally successful browser step can hide missing ownership or an invalid cross-boundary conclusion.\",\n      \"desired_outcome\": \"Reject unsupported browser invocation environments.\"\n    },\n    \"why\": {\n      \"rationale\": \"MOD-010 owns the behavior necessary for the selected SR-088 criteria; the SR remains the system-wide obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading, recovering or qualifying the selected browser scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-010 and its declared browser cooperation contracts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the constrained Functions and preserve source, output, qualification and authority distinctions at the boundary.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Contribution to SR-088 criteria 2, 3, 5. Other Module contributions and final product qualification remain distinct.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"In a clean declared generation environment, the acquired candidate generates views for a minimal customer project without the RigorLoop source checkout, undeclared build steps or hidden downloads.\",\n    \"Qualification includes reading a copied output offline in the declared browser environment; dependency and profile incompatibilities produce explicit diagnostics rather than a false successful result.\",\n    \"Generator, profile, reading environment and dependency compatibility are declared and assessed together for each supported configuration; unsupported configurations are not implied by a generic download.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Draft allocation; does not establish implemented browser support or requirement satisfaction.\"\n  ],\n  \"allocated_to\": \"MOD-010\",\n  \"constrains\": [\n    \"FUNC-040\",\n    \"FUNC-048\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"AR-051; SR-088 criteria 2, 3, 5\",\n      \"basis\": \"System and Architecture Design from SR-084–088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:680f2ce92cd94db8393b8d8167b57802f9e69b965db00363c7dd46d868d339d6","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/AR-051-reject-unsupported-browser-invocation-environments.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised.","MOD-010 contributes admission, exact packaged-engine selection and truthful result presentation; MOD-013 performs the complete candidate/customer/offline qualification."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-051","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 3 allocated criteria, preserving MOD-010 contribution and collaborating owners under SR-088.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:e54e6164b2031abaad4a91defa6784121b05573c5e2bbba2a9dc5114ce8565bd","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/sr.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:8cd48470112d1d1948365f950b015e92df117ac302661f26311de28f9b3e2b27","path":"design/system/functions/FUNC-040-admit-explicit-requests-under-declared-command-contracts.json"},{"identity":"sha256:302fb1f00c393413ca968a5be04118d06d452a75f31da200675fbe56bcbf27dd","path":"design/system/functions/FUNC-048-project-bounded-command-results-without-changing-meaning.json"}],"summary":"The existing browser allocation is covered by explicit assembly, command admission, qualification and separately authorized publication cooperation."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-011 backup manifest binds project, captured incarnation/revision, backup/record/schema versions, complete selected Change/account/reference closure, required attachment membership and explicit external/excluded scope.","number":1,"state":"covered"},{"explanation":"The maintained admission fence drains ordinary database and payload leases, then holds exclusion across snapshot and artifact capture; known noncooperating writers require participant-established source quiescence or withheld capture.","number":2,"state":"covered"},{"explanation":"Required payload closure, file-kind/path containment, size/hash integrity and database/reference validation precede complete publication; missing/unreadable/corrupt required members identify gaps and withhold the marker/complete result.","number":3,"state":"covered"},{"explanation":"Owned staging beside an absent output and no replacement of existing backups preserve source/valid backups on interruption, cancellation or capacity failure.","number":4,"state":"covered"},{"explanation":"Selected nonempty Change sets retain each selected Change’s current closure, report excluded Changes/external model references, and do not reconstruct discarded runs, later writes, unselected files or unsaved work.","number":5,"state":"covered"},{"explanation":"The unchanged typed public maintenance contract separates nonreserving preview from execution, binds source/destination expectations, and reports actual complete/activated/uncertain scope.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-052\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Capture coherent selected operational backups\",\n  \"status\": \"draft\",\n  \"statement\": \"The Work records Module shall capture coherent selected operational backups through its typed maintenance boundary, preserving actual scope, source meaning and safe failure.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Copying only records, or capturing changing records and artifacts at different states, can produce a backup that cannot restore its claimed scope.\",\n      \"desired_outcome\": \"A participant can distinguish a complete recoverable capture from an incomplete attempt and know which work it preserves.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-074 requires operational preservation; MOD-011 owns the associated store and maintenance activation, while MOD-010 owns admission and result presentation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized agents relying on retained operational work\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An actor explicitly selects the supported maintenance task, scope, source expectations and destination.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-011 through IF-003, invoked by MOD-010 through IF-004; engineering definitions remain repository-owned.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the reviewed MOD-011 maintenance contract: coherent staged scope, explicit project/schema/integrity checks, exclusive activation and attributable recovery outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Selected retained supported records and payloads only; no silent merge, universal history retention, source deletion or renewed engineering approval.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For a selected project state containing Changes, findings and retained artifacts, a complete backup identifies the captured state, project, interpretation version, included records and artifacts, and declared exclusions; all included references resolve within the retained scope or are explicitly external.\",\n    \"When recording continues during capture, the backup represents one coherent declared state or reports that capture could not complete; it never combines incompatible record and artifact versions as a complete backup.\",\n    \"If a required artifact is missing, unreadable or fails its recorded integrity check, backup creation reports the affected scope and does not declare a complete backup.\",\n    \"Interruption, cancellation or insufficient destination capacity leaves existing valid backups and source work unchanged and identifies any incomplete output as unusable for complete restoration.\",\n    \"An explicitly selected narrower scope identifies exclusions and cannot claim to preserve excluded evidence, post-capture work or unsaved content.\",\n    \"The public maintenance contract identifies preview versus execution, current expectations and actual effects; interrupted activation remains fenced until explicitly reconciled.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"Historical subject/revision provenance remains stable; restoring operational state creates a fresh store incarnation so old mutation tokens cannot be replayed.\"\n  ],\n  \"allocated_to\": \"MOD-011\",\n  \"constrains\": [\n    \"FUNC-074\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"SR-074; MOD-011 store-maintenance-v1 contract\",\n      \"basis\": \"Reconcile the existing reviewed maintenance responsibility with explicit REM allocation. This allocation is design intent, not execution or satisfaction evidence.\"\n    }\n  ]\n}\n","identity":"sha256:a6c1436112bdc5b688d59af332dc3d28b56c2792d71836db7e460d6b2ada30af","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-074-create-coherent-recoverable-operational-backups/AR-052-capture-coherent-selected-operational-backups.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-052","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-052 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:c5fe6bbdc7d362a1aab7936faeaa1f2251291b63769163098d1dba8450fbf3bd","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-074-create-coherent-recoverable-operational-backups/sr.json"},{"identity":"sha256:a8478d902b9a1dc890a29e0597d5a8b9a31bb1cbb5b29e3a9b1c1ac63efa8729","path":"design/system/functions/FUNC-074-create-a-coherent-operational-backup.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The self-contained validated backup supplies original records, dispositions, subjects/revisions, provenance and managed payloads without the source store.","number":1,"state":"covered"},{"explanation":"Manifest/completion/project/version/content validation rejects wrong association, unsupported interpretation, corrupt members and missing required payloads before activation; unrelated destination and original backup remain untouched.","number":2,"state":"covered"},{"explanation":"Restoration preserves original engineering judgments and assessed subjects, while a new store incarnation invalidates old mutation tokens.","number":3,"state":"covered"},{"explanation":"Empty destination requires absent expectation and replacement disabled; occupied/unavailable destination requires separately authorized replacement and fresh exact observation, rechecked under exclusion.","number":4,"state":"covered"},{"explanation":"Durable maintenance manifest and fence span path installation/reopening/validation until activated marker.","number":5,"state":"covered"},{"explanation":"Missing/unusable backup or corrupt/unavailable store yields explicit unavailable/recovery-needed scope.","number":6,"state":"covered"},{"explanation":"The unchanged typed public maintenance contract separates nonreserving preview from execution, binds source/destination expectations, and reports actual complete/activated/uncertain scope.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-053\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Restore only validated associated operational scope\",\n  \"status\": \"draft\",\n  \"statement\": \"The Work records Module shall restore only validated associated operational scope through its typed maintenance boundary, preserving actual scope, source meaning and safe failure.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Loss of a local operational store can erase resumption context; an apparently successful restore can silently omit evidence or renew old judgments.\",\n      \"desired_outcome\": \"An authorized participant can recover the declared retained work and identify every limitation before relying on it.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-075 requires operational preservation; MOD-011 owns the associated store and maintenance activation, while MOD-010 owns admission and result presentation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized agents relying on retained operational work\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An actor explicitly selects the supported maintenance task, scope, source expectations and destination.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-011 through IF-003, invoked by MOD-010 through IF-004; engineering definitions remain repository-owned.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the reviewed MOD-011 maintenance contract: coherent staged scope, explicit project/schema/integrity checks, exclusive activation and attributable recovery outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Selected retained supported records and payloads only; no silent merge, universal history retention, source deletion or renewed engineering approval.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"With the original store unavailable and a valid complete backup accessible, restore reproduces the selected records, finding dispositions, subjects and revisions, decisions, provenance and required artifact content in the declared project scope.\",\n    \"Wrong-project input, unsupported interpretation, corrupted content or missing required artifacts is rejected before destination activation; source backup and unrelated destination content remain unchanged.\",\n    \"Restored reviews and verification results retain their original subject identities and applicability; neither restoration nor a different current engineering revision renews approval or evidence freshness.\",\n    \"An occupied or changed destination causes an explicit conflict unless a separately authorized safe replacement is supported; restoration never silently merges divergent histories or overwrites newer work.\",\n    \"An interrupted restoration exposes no partially restored state as complete or ready for resumption; retry identifies the actual destination state and preserves existing usable content.\",\n    \"When no usable backup exists, restoration reports unavailable and does not initialize an empty history as successful recovery.\",\n    \"The public maintenance contract identifies preview versus execution, current expectations and actual effects; interrupted activation remains fenced until explicitly reconciled.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"Historical subject/revision provenance remains stable; restoring operational state creates a fresh store incarnation so old mutation tokens cannot be replayed.\"\n  ],\n  \"allocated_to\": \"MOD-011\",\n  \"constrains\": [\n    \"FUNC-075\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"SR-075; MOD-011 store-maintenance-v1 contract\",\n      \"basis\": \"Reconcile the existing reviewed maintenance responsibility with explicit REM allocation. This allocation is design intent, not execution or satisfaction evidence.\"\n    }\n  ]\n}\n","identity":"sha256:a06dd4ae91625654d2b1b8fd550b84ab711de41a4b510c9ab4a1ffd6788609a3","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-075-restore-operational-history-without-changing-its-original-meaning/AR-053-restore-only-validated-associated-operational-scope.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-053","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical AR-053 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:44126953b43252bdb28cf64fdbab87e77da936c3609cc7a79cbbec587a46761b","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-075-restore-operational-history-without-changing-its-original-meaning/sr.json"},{"identity":"sha256:3c4b1b0f78d2474332d2788d3843e962524ed1d6a510db4b84f2ec032ddbdcba","path":"design/system/functions/FUNC-075-validate-and-restore-retained-operational-work.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Sender backup and receiver preview/read expose exact project, captured state, selected records/artifacts and exclusions before activation.","number":1,"state":"covered"},{"explanation":"Explicit same-project configuration, complete transported backup and absent expectation with replacement disabled compose AR-052 capture and AR-053 restoration into an empty destination; no separate transfer operation is invented.","number":2,"state":"covered"},{"explanation":"Different project, occupied/divergent history or conflicting reused identities reject transfer without changing either side.","number":3,"state":"covered"},{"explanation":"Incoming selected scope/exclusions are visible before and after transfer and bound completeness.","number":4,"state":"covered"},{"explanation":"Copying the immutable backup leaves the source usable; receiver maintenance changes only admitted operational paths.","number":5,"state":"covered"},{"explanation":"The unchanged typed public maintenance contract separates nonreserving preview from execution, binds source/destination expectations, and reports actual complete/activated/uncertain scope.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-054\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Transfer selected scope through explicit project association\",\n  \"status\": \"draft\",\n  \"statement\": \"The Work records Module shall transfer selected scope through explicit project association through its typed maintenance boundary, preserving actual scope, source meaning and safe failure.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A copied engineering checkout does not contain private work history, and importing history into the wrong project can create false provenance.\",\n      \"desired_outcome\": \"Another local environment can inspect and resume the selected retained work with its original meaning and explicit limits.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-076 requires operational preservation; MOD-011 owns the associated store and maintenance activation, while MOD-010 owns admission and result presentation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized agents relying on retained operational work\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An actor explicitly selects the supported maintenance task, scope, source expectations and destination.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-011 through IF-003, invoked by MOD-010 through IF-004; engineering definitions remain repository-owned.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the reviewed MOD-011 maintenance contract: coherent staged scope, explicit project/schema/integrity checks, exclusive activation and attributable recovery outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Selected retained supported records and payloads only; no silent merge, universal history retention, source deletion or renewed engineering approval.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Transfer declares source project, retained scope, included artifacts and state identity; the receiving environment can inspect those facts before activation.\",\n    \"A matching project in an empty authorized destination receives the selected scope with the same identities and provenance through the backup/restoration integrity obligations of SR-074/075.\",\n    \"A different project identity, divergent existing history or reused record identity with different content causes a conflict and leaves both histories intact; project-name similarity does not establish identity.\",\n    \"Excluded records or artifacts are visible before reliance, and the receiving result does not claim completeness outside the declared transferable scope.\",\n    \"Transfer leaves the source usable, does not change engineering-model files, and does not silently refresh assessments to the destination checkout revision.\",\n    \"The public maintenance contract identifies preview versus execution, current expectations and actual effects; interrupted activation remains fenced until explicitly reconciled.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"Historical subject/revision provenance remains stable; restoring operational state creates a fresh store incarnation so old mutation tokens cannot be replayed.\"\n  ],\n  \"allocated_to\": \"MOD-011\",\n  \"constrains\": [\n    \"FUNC-075\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"SR-076; MOD-011 store-maintenance-v1 contract\",\n      \"basis\": \"Reconcile the existing reviewed maintenance responsibility with explicit REM allocation. This allocation is design intent, not execution or satisfaction evidence.\"\n    }\n  ]\n}\n","identity":"sha256:215de102a96431d978388e38601896771ec8f987a1e5136fc235a98eeb256fb0","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-076-transfer-retained-operational-work-with-explicit-project-association/AR-054-transfer-selected-scope-through-explicit-project-association.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-054","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-054 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:120cc01f5b2ba455cf04d05f5738e7906253e35a3f678cf42f8a4a45d329db0e","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-076-transfer-retained-operational-work-with-explicit-project-association/sr.json"},{"identity":"sha256:3c4b1b0f78d2474332d2788d3843e962524ed1d6a510db4b84f2ec032ddbdcba","path":"design/system/functions/FUNC-075-validate-and-restore-retained-operational-work.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Qualified adapter mapping plus attributable per-record import/retain/block disposition covers the entire selected record/artifact inventory before publication.","number":1,"state":"covered"},{"explanation":"Mapped target preserves source identities/format/location/content, actor decisions, unresolved findings, relations and original assessed subjects.","number":2,"state":"covered"},{"explanation":"Unsupported history stays recoverable archival content only after active dependencies are resolved.","number":3,"state":"covered"},{"explanation":"Required originals package is published and verified before activation with exact bytes, paths, identities and required uncommitted material/artifacts.","number":4,"state":"covered"},{"explanation":"Legacy source owners establish and hold actual writer/payload quiescence through capture, final recheck and activation; destination fence alone is insufficient.","number":5,"state":"covered"},{"explanation":"One validated target becomes authoritative only after required source/consumer reconciliation; old writer remains excluded until retired from current use.","number":6,"state":"covered"},{"explanation":"The unchanged typed public maintenance contract separates nonreserving preview from execution, binds source/destination expectations, and reports actual complete/activated/uncertain scope.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-055\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Import qualified source facts with preserved originals\",\n  \"status\": \"draft\",\n  \"statement\": \"The Work records Module shall import qualified source facts with preserved originals through its typed maintenance boundary, preserving actual scope, source meaning and safe failure.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A storage conversion can lose unsupported records, unresolved findings or exact evidence, or misrepresent old approvals as current.\",\n      \"desired_outcome\": \"Maintainers can account for every selected source and rely on one coherent operational destination without losing historical meaning.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-077 requires operational preservation; MOD-011 owns the associated store and maintenance activation, while MOD-010 owns admission and result presentation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized agents relying on retained operational work\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An actor explicitly selects the supported maintenance task, scope, source expectations and destination.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-011 through IF-003, invoked by MOD-010 through IF-004; engineering definitions remain repository-owned.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the reviewed MOD-011 maintenance contract: coherent staged scope, explicit project/schema/integrity checks, exclusive activation and attributable recovery outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Selected retained supported records and payloads only; no silent merge, universal history retention, source deletion or renewed engineering approval.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Before publication, migration identifies selected source content and identities and classifies each record as supported for import, retained archival evidence, or blocked pending disposition; counts alone do not establish semantic equivalence.\",\n    \"Imported records preserve stable identities, actor decisions, unresolved findings, relationships, original subject identities and assessment meaning; source format, original location and content identity remain attributable.\",\n    \"Unsupported historical formats remain archival and do not acquire runtime support or renewed approval; active work that depends on them blocks activation until a responsible disposition is recorded.\",\n    \"Required original bytes, uncommitted source content and required artifacts remain recoverable. Migrating records does not itself authorize source deletion; SR-024 governs retirement.\",\n    \"Changed source identity, interruption, conflicting destination content or an invalid final reference prevents partial activation and preserves sources and unrelated destination work. A retry cannot duplicate already imported identities or silently merge conflicts.\",\n    \"Activation identifies one authoritative operational destination and reconciles current readers and writers; no permanent dual-write or silent legacy fallback is established.\",\n    \"The public maintenance contract identifies preview versus execution, current expectations and actual effects; interrupted activation remains fenced until explicitly reconciled.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"Historical subject/revision provenance remains stable; restoring operational state creates a fresh store incarnation so old mutation tokens cannot be replayed.\"\n  ],\n  \"allocated_to\": \"MOD-011\",\n  \"constrains\": [\n    \"FUNC-076\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"SR-077; MOD-011 store-maintenance-v1 contract\",\n      \"basis\": \"Reconcile the existing reviewed maintenance responsibility with explicit REM allocation. This allocation is design intent, not execution or satisfaction evidence.\"\n    }\n  ]\n}\n","identity":"sha256:7fe3127e3ee2c61c5747f737988ec97fc5f97099d7adc3deff18e5596226254e","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-077-migrate-operational-records-with-explicit-preservation-and-disposition/AR-055-import-qualified-source-facts-with-preserved-originals.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-055","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical AR-055 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:f8aff524a22587d6aee52947a07847abb132c40bbc57852db2e96b04028fac95","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-077-migrate-operational-records-with-explicit-preservation-and-disposition/sr.json"},{"identity":"sha256:f707b0a9a7397e67324a7f27c0bdb8fc3d4d7196c6bd60fcbb778803d00e1e82","path":"design/system/functions/FUNC-076-reconcile-and-migrate-selected-operational-records.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"FUNC-009 already requires complete selected reachability. traversal.md Admission and coherent inventory requires full source membership, coherent bytes and same-state/profile interpretation via IF-001/002, including all possible incoming sources.","number":1,"state":"covered"},{"explanation":"Authoritative edge source/type/target and field/containment provenance are retained. Incoming reverses traversal orientation over the same inventory; both admits either direction without authoring duplicate facts. IF-001 complete relationship-bearing membership prevents an outgoing-only partial index from falsely establishing incoming completeness. Parentage follows the governing profile representation.","number":2,"state":"covered"},{"explanation":"The selected-state plus entity visited key is sufficient because one request fixes types and direction.","number":3,"state":"covered"},{"explanation":"Depth zero returns starts without adjacency expansion; depth N expands only minimum-depth nodes below N.","number":4,"state":"covered"},{"explanation":"Acquisition and exploration outcomes are separate. Complete inventory enumeration, reads and interpretation are required before a positive result. Missing eligible targets, uninterpretable required content, interruption and resource exhaustion retain only same-state attributable observations with affected member/path/frontier and reason. Incomplete takes precedence over a simultaneous requested bound. Unestablished coherence or response loss cannot become complete empty; MOD-010 preserves diagnostics.","number":5,"state":"covered"},{"explanation":"Admission requires one project/state/profile, nonempty unique-resolvable starts, declared relationship types, outgoing/incoming/both direction and valid explicit bounds.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-056\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve scoped traversal completeness and attribution\",\n  \"status\": \"draft\",\n  \"statement\": \"The Views and traceability Module shall traverse the complete applicable relationship inventory of one selected model state, deriving incoming navigation from authored facts, terminating cycles, and preserving exact request, path provenance, explicit boundaries and incomplete outcomes through its result.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A finite navigation tree or partial inventory can conceal reachable obligations and appear complete.\",\n      \"desired_outcome\": \"The traversal owner returns the full requested reachability or an attributable bounded/incomplete result.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-009 requires completeness to refer to the actual selected types, direction, state and limits, including incoming paths and cyclic graphs.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers following responsibility paths\",\n        \"Command and view consumers of model traversal\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a participant requests or changes a relationship traversal scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-004 traversal responsibility inside MOD-016; external consumers use IF-013.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Compose state-bound content and interpretation from IF-001/IF-002, build attributable forward/inverse adjacency, use finite visited traversal, and retain admission, acquisition and exploration outcomes separately.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers all six SR-009 criteria for the traversal contribution. No implicit depth/result cap or latency guarantee. Supporting storage and interpretation obligations keep their existing owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For an admitted request and complete finite applicable inventory, return every reachable entity and finite typed edge/path support under the selected types and direction, with no hidden depth or count cutoff.\",\n    \"Derive incoming and bidirectional exploration from the same authored edges, retaining original source, target, relationship and provenance.\",\n    \"Process each entity at its minimum distance from the selected starts; terminate valid cross-domain cycles without dropping reachable entities or treating them as invalid requirement parentage.\",\n    \"For requested depth or entity-count limits, identify their exact semantics, delivered boundary and any omitted frontier; distinguish fulfilled bounded selection from unrestricted completeness.\",\n    \"If inventory acquisition, interpretation or traversal is incomplete or interrupted, preserve usable state-bound observations, affected scope and reason, without returning complete empty reachability.\",\n    \"Reject unresolved or ambiguous starts, unknown relationship types, unsupported direction and mixed project/state/baseline selection with actionable diagnostics and no substituted scope.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Design allocation only; existing reader navigation and schema checks do not establish this obligation as implemented or verified.\"\n  ],\n  \"allocated_to\": \"MOD-004\",\n  \"constrains\": [\n    \"FUNC-009\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-SCOPED-TRAVERSAL-DESIGN\",\n      \"locator\": \"SR-009; SCN-008; FUNC-009\",\n      \"basis\": \"Derive selected-state traversal responsibility, admission/completeness outcomes and necessary allocation from existing obligations. Proposed architecture only; no implementation, verification or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Coherent capture/traversal remains target Design; navigation/schemas cannot prove it. System proof requires MOD-001/003/004/010 composition. Historical delivery may remain stale."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-056","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 6 canonical AR-056 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:bbab4a06bc1dfa726412666c9247c99c1c9c3e50f0e8fcf6ea25b7abb5e9e6b7","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/sr.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:6edf5726ab6d760956942141036b874a21934635a926169cb18d036c5303485f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-043-capture-attributable-customer-model-inputs.json"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:6ce1497da7edf831832acbb0299a145d4a40d33f211eba88b45c993d34f30475","path":"rem/models/architecture-design.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-002 Request and result boundary defines explicit operation, selected model/base/profile, endpoints and original fact for replace/remove, with authoritative field/containment provenance.","number":1,"state":"covered"},{"explanation":"The owning design distinguishes explicit parent replacement from identity-preserving rename. It retains stable entity identity and requires applicable authority plus derivation reconsideration. A mandatory parent cannot be removed without a valid replacement; IF-002 checks final cardinality/acyclicity rather than transient staging states.","number":2,"state":"covered"},{"explanation":"MOD-002 constructs only the requested delta over acquired complete membership, retaining unchanged facts needed for identity/incoming/containment checks.","number":3,"state":"covered"},{"explanation":"Both endpoint projections are derived only from the same confirmed resulting fact set; replacement/removal rebuilds current selection so no old inverse remains current.","number":4,"state":"covered"},{"explanation":"Endpoint indexes are disposable and keyed by model/exact state/profile/content identity. Current selection invalidation does not mutate frozen historical views or make them current. General MOD-004 traversal reuses this meaning without introducing stored inverse authority.","number":5,"state":"covered"},{"explanation":"The owner’s outcomes distinguish failed/uncertain retention from confirmed retention followed by unavailable views.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-057\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Prepare single-authority relationship changes\",\n  \"status\": \"draft\",\n  \"statement\": \"The Definition editing Module shall prepare explicit relationship changes against one selected model state, author each fact only in its profile-declared representation, and derive consistent endpoint views from the confirmed resulting state while preserving actual rejection and incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Relationship edits can duplicate authority, accept invalid facts or produce inconsistent endpoint observations.\",\n      \"desired_outcome\": \"Prepare single-authority relationship changes.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-008 requires one authoritative relationship and state-consistent forward and inverse views.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering model authors and readers\",\n        \"Maintainers of MOD-002\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A relationship is created, replaced or removed in a selected model state.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-002 within MOD-016 using IF-001 and IF-002.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit candidate and base identities, profile-governed representation, complete scoped checks and truthful outcome reporting.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The MOD-002 contribution to SR-008; other owners retain their own obligations.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For create, replace and remove requests, identify the original fact where applicable, intended typed endpoints, governing profile and expected base; prepare exactly one authoritative representation without an authored inverse.\",\n    \"For requirement parent edits, use the declared containment representation and preserve entity identity; treat semantic reparenting as an explicit relationship change requiring applicable authority, never as a same-entity rename.\",\n    \"Submit the complete affected candidate and checking scope to IF-002 and IF-001; report invalid, unsupported, changed-state or incomplete outcomes without claiming acceptance.\",\n    \"After confirmed retention, derive both endpoint views from the same resulting state; replacement and removal cannot leave the prior inverse in that current view.\",\n    \"Bind each derived view to its state and profile; invalidate derived caches by state and preserve historical observations without mixing states.\",\n    \"If retention or subsequent view acquisition is incomplete, expose known effects and affected scope separately; do not turn uncertain retention into a completed accepted change or a missing view into a rolled-back write.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Design allocation only; no implementation or verification claim.\"\n  ],\n  \"allocated_to\": \"MOD-002\",\n  \"constrains\": [\n    \"FUNC-008\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-RELATIONSHIP-AUTHORING-DESIGN\",\n      \"locator\": \"SR-008; FUNC-008\",\n      \"basis\": \"Derive single-fact relationship editing, candidate admission and retention boundaries from SR-008. Proposed Design only; no runtime implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Custody must enforce exclusion/snapshot and durable recovery or refuse coherence; advisory locks/unfenced rescans cannot control arbitrary writers.","Participant logical admission only; callable adapters and any MOD-010 external boundary require separate review."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-057","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-057 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4468263bc7759fe571752a4ec75f0b067f113a2163481df40c7c469e51777b1d","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/sr.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:d4a820120577846f12878a269f912732b9e017ebfd09df84b9465410d38789b3","path":"design/system/functions/FUNC-008-author-typed-engineering-relationships.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:8660c0b4e3d969b44be6dd640f3a2d9ff4ad81c2d0202ea4ba6c33900ed0dd00","path":"design/system/functions/FUNC-005-revise-engineering-entity-while-preserving-identity.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:1b06bdee00ba1323e3ef88fcd3bd580f61d1df954e9393fae91f9101677f0861","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-001-retain-accepted-definitions-beyond-the-authoring-session.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"},{"identity":"sha256:47efc8fa6fe91e2947a1ac3fdd1a5dbb4a8328e4e89ec5dd16589def6703e104","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-003-check-candidate-identities-over-an-explicit-model-scope.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"},{"identity":"sha256:0b6d193cf874537ad68e03df84b6796763572c2a541210f1b75cba2f0631e941","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/AR-005-preserve-identity-when-applying-supported-definition-revisions.json"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"IF-002 check_candidate_relationships checks operation and relationship closed names first. Unsupported/unknown meaning is explicit and cannot fall through into a substituted profile/type or consistency success.","number":1,"state":"covered"},{"explanation":"The checker uses candidate-state identity findings and governing endpoint-kind definitions, retaining missing/ambiguous/incompatible cases as invalid or incomplete.","number":2,"state":"covered"},{"explanation":"The supplied resulting candidate includes unchanged entities and incoming facts required for each relationship cardinality.","number":3,"state":"covered"},{"explanation":"Profile-authoritative containment, exactly one permitted requirement parent and acyclicity are explicit checks.","number":4,"state":"covered"},{"explanation":"Findings carry checked base, candidate content/membership/profile and inspected scope. Missing required interpretation or incomplete relationship/identity scope yields incomplete or unsupported results, never a complete valid judgment over an unknown remainder.","number":5,"state":"covered"},{"explanation":"MOD-003 returns scoped structural findings only and performs no write. IF-001 retains final acceptance authority; participant authority and engineering approval/satisfaction remain separate. Whole-model conformance and migration are separately owned beyond this scoped relationship operation.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-058\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Check relationship candidates in their declared scope\",\n  \"status\": \"draft\",\n  \"statement\": \"The Interpretation and validation Module shall check proposed relationship changes against the declared profile over a complete candidate scope, rejecting unknown types, unresolved endpoints, conflicting authority, invalid containment and forbidden cardinality before the proposal can be accepted.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Relationship edits can duplicate authority, accept invalid facts or produce inconsistent endpoint observations.\",\n      \"desired_outcome\": \"Check relationship candidates in their declared scope.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-008 requires one authoritative relationship and state-consistent forward and inverse views.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering model authors and readers\",\n        \"Maintainers of MOD-003\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A relationship is created, replaced or removed in a selected model state.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-003 within MOD-016 using IF-001 and IF-002.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit candidate and base identities, profile-governed representation, complete scoped checks and truthful outcome reporting.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The MOD-003 contribution to SR-008; other owners retain their own obligations.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Reject unknown relationship or operation kinds before endpoint and consistency checks; do not substitute a known type or profile.\",\n    \"Identify missing or ambiguous endpoints and incompatible endpoint kinds using candidate-state identity findings.\",\n    \"Check the complete profile-required cardinality scope, including incoming facts and unchanged entities, against the resulting candidate after removals and replacements.\",\n    \"For parentage, check exactly one permitted parent and acyclic containment with one authoritative representation; an extra inverse or competing parent representation is invalid.\",\n    \"Return findings, candidate/base/profile identities and inspected scope; incomplete or unavailable input cannot produce a complete valid conclusion.\",\n    \"Keep relationship admission separate from whole-model conformance, authority, engineering approval and satisfaction.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Design allocation only; no implementation or verification claim.\"\n  ],\n  \"allocated_to\": \"MOD-003\",\n  \"constrains\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-RELATIONSHIP-AUTHORING-DESIGN\",\n      \"locator\": \"SR-008; FUNC-008\",\n      \"basis\": \"Derive single-fact relationship editing, candidate admission and retention boundaries from SR-008. Proposed Design only; no runtime implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Custody must enforce exclusion/snapshot and durable recovery or refuse coherence; advisory locks/unfenced rescans cannot control arbitrary writers.","Participant logical admission only; callable adapters and any MOD-010 external boundary require separate review."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-058","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-058 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4468263bc7759fe571752a4ec75f0b067f113a2163481df40c7c469e51777b1d","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/sr.json"},{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:d4a820120577846f12878a269f912732b9e017ebfd09df84b9465410d38789b3","path":"design/system/functions/FUNC-008-author-typed-engineering-relationships.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:8660c0b4e3d969b44be6dd640f3a2d9ff4ad81c2d0202ea4ba6c33900ed0dd00","path":"design/system/functions/FUNC-005-revise-engineering-entity-while-preserving-identity.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:1b06bdee00ba1323e3ef88fcd3bd580f61d1df954e9393fae91f9101677f0861","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-001-retain-accepted-definitions-beyond-the-authoring-session.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"},{"identity":"sha256:47efc8fa6fe91e2947a1ac3fdd1a5dbb4a8328e4e89ec5dd16589def6703e104","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-003-check-candidate-identities-over-an-explicit-model-scope.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"},{"identity":"sha256:0b6d193cf874537ad68e03df84b6796763572c2a541210f1b75cba2f0631e941","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/AR-005-preserve-identity-when-applying-supported-definition-revisions.json"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"IF-001 retain_relationship_change binds base/profile, original fact, candidate identity, affected definitions and containment membership to an exact write set.","number":1,"state":"covered"},{"explanation":"The storage owner obtains final identity and relationship checks for the actual candidate under model write exclusion across base comparison/checking/publication.","number":2,"state":"covered"},{"explanation":"Changed base/candidate/profile or inapplicable authority produces stale/rejected scope requiring reconciliation.","number":3,"state":"covered"},{"explanation":"Acceptance requires establishing all requested content and membership effects and naming the resulting state.","number":4,"state":"covered"},{"explanation":"The marker is persisted before authoritative mutation and survives restart; interrupted or unknown effects block coherent affected-model reads and further writes pending exact inspection.","number":5,"state":"covered"},{"explanation":"Confirmed state references bind bytes/membership/profile for later endpoint views. Earlier selected-state meaning remains historical; structural retention neither renews approval nor evidence applicability. A later view-read failure does not erase known retention or invent successful viewing.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-059\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Retain state-bound relationship changes\",\n  \"status\": \"draft\",\n  \"statement\": \"The Definition storage Module shall retain a relationship change only against its checked base and complete candidate, preserve one authoritative fact across the declared write scope, and report confirmed or incomplete effects without accepting stale or invalid relationship proposals.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Relationship edits can duplicate authority, accept invalid facts or produce inconsistent endpoint observations.\",\n      \"desired_outcome\": \"Retain state-bound relationship changes.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-008 requires one authoritative relationship and state-consistent forward and inverse views.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering model authors and readers\",\n        \"Maintainers of MOD-001\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A relationship is created, replaced or removed in a selected model state.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-001 within MOD-016 using IF-001 and IF-002.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit candidate and base identities, profile-governed representation, complete scoped checks and truthful outcome reporting.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The MOD-001 contribution to SR-008; other owners retain their own obligations.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Bind the exact affected definitions, containment changes, base state, profile and candidate content to one requested relationship change; do not retain an independently authored inverse.\",\n    \"Before acceptance, obtain complete applicable IF-002 identity and relationship findings for the actual resulting candidate and enforce the expected base at publication.\",\n    \"Reject or re-evaluate a changed base, candidate or profile without silently overwriting intervening work; report invalid or unsupported candidates without a successful save.\",\n    \"Confirm acceptance only when all requested effects are established and identify the resulting state; replacement/removal must no longer expose the old fact as current.\",\n    \"After interruption or uncertain partial effects, report known changed and unresolved scope without confirmed acceptance, automatic retry, assumed rollback or mixing states.\",\n    \"Preserve previous selected-state meaning and provide content-bound resulting-state read references for endpoint derivation; retention does not renew approval or evidence applicability.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Design allocation only; no implementation or verification claim.\"\n  ],\n  \"allocated_to\": \"MOD-001\",\n  \"constrains\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-RELATIONSHIP-AUTHORING-DESIGN\",\n      \"locator\": \"SR-008; FUNC-008\",\n      \"basis\": \"Derive single-fact relationship editing, candidate admission and retention boundaries from SR-008. Proposed Design only; no runtime implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Custody must enforce exclusion/snapshot and durable recovery or refuse coherence; advisory locks/unfenced rescans cannot control arbitrary writers.","Participant logical admission only; callable adapters and any MOD-010 external boundary require separate review."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-059","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-059 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4468263bc7759fe571752a4ec75f0b067f113a2163481df40c7c469e51777b1d","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/sr.json"},{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:d4a820120577846f12878a269f912732b9e017ebfd09df84b9465410d38789b3","path":"design/system/functions/FUNC-008-author-typed-engineering-relationships.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:8660c0b4e3d969b44be6dd640f3a2d9ff4ad81c2d0202ea4ba6c33900ed0dd00","path":"design/system/functions/FUNC-005-revise-engineering-entity-while-preserving-identity.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:1b06bdee00ba1323e3ef88fcd3bd580f61d1df954e9393fae91f9101677f0861","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-001-retain-accepted-definitions-beyond-the-authoring-session.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"},{"identity":"sha256:47efc8fa6fe91e2947a1ac3fdd1a5dbb4a8328e4e89ec5dd16589def6703e104","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-003-check-candidate-identities-over-an-explicit-model-scope.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"},{"identity":"sha256:0b6d193cf874537ad68e03df84b6796763572c2a541210f1b75cba2f0631e941","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/AR-005-preserve-identity-when-applying-supported-definition-revisions.json"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-004 logical admission identifies the selected applicable subjects, authoritative lifecycle/ownership rules, permitted deferral conditions and exact state.","number":1,"state":"covered"},{"explanation":"The MOD-004 result keeps both AR allocation and constrained-Function allocation paths with authored provenance and unresolved steps.","number":2,"state":"covered"},{"explanation":"Decidable equality/ancestry rules and complete relevant facts alone authorize a mechanical violation.","number":3,"state":"covered"},{"explanation":"The owner acquires the complete required inventory and diagnostic interpretation, reports unmodeled architecture, missing relevant constraints, ambiguity and interruptions, and retains attributable known adverse findings.","number":4,"state":"covered"},{"explanation":"The contract separates acquisition, evaluated scope and Consistent/Violated/Deferred/Review needed/Incomplete/Not applicable findings.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-060\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Assess declared allocation with explicit rule and scope\",\n  \"status\": \"draft\",\n  \"statement\": \"The Views and traceability Module shall assess applicable Allocated Requirement and Function responsibilities using exact selected-state facts and declared deciding rules, exposing missing or conflicting allocations, permitted deferrals and unresolved scope without converting mechanical consistency into engineering approval.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Derived responsibility or impact results can hide missing scope and be mistaken for stronger engineering conclusions.\",\n      \"desired_outcome\": \"Assess declared allocation with explicit rule and scope.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-010 requires an accountable result owner preserving its exact finding and completeness semantics.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering authors, architects and reviewers\",\n        \"Maintainers of MOD-004\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests the corresponding analysis in one selected model state.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-004 logical analysis boundary using IF-001/IF-002 and its internal traversal contribution.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Bind explicit request and source identities, derive attributable results, preserve unknown or limited scope, and leave stronger judgments with their owners.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The MOD-004 result obligation for all five SR-010 criteria; content custody, profile interpretation and general traversal retain existing owners and ARs.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For each selected applicable AR or Function, establish declared rule applicability and required ownership; identify missing responsibility and preserve only explicitly permitted deferrals with their source and conditions.\",\n    \"For every relevant AR-to-Function constraint, preserve both allocation paths, known or unresolved owner identities, authored provenance and the deciding rule basis.\",\n    \"Report a violation only where complete relevant facts and an applicable rule decide it; differing ownership without such a rule remains an engineering review question, including unsupported or conflicting rule meaning.\",\n    \"Inspect complete required membership, incoming constraints and architecture context; expose unmodeled, unavailable, ambiguous or interrupted scope and retain known findings without claiming complete consistency.\",\n    \"Keep acquisition/evaluation completeness, consistent facts, violations, deferrals and review questions distinguishable; no result invents allocation, creates an AR, approves architecture or establishes satisfaction.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed architecture only; no runtime availability, implementation or verification claim.\"\n  ],\n  \"allocated_to\": \"MOD-004\",\n  \"constrains\": [\n    \"FUNC-010\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-ALLOCATION-IMPACT-DESIGN\",\n      \"locator\": \"SR-010; SR-011; SCN-009; SCN-010\",\n      \"basis\": \"Derive rule-bound allocation assessment and scope-bound potential-impact result contracts with distinct MOD-004 obligations. Reuse content, interpretation and traversal ownership; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:c400ae83432acce60523b9624b79d1d6fc59f316c41c22e4cd815645b7640089","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/AR-060-assess-declared-allocation-with-explicit-rule-and-scope.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Logical analysis results only; callable protocols/adoption and runtime qualification remain separate. Repository views do not execute allocation/impact analysis."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-060","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 5 canonical AR-060 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:56978c46744fbe04bf2a3815ba42b6269d01f80c06202dfc9a1a0e65b96ead9a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/sr.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"},{"identity":"sha256:628f24b4ad9f21faa44d6bf3884f35b5a0be79430c8e39950cb648c570152350","path":"design/system/functions/FUNC-011-report-possible-change-impact.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:98c94da392584be5a65a45b09120621d96fa4d26e157ae0e7294414d3b64ddb3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-tree.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The impact component owns exact composition of each non-seed candidate and at least one finite typed witness from an identified seed, preserving state/profile, original/traversal orientations, intermediate nodes and authored provenance.","number":1,"state":"covered"},{"explanation":"One breadth-first eligible-edge graph applies the normalized nonempty type/orientation set at every hop.","number":2,"state":"covered"},{"explanation":"Seeds are distinct from candidates and count toward entity bounds. Only Complete exploration can state no additional relationship-based potential impact, explicitly limited to the selected influence scope; it never means no real-world effects. Empty bounded/incomplete selections keep their limitation.","number":3,"state":"covered"},{"explanation":"All requested/effective bounds and frontier omissions, partial acquisition/interpretation/traversal/witness failures, cancellation and resource exhaustion remain in the result.","number":4,"state":"covered"},{"explanation":"Potential impact remains a review aid. Evidence/Implementation reachability neither establishes actual change nor alters validity, support, permissions or satisfaction. Pure derived analysis has no authoritative model/status/record write and preserves MOD-007/domain judgment authority.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-061\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Compose witnessed potential impact with traversal limits\",\n  \"status\": \"draft\",\n  \"statement\": \"The Views and traceability Module shall compose relationship-based potential impact from an exact changed-subject and influence selection, retaining a supporting typed witness for every candidate and preserving traversal limitations without asserting actual consequences.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Derived responsibility or impact results can hide missing scope and be mistaken for stronger engineering conclusions.\",\n      \"desired_outcome\": \"Compose witnessed potential impact with traversal limits.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-011 requires an accountable result owner preserving its exact finding and completeness semantics.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering authors, architects and reviewers\",\n        \"Maintainers of MOD-004\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests the corresponding analysis in one selected model state.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-004 logical analysis boundary using IF-001/IF-002 and its internal traversal contribution.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Bind explicit request and source identities, derive attributable results, preserve unknown or limited scope, and leave stronger judgments with their owners.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The MOD-004 result obligation for all five SR-011 criteria; content custody, profile interpretation and general traversal retain existing owners and ARs.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For every reported non-seed candidate, retain an identified changed subject and at least one finite typed path with original and traversal orientation, intermediate identities, provenance and exact selected-state basis.\",\n    \"Apply the selected relationship-type and orientation pairs at every step of one combined influence graph; reject supplied traversal support with mismatched state, profile, inventory, changed subjects, influence or limits rather than broaden or reinterpret it.\",\n    \"Keep changed subjects separate from impact candidates and report no additional relationship-based impact only after complete exploration, explicitly limited to the selected influence scope without denying unrecorded or real-world effects.\",\n    \"Carry explicit depth/count bounds and omitted frontier, incomplete acquisition/interpretation/traversal or witness composition, interruption and resource exhaustion into the result; missing/ambiguous starts and empty partial results cannot become complete no-impact.\",\n    \"Label every candidate as potential impact for engineering review; reached implementation or evidence does not by itself establish behavior change, invalidation, required action, permission or satisfaction.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed architecture only; no runtime availability, implementation or verification claim.\"\n  ],\n  \"allocated_to\": \"MOD-004\",\n  \"constrains\": [\n    \"FUNC-011\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-ALLOCATION-IMPACT-DESIGN\",\n      \"locator\": \"SR-010; SR-011; SCN-009; SCN-010\",\n      \"basis\": \"Derive rule-bound allocation assessment and scope-bound potential-impact result contracts with distinct MOD-004 obligations. Reuse content, interpretation and traversal ownership; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:49574e3fd17329f3aa794b8975763733d11bf912262da2158263b67ec88bfd4e","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-011-explain-possible-change-impact-through-engineering-paths/AR-061-compose-witnessed-potential-impact-with-traversal-limits.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Logical analysis results only; callable protocols/adoption and runtime qualification remain separate. Repository views do not execute allocation/impact analysis."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"AR-061","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 5 canonical AR-061 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:ebc04b8f7806761e8d29769aa5b6721813f2dfa801a4cda0dc8bda178f31a7f9","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-011-explain-possible-change-impact-through-engineering-paths/sr.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"},{"identity":"sha256:628f24b4ad9f21faa44d6bf3884f35b5a0be79430c8e39950cb648c570152350","path":"design/system/functions/FUNC-011-report-possible-change-impact.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:98c94da392584be5a65a45b09120621d96fa4d26e157ae0e7294414d3b64ddb3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-tree.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Method preparation explicitly returns exact criteria, scope, subject/state, technique, conditions, expectations and author, including manual techniques; the common admission contract supplies content identity.","number":1,"state":"covered"},{"explanation":"Missing required components are named with affected scope; ambiguous identity rejects. Incomplete identifiable content cannot be labeled complete or performed.","number":2,"state":"covered"},{"explanation":"Changes create new method identities and retain the text/immutable basis necessary to interpret still-relied-on observations; mutable paths alone are rejected as adequate attribution.","number":3,"state":"covered"},{"explanation":"IF-014 preparation is followed by explicit actor-selected IF-004/003 retention/readback. The corrected method-only v4 carrier is inconclusive with exact supporting content and explicit absence of target execution; preparation and save do not satisfy criteria.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-062\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Prepare state-bound verification definitions\",\n  \"status\": \"draft\",\n  \"statement\": \"The Review and verification Module shall prepare identifiable method definitions bound to exact criterion and subject bases, preserving incomplete context and revised method meaning separately from actual observations.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Assurance preparation and retention can conflate planned methods, actual observations, semantic judgment and current reliance.\",\n      \"desired_outcome\": \"Prepare state-bound verification definitions.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-025 needs accountable assurance content and failure semantics in MOD-007.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Verification engineers and independent reviewers\",\n        \"Project decision owners\",\n        \"MOD-007 and MOD-012 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An assessor prepares or reassesses assurance content for a declared engineering claim.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-007 contribution to MOD-017 IF-014; guided recording through MOD-012 and existing IF-004/003.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply assurance-content.md to exact supplied bases, preserve gaps and actual actor decisions, then confirm selected retention separately.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-025 criteria within the declared finite claim; operational persistence and execution authority retain their existing owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Return each definition with criterion content/basis, intended scope, subject/state, technique, conditions, expected observations and accountable author, including manual techniques.\",\n    \"Identify missing or ambiguous required context and affected scope without presenting an incomplete definition as complete or performed.\",\n    \"Bind revisions to new content identities and preserve the method basis needed to interpret observations still relied upon; mutable paths alone cannot replace that basis.\",\n    \"Carry prepared method content through explicit retained support and actual recording outcomes; neither preparation, a retained method nor a successful save establishes observed criterion satisfaction.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Target Design; no implemented automation, executed verification or requirement satisfaction is asserted.\"\n  ],\n  \"allocated_to\": \"MOD-007\",\n  \"constrains\": [\n    \"FUNC-027\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-ASSURANCE-CONTENT-DESIGN\",\n      \"locator\": \"IR-004; SR-025–029; SCN-026–029\",\n      \"basis\": \"Derive assessor-assisted assurance preparation, explicit retention cooperation and scoped reliance through MOD-007 and IF-014. Preserve actual judgment, command and persistence ownership; target Design only.\"\n    }\n  ]\n}\n","identity":"sha256:3e0839c2e595f5c53faac3c12c0b04d67b00369df010e0b4876c280a7e2fee77","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-025-define-verification-against-identifiable-requirement-criteria/AR-062-prepare-state-bound-verification-definitions.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-062","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-062 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:a9ccdbfde2fe8a260c232bea8fb9cb8e575d4a7d723f5c69dc386b97891a3a19","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-025-define-verification-against-identifiable-requirement-criteria/sr.json"},{"identity":"sha256:3da76ed9a92f8ff53dc84cd3256a7926a595e356aef80be434f9faa1084d0e75","path":"design/system/functions/FUNC-027-retain-criterion-based-verification-definitions.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Occurrence preparation records exact method/criterion basis, state, conditions, source, occurrence identity and inspectable support, preserving expected-versus-actual meaning.","number":1,"state":"covered"},{"explanation":"Execution states and criterion outcomes are independent dimensions; interrupted results retain assessed/unassessed boundaries, while unable-to-assess is not a criterion failure or favorable observation.","number":2,"state":"covered"},{"explanation":"Missing exact state/provenance/conditions or unavailable support produces reliance gaps. Planned expectations and a filename cannot substitute for actual obtained observations or retained bytes.","number":3,"state":"covered"},{"explanation":"Comparable summary replacement must preserve relevant contrary meaning/provenance or its retained reference until accountable disposition.","number":4,"state":"covered"},{"explanation":"Actual selected artifact or command outcomes establish retention; conflicts require fresh context, lost responses require scoped readback, and unresolved effects remain unresolved without automatic replay or fallback store.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-063\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve actual observation meaning through recording\",\n  \"status\": \"draft\",\n  \"statement\": \"The Review and verification Module shall prepare attributable occurrence and observation content that preserves actual execution state, assessed scope and contrary evidence through explicit retention without inventing results.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Assurance preparation and retention can conflate planned methods, actual observations, semantic judgment and current reliance.\",\n      \"desired_outcome\": \"Preserve actual observation meaning through recording.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-026 needs accountable assurance content and failure semantics in MOD-007.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Verification engineers and independent reviewers\",\n        \"Project decision owners\",\n        \"MOD-007 and MOD-012 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An assessor prepares or reassesses assurance content for a declared engineering claim.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-007 contribution to MOD-017 IF-014; guided recording through MOD-012 and existing IF-004/003.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply assurance-content.md to exact supplied bases, preserve gaps and actual actor decisions, then confirm selected retention separately.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-026 criteria within the declared finite claim; operational persistence and execution authority retain their existing owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Identify the occurrence, method and criterion basis, exact observed subject/state, actual conditions, observing source and supporting evidence.\",\n    \"Distinguish unperformed, unable-to-assess, interrupted and completed activity from favorable, adverse or inconclusive criterion observations; preserve actual partial observations and the unassessed remainder.\",\n    \"Expose missing provenance, exact state or unavailable supporting bytes as limitations, and never substitute expected observations for actual results.\",\n    \"Preserve relevant conflicting/adverse observations and their original provenance when current summaries are replaced until an accountable disposition resolves their reliance; later favorable results cannot erase them.\",\n    \"Confirm retention through actual selected artifact or command outcomes, preserve unresolved effects after interruption, and never replay a stale prepared update automatically.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Target Design; no implemented automation, executed verification or requirement satisfaction is asserted.\"\n  ],\n  \"allocated_to\": \"MOD-007\",\n  \"constrains\": [\n    \"FUNC-028\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-ASSURANCE-CONTENT-DESIGN\",\n      \"locator\": \"IR-004; SR-025–029; SCN-026–029\",\n      \"basis\": \"Derive assessor-assisted assurance preparation, explicit retention cooperation and scoped reliance through MOD-007 and IF-014. Preserve actual judgment, command and persistence ownership; target Design only.\"\n    }\n  ]\n}\n","identity":"sha256:8766875a4f5c42af78d715aeed0f1688e708c5672d65e02b4f48977d3888dbea","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-026-retain-actual-verification-observations-and-execution-state/AR-063-preserve-actual-observation-meaning-through-recording.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-063","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-063 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:e96a55c71ccf89fa5837e964dc4b0019b36742d6dfd781559a8ed66e740d4133","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-026-retain-actual-verification-observations-and-execution-state/sr.json"},{"identity":"sha256:0d4c34a662fae8b74f1c59da1062b9094d557cbfc2130c89975f5a1703af4cf6","path":"design/system/functions/FUNC-028-retain-actual-verification-observations-and-provenance.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The applicability contract compares all declared dimensions including governing freshness and availability; returned mismatches/unknown fields preserve their concrete reason and affected scope.","number":1,"state":"covered"},{"explanation":"Actual assessor reasoning, inspected scope and source are required; an ID, method file, pass label or mechanical content equality alone cannot establish semantic applicability.","number":2,"state":"covered"},{"explanation":"Gate purpose is retained across requirement, Design, advisory, whole-change and Verify use; a clean narrow review cannot substitute for broader approval.","number":3,"state":"covered"},{"explanation":"Actor-reported unchanged content and scoped mechanical comparison remain distinct evidence. Record revision and external subject observations are separate; timestamps/saved labels are insufficient.","number":4,"state":"covered"},{"explanation":"Selected evidence population and acquisition limits remain explicit; incomplete dependencies and omissions restrict conclusions.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-064\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Expose scoped evidence applicability with attributable comparisons\",\n  \"status\": \"draft\",\n  \"statement\": \"The Review and verification Module shall compare offered evidence with the exact claim basis and expose applicability mismatches, unknowns and accountable rationale without converting mechanical identity into semantic adequacy.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Assurance preparation and retention can conflate planned methods, actual observations, semantic judgment and current reliance.\",\n      \"desired_outcome\": \"Expose scoped evidence applicability with attributable comparisons.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-027 needs accountable assurance content and failure semantics in MOD-007.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Verification engineers and independent reviewers\",\n        \"Project decision owners\",\n        \"MOD-007 and MOD-012 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An assessor prepares or reassesses assurance content for a declared engineering claim.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-007 contribution to MOD-017 IF-014; guided recording through MOD-012 and existing IF-004/003.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply assurance-content.md to exact supplied bases, preserve gaps and actual actor decisions, then confirm selected retention separately.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-027 criteria within the declared finite claim; operational persistence and execution authority retain their existing owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Assess subject/state, criterion content, scope, conditions, provenance, evidence availability and governing freshness; retain concrete mismatches and unknown fields.\",\n    \"Require an attributable applicability rationale and inspected scope; a stable entity identity, method file or pass label alone cannot establish current applicability.\",\n    \"Keep requirement, Design, advisory, whole-change and Verify scope distinct; narrower advice cannot support broader approval merely through common files.\",\n    \"Distinguish an actor-reported no-change assertion from a defined mechanical comparison and preserve both scopes; neither timestamp nor saved status establishes unchanged content.\",\n    \"Expose incomplete evidence populations and uncertain dependencies, without assuming all contrary observations were discovered or all unchanged hashes imply adequate support.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Target Design; no implemented automation, executed verification or requirement satisfaction is asserted.\"\n  ],\n  \"allocated_to\": \"MOD-007\",\n  \"constrains\": [\n    \"FUNC-029\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-ASSURANCE-CONTENT-DESIGN\",\n      \"locator\": \"IR-004; SR-025–029; SCN-026–029\",\n      \"basis\": \"Derive assessor-assisted assurance preparation, explicit retention cooperation and scoped reliance through MOD-007 and IF-014. Preserve actual judgment, command and persistence ownership; target Design only.\"\n    }\n  ]\n}\n","identity":"sha256:7a0893bf829f001663df33e9f27723998adf501899f3d8394af833f65f8d2568","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-027-assess-evidence-applicability-to-the-claimed-engineering-state/AR-064-expose-scoped-evidence-applicability-with-attributable-comparisons.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-064","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-064 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:ffc96ad018255d8dac9f312f828f22e72ccf2c03c5f12ec15266c036dd8c5bfe","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-027-assess-evidence-applicability-to-the-claimed-engineering-state/sr.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Coverage enumerates each included criterion with applicable/contrary support, unknowns, gaps and semantic explanation, bound to exact subject/criterion content and the accountable assessor.","number":1,"state":"covered"},{"explanation":"Known support gaps and material contradictions withhold justified favorable reliance. Narrowing is explicit assessor input; revised resolution/content/basis re-enters preparation before recording.","number":2,"state":"covered"},{"explanation":"Mechanical reference completeness, pass labels and permitted tradeoffs do not become observed satisfaction or action authority; Governance authority remains a separate contract.","number":3,"state":"covered"},{"explanation":"The contract identifies purpose, actual contributors and assessor independence, and preserves requirement acceptance before Architecture completeness as separate valid gates.","number":4,"state":"covered"},{"explanation":"Prepared and recorded judgments preserve actual reviewer meaning, current support and open obligations.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-065\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Prepare accountable judgments from explicit criterion coverage\",\n  \"status\": \"draft\",\n  \"statement\": \"The Review and verification Module shall compose per-criterion support and contradictions with an assessor-supplied scoped judgment, withholding unsupported favorable reliance while preserving accountable meaning through recording.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Assurance preparation and retention can conflate planned methods, actual observations, semantic judgment and current reliance.\",\n      \"desired_outcome\": \"Prepare accountable judgments from explicit criterion coverage.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-028 needs accountable assurance content and failure semantics in MOD-007.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Verification engineers and independent reviewers\",\n        \"Project decision owners\",\n        \"MOD-007 and MOD-012 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An assessor prepares or reassesses assurance content for a declared engineering claim.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-007 contribution to MOD-017 IF-014; guided recording through MOD-012 and existing IF-004/003.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply assurance-content.md to exact supplied bases, preserve gaps and actual actor decisions, then confirm selected retention separately.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-028 criteria within the declared finite claim; operational persistence and execution authority retain their existing owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Account for every included criterion with applicable observations, contrary support, unresolved gaps and the assessor's semantic reasoning against an exact subject and criterion basis.\",\n    \"Leave claims with missing required support or unresolved material contradiction unestablished; a narrower conclusion requires explicit assessor-selected included and excluded scope.\",\n    \"Do not turn mechanically complete references, accepted exceptions or tradeoffs into observed satisfaction or action authority.\",\n    \"Identify gate purpose, actual contributors, assessor and required independence basis; requirement reuse can be accepted before architecture completion and Design review assesses the later completeness.\",\n    \"Preserve actual reviewer attribution, relied-on support and unresolved obligations through preparation and retention; work updates and successful storage never author or renew approval.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Target Design; no implemented automation, executed verification or requirement satisfaction is asserted.\"\n  ],\n  \"allocated_to\": \"MOD-007\",\n  \"constrains\": [\n    \"FUNC-030\",\n    \"FUNC-031\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-ASSURANCE-CONTENT-DESIGN\",\n      \"locator\": \"IR-004; SR-025–029; SCN-026–029\",\n      \"basis\": \"Derive assessor-assisted assurance preparation, explicit retention cooperation and scoped reliance through MOD-007 and IF-014. Preserve actual judgment, command and persistence ownership; target Design only.\"\n    }\n  ]\n}\n","identity":"sha256:0027c0caec17687fe548b67ec08c12586e7bb87fa6c0394066d6931aed84bcde","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-028-record-scoped-engineering-judgments-from-criterion-coverage/AR-065-prepare-accountable-judgments-from-explicit-criterion-coverage.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-065","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-065 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:e2378e5f388d6d54c50f8427ca9b9a0fbaf3cb9553dc5d6ac912f13b19d7cd50","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-028-record-scoped-engineering-judgments-from-criterion-coverage/sr.json"},{"identity":"sha256:85db55d933a26a2b6840d630caab1172dc9c820486bfca845444ab3fdf81fc59","path":"design/system/functions/FUNC-030-expose-claim-criterion-coverage-and-contradictory-evidence.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Current-reliance comparison names changed subjects, criteria, conditions, evidence and dependencies, affected repetition and unresolved impact, with exact recorded versus inspected bases.","number":1,"state":"covered"},{"explanation":"Unaffected support requires explicit reuse rationale; material effects require reassessment. Demonstrated immaterial changes/equivalent retries may use scoped attributable dispositions rather than automatic new reviews.","number":2,"state":"covered"},{"explanation":"Repeated plans remain unperformed; affected current claims stay unestablished until observations and an accountable conclusion support them.","number":3,"state":"covered"},{"explanation":"Replacements identify new basis, assessor, reasoning and limits while preserving unresolved obligations and still-used conclusions before compacting superseded content.","number":4,"state":"covered"},{"explanation":"Historical completion is preserved; regressions become linked new work and mistakes receive explicit annotations, never silent rewriting of the accepted historical account.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-066\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Reassess current reliance without rewriting historical meaning\",\n  \"status\": \"draft\",\n  \"statement\": \"The Review and verification Module shall identify affected, reusable and uncertain support after changes to a current claim, obtain proportionate accountable reassessment, and preserve unresolved and historical meaning during selective retention.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Assurance preparation and retention can conflate planned methods, actual observations, semantic judgment and current reliance.\",\n      \"desired_outcome\": \"Reassess current reliance without rewriting historical meaning.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-029 needs accountable assurance content and failure semantics in MOD-007.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Verification engineers and independent reviewers\",\n        \"Project decision owners\",\n        \"MOD-007 and MOD-012 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"An assessor prepares or reassesses assurance content for a declared engineering claim.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-007 contribution to MOD-017 IF-014; guided recording through MOD-012 and existing IF-004/003.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply assurance-content.md to exact supplied bases, preserve gaps and actual actor decisions, then confirm selected retention separately.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-029 criteria within the declared finite claim; operational persistence and execution authority retain their existing owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Compare changed subjects, criteria, conditions, evidence and dependencies with the recorded basis; identify affected verification requiring repetition and expose unknown impact.\",\n    \"Retain only explicitly justified unaffected support; material effects require reassessment, while demonstrated immaterial edits or equivalent evidence retries may use an attributable scoped applicability disposition.\",\n    \"Keep repeated checks that are merely planned distinct from applicable new observations; retain affected claims as unestablished until evidence and an accountable conclusion justify them.\",\n    \"Bind replacement judgments to their new assessed basis, assessor, reasoning and limits; preserve unresolved obligations and prior conclusions still relied upon before compacting superseded detail.\",\n    \"Keep completed Change accounts historical; record later regressions as linked work and original-account mistakes as explicit annotations without silently rewriting completion.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Target Design; no implemented automation, executed verification or requirement satisfaction is asserted.\"\n  ],\n  \"allocated_to\": \"MOD-007\",\n  \"constrains\": [\n    \"FUNC-029\",\n    \"FUNC-030\",\n    \"FUNC-031\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-ASSURANCE-CONTENT-DESIGN\",\n      \"locator\": \"IR-004; SR-025–029; SCN-026–029\",\n      \"basis\": \"Derive assessor-assisted assurance preparation, explicit retention cooperation and scoped reliance through MOD-007 and IF-014. Preserve actual judgment, command and persistence ownership; target Design only.\"\n    }\n  ]\n}\n","identity":"sha256:3425c4ac2c6872d28034c0068b02470bb3cf036d18f484238890894632c6e171","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-029-reassess-claim-support-after-engineering-changes/AR-066-reassess-current-reliance-without-rewriting-historical-meaning.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-066","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-066 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:ee2d4a2a69ce348cef2cfbcc49b09a3127d164bbcd40ebfaddbb592cdc8f9eba","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-029-reassess-claim-support-after-engineering-changes/sr.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"},{"identity":"sha256:85db55d933a26a2b6840d630caab1172dc9c820486bfca845444ab3fdf81fc59","path":"design/system/functions/FUNC-030-expose-claim-criterion-coverage-and-contradictory-evidence.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Decode/shape/property/required-field/closed-value checks precede dependent consistency. Raw capture admits malformed bytes; diagnostics bind exact member location/content even if no entity ID can be recovered.","number":1,"state":"covered"},{"explanation":"Complete relevant inventory and incoming facts support identity, naming, typed endpoints, requirement parents and cycle detection.","number":2,"state":"covered"},{"explanation":"Declared cardinalities are evaluated from authoritative facts, including one Scenario-owning IR, independently of labels or storage-name resemblance.","number":3,"state":"covered"},{"explanation":"Exact matching prior/proposed state and required decision provenance are necessary for transitions.","number":4,"state":"covered"},{"explanation":"Results identify exact basis, rules, evaluated families, known violations and every skipped dependency.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-067\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Diagnose model rules over explicit complete scope\",\n  \"status\": \"draft\",\n  \"statement\": \"The Interpretation and validation Module shall diagnose the selected model against its declared mechanically decidable rules with actionable subject and rule attribution, preserving invalid values, incomplete acquisition and unassessed transitions without an unsupported conformance claim.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Whole-model checks and migration preparation can hide incomplete rules or alter meaning while appearing valid.\",\n      \"desired_outcome\": \"Diagnose model rules over explicit complete scope.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-013 requires accountable diagnostics and candidate outcomes within MOD-003.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Model authors and maintainers\",\n        \"Engineering reviewers\",\n        \"MOD-003 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests selected-state conformance or an explicit model migration candidate.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-003 logical request boundary and pure IF-002 operations over IF-001 captured input.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Bind explicit source/profile/mapping scope, preserve all relevant findings and missingness, and return separate attributable mechanical, semantic and adoption limits.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-013 criteria for the selected finite model; capture custody, existing interpretation and later adoption retain their separate owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Check record shape, required values, property names and closed vocabularies before dependent consistency, identifying malformed members even when their entity identity is unreadable.\",\n    \"Assess complete relevant identity, naming, requirement-parent, cycle and typed-reference scope; preserve incoming dependencies and diagnose duplicate or ambiguous endpoints without selecting one arbitrarily.\",\n    \"Apply declared cardinalities from authoritative facts, including exactly one owning IR per Scenario, independently of display names and filename similarity.\",\n    \"Evaluate transition rules only with matching prior/proposed states and required decision input; retain unassessed/unsupported transition scope separately from valid state-only findings.\",\n    \"Return exact state/profile, governing rules, checked families, attributable findings and unassessed scope. Known violations survive interruption; narrowed or incomplete checks cannot claim whole-model conformance.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design only; no product runtime, current migration support, implementation or verification is claimed.\"\n  ],\n  \"allocated_to\": \"MOD-003\",\n  \"constrains\": [\n    \"FUNC-002\",\n    \"FUNC-013\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CONFORMANCE-MIGRATION-DESIGN\",\n      \"locator\": \"IR-005; SR-012–015; SCN-011–014\",\n      \"basis\": \"Derive whole-model diagnostics, separate mechanical/review presentation and source-preserving explicit migration candidates through MOD-003. Reuse capture, interpretation and scoped-check ownership; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:91db4b6dead35ecf421671f0c5f7af85b8b85882bf4748581e08d41b83b201cc","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-013-diagnose-violations-of-declared-model-rules/AR-067-diagnose-model-rules-over-explicit-complete-scope.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw-capture/pure-check/candidate design needs adapter, mapping, capacity and platform qualification; adoption/persistence writers remain separate.","Semantic equivalence, mapping adequacy and consumer judgments require attributable assessment, not hashes/counts. No operational migration, workflow/profile adoption or transition authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-067","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-067 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:ba9b9c6484825cad6d913f09ee95bbc00d29eab5a2b8db8f574ad34b6d98676c","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-013-diagnose-violations-of-declared-model-rules/sr.json"},{"identity":"sha256:e3fa23aeb0b639459320519bf9a382f1ee11c7696fce1f76c2b420c8cf061d1c","path":"design/system/functions/FUNC-002-check-entity-identity-presence-and-uniqueness.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Mechanical conclusions are expressly bounded to named state, profile, rule families and inspected scope and cannot establish approval, implementation or satisfaction.","number":1,"state":"covered"},{"explanation":"Clarity, unsupported rationale, derivation and evidence sufficiency remain accountable review questions regardless of shape validity; no semantic assessor is synthesized by the checker.","number":2,"state":"covered"},{"explanation":"Supplied judgments remain separately attributed with exact purpose/assessor/basis/conclusion/limits.","number":3,"state":"covered"},{"explanation":"Allocation questions retain MOD-004 AR-060 deciding-rule and review-needed meaning. New presentation does not fabricate mechanical conflicts or adequate allocation from structural success.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-068\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Keep conformance observations distinct from supplied judgments\",\n  \"status\": \"draft\",\n  \"statement\": \"The Interpretation and validation Module shall present mechanical conformance findings and supplied engineering judgments as separate attributable accounts, preserving their exact bases and limitations without inferring approval or semantic adequacy.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Whole-model checks and migration preparation can hide incomplete rules or alter meaning while appearing valid.\",\n      \"desired_outcome\": \"Keep conformance observations distinct from supplied judgments.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-014 requires accountable diagnostics and candidate outcomes within MOD-003.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Model authors and maintainers\",\n        \"Engineering reviewers\",\n        \"MOD-003 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests selected-state conformance or an explicit model migration candidate.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-003 logical request boundary and pure IF-002 operations over IF-001 captured input.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Bind explicit source/profile/mapping scope, preserve all relevant findings and missingness, and return separate attributable mechanical, semantic and adoption limits.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-014 criteria for the selected finite model; capture custody, existing interpretation and later adoption retain their separate owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Limit a mechanical conclusion to the named state, profile, rules and inspected scope; it cannot establish requirement approval, implementation or satisfaction.\",\n    \"Leave clarity, rationale, derivation and evidence adequacy to accountable engineering review even when the model is structurally valid.\",\n    \"Preserve each supplied judgment's subject, basis, assessor, purpose, conclusion and limitations; expose mismatch or unknown applicability rather than refreshing, merging or inventing approval.\",\n    \"Keep allocation questions without a deciding mechanical rule as review needs under MOD-004's existing contract, without fabricating a conflict or adequate design.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design only; no product runtime, current migration support, implementation or verification is claimed.\"\n  ],\n  \"allocated_to\": \"MOD-003\",\n  \"constrains\": [\n    \"FUNC-013\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CONFORMANCE-MIGRATION-DESIGN\",\n      \"locator\": \"IR-005; SR-012–015; SCN-011–014\",\n      \"basis\": \"Derive whole-model diagnostics, separate mechanical/review presentation and source-preserving explicit migration candidates through MOD-003. Reuse capture, interpretation and scoped-check ownership; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:bbd6122b7db81a96e903822946d66cef75296ea29cc782bff310ffce39dfdcb3","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-014-separate-model-conformance-results-from-engineering-judgments/AR-068-keep-conformance-observations-distinct-from-supplied-judgments.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw-capture/pure-check/candidate design needs adapter, mapping, capacity and platform qualification; adoption/persistence writers remain separate.","Semantic equivalence, mapping adequacy and consumer judgments require attributable assessment, not hashes/counts. No operational migration, workflow/profile adoption or transition authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-068","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-068 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:f604dc48c793d58415de03fe757ec249e4ac699a87772a92b179a96c31bbffdc","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-014-separate-model-conformance-results-from-engineering-judgments/sr.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:c400ae83432acce60523b9624b79d1d6fc59f316c41c22e4cd815645b7640089","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/AR-060-assess-declared-allocation-with-explicit-rule-and-scope.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Transformation report binds immutable source/state, exact profiles and mapping with the target membership/content manifest; target output is returned as bytes or immutable references, not merely a hopeful path.","number":1,"state":"covered"},{"explanation":"Representation changes preserve stable IDs and equivalent normalized authoritative facts. Explicit additions/removals/defaults/identity or relation changes carry supplied intentional semantic-change basis and never hide as rename.","number":2,"state":"covered"},{"explanation":"Complete source accounting and bounded declarative transforms expose unmapped/unknown content, ambiguity, unsupported operations, target collisions and failed/partial construction.","number":3,"state":"covered"},{"explanation":"Target conformance and declared consumer support are bound to the unchanged candidate and criteria.","number":4,"state":"covered"},{"explanation":"Transformation completion, semantic preservation review, target validity, consumer compatibility and adoption authority remain separate.","number":5,"state":"covered"},{"explanation":"Private target buffers cannot alias/write source. Failure/cancellation/abandonment preserve source/profile/history; uncertain response reports uncertain availability, with safe pure re-preparation distinct from persistence or adoption.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-069\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Prepare attributable migrations without source mutation\",\n  \"status\": \"draft\",\n  \"statement\": \"The Interpretation and validation Module shall produce isolated model migration candidates from explicit source-to-target mappings, account for preserved and intentionally changed meaning, and expose target and consumer assessment limits before controlled adoption.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Whole-model checks and migration preparation can hide incomplete rules or alter meaning while appearing valid.\",\n      \"desired_outcome\": \"Prepare attributable migrations without source mutation.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-015 requires accountable diagnostics and candidate outcomes within MOD-003.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Model authors and maintainers\",\n        \"Engineering reviewers\",\n        \"MOD-003 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests selected-state conformance or an explicit model migration candidate.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-003 logical request boundary and pure IF-002 operations over IF-001 captured input.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Bind explicit source/profile/mapping scope, preserve all relevant findings and missingness, and return separate attributable mechanical, semantic and adoption limits.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All parent SR-015 criteria for the selected finite model; capture custody, existing interpretation and later adoption retain their separate owners.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Bind source state, both profiles, explicit mapping and target candidate membership/content in an inspectable transformation report.\",\n    \"Preserve stable identities and equivalent authoritative relationship meaning for representation changes; attribute every intentional addition, removal, identity or semantic change to its supplied basis.\",\n    \"Account for all included source content and report unmapped or unknown facts, unsupported transforms, ambiguous rule overlaps, target conflicts and failed or partial transformation without silent loss or repair.\",\n    \"Assess whole-model target conformance and each declared consumer against the exact candidate, retaining provenance, mismatches, unassessed checks and inventory completeness; required gaps withhold readiness.\",\n    \"Keep semantic preservation review, mechanical validity, consumer compatibility and controlled-adoption authority distinct; a complete candidate does not adopt the target profile.\",\n    \"Prepare only in isolated target buffers and preserve source content, historical profile meaning and current selection after failure, cancellation or abandonment; uncertain response cannot establish a completed available candidate.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design only; no product runtime, current migration support, implementation or verification is claimed.\"\n  ],\n  \"allocated_to\": \"MOD-003\",\n  \"constrains\": [\n    \"FUNC-014\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CONFORMANCE-MIGRATION-DESIGN\",\n      \"locator\": \"IR-005; SR-012–015; SCN-011–014\",\n      \"basis\": \"Derive whole-model diagnostics, separate mechanical/review presentation and source-preserving explicit migration candidates through MOD-003. Reuse capture, interpretation and scoped-check ownership; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:498980aa84b8f81dbed673d802a7357f8adc63d69636c842316e9ab01acc09c4","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-015-prepare-explicit-model-migrations-without-rewriting-history/AR-069-prepare-attributable-migrations-without-source-mutation.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw-capture/pure-check/candidate design needs adapter, mapping, capacity and platform qualification; adoption/persistence writers remain separate.","Semantic equivalence, mapping adequacy and consumer judgments require attributable assessment, not hashes/counts. No operational migration, workflow/profile adoption or transition authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-069","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-069 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:2492fd1f6ec886ec844338117be9a3ca27efb8575df1c3c5c7e9b9e36fb84cdd","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-015-prepare-explicit-model-migrations-without-rewriting-history/sr.json"},{"identity":"sha256:0d2329f7158503cbd7b1cb43508d0707c45aa284c7efb8b97bad0cc4540da704","path":"design/system/functions/FUNC-014-prepare-a-model-migration-candidate.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-005 assigns unique project baseline identity and descriptor containing exact membership, rules, relationships, provenance, included material and external-only exclusions; content identity remains separate.","number":1,"state":"covered"},{"explanation":"IF-007 acquisition/interpretation and IF-015 conformance support are coupled to the exact basis; participant coherence covers missing scope/context and cross-material questions beyond a structural pass.","number":2,"state":"covered"},{"explanation":"Confirmed durable bundle custody precedes guarded descriptor publication; both sealed bundle and catalog readback must agree before establishment.","number":3,"state":"covered"},{"explanation":"Append-only immutable bundles and conflicting same-ID descriptor checks preserve original content and rules after later current-model changes.","number":4,"state":"covered"},{"explanation":"Unconfirmed staging/catalog writes and lost responses retain sealed-but-unregistered versus established distinctions; exact request/bundle/catalog inspection precedes reconciliation.","number":5,"state":"covered"},{"explanation":"IF-016 supplies existing authority within its scope and conditions; no new approval gate or permission follows from inspection/coherence/retention.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-070\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Establish baselines from confirmed coherent retained scope\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-005 responsibility shall establish baselines from confirmed coherent retained scope within the exact selected scope, preserving original meaning and explicit incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Baseline orchestration and catalog establishment can otherwise conflate preparation with confirmed effects or hide unavailable content.\",\n      \"desired_outcome\": \"Establish baselines from confirmed coherent retained scope.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-020 requires this accountable architectural contribution; other contributions retain their own owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers\",\n        \"Reviewers and project decision owners\",\n        \"MOD-005 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests baseline orchestration and catalog establishment.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected local project state and declared retained/current material under state-control.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply state-control.md with exact identity/scope and original interpretation, explicit custody/authority boundaries and attributable incomplete or confirmed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Baseline orchestration and catalog establishment. No full IR003 assessment, runtime qualification, destructive adoption or operational maintenance execution is claimed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Bind a unique project baseline identity to exact membership, original definitions and relationships, metamodel/rules, provenance, included material and external-only exclusions.\",\n    \"Require complete required acquisition, original interpretation and accountable coherence support; mechanical validity alone does not establish adequate coherent scope.\",\n    \"Obtain exact content-custody confirmation before publishing the baseline descriptor; establish retention only after descriptor and sealed bundle readback agree.\",\n    \"Preserve earlier descriptor content and original interpretation when the current model changes; same identity with different retained content conflicts.\",\n    \"Report partial custody, sealed-but-unregistered content, missing rules and uncertain catalog effects without an established complete baseline; reconcile exact effects before retry.\",\n    \"Apply existing authority and retention policy to the exact request without turning inspection, coherence or retention into approval.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-005\",\n  \"constrains\": [\n    \"FUNC-020\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-BASELINE-STATE-DESIGN\",\n      \"locator\": \"SR-020–024; SCN-019–022/025\",\n      \"basis\": \"Define immutable baseline custody, original-meaning comparison/recovery, attributable transition preparation and dependency-safe retirement. Preserve selective retention and separate action authority, operational maintenance and actual execution; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:f1e92fd3eb2e227c9a5e2b2fd2fdf75717bba8ffd77ca60fc3821c55ca1a5a16","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/AR-070-establish-baselines-from-confirmed-coherent-retained-scope.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-070","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-070 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:e17161533905669c22742041d92755248e13b1ca007a9a4ed0091eaaf635c46c","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/sr.json"},{"identity":"sha256:ba41087b0df1d5c12ae152e35397deb80e06e0a31302e87be22f54da8e44fb02","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/AR-071-preserve-immutable-baseline-content-with-attributable-custody.json"},{"identity":"sha256:2fb519f924328c02ff8c7d8c3657576c556804cd831d07150f6cac1412e4e3d6","path":"design/system/functions/FUNC-020-establish-and-inspect-retained-engineering-baselines.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Private sealed bundles retain exact manifest/member bytes, original profile content, provenance and included material independently of mutable current definitions; mutable hardlinks/symlinks cannot stand in for retained content.","number":1,"state":"covered"},{"explanation":"Member-kind, containment, length/attributes and integrity checks reject unsafe/unsupported members; external references and missing required material cannot count toward complete preservation.","number":2,"state":"covered"},{"explanation":"Owned staging, complete verification, durable flush, no-replace publication/directory durability and custody exclusion precede receipts.","number":3,"state":"covered"},{"explanation":"Bundle/catalog publication is deliberately not a cross-owner transaction. Sealed content survives catalog failure; exact request-bound readback reconciles interruption without deleting sole confirmed content or inferring rollback.","number":4,"state":"covered"},{"explanation":"Exact sealed reads preserve original bytes/rules and expose missing/corrupt/unsupported/inaccessible scope.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-071\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve immutable baseline content with attributable custody\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-001 responsibility shall preserve immutable baseline content with attributable custody within the exact selected scope, preserving original meaning and explicit incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Exact immutable engineering content custody can otherwise conflate preparation with confirmed effects or hide unavailable content.\",\n      \"desired_outcome\": \"Preserve immutable baseline content with attributable custody.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-020 requires this accountable architectural contribution; other contributions retain their own owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers\",\n        \"Reviewers and project decision owners\",\n        \"MOD-001 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests exact immutable engineering content custody.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected local project state and declared retained/current material under state-control.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply state-control.md with exact identity/scope and original interpretation, explicit custody/authority boundaries and attributable incomplete or confirmed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Exact immutable engineering content custody. No full IR003 assessment, runtime qualification, destructive adoption or operational maintenance execution is claimed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Retain exact manifest membership, bytes, original profile/rules, provenance and included material independently of mutable current definitions; no alias to mutable source content.\",\n    \"Validate supported member kinds, containment and integrity; external-only references never count as preserved content and missing required members prevent full confirmation.\",\n    \"Stage and durably seal complete content before issuing a custody receipt; conflicting baseline bindings reject and unsupported platform durability cannot report complete preservation.\",\n    \"Preserve sealed bundles through catalog failure and uncertain receipts; reconcile exact stored effects after interruption without fabricated rollback or blind overwrite.\",\n    \"Return original selected content and precise missing, corrupt, unsupported or inaccessible scope without substitution of current bytes or rules.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-001\",\n  \"constrains\": [\n    \"FUNC-001\",\n    \"FUNC-004\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-BASELINE-STATE-DESIGN\",\n      \"locator\": \"SR-020–024; SCN-019–022/025\",\n      \"basis\": \"Define immutable baseline custody, original-meaning comparison/recovery, attributable transition preparation and dependency-safe retirement. Preserve selective retention and separate action authority, operational maintenance and actual execution; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:ba41087b0df1d5c12ae152e35397deb80e06e0a31302e87be22f54da8e44fb02","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/AR-071-preserve-immutable-baseline-content-with-attributable-custody.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-071","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-071 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:e17161533905669c22742041d92755248e13b1ca007a9a4ed0091eaaf635c46c","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/sr.json"},{"identity":"sha256:f1e92fd3eb2e227c9a5e2b2fd2fdf75717bba8ffd77ca60fc3821c55ca1a5a16","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/AR-070-establish-baselines-from-confirmed-coherent-retained-scope.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Both immutable descriptor/bundle/profile bases and comparison scope are independently bound; entity continuity uses stable IDs rather than names/paths.","number":1,"state":"covered"},{"explanation":"Directed before/after facts include definition, relationship, lifecycle, name/location, rule and relevant provenance changes under each original basis, with neither state mutated.","number":2,"state":"covered"},{"explanation":"Addition/removal requires complete relevant membership. Ambiguity, unsupported semantic comparison and unavailable portions remain explicit rather than chosen matches, equality or absence.","number":3,"state":"covered"},{"explanation":"No recorded difference is a bounded inspected-facts conclusion only; conformance, equivalence, approval and satisfaction remain separate.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-072\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Compare retained states under their original bases\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-005 responsibility shall compare retained states under their original bases within the exact selected scope, preserving original meaning and explicit incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Selected retained-state comparison can otherwise conflate preparation with confirmed effects or hide unavailable content.\",\n      \"desired_outcome\": \"Compare retained states under their original bases.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-021 requires this accountable architectural contribution; other contributions retain their own owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers\",\n        \"Reviewers and project decision owners\",\n        \"MOD-005 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests selected retained-state comparison.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected local project state and declared retained/current material under state-control.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply state-control.md with exact identity/scope and original interpretation, explicit custody/authority boundaries and attributable incomplete or confirmed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Selected retained-state comparison. No full IR003 assessment, runtime qualification, destructive adoption or operational maintenance execution is claimed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Bind both baseline identities, exact content and original rules to the selected comparison and match entities by stable identity; rename/move does not invent an addition.\",\n    \"Expose before/after changes in definitions, relationships, lifecycle, names/locations, governing rules and relevant provenance without rewriting either state.\",\n    \"Claim additions/removals only with complete relevant membership; ambiguity or unavailable interpretation remains explicit instead of unchanged or absent.\",\n    \"Bound no-recorded-difference to inspected content and scope; do not infer semantic equivalence, approval or satisfaction.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-005\",\n  \"constrains\": [\n    \"FUNC-021\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-BASELINE-STATE-DESIGN\",\n      \"locator\": \"SR-020–024; SCN-019–022/025\",\n      \"basis\": \"Define immutable baseline custody, original-meaning comparison/recovery, attributable transition preparation and dependency-safe retirement. Preserve selective retention and separate action authority, operational maintenance and actual execution; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:51916da9d431a87db354b9da8b26c22a7c4142763cf19a4d5441c6a9204d26e2","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-021-compare-retained-engineering-states-with-their-original-meaning/AR-072-compare-retained-states-under-their-original-bases.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-072","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-072 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:8a96525ea64d7cc0aac2d1fcc94bd8d7e9bb1aae4577b212ecdb7590daa2abd4","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-021-compare-retained-engineering-states-with-their-original-meaning/sr.json"},{"identity":"sha256:27c06f8dfa8680d7c9a5490dd7f21c3e6699cd0362187a777dcf4239d958b01c","path":"design/system/functions/FUNC-021-compare-selected-retained-engineering-states.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-005 orchestrates exact selected descriptor/bundle recovery through IF-015 custody and original interpretation, preserving original allocations and judgment meaning.","number":1,"state":"covered"},{"explanation":"Newly created owned isolated destination and contained member materialization reject existing/active-work targets; recovery cannot authorize adoption.","number":2,"state":"covered"},{"explanation":"MOD-005 compares complete returned inventory, bytes and supported attributes with the sealed basis and requires original interpretation for complete recovery with zero loss/alteration.","number":3,"state":"covered"},{"explanation":"Known corrupt/missing/unsupported/partial scope and lost-response uncertainty remain explicit. Owned-output/request inspection is necessary before declaring completeness or retrying.","number":4,"state":"covered"},{"explanation":"External-only material and later unsaved work are excluded. Failure/cancellation leaves retained baseline and active model untouched, cleaning only owned temporary output.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-073\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Recover baselines into isolated verified output\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-005 responsibility shall recover baselines into isolated verified output within the exact selected scope, preserving original meaning and explicit incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Baseline recovery orchestration and complete-result responsibility can otherwise conflate preparation with confirmed effects or hide unavailable content.\",\n      \"desired_outcome\": \"Recover baselines into isolated verified output.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-022 requires this accountable architectural contribution; other contributions retain their own owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers\",\n        \"Reviewers and project decision owners\",\n        \"MOD-005 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests baseline recovery orchestration and complete-result responsibility.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected local project state and declared retained/current material under state-control.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply state-control.md with exact identity/scope and original interpretation, explicit custody/authority boundaries and attributable incomplete or confirmed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Baseline recovery orchestration and complete-result responsibility. No full IR003 assessment, runtime qualification, destructive adoption or operational maintenance execution is claimed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Select the exact retained descriptor and custody manifest, and recover all declared authoritative content, original rules and provenance without retargeting identities, allocations or judgments.\",\n    \"Use an owned isolated output area and reject pre-existing or active-work destinations; recovery does not authorize destructive adoption.\",\n    \"Compare recovered inventory, bytes and supported recorded attributes with the retained basis and preserve original interpretation; complete recovery requires zero loss or alteration within declared scope.\",\n    \"Report missing, damaged, unsupported, inaccessible or partially recovered scope explicitly, including lost-receipt uncertainty, without a complete recovery claim.\",\n    \"Exclude unretained external material and later unsaved work; failure/cancellation preserves active work and the retained baseline, with cleanup confined to owned temporary output.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-005\",\n  \"constrains\": [\n    \"FUNC-022\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-BASELINE-STATE-DESIGN\",\n      \"locator\": \"SR-020–024; SCN-019–022/025\",\n      \"basis\": \"Define immutable baseline custody, original-meaning comparison/recovery, attributable transition preparation and dependency-safe retirement. Preserve selective retention and separate action authority, operational maintenance and actual execution; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:7b02f92249e05ee103d919e7ee0360a05a744992c1be69cdd329f4f59228d682","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-022-recover-retained-baselines-without-altering-historical-meaning/AR-073-recover-baselines-into-isolated-verified-output.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-073","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-073 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:df0f264c8b823ade0379862fe0930249fdbf84863a605db728c09bf5edec9138","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-022-recover-retained-baselines-without-altering-historical-meaning/sr.json"},{"identity":"sha256:b492e30e5151f3b6ee34063dd17874f32b96b9975c645c837dc0b23aa98cc3c5","path":"design/system/functions/FUNC-022-recover-the-recorded-content-of-a-retained-baseline.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Transition preparation binds actual project/Change, exact before/result baselines, initiating rationale, subjects/revisions, actors, decisions and adopted outcome.","number":1,"state":"covered"},{"explanation":"Intent, execution, decision and confirmed retention remain distinct; missing support cannot fabricate an established transition or resulting baseline.","number":2,"state":"covered"},{"explanation":"Participant-selected content is explicitly recorded through existing native tasks/support attachments, with inconclusive carriers for unassessed support and scoped readback for uncertain effects.","number":3,"state":"covered"},{"explanation":"Significant decision/completion corrections retain explicit original-basis attribution; routine working-state replacement preserves surviving reliance without a permanent version chain.","number":4,"state":"covered"},{"explanation":"Exact transition support is inspectable independently of current definitions. Current-model reading requires no Change replay; unavailable history remains unknown rather than a claim that nothing happened.","number":5,"state":"covered"},{"explanation":"Compact operational completion accounts retain important accepted meaning and still-used support, without implying every action/check or an operational Basis is an engineering Baseline.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-074\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Prepare attributable controlled transition accounts\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-006 responsibility shall prepare attributable controlled transition accounts within the exact selected scope, preserving original meaning and explicit incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Transition meaning and participant-assisted recording cooperation can otherwise conflate preparation with confirmed effects or hide unavailable content.\",\n      \"desired_outcome\": \"Prepare attributable controlled transition accounts.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-023 requires this accountable architectural contribution; other contributions retain their own owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers\",\n        \"Reviewers and project decision owners\",\n        \"MOD-006 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests transition meaning and participant-assisted recording cooperation.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected local project state and declared retained/current material under state-control.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply state-control.md with exact identity/scope and original interpretation, explicit custody/authority boundaries and attributable incomplete or confirmed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Transition meaning and participant-assisted recording cooperation. No full IR003 assessment, runtime qualification, destructive adoption or operational maintenance execution is claimed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Identify Change/project, initiating basis, affected subjects/revisions, actors, decisions, exact originating/resulting baselines and adopted outcome for an established transition.\",\n    \"Keep proposal, observed execution, accountable decision and confirmed retention separate; missing baseline, decision or execution context remains an incomplete transition.\",\n    \"Carry actual prepared content through explicit supported recording; storage success grants neither authority nor semantic approval and uncertain effects require scoped readback.\",\n    \"Preserve significant historical decisions and completion meaning through explicit attributable corrections; routine updates need not retain every former version.\",\n    \"Keep transition provenance inspectable independently of current definitions, while current-model reading requires no Change replay; unavailable history remains unavailable rather than no Change.\",\n    \"Permit a compact completed operational acceptance account without logging every action/check, preserving original baseline meaning and still-relied-on support.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-006\",\n  \"constrains\": [\n    \"FUNC-023\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-BASELINE-STATE-DESIGN\",\n      \"locator\": \"SR-020–024; SCN-019–022/025\",\n      \"basis\": \"Define immutable baseline custody, original-meaning comparison/recovery, attributable transition preparation and dependency-safe retirement. Preserve selective retention and separate action authority, operational maintenance and actual execution; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:9016671af0f96818a9607a01582c800ae503996de827f14dbb0b6fad237e244d","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-023-record-controlled-transitions-and-their-engineering-provenance/AR-074-prepare-attributable-controlled-transition-accounts.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-074","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-074 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:b70f07a016cc975c404dc99533736cacd6a3f240681b9211d75619e891bab658","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-023-record-controlled-transitions-and-their-engineering-provenance/sr.json"},{"identity":"sha256:8985e5e5c42ec020c0b2d188d84ad38fb9e11a68701cf956767f9dc9e5cd3304","path":"design/system/functions/FUNC-023-record-controlled-change-transitions-and-provenance.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-006 explicitly classifies preserved engineering/history versus disposable no-reliance operational detail; only the former requires original recovery.","number":1,"state":"covered"},{"explanation":"Current-reliance inventory includes relevant model and non-model dependencies and explicit completeness.","number":2,"state":"covered"},{"explanation":"Exact recoverable originals and already readable adequate replacements precede removal. Age, mere commit identity and successful import do not establish required retention or consumer readiness.","number":3,"state":"covered"},{"explanation":"Exact action/policy/grant/state conditions are rechecked within the corrected stability boundary before effects; changed or unavailable authority prevents reserved action rather than treating preparation as permission.","number":4,"state":"covered"},{"explanation":"Relevant adverse support/failures for other scopes survive replacement; intentionally discarded detail is honestly unavailable and cannot silently resolve to newer content.","number":5,"state":"covered"},{"explanation":"Custody routing keeps model, operational and participant external-file effects separate. Coordination holds required dependency stability through partial/completed effects and reconciliation, which are actually recorded rather than inferred from preflight.","number":6,"state":"covered"},{"explanation":"Release of retained history stays outside ordinary cleanup; current operation must remain usable from current owners and retained history preserves original meaning.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-075\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Resolve reliance before authorizing current material retirement\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-006 responsibility shall resolve reliance before authorizing current material retirement within the exact selected scope, preserving original meaning and explicit incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Retirement disposition and actual outcome accountability can otherwise conflate preparation with confirmed effects or hide unavailable content.\",\n      \"desired_outcome\": \"Resolve reliance before authorizing current material retirement.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-024 requires this accountable architectural contribution; other contributions retain their own owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers\",\n        \"Reviewers and project decision owners\",\n        \"MOD-006 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests retirement disposition and actual outcome accountability.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected local project state and declared retained/current material under state-control.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply state-control.md with exact identity/scope and original interpretation, explicit custody/authority boundaries and attributable incomplete or confirmed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Retirement disposition and actual outcome accountability. No full IR003 assessment, runtime qualification, destructive adoption or operational maintenance execution is claimed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Distinguish preserved engineering/history material requiring recoverable originals from superseded operational detail that has no reliance or retention obligation and needs no archive.\",\n    \"Account for active work, unresolved findings, current evidence, obligations and consumers with complete relevant model and non-model scope; unresolved or unknown required reliance withholds removal.\",\n    \"Confirm required exact original recovery and usable replacement/current references before removal; uncommitted required content, age or a successful import is insufficient.\",\n    \"Assess exact action authority and relevant state/policy conditions within an executor-held maintenance interval covering relevant model, operational, external dependency/replacement and authority writers through effects/reconciliation; changed, missing or unstable basis prevents the affected reserved action.\",\n    \"Preserve failures and contrary support for other scopes when replacing working evidence; discarded detail cannot silently resolve to newer bytes.\",\n    \"Route model and operational effects to their custody owners and bounded external-file cleanup to the authorized participant; record actual partial/completed effects and remaining dependencies.\",\n    \"Keep release of retained history separate under its policy; current operation must remain usable without fetching retired definitions and later unavailability is explicit.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-006\",\n  \"constrains\": [\n    \"FUNC-024\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-BASELINE-STATE-DESIGN\",\n      \"locator\": \"SR-020–024; SCN-019–022/025\",\n      \"basis\": \"Define immutable baseline custody, original-meaning comparison/recovery, attributable transition preparation and dependency-safe retirement. Preserve selective retention and separate action authority, operational maintenance and actual execution; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:dc45b900e32b344fb193aef3bba305bef515cb305d54e80aa62be811e71f3704","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/AR-075-resolve-reliance-before-authorizing-current-material-retirement.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-075","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical AR-075 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:1e8332fabc5d1038e4c0eaaf3b5d31fcc230e7a0eb5ac576f50d12fa4bee9d19","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/sr.json"},{"identity":"sha256:49b7f04d8890a8af9ff9b5ec67c4c7d07ecf47010f32ad90a65e1a0c885dd344","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/AR-076-apply-state-bound-model-retirement-without-corrupting-retained-history.json"},{"identity":"sha256:a1950aba542f169c423b1352b1533716ef92894a540bf9c339a02f2a5d908de4","path":"design/system/functions/FUNC-024-assess-and-apply-retirement-of-current-view-material.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Exact removal/replacement inventory, expected model state, actual authority and complete reliance/recovery basis are admitted under the corrected cross-custody stability boundary; prepared disposition alone grants no execution permission.","number":1,"state":"covered"},{"explanation":"Model write exclusion protects exact resulting-state checks and publication; required replacements precede selected removal, retained bundles remain immutable, and relevant cross-owner preconditions remain stable through effects.","number":2,"state":"covered"},{"explanation":"Durable unresolved-write metadata precedes authoritative mutation. Partial/uncertain publication blocks coherent affected reads and further writes until exact reconciliation.","number":3,"state":"covered"},{"explanation":"Actual retained/replaced/removed/unresolved membership is reported; changed bases reject and unrelated work is preserved.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-076\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Apply state-bound model retirement without corrupting retained history\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-001 responsibility shall apply state-bound model retirement without corrupting retained history within the exact selected scope, preserving original meaning and explicit incomplete outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Conditional current-model publication and removal custody can otherwise conflate preparation with confirmed effects or hide unavailable content.\",\n      \"desired_outcome\": \"Apply state-bound model retirement without corrupting retained history.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-024 requires this accountable architectural contribution; other contributions retain their own owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers\",\n        \"Reviewers and project decision owners\",\n        \"MOD-001 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant requests conditional current-model publication and removal custody.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected local project state and declared retained/current material under state-control.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply state-control.md with exact identity/scope and original interpretation, explicit custody/authority boundaries and attributable incomplete or confirmed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Conditional current-model publication and removal custody. No full IR003 assessment, runtime qualification, destructive adoption or operational maintenance execution is claimed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Accept only exact current-model removal/replacement scope with expected state, applicable authority and resolved reliance/recovery basis; never treat a prepared disposition as execution permission.\",\n    \"Require executor-held cross-custody quiescence/exclusion through final reliance/authority checks, effects and reconciliation, in addition to model write exclusion; verify the exact base/resulting-model rules, preserve replacements and never touch immutable retained bundles.\",\n    \"Persist unresolved-write scope before effects and block coherent affected reads and further writes after partial or uncertain publication until exact effects are reconciled.\",\n    \"Report actual retained, replaced, removed and unresolved membership; changed bases reject, unrelated work remains untouched and failure cannot imply rollback or complete cleanup.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-001\",\n  \"constrains\": [\n    \"FUNC-001\",\n    \"FUNC-004\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-BASELINE-STATE-DESIGN\",\n      \"locator\": \"SR-020–024; SCN-019–022/025\",\n      \"basis\": \"Define immutable baseline custody, original-meaning comparison/recovery, attributable transition preparation and dependency-safe retirement. Preserve selective retention and separate action authority, operational maintenance and actual execution; proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:49b7f04d8890a8af9ff9b5ec67c4c7d07ecf47010f32ad90a65e1a0c885dd344","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/AR-076-apply-state-bound-model-retirement-without-corrupting-retained-history.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-076","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-076 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:1e8332fabc5d1038e4c0eaaf3b5d31fcc230e7a0eb5ac576f50d12fa4bee9d19","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/sr.json"},{"identity":"sha256:dc45b900e32b344fb193aef3bba305bef515cb305d54e80aa62be811e71f3704","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/AR-075-resolve-reliance-before-authorizing-current-material-retirement.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"IF-011/FUNC-025 return seven sections from their single authoritative owners with accountable next action, reason and owner; MOD-012 obtains facts through IF-004 rather than creating a duplicate editable handoff.","number":1,"state":"covered"},{"explanation":"Complete selector index and bounded supported reads remain associated with project/Change/adopted contract and observed identity.","number":2,"state":"covered"},{"explanation":"Actual outcomes, intended checks, non-applicability, issue disposition, review standing and authority retain distinct owners/meanings.","number":3,"state":"covered"},{"explanation":"Work owners supply material changes before dependent decisions/transfer; MOD-012 explicitly records through IF-004 against inspected identity.","number":4,"state":"covered"},{"explanation":"Comparable working support can be replaced selectively only with still-relied-upon scope/basis/outcome/limits and adverse support preserved.","number":5,"state":"covered"},{"explanation":"Restored state exposes capture limits and unavailable later work without renewing grants/reviews.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-077\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Interpret current handoffs with explicit reliance and gaps\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-006 responsibility shall interpret current handoffs with explicit reliance and gaps within the selected project and Change scope.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Resumption can otherwise invent missing context or authority and lose obligations still relied upon.\",\n      \"desired_outcome\": \"Interpret current handoffs with explicit reliance and gaps.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-006 requires a complete accountable contribution beyond general workflow progression or adoption.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers resuming work\",\n        \"Project decision owners\",\n        \"MOD-006 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant resumes or progresses governed work and prepares its next handoff.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected project, Change, adopted contract and exact action context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the MOD-006 README.md handoff and authority collaboration through IF-011/009 with explicit participant-mediated IF-004 recording.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Semantic resumption or authority interpretation. Operational maintenance execution, runtime adoption and overall IR-003 satisfaction remain separate.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Return all seven current handoff sections through IF-011 from authoritative record and subject references, with one semantic owner per fact and an identified next action, reason and responsible owner.\",\n    \"Use attributable supported bounded reads and complete selectors over one coherent project, Change and contract basis; report omitted, unavailable, stale or conflicting facts without inferring absence, approval or completion.\",\n    \"Keep actual outcomes, planned checks, not-applicable explanations, issue disposition, review standing and authority distinct; route returns changed-subject assessment applicability to its owner.\",\n    \"Prepare meaningful updates before dependent decisions or transfer and carry them through explicit IF-004 recording, preserving concurrent facts and reconciling uncertain effects before retry.\",\n    \"Permit comparable current summary replacement and selective detail retention while preserving unresolved issues and result, scope, basis, limitations and support still relied upon; require attributable disposition before compaction.\",\n    \"Expose restored retained state and unavailable later work without renewing authority or review; keep compact historical completion and its acceptance meaning distinct from current health and linked regression work.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-006\",\n  \"constrains\": [\n    \"FUNC-025\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-RESUMPTION-AUTHORITY-DESIGN\",\n      \"locator\": \"SR-006/007; SCN-023/024; FUNC-025/026\",\n      \"basis\": \"Derive current handoff interpretation and action-bound authority through existing IF-011/009, with explicit participant recording, selective retention and one MOD-006 owner. Proposed Design only; no runtime adoption, execution or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:81dd26f1870a5ef8570e5e5d14e1ea012bebb1569be9f2d51dc1e3fd94ddd791","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-006-resume-changes-from-recorded-work-context/AR-077-interpret-current-handoffs-with-explicit-reliance-and-gaps.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No workflow adoption. Participant interpretation and CLI custody retain separate owners; no automatic permission enforcement, new record schema or global coordinator.","Maintenance execution and whole-IR outcomes remain separately assessed. State exclusion, exact release candidate and current effect/source reconciliation remain execution prerequisites; authority assessment does not satisfy them. AR-046 history remains."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-077","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-077 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:42e35b2c42c1db2d416487b09de5aea0f0d9b84cdad9c3c3a20fe8ab7e6a41f9","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-006-resume-changes-from-recorded-work-context/sr.json"},{"identity":"sha256:b5bbfbf03874ea29120c3443bd5efc8160f8cbbf230286fde5316d5fee495ef1","path":"design/system/functions/FUNC-025-retain-and-retrieve-activity-specific-change-context.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"IF-009 binds policy, decision owner, grant/mandate and conditions to exact action, subject/state, participant, project and scope; absence or conflicting basis yields the specific unmet boundary rather than assumed permission.","number":1,"state":"covered"},{"explanation":"Valid prior authorization and bounded standing delegation remain usable across covered steps/sessions without redundant confirmation; no new permission token or grant store is introduced.","number":2,"state":"covered"},{"explanation":"Reserved scope/policy/tradeoff/release classes and explicit external/destructive authorization are named under the existing precedence and selected project policy, without a universal approval workflow.","number":3,"state":"covered"},{"explanation":"Revoked, superseded, completed, exceeded and condition-failing grants withhold affected actions; higher authority and nondelegable boundaries prevail while independent still-covered work remains possible.","number":4,"state":"covered"},{"explanation":"Review/check/routing results and other-scope grants cannot substitute for permission; permission cannot waive independent assessment or required proof.","number":5,"state":"covered"},{"explanation":"Consumer rechecks action/material authority conditions immediately before effects and inspects uncertain prior effects before retry.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-078\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Assess exact action authority without redundant confirmation\",\n  \"status\": \"draft\",\n  \"statement\": \"The MOD-006 responsibility shall assess exact action authority without redundant confirmation within the selected project and Change scope.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Resumption can otherwise invent missing context or authority and lose obligations still relied upon.\",\n      \"desired_outcome\": \"Assess exact action authority without redundant confirmation.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-007 requires a complete accountable contribution beyond general workflow progression or adoption.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers resuming work\",\n        \"Project decision owners\",\n        \"MOD-006 maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A participant resumes or progresses governed work and prepares its next handoff.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected project, Change, adopted contract and exact action context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the MOD-006 README.md handoff and authority collaboration through IF-011/009 with explicit participant-mediated IF-004 recording.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Semantic resumption or authority interpretation. Operational maintenance execution, runtime adoption and overall IR-003 satisfaction remain separate.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Assess an identified action, subject/state, participant, scope and conditions through IF-009 against attributable applicable policy, decision owner and grant or mandate; expose the exact unmet reserved boundary.\",\n    \"Recognize valid existing grants and bounded standing delegation across covered steps and resumed sessions without requesting confirmation solely because the session changed.\",\n    \"Identify the governing human boundaries for scope expansion, policy changes, reserved project tradeoffs and release decisions; require explicit applicable authorization for external mutation and destruction.\",\n    \"Withhold actions affected by revocation, supersession, completion, exceeded scope or failed conditions while retaining separately covered scope; higher authority and nondelegable decisions cannot be bypassed.\",\n    \"Keep favorable reviews, successful checks, routing suggestions and grants for other subjects separate from permission; authorization does not waive required independent assessment.\",\n    \"Require consumer rechecking of material authority conditions before a governed effect and reconciliation of uncertain prior effects before retry, preserving action-specific safeguards without treating an assessment as a reservation or new grant.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Proposed Design; no implementation, executed criterion verification or satisfaction claim.\"\n  ],\n  \"allocated_to\": \"MOD-006\",\n  \"constrains\": [\n    \"FUNC-026\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-RESUMPTION-AUTHORITY-DESIGN\",\n      \"locator\": \"SR-006/007; SCN-023/024; FUNC-025/026\",\n      \"basis\": \"Derive current handoff interpretation and action-bound authority through existing IF-011/009, with explicit participant recording, selective retention and one MOD-006 owner. Proposed Design only; no runtime adoption, execution or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:a256787d50b7e520c3d828c35b8ff67e93b9cf7a5519bf9e23a82f514c2a3b6f","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-007-preserve-human-authority-over-governed-decisions/AR-078-assess-exact-action-authority-without-redundant-confirmation.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No workflow adoption. Participant interpretation and CLI custody retain separate owners; no automatic permission enforcement, new record schema or global coordinator.","Maintenance execution and whole-IR outcomes remain separately assessed. State exclusion, exact release candidate and current effect/source reconciliation remain execution prerequisites; authority assessment does not satisfy them. AR-046 history remains."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-078","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-078 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:a7dc9c043bd829f8b6cb241924bf0c62ca038d82ceb911064d1707b03033b4f2","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-007-preserve-human-authority-over-governed-decisions/sr.json"},{"identity":"sha256:e2d0fbfe210afa2888bbdd1061ab5a4b3783292b44a7ab374b73beaa3203d869","path":"design/system/functions/FUNC-026-determine-applicable-authority-before-governed-actions.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"IF-008 returns activity/profile, owners, exact source identities, applicability and worked-example navigation; source rules and illustrative batch content remain distinct.","number":1,"state":"covered"},{"explanation":"Human and agent guidance consume one captured meaning; missing required sources or examples names incomplete scope rather than complete guidance.","number":2,"state":"covered"},{"explanation":"Activity/profile/source changes trigger applicability comparison; coherent captured reuse or repreparation prevents mixed-version and silent fallback claims.","number":3,"state":"covered"},{"explanation":"MOD-008 contributes selection through parent IF-008; interpretation, adoption and editing authority remain with their existing owners.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-079\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Bind authoring guidance to its applicable source basis\",\n  \"status\": \"draft\",\n  \"statement\": \"The Authoring guidance Module shall bind its guidance selections and explanations to the requested activity and declared profile with identifiable canonical sources, applicable worked examples and explicit unsupported or conflicting scope.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An unbound guidance selection can silently mix incompatible rules or present examples as authority.\",\n      \"desired_outcome\": \"Bind authoring guidance to its applicable source basis.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-032 needs an accountable MOD-008 obligation at the IF-008 guidance boundary; existing workflow AR-029/033 do not cover this complete guidance responsibility.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"New REM authors with basic engineering knowledge\",\n        \"Experienced authors/reviewers and engineering agents\",\n        \"Guidance maintainers and accountable assessors\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During the selected authoring/correction or prepared guidance-assessment activity, and when its material source or subject basis changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-008 contribution to MOD-017 IF-008, with MOD-012 guided consumption and existing IF-014 assurance/IF-004 recording when selected.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply guidance.md to exact declared inputs and owned source meanings; preserve actor decisions, incomplete scope and separately observed effects.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The complete allocated contribution to SR-032 within the declared finite activity/profile/task scope; no universal usability, runtime automation or population claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Return each selection with activity, declared profile/version, canonical owners, inspected source identities, applicability reasoning and worked-example navigation; distinguish normative rules from illustrations.\",\n    \"Preserve the same governing basis and required meaning in human and agent presentations; report missing required sources or examples instead of claiming complete guidance.\",\n    \"Reassess changed activity/profile/source selections and identify incompatible, superseded, unavailable or unresolved prior material without silent fallback or mixed-version explanation.\",\n    \"Return the selected basis or explicit gaps through IF-008 without adopting a profile, interpreting or migrating the model, or granting editing authority.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Guidance and Design coverage do not establish participant success, execution authority or installed support.\"\n  ],\n  \"allocated_to\": \"MOD-008\",\n  \"constrains\": [\n    \"FUNC-032\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-AUTHORING-GUIDANCE-DESIGN\",\n      \"locator\": \"IR-006; SR-032–034; SCN-031–034/040\",\n      \"basis\": \"Define source-bound guidance selection, bounded authoring/correction and participant-assisted semantic task assessment, with justified MOD-008 allocation and existing assurance/recording cooperation. Target Design only; no observed usability or installed capability claim.\"\n    }\n  ]\n}\n","identity":"sha256:e1219ca351ff6b902a6da757148d0bfd1a837a7eeca90cbedb68fec13c1f06f1","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/AR-079-bind-authoring-guidance-to-its-applicable-source-basis.json"},"limitations":["Design only; no implementation, executed verification, participant usability or installed-skill qualification. Delivery unchanged.","Participant-assisted exact source selection and semantic comparison; no automatic judge, universal performance claim, new schema/command or profile adoption.","Actual outcomes require observed tasks/checks/explanations; assistance, missing/unsupported scope and original bases remain explicit. Authority, formal assurance and confirmed retention keep separate owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-079","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-079 criteria; target participant-assisted Design.","state":"covered","subjects":[{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:25d6e04a47206a5d83867259de252532bb9d2990707c12ff5f60290dad665e82","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7616f27fa93749af2e127663bcfd04fef9579dff8d3ed0c5d00f63f872a245de","path":"design/system/functions/FUNC-032-select-canonical-guidance-for-an-authoring-activity.json"},{"identity":"sha256:11164a5918fbd34a517dd0139be01d9ba96652f4a021b8d5e4491e48ec21e1a6","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/sr.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The seven worked activities connect canonical requirement, Scenario, Function, allocation and Interface meanings to concrete expected distinctions without creating competing normative rules.","number":1,"state":"covered"},{"explanation":"Each correction relates identifiable diagnostic, exact subject and owner rule to an expected result and checks; changed or missing basis requires fresh inspection.","number":2,"state":"covered"},{"explanation":"Rename preserves identity/parentage and reference closure; retirement identifies surviving obligations and historical meaning. Guidance explains these outcomes without performing edits.","number":3,"state":"covered"},{"explanation":"Unresolved decisions, unsupported representations and authority limits have responsible next actions; recommendations and conformant examples confer neither approval nor satisfaction.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-080\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Explain checkable authoring corrections within owner boundaries\",\n  \"status\": \"draft\",\n  \"statement\": \"The Authoring guidance Module shall explain a supported authoring or correction outcome from its identified canonical rule and subject basis, preserving method ownership, unresolved decisions, representation limits and separate execution authority.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A structural diagnostic or plausible example can be mistaken for a correct authorized engineering edit.\",\n      \"desired_outcome\": \"Explain checkable authoring corrections within owner boundaries.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-033 needs an accountable MOD-008 obligation at the IF-008 guidance boundary; existing workflow AR-029/033 do not cover this complete guidance responsibility.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"New REM authors with basic engineering knowledge\",\n        \"Experienced authors/reviewers and engineering agents\",\n        \"Guidance maintainers and accountable assessors\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During the selected authoring/correction or prepared guidance-assessment activity, and when its material source or subject basis changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-008 contribution to MOD-017 IF-008, with MOD-012 guided consumption and existing IF-014 assurance/IF-004 recording when selected.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply guidance.md to exact declared inputs and owned source meanings; preserve actor decisions, incomplete scope and separately observed effects.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The complete allocated contribution to SR-033 within the declared finite activity/profile/task scope; no universal usability, runtime automation or population claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Explain 5W2H and single-parent requirement derivation, black-box Scenarios, Feature/Function distinctions and consistent AR/Function/Module and Interface responsibility using applicable rules and worked reasoning.\",\n    \"For an identifiable finding, relate the diagnostic, affected subject and rule to a proposed correction and applicable checks; missing or changed basis prevents an unsupported complete-fix claim.\",\n    \"For rename and retirement, explain preserved identity/parentage and reference reconciliation or explicit surviving-obligation disposition and recoverable historical meaning; do not execute the action through guidance.\",\n    \"Return unresolved decisions, unsupported representations and authority limits with the next responsible clarification; do not treat a recommendation, conformant example or completed explanation as approval or satisfaction.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Guidance and Design coverage do not establish participant success, execution authority or installed support.\"\n  ],\n  \"allocated_to\": \"MOD-008\",\n  \"constrains\": [\n    \"FUNC-033\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-AUTHORING-GUIDANCE-DESIGN\",\n      \"locator\": \"IR-006; SR-032–034; SCN-031–034/040\",\n      \"basis\": \"Define source-bound guidance selection, bounded authoring/correction and participant-assisted semantic task assessment, with justified MOD-008 allocation and existing assurance/recording cooperation. Target Design only; no observed usability or installed capability claim.\"\n    }\n  ]\n}\n","identity":"sha256:4f0b1cae66ccb72d183467b891306975c837f873cafc5d2ff2f6c765492c8110","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/AR-080-explain-checkable-authoring-corrections-within-owner-boundaries.json"},"limitations":["Design only; no implementation, executed verification, participant usability or installed-skill qualification. Delivery unchanged.","Participant-assisted exact source selection and semantic comparison; no automatic judge, universal performance claim, new schema/command or profile adoption.","Actual outcomes require observed tasks/checks/explanations; assistance, missing/unsupported scope and original bases remain explicit. Authority, formal assurance and confirmed retention keep separate owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-080","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-080 criteria; target participant-assisted Design.","state":"covered","subjects":[{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:25d6e04a47206a5d83867259de252532bb9d2990707c12ff5f60290dad665e82","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:92153a9115ae4d3b6e0184a95c89e6b3b6ade3f80793c097b715abbe4286c265","path":"design/system/functions/FUNC-033-explain-engineering-authoring-and-correction-steps.json"},{"identity":"sha256:6c44ffbbe94834879a1b7047b6961bb7ed9c1b923b445c29bb0b3059a9dbd999","path":"rem/methods/5w2h.md"},{"identity":"sha256:6973551e7d8b2d709a8a99c4d819af049a3bdc0e25ea06e5c64cc0c78e5468e1","path":"rem/methods/requirement-analysis.md"},{"identity":"sha256:a095ea5dc500a5afcfb1eb9875c05ca80111f3af82eb53c8ea22f3613c5079be","path":"rem/methods/scenario-analysis.md"},{"identity":"sha256:70aca72b937bc5063b2fd130d3e050d3973c16b478426bdf78e7b34bd3c80cb4","path":"rem/methods/functional-analysis.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:6ce1497da7edf831832acbb0299a145d4a40d33f211eba88b45c993d34f30475","path":"rem/models/architecture-design.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:4d6e2356f9a742c605f56e636f4ef29c979024cf8eae2432ec46aa32c98f7acf","path":"rem/models/operational-support.md"},{"identity":"sha256:305c34fc2c2fe2997a7e3d672ab04d6616af8f8421a50c9b53ef25176deb4d29","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/requirement-analysis.md"},{"identity":"sha256:cb6137d5432b1273021274aa372a71d4a54b024b151e9ab704fd7697049c724e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/design-authoring.md"},{"identity":"sha256:0a98d6e691a745754a985a49e118bac13e85c508ea60235eb5f99617d903626f","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/sr.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The pre-performance task account fixes participant, exact guidance basis, input, independent expected output, rule explanation, checks and assistance across declared coverage.","number":1,"state":"covered"},{"explanation":"FUNC-034 compares actual output, checks and explanation conjunctively. Missing evidence stays unassessed; observed semantic errors are unsuccessful despite valid structure.","number":2,"state":"covered"},{"explanation":"Comparisons preserve adverse results, ambiguity, assistance and unsupported/interrupted scope; assisted success cannot be labeled unassisted or generalized across groups/versions.","number":3,"state":"covered"},{"explanation":"MOD-012 carries exact prepared task content through IF-014 and selected IF-004 retention/readback. Changed expectations preserve historical observations; saved content is not formal approval or usability proof.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-081\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Compare prepared guidance tasks without manufacturing success\",\n  \"status\": \"draft\",\n  \"statement\": \"The Authoring guidance Module shall prepare and compare participant-specific semantic authoring tasks against identified expectations, exposing actual outcomes, assistance and unassessed scope while leaving generic assurance judgments and retention to their accountable owners.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Passing shape checks can hide incorrect semantic outcomes, missing explanations or undocumented help.\",\n      \"desired_outcome\": \"Compare prepared guidance tasks without manufacturing success.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-034 needs an accountable MOD-008 obligation at the IF-008 guidance boundary; existing workflow AR-029/033 do not cover this complete guidance responsibility.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"New REM authors with basic engineering knowledge\",\n        \"Experienced authors/reviewers and engineering agents\",\n        \"Guidance maintainers and accountable assessors\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During the selected authoring/correction or prepared guidance-assessment activity, and when its material source or subject basis changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-008 contribution to MOD-017 IF-008, with MOD-012 guided consumption and existing IF-014 assurance/IF-004 recording when selected.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply guidance.md to exact declared inputs and owned source meanings; preserve actor decisions, incomplete scope and separately observed effects.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The complete allocated contribution to SR-034 within the declared finite activity/profile/task scope; no universal usability, runtime automation or population claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Before task performance, identify participant group, exact guidance/profile basis, prepared inputs, expected semantic outputs, rule explanation, applicable checks and assistance conditions across the declared activity coverage.\",\n    \"Report success only from the expected semantic outcome, passed applicable checks and an adequate rule explanation from canonical guidance; structural validity alone, absent observations or missing checks cannot establish success.\",\n    \"Preserve incorrect results, ambiguities, actual assistance, unsupported formats and interrupted/unperformed tasks; keep assisted and unassisted results and participant/version conclusions distinguishable.\",\n    \"Carry exact prepared expectations and actual task comparison separately into existing assurance preparation and selected retention; changed expectations do not rewrite prior observations, and preparation or saved content does not establish formal judgment or general usability.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Guidance and Design coverage do not establish participant success, execution authority or installed support.\"\n  ],\n  \"allocated_to\": \"MOD-008\",\n  \"constrains\": [\n    \"FUNC-034\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-AUTHORING-GUIDANCE-DESIGN\",\n      \"locator\": \"IR-006; SR-032–034; SCN-031–034/040\",\n      \"basis\": \"Define source-bound guidance selection, bounded authoring/correction and participant-assisted semantic task assessment, with justified MOD-008 allocation and existing assurance/recording cooperation. Target Design only; no observed usability or installed capability claim.\"\n    }\n  ]\n}\n","identity":"sha256:eb4023bc54f433e22abd94a88aed99eae8d976bb4671c4ff5860d58f187aed6b","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-034-assess-guidance-using-semantic-authoring-outcomes/AR-081-compare-prepared-guidance-tasks-without-manufacturing-success.json"},"limitations":["Design only; no implementation, executed verification, participant usability or installed-skill qualification. Delivery unchanged.","Participant-assisted exact source selection and semantic comparison; no automatic judge, universal performance claim, new schema/command or profile adoption.","Actual outcomes require observed tasks/checks/explanations; assistance, missing/unsupported scope and original bases remain explicit. Authority, formal assurance and confirmed retention keep separate owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-081","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-081 criteria; target participant-assisted Design.","state":"covered","subjects":[{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:25d6e04a47206a5d83867259de252532bb9d2990707c12ff5f60290dad665e82","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:fee3866fd49b961a63f7a9fa282eaaa20ad87233786368a7fe856f015aa20f69","path":"design/system/functions/FUNC-034-assess-authoring-guidance-against-prepared-task-outcomes.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:98bbb8a10d2c65ed2107ae29b9de5961e6374a8f57d20c6ca2c7a1b16cdc9978","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-034-assess-guidance-using-semantic-authoring-outcomes/sr.json"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"IF-017 characterization binds finding/context/content and observed sources while explicitly separating inferred mechanisms, alternative explanations and contradictions.","number":1,"state":"covered"},{"explanation":"Declared reuse conditions require an explained reusable mechanism and exclusions; unsupported causality remains provisional even when recurrence is observed.","number":2,"state":"covered"},{"explanation":"A local-only correction returns to its governing work rather than becoming a generalized lesson or mandatory topic.","number":3,"state":"covered"},{"explanation":"The selected local writer preserves contributor confirmation, no-clobber and identity-bound retry under the explicit final write guard; IF-017 preparation and actual artifact/record retention remain separate.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-082\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve supported lesson meaning and reuse limits\",\n  \"status\": \"draft\",\n  \"statement\": \"The Lessons and improvement Module shall prepare attributable lesson characterizations with observed and inferred content distinguished, justified reuse and explicit limits, while preserving the selected learning operation's confirmation and custody boundaries.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Unsupported causal interpretations can become durable guidance without justified reuse or permitted custody.\",\n      \"desired_outcome\": \"Preserve supported lesson meaning and reuse limits.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-035 requires this accountable MOD-009 contribution; source meaning, adoption and evidence authority must remain distinct.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering participants and reviewers\",\n        \"Lesson and improvement owners\",\n        \"Project decision owners and assurance assessors\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During supported finding analysis, work preparation, proposal disposition or opportunity-based effect assessment as applicable; reconsider when the material basis changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-009 contribution to MOD-017 IF-017 consumed by MOD-012; existing controlled-change, assurance and selected retention boundaries.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply improvement.md to exact participant-supplied context and observations, preserve missing/contrary support, and confirm authority, adopted effects and retention through their existing owners.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Complete allocated contribution to SR-035 within the declared finite project/activity/observation scope; no automatic causal discovery, policy adoption or universal effectiveness claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Bind the finding, original context and observed sources to identifiable content; keep inferred mechanisms and material alternative or contrary explanations distinct from facts.\",\n    \"Explain supported recurrence, reusable weakness or high-consequence broader applicability and its exclusions; an unsupported cause remains provisional and cannot support a conclusive lesson claim.\",\n    \"Return a finding without supported reusable implications to its owning work as a local correction, without manufacturing a durable general rule.\",\n    \"Carry the supplied characterization through IF-017 and the selected artifact/record writer with actual retention distinguished; selected Learn topic/route effects preserve required contributor confirmation, no-clobber and identity-bound retry.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Existing Learn contributor confirmation and topic/route custody remain applicable to their actual operations; Design approval does not execute them.\"\n  ],\n  \"allocated_to\": \"MOD-009\",\n  \"constrains\": [\n    \"FUNC-035\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LESSON-IMPROVEMENT-DESIGN\",\n      \"locator\": \"IR-007; SR-035–038; SCN-035–039\",\n      \"basis\": \"Refine supported lesson characterization, bounded contextual use, accountable proposals and opportunity-based effect assessment through MOD-009 and parent IF-017. Preserve existing Learn confirmation/custody/route boundaries and separate controlled adoption, assurance and retention. Proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:5a8c0fb149340b3f144e8080956543701d72b2b2dd37324f4034b70abed6dd76","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/AR-082-preserve-supported-lesson-meaning-and-reuse-limits.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-082","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-082 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:7be9f608eb844fa4a727aa04970221394d750ce9db45170a46b1667828205935","path":"design/system/functions/FUNC-035-characterize-a-reusable-lesson-from-an-engineering-finding.json"},{"identity":"sha256:ebe79d84d659cd5f09959503a0f70fcb56bf4af24ea55d1aeb8d2e0fbcc73d3c","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/sr.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Candidate lessons retain exact source identities, declared population/acquisition limits and accountable condition/mechanism comparisons rather than relying on an index alone.","number":1,"state":"covered"},{"explanation":"Known exclusion, incomplete work context, unavailable source and complete inspected no-match scope have separate attributable outcomes.","number":2,"state":"covered"},{"explanation":"Current disposition binds the governing decision and affected version; proposed/rejected/revision-required/unknown content cannot become adopted policy from a status label or settled route.","number":3,"state":"covered"},{"explanation":"Consultation is read-only; changed activity or source requires a coherent new selection or visible uncertainty. Neither lookup nor an old index renews applicability or authority.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-083\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Select lessons with explicit context and adoption basis\",\n  \"status\": \"draft\",\n  \"statement\": \"The Lessons and improvement Module shall present lessons from an identified available scope using attributable context comparisons and current governing improvement dispositions, preserving exclusions, unavailable sources and unresolved applicability.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Lesson lookup can hide unavailable context or turn a proposal into current policy.\",\n      \"desired_outcome\": \"Select lessons with explicit context and adoption basis.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-036 requires this accountable MOD-009 contribution; source meaning, adoption and evidence authority must remain distinct.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering participants and reviewers\",\n        \"Lesson and improvement owners\",\n        \"Project decision owners and assurance assessors\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During supported finding analysis, work preparation, proposal disposition or opportunity-based effect assessment as applicable; reconsider when the material basis changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-009 contribution to MOD-017 IF-017 consumed by MOD-012; existing controlled-change, assurance and selected retention boundaries.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply improvement.md to exact participant-supplied context and observations, preserve missing/contrary support, and confirm authority, adopted effects and retention through their existing owners.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Complete allocated contribution to SR-036 within the declared finite project/activity/observation scope; no automatic causal discovery, policy adoption or universal effectiveness claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Return each relevant lesson with exact inspected basis, mechanism, compared activity conditions and applicability reasoning, including the selected source population and acquisition limits.\",\n    \"Explain material exclusions or contextual differences; insufficient context, unavailable sources and a completely inspected no-match scope remain distinct.\",\n    \"Bind an associated improvement disposition to its authoritative decision and affected version; proposed, rejected, revision-required or unknown dispositions cannot be rendered as adopted current rules.\",\n    \"Keep consultation read-only and source-bound across changed selections; an index, lesson or route status cannot authorize a policy/model change or silently renew applicability.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Existing Learn contributor confirmation and topic/route custody remain applicable to their actual operations; Design approval does not execute them.\"\n  ],\n  \"allocated_to\": \"MOD-009\",\n  \"constrains\": [\n    \"FUNC-036\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LESSON-IMPROVEMENT-DESIGN\",\n      \"locator\": \"IR-007; SR-035–038; SCN-035–039\",\n      \"basis\": \"Refine supported lesson characterization, bounded contextual use, accountable proposals and opportunity-based effect assessment through MOD-009 and parent IF-017. Preserve existing Learn confirmation/custody/route boundaries and separate controlled adoption, assurance and retention. Proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:a2f18deb20a0b5ccb4412c87546ea8399a56a97f6b051882a9191c6ed3f47c08","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-036-present-applicable-lessons-when-preparing-engineering-work/AR-083-select-lessons-with-explicit-context-and-adoption-basis.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-083","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-083 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:055557862da7bf1cf6d1bdd6979c8495ac7f3239d588d7139532a407ceab58c8","path":"design/system/functions/FUNC-036-select-lessons-applicable-to-planned-engineering-work.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:de50b9b375e6c6a0e5788b844574b22923e692c48fc8a829408dec013a8a3650","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-036-present-applicable-lessons-when-preparing-engineering-work/sr.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The pre-adoption proposal carries exact lesson/mechanism, affected owner subjects, applicability, intended change and independently observable success/adverse criteria.","number":1,"state":"covered"},{"explanation":"Incomplete support, owner, subject or criterion prevents readiness while permitting a clearly labeled incomplete proposal to remain inspectable.","number":2,"state":"covered"},{"explanation":"MOD-012 composes existing authority/transition services and an explicit authorized owner handoff; preparation neither invokes an unrequested owner nor supplies adoption.","number":3,"state":"covered"},{"explanation":"Actual adopted scope requires the exact proposal, decision, before/result state and qualifying owner outcome. Scheduled-follow-up settlement and artifact adoption have distinct completion meanings.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-084\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Prepare owner-bound improvements without implying adoption\",\n  \"status\": \"draft\",\n  \"statement\": \"The Lessons and improvement Module shall prepare a source-bound improvement proposal with accountable destination ownership and observable criteria, and preserve its exact association to separately governed disposition and adopted scope.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A prepared proposal or finished route can be mistaken for an adopted improvement.\",\n      \"desired_outcome\": \"Prepare owner-bound improvements without implying adoption.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-037 requires this accountable MOD-009 contribution; source meaning, adoption and evidence authority must remain distinct.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering participants and reviewers\",\n        \"Lesson and improvement owners\",\n        \"Project decision owners and assurance assessors\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During supported finding analysis, work preparation, proposal disposition or opportunity-based effect assessment as applicable; reconsider when the material basis changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-009 contribution to MOD-017 IF-017 consumed by MOD-012; existing controlled-change, assurance and selected retention boundaries.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply improvement.md to exact participant-supplied context and observations, preserve missing/contrary support, and confirm authority, adopted effects and retention through their existing owners.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Complete allocated contribution to SR-037 within the declared finite project/activity/observation scope; no automatic causal discovery, policy adoption or universal effectiveness claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Before adoption identify lesson/mechanism, applicable situations, exact affected authoritative subjects, owner, intended behavior and independently observable success/adverse-effect criteria.\",\n    \"Expose missing support, owner, subject or criterion as an incomplete proposal rather than readiness for adoption.\",\n    \"Carry the exact proposal to the authorized change owner through existing authority/transition cooperation; preserve revision/rejection decisions and original findings without executing adoption through preparation.\",\n    \"Relate any adopted claim to the exact proposal, governing decision, affected state/baseline and required owner-produced result; route settlement or scheduled follow-up alone establishes neither adoption nor effectiveness.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Existing Learn contributor confirmation and topic/route custody remain applicable to their actual operations; Design approval does not execute them.\"\n  ],\n  \"allocated_to\": \"MOD-009\",\n  \"constrains\": [\n    \"FUNC-037\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LESSON-IMPROVEMENT-DESIGN\",\n      \"locator\": \"IR-007; SR-035–038; SCN-035–039\",\n      \"basis\": \"Refine supported lesson characterization, bounded contextual use, accountable proposals and opportunity-based effect assessment through MOD-009 and parent IF-017. Preserve existing Learn confirmation/custody/route boundaries and separate controlled adoption, assurance and retention. Proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:f0ad6bd5c8ba479eeacf98501e0932dada28061109957c814f9c9e95dc0c90fa","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-037-prepare-accountable-improvements-for-controlled-adoption/AR-084-prepare-owner-bound-improvements-without-implying-adoption.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-084","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-084 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:4040eff5bf024090b9b5a19df8f123e957f836f4ac23459f9ac7238f8f6d0b2e","path":"design/system/functions/FUNC-037-formulate-an-accountable-engineering-improvement-proposal.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:8f46aba0702296137e78cc1c876ed5fc3e89b59ab6bdce2dbc72312fb183cf8d","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-037-prepare-accountable-improvements-for-controlled-adoption/sr.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Actual triggering observations are bound to the adopted version and prepared criteria; inability or failure to perform remains visible without invented correction success.","number":1,"state":"covered"},{"explanation":"The next known comparable activity is justified from scoped context/order; all required recurrence, intended effect and adverse observations remain explicit, including earlier comparable failures.","number":2,"state":"covered"},{"explanation":"No opportunity and missing observations at an occurred opportunity are different gaps; neither permits effectiveness from adoption or reproduction alone.","number":3,"state":"covered"},{"explanation":"Domain comparisons carry actual adverse, mixed and incomplete observations to IF-010/014 assurance with bounded claims; no time/sample threshold or universal prevention is introduced.","number":4,"state":"covered"},{"explanation":"Material changes and recurrence identify affected current reliance and fresh assessment needs while retaining original context-bound observations and conclusions.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-085\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Compare improvement effects at identified opportunities\",\n  \"status\": \"draft\",\n  \"statement\": \"The Lessons and improvement Module shall prepare context-bound comparisons of an adopted improvement's actual triggering and later comparable observations, preserving adverse or missing support and explicit reassessment without claiming effectiveness from adoption or elapsed time.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Adoption, reproduction success or elapsed time can be mistaken for effectiveness without comparable observations.\",\n      \"desired_outcome\": \"Compare improvement effects at identified opportunities.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-038 requires this accountable MOD-009 contribution; source meaning, adoption and evidence authority must remain distinct.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineering participants and reviewers\",\n        \"Lesson and improvement owners\",\n        \"Project decision owners and assurance assessors\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During supported finding analysis, work preparation, proposal disposition or opportunity-based effect assessment as applicable; reconsider when the material basis changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-009 contribution to MOD-017 IF-017 consumed by MOD-012; existing controlled-change, assurance and selected retention boundaries.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply improvement.md to exact participant-supplied context and observations, preserve missing/contrary support, and confirm authority, adopted effects and retention through their existing owners.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Complete allocated contribution to SR-038 within the declared finite project/activity/observation scope; no automatic causal discovery, policy adoption or universal effectiveness claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Bind actual reproducible triggering results to the adopted version and criteria; nonreproducibility or an unperformed attempt cannot be reported as a correction result.\",\n    \"Identify the next comparable known activity after adoption with context/order/acquisition limits and compare recurrence, intended behavior and adverse effects against prepared criteria; do not hide an earlier comparable failure.\",\n    \"Distinguish no comparable opportunity from missing observations at one that occurred; both leave dependent effectiveness unassessed regardless of adoption or reproduction success.\",\n    \"Carry actual contrary, mixed and incomplete observations to separate assurance preparation with bounded conclusions; no universal duration, sample threshold or recurrence-prevention guarantee is implied.\",\n    \"On recurrence or material context/version/criterion change, explain affected current reliance and required reassessment while preserving original observations and their earlier bounded meaning.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Existing Learn contributor confirmation and topic/route custody remain applicable to their actual operations; Design approval does not execute them.\"\n  ],\n  \"allocated_to\": \"MOD-009\",\n  \"constrains\": [\n    \"FUNC-038\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LESSON-IMPROVEMENT-DESIGN\",\n      \"locator\": \"IR-007; SR-035–038; SCN-035–039\",\n      \"basis\": \"Refine supported lesson characterization, bounded contextual use, accountable proposals and opportunity-based effect assessment through MOD-009 and parent IF-017. Preserve existing Learn confirmation/custody/route boundaries and separate controlled adoption, assurance and retention. Proposed Design only.\"\n    }\n  ]\n}\n","identity":"sha256:2e2e63a4435c76e75a35b0c6c60de50050f859c736b817c1a361f6a3de42e4c7","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-038-assess-improvement-effects-at-comparable-opportunities/AR-085-compare-improvement-effects-at-identified-opportunities.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-085","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical AR-085 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:0cddbc39afd8e0e53e405042586d32c7d2870815b52b5361ef5a273a41683ded","path":"design/system/functions/FUNC-038-assess-observed-effects-of-an-adopted-engineering-improvement.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:7027c6f3b9bdb62edeed73dc99c5c68a4eb4f292ae91aa999b32d647ed81e142","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-038-assess-improvement-effects-at-comparable-opportunities/sr.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Storage-owned typed association rows bind project-qualified stable keys to exact original record occurrences and provenance. Literal filters avoid path/name/prose inference and distinguish finding-specific association from a multi-subject parent Review.","number":1,"state":"covered"},{"explanation":"Authoritative coverage metadata and coherent selected facts retain missing/unreadable/unsupported/unmapped/compacted distinctions. Exhaustion establishes only the end of selected available units, not unconditional completeness of retained or all-time history.","number":2,"state":"covered"},{"explanation":"One qualified read-only SQLite snapshot supplies state, coverage, associations and facts under maintenance access rules. Recovery-needed, uninitialized or unsupported conditions cannot be repaired by lookup; unavailable/busy preserves the no-write boundary.","number":3,"state":"covered"},{"explanation":"MOD-011 alone authenticates the opaque cursor and compares its project/activation/generation/normalized selector/order/page-bound state before emitting units. Unique bytewise tuple ordering and strict resume-after produce deterministic same-state pages; mismatches reject without partial conflicting results.","number":4,"state":"covered"},{"explanation":"Every target-profile record/association/coverage mutation atomically advances checked generation; incompatible writers are fenced. Authorized activation/restore/transfer/replacement supplies a fresh activation/key, so restored old bytes and change-and-revert cannot revive old cursors.","number":5,"state":"covered"},{"explanation":"Selective retention and original assessment meaning remain intact. Missing stable-key mappings are visible rather than backfilled; complete writer/profile/read-only/maintenance qualification and authorized migration are prerequisites for future availability, not lookup effects.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-086\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve attributable state-bound subject history\",\n  \"status\": \"draft\",\n  \"statement\": \"The Work record storage Module shall select bounded retained records using explicit project-qualified subject associations and one coherent history state, preserving original provenance, coverage limitations and safe continuation without operational mutation.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Cross-Change selection can lose identity, hide missing retained scope or mix states across pages.\",\n      \"desired_outcome\": \"Preserve attributable state-bound subject history.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-078 requires this distinct accountable contribution; reuse current record, admission and authority ownership while qualifying new history semantics separately.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers inspecting recorded work\",\n        \"Engineering agents and operational record maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When an explicitly selected subject-history lookup or continuation is requested; state metadata also constrains the cooperating target-profile writers.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-018 composition through IF-004 and IF-003; local associated project records under history-selection.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit recorded identity, coherent read state, literal filters and bounded complete outcomes under the owning history contract.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Finite retained project scope; no exhaustive past, automatic migration, distributed history or implementation/adoption claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Use explicit recorded subject associations and literal record filters; preserve originating Change, record and original subject bases across revisions and renames without inferring identity or finding relevance from paths, names or prose.\",\n    \"Distinguish available complete no-match from absent, incompatible, unreadable, unmapped or partially retained scope; page exhaustion cannot erase retention or association gaps.\",\n    \"Read state, associations, coverage and facts from one read-only transaction under the qualified access/fence contract; lookup cannot initialize storage, perform recovery/migration, repair associations or change engineering records.\",\n    \"Bind authenticated continuation to project, activation/generation, normalized selection/order/page bound and unique last tuple; same-state pages are deterministic, while changed or altered continuation returns no page units and requires fresh selection.\",\n    \"Advance history generation atomically with every target-profile record/association/coverage mutation, fence incompatible writers and rotate activation/key on replacement or restoration so change-and-revert and restored old bytes cannot revive an earlier cursor.\",\n    \"Preserve selective retention and old subject meanings; explicit association/profile migration and writer qualification are prerequisites rather than hidden lookup effects.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Historical judgments do not establish current applicability or authority. Existing v2/v4 contracts remain independently versioned and unchanged by this target Design.\"\n  ],\n  \"allocated_to\": \"MOD-011\",\n  \"constrains\": [\n    \"FUNC-077\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-SUBJECT-HISTORY-DESIGN\",\n      \"locator\": \"SR-078; FUNC-077; SCN-074\",\n      \"basis\": \"Define recorded subject association, coherent bounded history selection and state-bound continuation through existing command/storage owners. Target Design only; current ordinary queries, schema and installed capability remain unchanged.\"\n    }\n  ]\n}\n","identity":"sha256:637e3b1e7891ec3e759f1965e5f422eb0e4df907f5897397447dcd396242c166","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/AR-086-preserve-attributable-state-bound-subject-history.json"},"limitations":["Target Design only; no public command, schema/profile adoption, migration, executed query, implementation or verification is established. Existing v2/v4 ordinary queries remain unchanged.","Complete compatible writer/maintenance population, protected activation metadata and actually nonmutating read acquisition must be qualified before history capability advertisement.","Results expose explicit retained facts/associations and coverage limits; no exhaustive past, inferred identity/relevance, current approval, recovery of discarded data or runtime performance guarantee."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-086","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical AR-086 criteria; separately proposed history Design.","state":"covered","subjects":[{"identity":"sha256:0f369ea622bb533f2d51e26efe1a11881d3671646f6e6be2b662af4c4afca819","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/history-selection.md"},{"identity":"sha256:57c186ae6288364f5f914b5d99615417207e404ac76bd9388515ee2bc85e10ca","path":"design/system/functions/FUNC-077-select-attributable-history-for-an-engineering-subject.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:7ebd9cd8729128c41367446a55b653064b9ccde5fa8cb917b61e96dad53b2190","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/sr.json"}],"summary":"Design Covered; runtime history capability remains unqualified."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-010 checks supported proposed operation, syntax, explicit scope, known filter vocabulary/combinations and finite encoded bounds before dispatch. Opaque cursor authentication and bound state/selection comparison remain MOD-011 checks before results, preserving key/state ownership.","number":1,"state":"covered"},{"explanation":"The exact normalized project, subject, declared finite Change scope, literal filters and page request cross existing IF-004/003. Command dispatch introduces neither prose relevance nor approval/applicability inference and does not extend ordinary no-cursor operations.","number":2,"state":"covered"},{"explanation":"The public projection preserves original Change/record/subject provenance, captured state, coverage gaps, exhaustion and continuation. Invalid, conflict, busy, unavailable, incomplete and too-large cannot become empty complete history.","number":3,"state":"covered"},{"explanation":"The shared pure encoder reserves mandatory state/limitations/cursor inside the proposed 1 MiB response. Pages stop only between whole units; an oversized unit/mandatory outcome is rejected without cursor advance or truncation. Complete output is serialized before stdout, and response failure causes no record mutation.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"AR-087\",\n  \"type\": \"allocated-requirement\",\n  \"title\": \"Preserve explicit history query scope and outcomes\",\n  \"status\": \"draft\",\n  \"statement\": \"The Command handling Module shall admit the separately qualified history query with explicit subject, retained scope, literal filters and bounded continuation, and present exact storage outcomes without semantic inference, truncation or effects.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Cross-Change selection can lose identity, hide missing retained scope or mix states across pages.\",\n      \"desired_outcome\": \"Preserve explicit history query scope and outcomes.\"\n    },\n    \"why\": {\n      \"rationale\": \"SR-078 requires this distinct accountable contribution; reuse current record, admission and authority ownership while qualifying new history semantics separately.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers inspecting recorded work\",\n        \"Engineering agents and operational record maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When an explicitly selected subject-history lookup or continuation is requested; state metadata also constrains the cooperating target-profile writers.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"MOD-018 composition through IF-004 and IF-003; local associated project records under history-selection.md.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit recorded identity, coherent read state, literal filters and bounded complete outcomes under the owning history contract.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Finite retained project scope; no exhaustive past, automatic migration, distributed history or implementation/adoption claim.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Reject unsupported profile, unknown request fields/filter values, invalid bounds and contradictions visible in explicit request fields before dispatch; pass bounded opaque continuation to MOD-011 for authentication and bound-selection/state checks before page results, without adding cursor behavior to existing ordinary queries.\",\n    \"Pass the exact normalized subject, finite Change scope and literal recorded-fact filters to IF-003; no prose-based relevance or authority/applicability inference is introduced.\",\n    \"Present original Change/record/subject provenance, history state, exclusions, completeness and continuation faithfully; no-match remains distinct from unavailable, incomplete, conflict, busy and oversized outcomes.\",\n    \"Form complete encoded output within the public byte bound before emission; never truncate a unit or advance a cursor over an unreturned item, and preserve no-write outcomes on output failure.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Historical judgments do not establish current applicability or authority. Existing v2/v4 contracts remain independently versioned and unchanged by this target Design.\"\n  ],\n  \"allocated_to\": \"MOD-010\",\n  \"constrains\": [\n    \"FUNC-077\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-SUBJECT-HISTORY-DESIGN\",\n      \"locator\": \"SR-078; FUNC-077; SCN-074\",\n      \"basis\": \"Define recorded subject association, coherent bounded history selection and state-bound continuation through existing command/storage owners. Target Design only; current ordinary queries, schema and installed capability remain unchanged.\"\n    }\n  ]\n}\n","identity":"sha256:7ce9338f55f45e6f0f8a349c703a76ea441fc53079478acb810039f985def4f3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/AR-087-preserve-explicit-history-query-scope-and-outcomes.json"},"limitations":["Target Design only; no public command, schema/profile adoption, migration, executed query, implementation or verification is established. Existing v2/v4 ordinary queries remain unchanged.","Complete compatible writer/maintenance population, protected activation metadata and actually nonmutating read acquisition must be qualified before history capability advertisement.","Results expose explicit retained facts/associations and coverage limits; no exhaustive past, inferred identity/relevance, current approval, recovery of discarded data or runtime performance guarantee."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"AR-087","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical AR-087 criteria; separately proposed history Design.","state":"covered","subjects":[{"identity":"sha256:0f369ea622bb533f2d51e26efe1a11881d3671646f6e6be2b662af4c4afca819","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/history-selection.md"},{"identity":"sha256:57c186ae6288364f5f914b5d99615417207e404ac76bd9388515ee2bc85e10ca","path":"design/system/functions/FUNC-077-select-attributable-history-for-an-engineering-subject.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:7ebd9cd8729128c41367446a55b653064b9ccde5fa8cb917b61e96dad53b2190","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/sr.json"}],"summary":"Design Covered; runtime history capability remains unqualified."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Confirmed filesystem custody, fresh-session acquisition and complete identity resolution compose a usable later read of exact saved content. The same actor is not required; unconfirmed saves and inaccessible state remain honest limits.","number":1,"state":"covered"},{"explanation":"Complete candidate checking and same-ID revision preserve designation across full subtree moves and content changes while separating semantic reparenting, collisions, changed state and renewed approval.","number":2,"state":"covered"},{"explanation":"One captured state supplies authored type-specific meaning and required references to MOD-004 presentation. Neither Change replay nor original conversation supplies missing current content; optional history is separate.","number":3,"state":"covered"},{"explanation":"Owning-model rationale retains five recorded fields and resolvable exact-content/profile association. Explicit actor reassessment after changes preserves truthful current applicability rather than copying historical approval.","number":4,"state":"covered"},{"explanation":"Independent definition, required-context, rationale and optional-history outcomes let later readers see both available knowledge and precise remaining gaps. Diagnostic success is distinct from complete content and from satisfaction.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-001\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Preserve engineering knowledge across sessions\",\n  \"status\": \"draft\",\n  \"statement\": \"Engineers, reviewers, and engineering agents need current engineering knowledge and its still-applicable reasoning to remain available and understandable beyond the conversations, tools, and authoring sessions that produced it.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Engineering context can disappear when definitions and decision reasoning depend on conversations, private memory, or an individual authoring session.\",\n      \"desired_outcome\": \"Later participants can understand the current engineering model and its applicable reasoning without access to the original authoring session.\"\n    },\n    \"why\": {\n      \"rationale\": \"People must be able to resume engineering work and understand the current system without relying on the memory or private context of the original author.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and architects\",\n        \"Reviewers and maintainers\",\n        \"Engineering agents acting for project participants\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Applies throughout requirements analysis, design, implementation, verification, and maintenance within the project's governed engineering scope.\",\n        \"In the initial authoring profile, retain current definitions, still-applicable reasoning, and unresolved work for as long as current engineering reliance needs them. Retirement follows IR-003's preservation policy rather than a fixed age-based expiry.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within the project's governed engineering information, as it is authored and relied on across sessions.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Retain current definitions and decision reasoning under stable identities; derive system obligations beneath this IR and use Scenario Analysis to establish the capabilities and concrete situations supported by the need. In the initial authoring profile, retrieval identifies the selected subject and state and returns the recorded content or an explicit unavailable, unsupported, incomplete, or failed outcome. A partial result must not be represented as a complete definition.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers retained current definitions, stable entity identity, and reasoning needed to understand current engineering decisions. Historical reconstruction belongs to IR-003; relationship analysis belongs to IR-002; judgments of satisfaction belong to IR-004. Coverage is the governed engineering scope. Qualitative durability does not imply unlimited retention, crash recovery, or a numerical service target. The initial authoring profile makes no elapsed-time commitment for retrieval; its acceptance concerns correct retained content, identifiable scope, and accurate failure or completeness reporting.\",\n      \"scale\": \"The initial authoring profile covers one selected finite governed project model at a time. It defines no fixed entity-count maximum, large-model capacity guarantee, or federated model service. An operation may claim completeness only for the declared scope it actually processed; resource limits and partial results must be explicit.\"\n    }\n  },\n  \"assumptions\": [\n    \"The project's governed storage and the configuration history selected for retention remain accessible; this authoring profile does not supply a storage-hosting or backup service.\"\n  ],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 3, 5, 30, 31, and 35\",\n      \"basis\": \"Initial needs, durable assets, stable identity, and understandable current state.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Pitch; Resumable across sessions and agents; What it commits to\",\n      \"basis\": \"Durable project artifacts and current understanding independent of conversation history.\"\n    },\n    {\n      \"source\": \"SRC-REM-REFINEMENT\",\n      \"locator\": \"Requirement Analysis: Analyze the initial need; Name the initial requirement\",\n      \"basis\": \"Required 5W2H analysis and a clearer IR name, preserving the existing identity and need statement.\"\n    },\n    {\n      \"source\": \"SRC-CONSTITUTION\",\n      \"locator\": \"Repository cleanup and historical retention\",\n      \"basis\": \"Current reliance and unresolved work remain available; retirement requires recoverability and reconciliation rather than a fixed expiry.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"IR-001\",\n      \"basis\": \"Resolution of the recorded questions for the initial RigorLoop authoring profile under the user's instruction to solve them; the source register preserves the original questions and rationale.\"\n    },\n    {\n      \"source\": \"SRC-IR-001-SCENARIO-ANALYSIS\",\n      \"locator\": \"IR-001\",\n      \"basis\": \"Apply the renewed REM Scenario Analysis method to the existing IR-001 need; preserve requirement identities and reconcile scenario outcomes with obligations and logical behavior. Confirmation records draft analysis, not approval, implementation, or satisfaction.\"\n    },\n    {\n      \"source\": \"SRC-SCENARIO-MODEL-REFINEMENT\",\n      \"locator\": \"IR-001\",\n      \"basis\": \"Apply the refined governed Scenario model to this IR. Preserve the four original stakeholder situations and make their embedded author-save and author-record-rationale goals explicit as two additional owned Scenarios; preserve the existing need and SR decomposition.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"IR-001\",\n      \"basis\": \"Review the existing five SRs, six Scenarios, two Features, and seven Functions against the declared need and adjacent IRs. No additional obligation is needed for this scope; selected-state interpretation is reconciled through SR-012 without changing the need.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-001\",\n    \"FEAT-002\",\n    \"SCN-001\",\n    \"SCN-002\",\n    \"SCN-003\",\n    \"SCN-004\",\n    \"SCN-005\",\n    \"SCN-006\"\n  ]\n}\n","identity":"sha256:7f71cdb4fe655b04090d71e55746b366c417b1a342c16f35b780640c5c8c0920","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/ir.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Model-write adapters/filesystem behavior remain unqualified. Control writers or withhold coherence; no advisory control of arbitrary editors.","Exact-content/profile rationale association is actor-supplied, not certification; unsupported/missing input stays a gap. IR-003 owns history/recovery/retirement/authority.","Five directly assessed outcomes are not canonical criteria. Accessible storage is assumed; no hosting, disaster recovery, unlimited retention or capacity guarantee."],"outcome_basis":{"identity":"sha256:f027d22c0e27f2640eb8adc0c6b10f69269ca8d8e4b3af8156c4282ea4e2fd58","outcomes":[{"number":1,"sources":[{"identity":"sha256:7f71cdb4fe655b04090d71e55746b366c417b1a342c16f35b780640c5c8c0920","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/ir.json"},{"identity":"sha256:c3ec5eb0db9f8580e4b7a7c765cecad41288f8218fa88efe0c8b494ea9f87886","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/sr.json"},{"identity":"sha256:36c7c4bfe79272c50c73d43ba74ca8d3e2895538ea6034d5877df3bb5e23a8e2","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/sr.json"},{"identity":"sha256:2a7574215dbe536594912f7e7b9cf862841180721db9445f896e2b35e22177e4","path":"design/system/features/FEAT-001-inspect-engineering-definitions-and-their-rationale.json"},{"identity":"sha256:7451c79fae7acf9d7eb775744cd2215f969425d6e8d3db7b381c00e533fe7398","path":"design/system/features/FEAT-002-author-and-revise-engineering-definitions.json"},{"identity":"sha256:9eff1a8a23d6b40076b52749918a984f74c673e6a452dcb9cd4f365907a8266a","path":"design/requirements/scenarios/SCN-001-retrieve-a-saved-definition-in-a-later-session.json"},{"identity":"sha256:654a2d3d9f86b5f62ae6bad42dcf66fb49ac228c61f84827498963f187121bac","path":"design/requirements/scenarios/SCN-005-save-an-engineering-definition-for-later-sessions.json"}],"text":"Later participants can retrieve explicitly saved engineering knowledge without its originating conversation or authoring process."},{"number":2,"sources":[{"identity":"sha256:7f71cdb4fe655b04090d71e55746b366c417b1a342c16f35b780640c5c8c0920","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/ir.json"},{"identity":"sha256:36c7c4bfe79272c50c73d43ba74ca8d3e2895538ea6034d5877df3bb5e23a8e2","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/sr.json"},{"identity":"sha256:53517029dd4cc9c16636aeaf081f33ee8ef719b4c1f1032241bc0b77677585b8","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/sr.json"},{"identity":"sha256:7451c79fae7acf9d7eb775744cd2215f969425d6e8d3db7b381c00e533fe7398","path":"design/system/features/FEAT-002-author-and-revise-engineering-definitions.json"},{"identity":"sha256:a035eb8cfca2d6ad1279c86f56f3c4e2eb4ea2662e0f70174671109dcd8ad357","path":"design/requirements/scenarios/SCN-002-evolve-an-entity-while-retaining-its-identity.json"}],"text":"Existing references continue to designate the same engineering subject through supported name, location and definition evolution."},{"number":3,"sources":[{"identity":"sha256:7f71cdb4fe655b04090d71e55746b366c417b1a342c16f35b780640c5c8c0920","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/ir.json"},{"identity":"sha256:c3ec5eb0db9f8580e4b7a7c765cecad41288f8218fa88efe0c8b494ea9f87886","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/sr.json"},{"identity":"sha256:4cbc2de2e82a9529fe5ae3d608e6de5b1f4817f7e8225a44b77e23550b4a1d21","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/sr.json"},{"identity":"sha256:2a7574215dbe536594912f7e7b9cf862841180721db9445f896e2b35e22177e4","path":"design/system/features/FEAT-001-inspect-engineering-definitions-and-their-rationale.json"},{"identity":"sha256:9eff1a8a23d6b40076b52749918a984f74c673e6a452dcb9cd4f365907a8266a","path":"design/requirements/scenarios/SCN-001-retrieve-a-saved-definition-in-a-later-session.json"},{"identity":"sha256:3f45bfe1f1ee35005e686dff170bc57d5c3aafe5d975403df585b3272a046b3b","path":"design/requirements/scenarios/SCN-003-understand-the-current-definition-and-applicable-decision-rationale.json"}],"text":"A reader can understand the current engineering meaning directly from current definitions and authoritative context."},{"number":4,"sources":[{"identity":"sha256:7f71cdb4fe655b04090d71e55746b366c417b1a342c16f35b780640c5c8c0920","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/ir.json"},{"identity":"sha256:3b9163779c9558555f98297806e733ca2ed71637a3ae56f54c234990b3114a23","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-005-retain-applicable-decision-rationale/sr.json"},{"identity":"sha256:2a7574215dbe536594912f7e7b9cf862841180721db9445f896e2b35e22177e4","path":"design/system/features/FEAT-001-inspect-engineering-definitions-and-their-rationale.json"},{"identity":"sha256:7451c79fae7acf9d7eb775744cd2215f969425d6e8d3db7b381c00e533fe7398","path":"design/system/features/FEAT-002-author-and-revise-engineering-definitions.json"},{"identity":"sha256:3f45bfe1f1ee35005e686dff170bc57d5c3aafe5d975403df585b3272a046b3b","path":"design/requirements/scenarios/SCN-003-understand-the-current-definition-and-applicable-decision-rationale.json"},{"identity":"sha256:5a356b2761dc1b5b7d72661ecfb4fbe902b0d68e785e00661c67ad44397b4bcc","path":"design/requirements/scenarios/SCN-006-record-decision-rationale-for-a-current-engineering-definition.json"}],"text":"Still-applicable recorded reasoning remains accessible from current definitions even when originating Change explanations leave current working material."},{"number":5,"sources":[{"identity":"sha256:7f71cdb4fe655b04090d71e55746b366c417b1a342c16f35b780640c5c8c0920","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/ir.json"},{"identity":"sha256:c3ec5eb0db9f8580e4b7a7c765cecad41288f8218fa88efe0c8b494ea9f87886","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/sr.json"},{"identity":"sha256:4cbc2de2e82a9529fe5ae3d608e6de5b1f4817f7e8225a44b77e23550b4a1d21","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/sr.json"},{"identity":"sha256:3b9163779c9558555f98297806e733ca2ed71637a3ae56f54c234990b3114a23","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-005-retain-applicable-decision-rationale/sr.json"},{"identity":"sha256:2a7574215dbe536594912f7e7b9cf862841180721db9445f896e2b35e22177e4","path":"design/system/features/FEAT-001-inspect-engineering-definitions-and-their-rationale.json"},{"identity":"sha256:2cdf241482255eb36c723771a24589d3f8f274ab481b670457461ed7a1b12eac","path":"design/requirements/scenarios/SCN-004-recognize-unavailable-or-incomplete-engineering-knowledge.json"}],"text":"Readers can distinguish complete known knowledge from unavailable, unsupported, incomplete, failed or unresolved definition and reasoning scope."}],"sr_children":["SR-001","SR-002","SR-003","SR-004","SR-005"],"support":[{"identity":"sha256:689062b6d6670e8b2a71c1231b4082b1fc7af2010edeb169a88811266302375e","requirement":"SR-001"},{"identity":"sha256:b03b80b46521cf50e2828f9954b64b8b3d700353f4cf321a17fbd49022e7ec3a","requirement":"SR-002"},{"identity":"sha256:a4d7acdd0038fd7c500e179fa7fd87f506d398a9c24f92dab70a746dbff787d7","requirement":"SR-003"},{"identity":"sha256:25360c1800e61de5f7ff073ece183d9b1fd5687e275eb97539c42d31e10c456e","requirement":"SR-004"},{"identity":"sha256:a4ac1b29b1e0e6efa810a6a64b1df04ca0fc0ee1bcb90c4698099a65920fd7d1","requirement":"SR-005"}]},"reported_at":"2026-10-06T12:12:35Z","requirement":"IR-001","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"Five direct stakeholder outcomes across all five SRs; independent of child-count rollup.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:7f71cdb4fe655b04090d71e55746b366c417b1a342c16f35b780640c5c8c0920","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/ir.json"},{"identity":"sha256:c3ec5eb0db9f8580e4b7a7c765cecad41288f8218fa88efe0c8b494ea9f87886","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/sr.json"},{"identity":"sha256:36c7c4bfe79272c50c73d43ba74ca8d3e2895538ea6034d5877df3bb5e23a8e2","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/sr.json"},{"identity":"sha256:53517029dd4cc9c16636aeaf081f33ee8ef719b4c1f1032241bc0b77677585b8","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/sr.json"},{"identity":"sha256:4cbc2de2e82a9529fe5ae3d608e6de5b1f4817f7e8225a44b77e23550b4a1d21","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/sr.json"},{"identity":"sha256:3b9163779c9558555f98297806e733ca2ed71637a3ae56f54c234990b3114a23","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-005-retain-applicable-decision-rationale/sr.json"},{"identity":"sha256:2a7574215dbe536594912f7e7b9cf862841180721db9445f896e2b35e22177e4","path":"design/system/features/FEAT-001-inspect-engineering-definitions-and-their-rationale.json"},{"identity":"sha256:7451c79fae7acf9d7eb775744cd2215f969425d6e8d3db7b381c00e533fe7398","path":"design/system/features/FEAT-002-author-and-revise-engineering-definitions.json"},{"identity":"sha256:9eff1a8a23d6b40076b52749918a984f74c673e6a452dcb9cd4f365907a8266a","path":"design/requirements/scenarios/SCN-001-retrieve-a-saved-definition-in-a-later-session.json"},{"identity":"sha256:a035eb8cfca2d6ad1279c86f56f3c4e2eb4ea2662e0f70174671109dcd8ad357","path":"design/requirements/scenarios/SCN-002-evolve-an-entity-while-retaining-its-identity.json"},{"identity":"sha256:3f45bfe1f1ee35005e686dff170bc57d5c3aafe5d975403df585b3272a046b3b","path":"design/requirements/scenarios/SCN-003-understand-the-current-definition-and-applicable-decision-rationale.json"},{"identity":"sha256:2cdf241482255eb36c723771a24589d3f8f274ab481b670457461ed7a1b12eac","path":"design/requirements/scenarios/SCN-004-recognize-unavailable-or-incomplete-engineering-knowledge.json"},{"identity":"sha256:654a2d3d9f86b5f62ae6bad42dcf66fb49ac228c61f84827498963f187121bac","path":"design/requirements/scenarios/SCN-005-save-an-engineering-definition-for-later-sessions.json"},{"identity":"sha256:5a356b2761dc1b5b7d72661ecfb4fbe902b0d68e785e00661c67ad44397b4bcc","path":"design/requirements/scenarios/SCN-006-record-decision-rationale-for-a-current-engineering-definition.json"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The IR need and SCN007 require trustworthy authored relationship understanding. Reviewed SR008/AR057–059 design provides direct participant admission, final-candidate checking, exact retention outcomes and consistent state-bound endpoint derivation. That composed design addresses this stakeholder outcome, with runtime realization still separate.","number":1,"state":"covered"},{"explanation":"The IR’s selected-scope navigation and SCN008 are addressed by SR009/AR056/IF013: complete coherent input, forward/incoming facts, finite witness paths, multi-source cycle termination and explicit complete/bounded/incomplete outcomes. This independently explains usable responsibility-path reading rather than inheriting a count.","number":2,"state":"covered"},{"explanation":"The IR need and SCN009 require attributable responsibility analysis rather than mere navigable links. MOD-004/FUNC010/AR060 now compose exact rule and lifecycle authority, both allocation paths, complete incoming scope, valid deferrals, mechanical violations and unresolved review/incomplete outcomes. The logical participant result and pure-engine responsibility make that stakeholder outcome architecturally complete while retaining engineering adequacy judgment.","number":3,"state":"covered"},{"explanation":"The IR need and SCN010 require an explainable investigation of proposed-change effects. MOD-004/FUNC011/AR061 now bind changed subjects and influence scope to one combined selected-state graph, finite witnesses and trustworthy traversal provenance; seed-only, bounded, incomplete and mismatched cases retain their limits. Potential impact never asserts actual consequence or evidence invalidation. This explicitly closes the missing impact composition rather than inheriting traversal coverage.","number":4,"state":"covered"},{"explanation":"The linked FEAT022 and SCN083–086 require independent customer model views, source qualification, copied reading and truthful failed generation. The current SR084/085/086/087 browser design composes capture/interpretation, qualified reusable views, complete static resources and guarded publication/recovery across named owners. Design coverage is supported at that full stakeholder scope; it does not qualify the current prototype or customer package.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-002\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Trace engineering obligations and responsibilities\",\n  \"status\": \"draft\",\n  \"statement\": \"Engineers, architects, and reviewers need to trace how initial needs relate to system obligations, capabilities, logical behavior, architectural responsibilities, realization, and assurance so they can assess consistency and the effects of proposed changes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Obligations, capabilities, behavior, architecture, and assurance can become disconnected, leaving their relationships and affected responsibilities unclear.\",\n      \"desired_outcome\": \"Participants can follow the engineering relationships needed to identify responsibility, assess consistency, and investigate the effects of a proposed change.\"\n    },\n    \"why\": {\n      \"rationale\": \"Disconnected engineering information makes it difficult to discover affected responsibilities, missing allocations, and unsupported conclusions.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and architects\",\n        \"Reviewers\",\n        \"Maintainers and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Applies when developing the model, reviewing its consistency, investigating a problem, or assessing the impact of a proposed change.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Across requirement parentage and cross-domain engineering relationships within the governed model.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit typed relationships with single-parent requirement containment and graph references across domains. Derive inverse views from the authored facts. SR derivation must distinguish relationship integrity, navigation, allocation consistency, and impact assessment. For the initial authoring profile, a traversal selects its starting entities, relationship types, direction, and model state. Required views include requirement ancestors and descendants, forward and reverse responsibility paths, and affected entities reached through the declared relationship scope. Cycles terminate without repeatedly processing the same traversal state. Requested depth or result limits are explicit, and any resource limit, missing reference, interruption, or truncation prevents an unqualified completeness claim. Customer architecture views project this selected-state information into five attributable perspectives and a portable read-only snapshot; canonical relationships remain authored once.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers meaningful requirement parentage and typed cross-domain relationships, including forward and reverse understanding. It does not make relationship presence evidence of requirement satisfaction or prescribe a graph database or user interface. The relationship families are described by REM; this initial need does not establish a quantitative performance target. Traversal is confined to the selected project model and baseline; cross-project and cross-baseline continuation are excluded from this initial profile. There is no implicit depth or result-count cutoff and no elapsed-time service target. Full reachability within the requested scope and explicitly limited exploration are distinguishable results. The customer browser adds explicit generation and offline-reading obligations derived under this need; no particular renderer or hosted service is imposed.\",\n      \"scale\": \"Use the single-project model scope and capacity policy defined by IR-001 analysis.how_much.scale; this requirement adds no separately maintained model-size target.\"\n    }\n  },\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 8, 17, 28, 29, 30, and 34\",\n      \"basis\": \"Strict requirement parentage, converging allocations, and typed graph traceability.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"What makes this different; Traceable from idea to verified change\",\n      \"basis\": \"Inspectable traceability from intent through realization and proof.\"\n    },\n    {\n      \"source\": \"SRC-SYSTEM\",\n      \"locator\": \"SYS-SR-03\",\n      \"basis\": \"Related existing traceability obligation; its full contract has not been migrated.\"\n    },\n    {\n      \"source\": \"SRC-REM-REFINEMENT\",\n      \"locator\": \"Requirement Analysis: Analyze the initial need; Name the initial requirement\",\n      \"basis\": \"Required 5W2H analysis and a clearer IR name, preserving the existing identity and need statement.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"IR-002\",\n      \"basis\": \"Resolution of the recorded questions for the initial RigorLoop authoring profile under the user's instruction to solve them; the source register preserves the original questions and rationale.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"IR-002\",\n      \"basis\": \"Complete this existing IR through governed black-box Scenarios, independently assessable SR obligations, and bounded shared Features and Functions. Preserve the need statement and selected scope; all records remain draft, with architectural allocation and implementation assessment deferred.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"IR-002\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-003\",\n    \"SCN-007\",\n    \"SCN-008\",\n    \"SCN-009\",\n    \"SCN-010\",\n    \"FEAT-022\",\n    \"SCN-083\",\n    \"SCN-084\",\n    \"SCN-085\",\n    \"SCN-086\"\n  ]\n}\n","identity":"sha256:0f980f9704b8d15537eb8254db2ee7a73bc77843930bb5c4b32e72a9640d60fc","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/ir.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Five outcomes interpret the IR, Features and Scenarios, not canonical criteria. Runtime adapters/customer qualification remain unassessed. Exact child accounts/material subjects require reassessment when missing, changed or stale."],"outcome_basis":{"identity":"sha256:3a8888606f8a94d39711f9b5c0d592dc91c125a842fa44d91e9e1e1c7a304442","outcomes":[{"number":1,"sources":[{"identity":"sha256:0f980f9704b8d15537eb8254db2ee7a73bc77843930bb5c4b32e72a9640d60fc","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/ir.json"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:eccf9da9452b46542f3f33d329f5124f982ca6f481bb28f07bb247b7269fed2b","path":"design/requirements/scenarios/SCN-007-apply-a-relationship-change-and-inspect-both-endpoint-views.json"},{"identity":"sha256:4468263bc7759fe571752a4ec75f0b067f113a2163481df40c7c469e51777b1d","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/sr.json"}],"text":"Authors can change one authoritative relationship and understand its outcome consistently from both endpoints, including rejected or incomplete changes."},{"number":2,"sources":[{"identity":"sha256:0f980f9704b8d15537eb8254db2ee7a73bc77843930bb5c4b32e72a9640d60fc","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/ir.json"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:f1ee063db8c6aeb54fa1f7fabffefb2d4abc1cd143eb56a69a16d0791aefd104","path":"design/requirements/scenarios/SCN-008-follow-responsibility-paths-within-a-selected-model-state.json"},{"identity":"sha256:bbab4a06bc1dfa726412666c9247c99c1c9c3e50f0e8fcf6ea25b7abb5e9e6b7","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/sr.json"}],"text":"Engineers can follow typed responsibility paths within one selected model state and distinguish complete, bounded and incomplete exploration."},{"number":3,"sources":[{"identity":"sha256:0f980f9704b8d15537eb8254db2ee7a73bc77843930bb5c4b32e72a9640d60fc","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/ir.json"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:c5424c9b92e6f55bcc1256fd46b6243ab1a21a1ee60f97ab085702b9e27d712f","path":"design/requirements/scenarios/SCN-009-review-converging-requirement-and-function-responsibilities.json"},{"identity":"sha256:56978c46744fbe04bf2a3815ba42b6269d01f80c06202dfc9a1a0e65b96ead9a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/sr.json"}],"text":"Architects can distinguish established allocation gaps or conflicts, permitted deferrals and questions requiring engineering review."},{"number":4,"sources":[{"identity":"sha256:0f980f9704b8d15537eb8254db2ee7a73bc77843930bb5c4b32e72a9640d60fc","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/ir.json"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:a7e3dd88ebfa694d4d16ab8b1510ffc6ecf74e97b02a044253be8933f318abd3","path":"design/requirements/scenarios/SCN-010-investigate-possible-impact-of-a-proposed-engineering-change.json"},{"identity":"sha256:ebc04b8f7806761e8d29769aa5b6721813f2dfa801a4cda0dc8bda178f31a7f9","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-011-explain-possible-change-impact-through-engineering-paths/sr.json"}],"text":"Authors can investigate explainable potential change impact through selected typed paths while preserving scope limits and leaving actual consequences to engineering review."},{"number":5,"sources":[{"identity":"sha256:0f980f9704b8d15537eb8254db2ee7a73bc77843930bb5c4b32e72a9640d60fc","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/ir.json"},{"identity":"sha256:a1259ad3b6ad455744b9d4b1b0e7381f57e2955cd3258e2ca0f04978ed9d078a","path":"design/system/features/FEAT-022-generate-and-share-attributable-architecture-views.json"},{"identity":"sha256:24dac0c40541fae86a5565d514d1a91cd80df6fdca1d76eeec2f75704583691f","path":"design/requirements/scenarios/SCN-083-generate-architecture-views-for-a-customer-project.json"},{"identity":"sha256:af85807362a5790ca75c5747efc91132e6eae9438d006dd0b0a62beaa729e66d","path":"design/requirements/scenarios/SCN-084-read-a-copied-architecture-snapshot-offline.json"},{"identity":"sha256:c14916c265533dca374bb18d3f948cafbc3821c154ab1dc7c5452497b776d26a","path":"design/requirements/scenarios/SCN-085-preserve-prior-architecture-output-when-generation-fails.json"},{"identity":"sha256:e19e1827c421b667a80889ae8d918be9a1a75e0a885fe2fd397cbe36f32e7894","path":"design/requirements/scenarios/SCN-086-distinguish-proposed-behavior-from-observed-architecture.json"},{"identity":"sha256:04d46256b799f5ba92f3481ef6692ca5ecbab5c632ea507dc8f7fbcaa32f132a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/sr.json"},{"identity":"sha256:bd4a159c76fca8c27594707ebd2d95bd43a07a76b27b0e06f022b823beaa9f94","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-085-preserve-engineering-meaning-across-architecture-views/sr.json"},{"identity":"sha256:a449de0f92f9099ffef32cf3f6b42e39f06f6569ceedccfd2736a1487152ac39","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-086-read-portable-architecture-snapshots-offline/sr.json"},{"identity":"sha256:2844f7d466b58a52365f9e337cdb07f46da798a17e8edf3a64ca81b241d3b0f3","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-087-generate-architecture-snapshots-within-safe-output-boundaries/sr.json"}],"text":"Authors and reviewers can generate attributable customer architecture views, distinguish proposed and observed facts, read a copied snapshot offline and understand safe generation failures without losing unrelated work."}],"sr_children":["SR-008","SR-009","SR-010","SR-011","SR-084","SR-085","SR-086","SR-087"],"support":[{"identity":"sha256:6c5345deb21a80fc55a6ae6e8297336f015503f3748479ac7bb7a59dbb625e8e","requirement":"SR-008"},{"identity":"sha256:c16ea63a6c8bf0b618abe03cf43b5b95498e92f77ecef585f32c866894c14832","requirement":"SR-009"},{"identity":"sha256:b1cf677a6dad1b8f571a13a91439bcadced494e65d90a1f3f063473d7b30353d","requirement":"SR-010"},{"identity":"sha256:13fad40d322ada14dce41dfe26e840cf8474cf18a7bd483cd1623198d3751163","requirement":"SR-011"},{"identity":"sha256:fd43942770f044faec6489caec40609af7573b5d1de3a72c9513bb71bcbf21e9","requirement":"SR-084"},{"identity":"sha256:5823df5b3f70e76563795d0e495bf2760e94705c8821619c6bf5ba1047c11507","requirement":"SR-085"},{"identity":"sha256:283a2ec1112b264435ad77584be201eb6d47064eb04592323e06e63353fa294a","requirement":"SR-086"},{"identity":"sha256:2d8c68ca6993276a58510a98123885efb437d39260954e8f833ce99ff78f7916","requirement":"SR-087"}]},"reported_at":"2026-10-06T12:12:35Z","requirement":"IR-002","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"Complete reviewed five-outcome Design interpretation of the unchanged IR002 need, its linked Features/Scenarios and all eight direct SR obligations. Not implemented stakeholder outcomes or requirement verification.","state":"covered","subjects":[{"identity":"sha256:bd4a159c76fca8c27594707ebd2d95bd43a07a76b27b0e06f022b823beaa9f94","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-085-preserve-engineering-meaning-across-architecture-views/sr.json"},{"identity":"sha256:1dee4e8814f45c1943675afcd28d2facd53586f7e18bb85d9d7caca8b269233f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-085-preserve-engineering-meaning-across-architecture-views/AR-046-preserve-meaning-and-attribution-across-browser-views.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:98c94da392584be5a65a45b09120621d96fa4d26e157ae0e7294414d3b64ddb3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-tree.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:45912f18331be67d938c93c65e5b28d8ac182799d9355e522c7c3cbd3a106162","path":"design/system/README.md"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:2469f00338b83e9a8a666c90c83cb079a5