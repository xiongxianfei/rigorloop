7c0da6953678ba","path":"design/requirements/scenarios/SCN-072-transfer-retained-work-to-another-local-environment.json"},{"identity":"sha256:8943ab95195de53c8582ec0c2ffcd86974d9d8f18575f21a182aa0f0780e294b","path":"design/requirements/scenarios/SCN-073-adopt-replacement-storage-for-retained-operational-work.json"}],"text":"Preservation and recovery retain authority, judgment meaning and explicit scope without hidden overwrite or renewal."}],"sr_children":["SR-006","SR-007","SR-020","SR-021","SR-022","SR-023","SR-024","SR-074","SR-075","SR-076","SR-077"],"support":[{"identity":"sha256:47fd70fa6e6fcd79c976ba928532487a8c6efafe681f787984ead4b902f24a9a","requirement":"SR-006"},{"identity":"sha256:64a208895230896c7877bc3551e4a336f1665cd6eba95308e12d810b0995a84d","requirement":"SR-007"},{"identity":"sha256:155e5ed0be2362d8766847243f5d23714cb26e72fada2569e516744cd4cf3a1c","requirement":"SR-020"},{"identity":"sha256:15363a53d9a97b2508ee830904ce6d5431f99b531734107a088679ea38b46082","requirement":"SR-021"},{"identity":"sha256:1e42276fc81ee51c0867739c073e12d9d5f3ba04a759773944dd752ffb00515c","requirement":"SR-022"},{"identity":"sha256:9a4b018f9c17dbce9803ce7e13d73d14f3670f4cd8a3c3f9a790e6e40700a0a8","requirement":"SR-023"},{"identity":"sha256:639fd16df3052b6f778bc96bbae7c9166d2a83e2319c9e7ab254b30efff71bfa","requirement":"SR-024"},{"identity":"sha256:e60d65ec838d1bdc01e0e5d4963fe646c54a51f0c56e4f9c3d404b17ae7c2a50","requirement":"SR-074"},{"identity":"sha256:61ff2bb22a3132a5f95b6d7d9ca769490deafcd3da517925a10915204017edf1","requirement":"SR-075"},{"identity":"sha256:3b4c8a9c2a6c31a802932a1efb89cb42849ebed19d4a0e67956723d6925dcb54","requirement":"SR-076"},{"identity":"sha256:0741da651f01cedb093d9c68c12e2c515354a5dda54ed7693aac18cb24f78a91","requirement":"SR-077"}]},"reported_at":"2026-10-06T07:59:52Z","requirement":"IR-003","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"Direct stakeholder-outcome Design assessment of current local-profile IR-003, across all eleven SRs and five explicit source-grounded outcomes. Outcome judgment is independent of child counts and does not establish runtime satisfaction.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:4b41b0d959fe2f43bc5e25ec0eb341f711dab57d506acb529ea13c362617f07c","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/browser-views.toml"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:6b8fc2b23b2e60a100ebc9539490ad89e9a40414f5ba030036ee599fdf93fe1a","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/ir.json"},{"identity":"sha256:42e35b2c42c1db2d416487b09de5aea0f0d9b84cdad9c3c3a20fe8ab7e6a41f9","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-006-resume-changes-from-recorded-work-context/sr.json"},{"identity":"sha256:a7dc9c043bd829f8b6cb241924bf0c62ca038d82ceb911064d1707b03033b4f2","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-007-preserve-human-authority-over-governed-decisions/sr.json"},{"identity":"sha256:e17161533905669c22742041d92755248e13b1ca007a9a4ed0091eaaf635c46c","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/sr.json"},{"identity":"sha256:8a96525ea64d7cc0aac2d1fcc94bd8d7e9bb1aae4577b212ecdb7590daa2abd4","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-021-compare-retained-engineering-states-with-their-original-meaning/sr.json"},{"identity":"sha256:df0f264c8b823ade0379862fe0930249fdbf84863a605db728c09bf5edec9138","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-022-recover-retained-baselines-without-altering-historical-meaning/sr.json"},{"identity":"sha256:b70f07a016cc975c404dc99533736cacd6a3f240681b9211d75619e891bab658","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-023-record-controlled-transitions-and-their-engineering-provenance/sr.json"},{"identity":"sha256:1e8332fabc5d1038e4c0eaaf3b5d31fcc230e7a0eb5ac576f50d12fa4bee9d19","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/sr.json"},{"identity":"sha256:c5fe6bbdc7d362a1aab7936faeaa1f2251291b63769163098d1dba8450fbf3bd","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-074-create-coherent-recoverable-operational-backups/sr.json"},{"identity":"sha256:44126953b43252bdb28cf64fdbab87e77da936c3609cc7a79cbbec587a46761b","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-075-restore-operational-history-without-changing-its-original-meaning/sr.json"},{"identity":"sha256:120cc01f5b2ba455cf04d05f5738e7906253e35a3f678cf42f8a4a45d329db0e","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-076-transfer-retained-operational-work-with-explicit-project-association/sr.json"},{"identity":"sha256:f8aff524a22587d6aee52947a07847abb132c40bbc57852db2e96b04028fac95","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-077-migrate-operational-records-with-explicit-preservation-and-disposition/sr.json"},{"identity":"sha256:ea072d90d827e5b0e26681e813dc4225f4aad0f4b9abefc2a6e55fbe0924f340","path":"design/system/features/FEAT-006-inspect-compare-and-recover-retained-engineering-baselines.json"},{"identity":"sha256:539b34dcfdb521197a5939b2b027e8c0338880dcf5363662092ec0b35082d24c","path":"design/system/features/FEAT-007-control-and-resume-engineering-changes.json"},{"identity":"sha256:a11804067cf82110efab5c9aad3fbbf41700a3218f6408e9792276e17f233417","path":"design/system/features/FEAT-021-preserve-and-restore-operational-history.json"},{"identity":"sha256:c36930c8b2bfd4a5de8dcf7412df4c1a03438ad334c4dfb8f8cdaed41c63a154","path":"design/requirements/scenarios/SCN-019-establish-an-identifiable-baseline-for-later-engineering-reliance.json"},{"identity":"sha256:f896ef17c06179be5b5a8b8dd4576f97623a3317356de4895a4250b9c319f6fa","path":"design/requirements/scenarios/SCN-020-understand-what-changed-between-two-retained-engineering-states.json"},{"identity":"sha256:385e0822df58215815ad39c8c777052317df9834a033095df9026f250d9d9399","path":"design/requirements/scenarios/SCN-021-recover-an-earlier-baseline-with-its-original-engineering-meaning.json"},{"identity":"sha256:a9e2e87df49df0372ad3e707a5ed28c99d59b5992f5356c234caef5bc2950638","path":"design/requirements/scenarios/SCN-022-explain-an-adopted-change-from-its-recorded-transition.json"},{"identity":"sha256:0b1d4af54d471a405d4ea149d8d064d03907ada697072094cd80193f4e9d5b4d","path":"design/requirements/scenarios/SCN-023-resume-interrupted-work-from-recorded-change-context.json"},{"identity":"sha256:b458e4583447bf9982560fded7156be3b2caa4d7539fcbe19c3b039e7616d7dc","path":"design/requirements/scenarios/SCN-024-determine-whether-a-proposed-action-is-already-authorized.json"},{"identity":"sha256:f6fcb78dab4247ceac142cd0021b1075e27c60fbeaedcf9640ed727cac01a704","path":"design/requirements/scenarios/SCN-025-retire-completed-material-while-preserving-current-reliance-and-history.json"},{"identity":"sha256:bfe33b3a01fa5bf54a5b8e9ea55f9b01af0d2b439266a2649043d6d87d4ada5a","path":"design/requirements/scenarios/SCN-070-create-a-recoverable-operational-backup.json"},{"identity":"sha256:734ea5e6bb2c7ba547e1fdea4299ce0b4cdf32939ee32a95bfa1374955809238","path":"design/requirements/scenarios/SCN-071-restore-operational-history-after-local-store-loss.json"},{"identity":"sha256:577e912d9b5114ef3ef0796499aa1e91d4bd3919b915fecf657c0da6953678ba","path":"design/requirements/scenarios/SCN-072-transfer-retained-work-to-another-local-environment.json"},{"identity":"sha256:8943ab95195de53c8582ec0c2ffcd86974d9d8f18575f21a182aa0f0780e294b","path":"design/requirements/scenarios/SCN-073-adopt-replacement-storage-for-retained-operational-work.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The IR need, FEAT-008 and SCN-026 require usable assessment planning without invented proof. The composed method content, exact revised binding and explicit method-only inconclusive retention let a participant recover what was intended and distinguish it from observations. This directly addresses the stakeholder outcome rather than inheriting SR labels.","number":1,"state":"covered"},{"explanation":"FEAT-008 and SCN-027 require an inspectable account of what actually occurred, including partial, unable and adverse cases. The occurrence model, independent execution/outcome dimensions, actual retained-byte confirmation and preserved contrary meaning make that distinction available to decision owners. No universal authentication or unseen-evidence discovery is asserted.","number":2,"state":"covered"},{"explanation":"FEAT-009 and SCN-028 require support applicable to the proposed engineering claim. Exact criterion/state/condition comparison, missing-basis diagnostics and scoped accountable rationale provide the needed distinction between current, mismatched and unknown support; mechanical identities alone do not supply it.","number":3,"state":"covered"},{"explanation":"The IR purpose and SCN-028 require accountable conclusions, not a pass-label rollup. Per-criterion reasoning and contradiction dispositions, explicit scope exclusions, actual independence, re-preparation after changed decisions and separate authority together make the judgment inspectable without converting persistence into approval.","number":4,"state":"covered"},{"explanation":"FEAT-009 and SCN-029 require decisions that survive relevant change without losing unresolved meaning. The explicit affected/reused/unknown analysis, repetition distinction, replacement basis and historical completion rules compose that outcome with selective retention. It remains target Design, not observed automated reassessment.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-004\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Assess engineering claims using applicable evidence\",\n  \"status\": \"draft\",\n  \"statement\": \"Reviewers and project decision owners need to assess engineering claims using identifiable verification methods and applicable observed evidence so they can distinguish demonstrated satisfaction from assumptions, plans, and unresolved gaps.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Plans, test definitions, and observations from an inapplicable state can be mistaken for proof of the claim currently being assessed.\",\n      \"desired_outcome\": \"Decision owners can distinguish demonstrated satisfaction within the assessed scope from assumptions, unperformed checks, and unresolved evidence gaps.\"\n    },\n    \"why\": {\n      \"rationale\": \"The existence of a test, a recorded decision, or an unchanged entity identity does not establish that a requirement is satisfied in the state being assessed.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Reviewers and verification engineers\",\n        \"Project decision owners\",\n        \"Engineers and maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Applies whenever requirement satisfaction, readiness, or another engineering conclusion is asserted or reassessed after change.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Across obligations, Verification, Evidence, and Judgment for the engineering states being assessed.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"For each claimed outcome, identify the applicable requirement and acceptance criteria, the exact assessed subject and state, the selected verification technique, its conditions and expected observations, and the actual result with supporting evidence. Evidence is sufficient only when every criterion within the claim has applicable supporting observations and any material contradictory evidence has been addressed. Missing, stale, or conflicting evidence leaves the affected claim unestablished; a narrower supported claim may identify its explicit scope. Inspect structure mechanically where possible and use recorded engineering review for semantic judgments. After a subject or governing criterion changes, reassess evidence applicability and repeat affected verification rather than inheriting satisfaction from a stable identity.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers the separation of obligations, verification definitions, observed evidence, and judgments, including their applicability to assessed revisions. It does not require every verification technique to be automated or prescribe CI or a test framework. Applicable proof depends on the claimed outcome and its acceptance conditions. No universal test count, coverage percentage, or numerical confidence threshold is established. The initial authoring profile uses criterion coverage and applicability as its sufficiency rule. It does not require a universal number of tests, review votes, elapsed observation time, or a numerical confidence score. Recording this rule does not establish that any draft requirement has been verified.\"\n    }\n  },\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 26, 27, 35, and 42\",\n      \"basis\": \"Verification methods, actual observations, and evidence supporting engineering claims.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Human-understandable AI work; What would prove this wrong\",\n      \"basis\": \"Inspectable proof and explicit limits on what remains to be judged.\"\n    },\n    {\n      \"source\": \"SRC-SYSTEM\",\n      \"locator\": \"SYS-SR-06\",\n      \"basis\": \"Related existing separation of current truth, mutable work state, judgments, proof, and history.\"\n    },\n    {\n      \"source\": \"SRC-REM-REFINEMENT\",\n      \"locator\": \"Requirement Analysis: Analyze the initial need; Name the initial requirement\",\n      \"basis\": \"Required 5W2H analysis and a clearer IR name, preserving the existing identity and need statement.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"IR-004\",\n      \"basis\": \"Resolution of the recorded questions for the initial RigorLoop authoring profile under the user's instruction to solve them; the source register preserves the original questions and rationale.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"IR-004\",\n      \"basis\": \"Complete the existing bounded initial need through the linked draft Scenarios, Features, and single-parent SR decomposition. Preserve the original statement, 5W2H scope, assumptions, and prior source history; author relationship facts once.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-008\",\n    \"FEAT-009\",\n    \"SCN-026\",\n    \"SCN-027\",\n    \"SCN-028\",\n    \"SCN-029\"\n  ]\n}\n","identity":"sha256:6217b3dfe937e4d60b5a133f9267057f0c986ddc205e4e35d5875b01f1e4032e","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/ir.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection with explicit recording; no automatic sufficiency, universal discovery, actor authentication or installed guidance qualification.","Native attachment/prose adds no command, wire grammar or record type. Provenance, sufficiency, independence and authority remain judgments; save/render success is insufficient. No release approval.","Five sourced outcomes are explicit direct IR judgment, not canonical criteria or child rollup."],"outcome_basis":{"identity":"sha256:27684bf26cdc853c88da732227b86fba9fd67153be64dc91f5c730447a5edeef","outcomes":[{"number":1,"sources":[{"identity":"sha256:6217b3dfe937e4d60b5a133f9267057f0c986ddc205e4e35d5875b01f1e4032e","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/ir.json"},{"identity":"sha256:4cbdf8b7833af39c36824391966613150bdefbbc99657dce553f5e5e836d31e8","path":"design/system/features/FEAT-008-define-verification-and-record-observed-evidence.json"},{"identity":"sha256:8817920591acf5bd89a27594440919b6c9486c6fc830202666aad9e4f89e4b93","path":"design/requirements/scenarios/SCN-026-define-how-a-requirement-criterion-will-be-verified.json"},{"identity":"sha256:a9ccdbfde2fe8a260c232bea8fb9cb8e575d4a7d723f5c69dc386b97891a3a19","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-025-define-verification-against-identifiable-requirement-criteria/sr.json"}],"text":"Participants can define how identifiable criteria will be assessed against an exact engineering state without presenting planned methods as observations."},{"number":2,"sources":[{"identity":"sha256:6217b3dfe937e4d60b5a133f9267057f0c986ddc205e4e35d5875b01f1e4032e","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/ir.json"},{"identity":"sha256:4cbdf8b7833af39c36824391966613150bdefbbc99657dce553f5e5e836d31e8","path":"design/system/features/FEAT-008-define-verification-and-record-observed-evidence.json"},{"identity":"sha256:b28936ae77c000f5752e98e1a61b34975a1fcc17dd9367e3e23274fb081a713d","path":"design/requirements/scenarios/SCN-027-record-what-actually-happened-during-a-verification-assessment.json"},{"identity":"sha256:e96a55c71ccf89fa5837e964dc4b0019b36742d6dfd781559a8ed66e740d4133","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-026-retain-actual-verification-observations-and-execution-state/sr.json"}],"text":"Participants can inspect actual assessment observations, provenance and execution limits, including contrary results and unavailable evidence."},{"number":3,"sources":[{"identity":"sha256:6217b3dfe937e4d60b5a133f9267057f0c986ddc205e4e35d5875b01f1e4032e","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/ir.json"},{"identity":"sha256:3b50e839f6dd83d2c1b4105fb44d5a3fed99e3120f281ad3bc64f49629937fa5","path":"design/system/features/FEAT-009-assess-evidence-supporting-engineering-claims.json"},{"identity":"sha256:881973be3aea9c08cd74fd628bed7a40bda6191ad72255dd81940c1fe4a2b6ff","path":"design/requirements/scenarios/SCN-028-judge-a-claim-against-applicable-observations-and-uncovered-criteria.json"},{"identity":"sha256:ffc96ad018255d8dac9f312f828f22e72ccf2c03c5f12ec15266c036dd8c5bfe","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-027-assess-evidence-applicability-to-the-claimed-engineering-state/sr.json"}],"text":"Reviewers can determine evidence applicability to the declared claim and distinguish concrete mismatches and unknown support."},{"number":4,"sources":[{"identity":"sha256:6217b3dfe937e4d60b5a133f9267057f0c986ddc205e4e35d5875b01f1e4032e","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/ir.json"},{"identity":"sha256:3b50e839f6dd83d2c1b4105fb44d5a3fed99e3120f281ad3bc64f49629937fa5","path":"design/system/features/FEAT-009-assess-evidence-supporting-engineering-claims.json"},{"identity":"sha256:881973be3aea9c08cd74fd628bed7a40bda6191ad72255dd81940c1fe4a2b6ff","path":"design/requirements/scenarios/SCN-028-judge-a-claim-against-applicable-observations-and-uncovered-criteria.json"},{"identity":"sha256:e2378e5f388d6d54c50f8427ca9b9a0fbaf3cb9553dc5d6ac912f13b19d7cd50","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-028-record-scoped-engineering-judgments-from-criterion-coverage/sr.json"}],"text":"Decision owners can inspect accountable criterion-based conclusions, uncovered scope and contradiction dispositions without mistaking judgments for permission."},{"number":5,"sources":[{"identity":"sha256:6217b3dfe937e4d60b5a133f9267057f0c986ddc205e4e35d5875b01f1e4032e","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/ir.json"},{"identity":"sha256:3b50e839f6dd83d2c1b4105fb44d5a3fed99e3120f281ad3bc64f49629937fa5","path":"design/system/features/FEAT-009-assess-evidence-supporting-engineering-claims.json"},{"identity":"sha256:86db1f2d61934c0bf540249997135aff4dd2bed6ccd47c1caf46456879eb900e","path":"design/requirements/scenarios/SCN-029-reassess-earlier-claim-support-after-a-subject-or-criterion-changes.json"},{"identity":"sha256:ee2d4a2a69ce348cef2cfbcc49b09a3127d164bbcd40ebfaddbb592cdc8f9eba","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-029-reassess-claim-support-after-engineering-changes/sr.json"}],"text":"Participants can reassess current support after changes while retaining unresolved obligations, justified reuse and historical completion meaning."}],"sr_children":["SR-025","SR-026","SR-027","SR-028","SR-029"],"support":[{"identity":"sha256:9ac9130d1d0f5c12f3b732616b49295d064d06c608097a4795ac3e219c4bcfb4","requirement":"SR-025"},{"identity":"sha256:861427e748aa80db2b3272525111f899f9248ec22ad2dfd596e704ab9f0ceba3","requirement":"SR-026"},{"identity":"sha256:af7fc57d85cbc86ae5ca07c2a44ad573e47cf8055d6e99ddaa85f4e73363d462","requirement":"SR-027"},{"identity":"sha256:5dc2d8053a8573a43ac71bdd25b8ded5ccaf4ab32c2d9c23f352e9253ff892a0","requirement":"SR-028"},{"identity":"sha256:3ecd56dac0431262dfced42a69304dd1e7420759664ffac63d054a4e763d5830","requirement":"SR-029"}]},"reported_at":"2026-10-06T07:59:52Z","requirement":"IR-004","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"Direct Design judgment of five explicitly sourced IR-004 stakeholder outcomes plus complete selected support from SR-025–029; these outcomes are assessment basis, not new canonical IR criteria.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:bfd8f747731417fc54ec34ce6f1e89281cae8ed4ba7ec024015695bffe3e9405","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/browser-views.toml"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:6217b3dfe937e4d60b5a133f9267057f0c986ddc205e4e35d5875b01f1e4032e","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/ir.json"},{"identity":"sha256:3e0839c2e595f5c53faac3c12c0b04d67b00369df010e0b4876c280a7e2fee77","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-025-define-verification-against-identifiable-requirement-criteria/AR-062-prepare-state-bound-verification-definitions.json"},{"identity":"sha256:a9ccdbfde2fe8a260c232bea8fb9cb8e575d4a7d723f5c69dc386b97891a3a19","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-025-define-verification-against-identifiable-requirement-criteria/sr.json"},{"identity":"sha256:8766875a4f5c42af78d715aeed0f1688e708c5672d65e02b4f48977d3888dbea","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-026-retain-actual-verification-observations-and-execution-state/AR-063-preserve-actual-observation-meaning-through-recording.json"},{"identity":"sha256:e96a55c71ccf89fa5837e964dc4b0019b36742d6dfd781559a8ed66e740d4133","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-026-retain-actual-verification-observations-and-execution-state/sr.json"},{"identity":"sha256:7a0893bf829f001663df33e9f27723998adf501899f3d8394af833f65f8d2568","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-027-assess-evidence-applicability-to-the-claimed-engineering-state/AR-064-expose-scoped-evidence-applicability-with-attributable-comparisons.json"},{"identity":"sha256:ffc96ad018255d8dac9f312f828f22e72ccf2c03c5f12ec15266c036dd8c5bfe","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-027-assess-evidence-applicability-to-the-claimed-engineering-state/sr.json"},{"identity":"sha256:0027c0caec17687fe548b67ec08c12586e7bb87fa6c0394066d6931aed84bcde","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-028-record-scoped-engineering-judgments-from-criterion-coverage/AR-065-prepare-accountable-judgments-from-explicit-criterion-coverage.json"},{"identity":"sha256:e2378e5f388d6d54c50f8427ca9b9a0fbaf3cb9553dc5d6ac912f13b19d7cd50","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-028-record-scoped-engineering-judgments-from-criterion-coverage/sr.json"},{"identity":"sha256:3425c4ac2c6872d28034c0068b02470bb3cf036d18f484238890894632c6e171","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-029-reassess-claim-support-after-engineering-changes/AR-066-reassess-current-reliance-without-rewriting-historical-meaning.json"},{"identity":"sha256:ee2d4a2a69ce348cef2cfbcc49b09a3127d164bbcd40ebfaddbb592cdc8f9eba","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-029-reassess-claim-support-after-engineering-changes/sr.json"},{"identity":"sha256:3da76ed9a92f8ff53dc84cd3256a7926a595e356aef80be434f9faa1084d0e75","path":"design/system/functions/FUNC-027-retain-criterion-based-verification-definitions.json"},{"identity":"sha256:0d4c34a662fae8b74f1c59da1062b9094d557cbfc2130c89975f5a1703af4cf6","path":"design/system/functions/FUNC-028-retain-actual-verification-observations-and-provenance.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"},{"identity":"sha256:85db55d933a26a2b6840d630caab1172dc9c820486bfca845444ab3fdf81fc59","path":"design/system/functions/FUNC-030-expose-claim-criterion-coverage-and-contradictory-evidence.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"},{"identity":"sha256:4cbdf8b7833af39c36824391966613150bdefbbc99657dce553f5e5e836d31e8","path":"design/system/features/FEAT-008-define-verification-and-record-observed-evidence.json"},{"identity":"sha256:3b50e839f6dd83d2c1b4105fb44d5a3fed99e3120f281ad3bc64f49629937fa5","path":"design/system/features/FEAT-009-assess-evidence-supporting-engineering-claims.json"},{"identity":"sha256:8817920591acf5bd89a27594440919b6c9486c6fc830202666aad9e4f89e4b93","path":"design/requirements/scenarios/SCN-026-define-how-a-requirement-criterion-will-be-verified.json"},{"identity":"sha256:b28936ae77c000f5752e98e1a61b34975a1fcc17dd9367e3e23274fb081a713d","path":"design/requirements/scenarios/SCN-027-record-what-actually-happened-during-a-verification-assessment.json"},{"identity":"sha256:881973be3aea9c08cd74fd628bed7a40bda6191ad72255dd81940c1fe4a2b6ff","path":"design/requirements/scenarios/SCN-028-judge-a-claim-against-applicable-observations-and-uncovered-criteria.json"},{"identity":"sha256:86db1f2d61934c0bf540249997135aff4dd2bed6ccd47c1caf46456879eb900e","path":"design/requirements/scenarios/SCN-029-reassess-earlier-claim-support-after-a-subject-or-criterion-changes.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The IR need, FEAT-004 and SCN-011 require shared meaning tied to the selected state rather than current conventions. Immutable raw custody followed by declared-profile interpretation and available exact governing definitions addresses that outcome, while unavailable historical context remains an honest limit instead of substituted meaning.","number":1,"state":"covered"},{"explanation":"FEAT-004 and SCN-012 require actionable defects and trustworthy check scope. Full relevant inventory, ordered local/dependent checks, rule/location attribution and independent completeness/violation dimensions let authors locate defects without confusing partial inspection or missing transition inputs with valid whole-model conformance.","number":2,"state":"covered"},{"explanation":"The IR analysis and SCN-013 require interpretable boundaries between structural facts and engineering judgment. Separate supplied accounts preserve state/scope/purpose/assessor, expose stale or unknown applicability and leave undecidable allocation questions with their actual owner. This supplies the stakeholder distinction directly rather than deriving it from successful child counts.","number":3,"state":"covered"},{"explanation":"FEAT-005 and SCN-014 require an inspectable candidate before deciding adoption. Finite explicit mapping, complete source disposition, isolated target identity, semantic-change disclosure and exact consumer support expose the consequences and gaps while source/history remain untouched. This addresses candidate understanding without promising operational migration or authorizing adoption.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-005\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Keep engineering models valid and consistently interpreted\",\n  \"status\": \"draft\",\n  \"statement\": \"Engineers, reviewers, and engineering agents need explicit, consistent rules for interpreting engineering models and identifying invalid model content so they can maintain and use engineering information with a shared understanding of its meaning.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Participants can apply incompatible interpretations or validity rules to the same engineering content when the governing metamodel is unclear.\",\n      \"desired_outcome\": \"Authors, readers, and reviewers can interpret governed content against identifiable common rules and understand where it departs from those rules.\"\n    },\n    \"why\": {\n      \"rationale\": \"When participants apply different meanings or validity rules to the same model, they can accept incompatible definitions, overlook broken relationships, or draw conclusions from information they interpret differently.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Reviewers and model maintainers\",\n        \"Engineering agents using or maintaining the model\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Applies when defining model rules, authoring or interpreting model content, checking a proposed engineering state, and changing the rules under which existing content is interpreted.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Across governed requirements, system design, and architecture design, and the Operational Support definitions that govern their representation and interpretation.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Define an explicit metamodel for entity meaning, fields, relationships, identity, and lifecycle rules. In the initial authoring profile, automated checks cover mechanically decidable rules for record shape, required values and closed vocabularies, identity uniqueness, naming and containment agreement, single-parent acyclic requirement hierarchy, typed reference resolution, and explicitly defined lifecycle transitions. Engineering review assesses need validity, clarity, derivation, allocation coherence beyond mechanical rules, assumption justification, and evidence adequacy. Both forms of assessment report their scope; passing one does not stand in for the other. The authoring schemas and focused model checks assess only their documented structural scope; they do not establish a complete product implementation of these obligations.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers model meaning, structural and semantic validity rules, and consistent interpretation of governed content. The relationship needs belong to IR-002; this need concerns the rules used to represent and assess their validity. Conformance to model rules does not establish that product requirements are satisfied; assessment of engineering claims using evidence belongs to IR-004. The need does not prescribe a schema language, storage format, or validation tool. The initial authoring profile interprets each retained baseline with the metamodel and rules identified by that baseline. Current authoring targets one explicitly selected profile; it does not promise that the current parser accepts every historical format. A format change uses an explicit, reviewed mapping to a new current state, preserves identity and meaning or records an intentional semantic change, and checks current references and consumers before adoption. Historical content remains unchanged and interpretable through its retained rules; an unsupported historical profile is reported rather than silently reinterpreted.\"\n    }\n  },\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 20, 21, 22, and 35\",\n      \"basis\": \"Operational Support governs the metamodel, representation, validation, lifecycle, and engineering-model invariants.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Who it is for; What it commits to\",\n      \"basis\": \"Existing project intent values explicit requirements, architectural consistency, and engineering information that participants can validate and review.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-EXPANSION\",\n      \"locator\": \"IR-005: Keep engineering models valid and consistently interpreted\",\n      \"basis\": \"The user authorized drafting this initial need as part of the expanded requirement inventory; the record remains a draft.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"IR-005\",\n      \"basis\": \"Resolution of the recorded questions for the initial RigorLoop authoring profile under the user's instruction to solve them; the source register preserves the original questions and rationale.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"IR-005\",\n      \"basis\": \"Complete this existing IR through governed black-box Scenarios, independently assessable SR obligations, and bounded shared Features and Functions. Preserve the need statement and selected scope; all records remain draft, with architectural allocation and implementation assessment deferred.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-004\",\n    \"FEAT-005\",\n    \"SCN-011\",\n    \"SCN-012\",\n    \"SCN-013\",\n    \"SCN-014\"\n  ]\n}\n","identity":"sha256:795c0107e0105fe5ab5cb04da4751490b0fe4b64c41eb9edba35ccf98cb775a2","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/ir.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw capture/pure checks/isolated candidates require adapter, mapping and capacity qualification; adoption/persistence writers stay separate.","Semantic equivalence, mapping and consumer adequacy require judgments, not hashes/counts. No operational migration, workflow/profile adoption or transition authority.","Sourced outcomes require direct judgment; IR has no canonical criterion array."],"outcome_basis":{"identity":"sha256:59e9f59d313cefa36f74812fc35d5b5303bb354f5c49f2372b6e3ccc4af71127","outcomes":[{"number":1,"sources":[{"identity":"sha256:795c0107e0105fe5ab5cb04da4751490b0fe4b64c41eb9edba35ccf98cb775a2","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/ir.json"},{"identity":"sha256:c6ff789592c958e5a125e72e8d7c081a3293b9b8db3eda4d71935032570423fb","path":"design/system/features/FEAT-004-assess-engineering-model-conformance.json"},{"identity":"sha256:ab05cdad70e6a45cd246d6469f91b196e35d1bc5585b03845133c0ac64dc475a","path":"design/requirements/scenarios/SCN-011-read-a-retained-model-under-its-original-governing-rules.json"},{"identity":"sha256:7339aa1fe37276f6f66e70aebd926c728add51dabd808d23f4769c147f845de5","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/sr.json"}],"text":"Participants can interpret each selected model under identifiable governing metamodel and profile definitions, preserving historical meaning and exposing unsupported context."},{"number":2,"sources":[{"identity":"sha256:795c0107e0105fe5ab5cb04da4751490b0fe4b64c41eb9edba35ccf98cb775a2","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/ir.json"},{"identity":"sha256:c6ff789592c958e5a125e72e8d7c081a3293b9b8db3eda4d71935032570423fb","path":"design/system/features/FEAT-004-assess-engineering-model-conformance.json"},{"identity":"sha256:b07ea37ecf83f7f232277898e1df62bbed604535bf04560bd469d930971d5e28","path":"design/requirements/scenarios/SCN-012-locate-model-violations-before-relying-on-an-authored-state.json"},{"identity":"sha256:ba9b9c6484825cad6d913f09ee95bbc00d29eab5a2b8db8f574ad34b6d98676c","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-013-diagnose-violations-of-declared-model-rules/sr.json"}],"text":"Authors can locate actionable declared-rule violations and understand the complete, unsupported or unassessed scope of mechanical checks."},{"number":3,"sources":[{"identity":"sha256:795c0107e0105fe5ab5cb04da4751490b0fe4b64c41eb9edba35ccf98cb775a2","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/ir.json"},{"identity":"sha256:c6ff789592c958e5a125e72e8d7c081a3293b9b8db3eda4d71935032570423fb","path":"design/system/features/FEAT-004-assess-engineering-model-conformance.json"},{"identity":"sha256:977dc537e396f3efbcbd91e612b47f9651adb0c859a2e8372519ede22c928cff","path":"design/requirements/scenarios/SCN-013-distinguish-structural-conformance-from-engineering-adequacy.json"},{"identity":"sha256:f604dc48c793d58415de03fe757ec249e4ac699a87772a92b179a96c31bbffdc","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-014-separate-model-conformance-results-from-engineering-judgments/sr.json"}],"text":"Reviewers can distinguish structural facts from separately attributable engineering judgments and unresolved semantic questions."},{"number":4,"sources":[{"identity":"sha256:795c0107e0105fe5ab5cb04da4751490b0fe4b64c41eb9edba35ccf98cb775a2","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/ir.json"},{"identity":"sha256:933e5a978cf48d19dfdbf09d6fa44000042fc8ad802295ec0360ee17e10dd3a0","path":"design/system/features/FEAT-005-migrate-engineering-models-between-declared-profiles.json"},{"identity":"sha256:879ddc7bffe06538f1afeb897ebb6d0613ec9fb4b86eedeeed68b2a5bd805f0f","path":"design/requirements/scenarios/SCN-014-prepare-a-profile-migration-while-preserving-historical-meaning.json"},{"identity":"sha256:2492fd1f6ec886ec844338117be9a3ca27efb8575df1c3c5c7e9b9e36fb84cdd","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-015-prepare-explicit-model-migrations-without-rewriting-history/sr.json"}],"text":"Maintainers can inspect explicitly mapped migration candidates and their identity, meaning, conformance and compatibility consequences before controlled adoption, while the source remains unchanged."}],"sr_children":["SR-012","SR-013","SR-014","SR-015"],"support":[{"identity":"sha256:b0d061463d57f6b4fd9e51a6157440b324537a4ff03d74323ac76e80a6e66b71","requirement":"SR-012"},{"identity":"sha256:4232a07114c975cbb30d48b211d57a31629e3eabd83b4c8c5af34c3e657b13bc","requirement":"SR-013"},{"identity":"sha256:2572dd1c0c5006df85a5893e94f0d703414d88c3178a3448f02578c57b99aac1","requirement":"SR-014"},{"identity":"sha256:a96b6d61af467792053ecb4a21536de19146a2124fed93196787d9835a48e7c9","requirement":"SR-015"}]},"reported_at":"2026-10-06T07:59:52Z","requirement":"IR-005","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"Direct Design assessment of four sourced IR-005 stakeholder outcomes, with exact support from all four SRs; outcomes are assessed interpretation, not new canonical IR criteria.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:f0cee4a452136c8a71465aef10e8b693ed298e447a2ac7e3d7fef848724f4796","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/browser-views.toml"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:795c0107e0105fe5ab5cb04da4751490b0fe4b64c41eb9edba35ccf98cb775a2","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/ir.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:7339aa1fe37276f6f66e70aebd926c728add51dabd808d23f4769c147f845de5","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/sr.json"},{"identity":"sha256:91db4b6dead35ecf421671f0c5f7af85b8b85882bf4748581e08d41b83b201cc","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-013-diagnose-violations-of-declared-model-rules/AR-067-diagnose-model-rules-over-explicit-complete-scope.json"},{"identity":"sha256:ba9b9c6484825cad6d913f09ee95bbc00d29eab5a2b8db8f574ad34b6d98676c","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-013-diagnose-violations-of-declared-model-rules/sr.json"},{"identity":"sha256:bbd6122b7db81a96e903822946d66cef75296ea29cc782bff310ffce39dfdcb3","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-014-separate-model-conformance-results-from-engineering-judgments/AR-068-keep-conformance-observations-distinct-from-supplied-judgments.json"},{"identity":"sha256:f604dc48c793d58415de03fe757ec249e4ac699a87772a92b179a96c31bbffdc","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-014-separate-model-conformance-results-from-engineering-judgments/sr.json"},{"identity":"sha256:498980aa84b8f81dbed673d802a7357f8adc63d69636c842316e9ab01acc09c4","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-015-prepare-explicit-model-migrations-without-rewriting-history/AR-069-prepare-attributable-migrations-without-source-mutation.json"},{"identity":"sha256:2492fd1f6ec886ec844338117be9a3ca27efb8575df1c3c5c7e9b9e36fb84cdd","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-015-prepare-explicit-model-migrations-without-rewriting-history/sr.json"},{"identity":"sha256:e3fa23aeb0b639459320519bf9a382f1ee11c7696fce1f76c2b420c8cf061d1c","path":"design/system/functions/FUNC-002-check-entity-identity-presence-and-uniqueness.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"},{"identity":"sha256:d4a820120577846f12878a269f912732b9e017ebfd09df84b9465410d38789b3","path":"design/system/functions/FUNC-008-author-typed-engineering-relationships.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:0d2329f7158503cbd7b1cb43508d0707c45aa284c7efb8b97bad0cc4540da704","path":"design/system/functions/FUNC-014-prepare-a-model-migration-candidate.json"},{"identity":"sha256:c6ff789592c958e5a125e72e8d7c081a3293b9b8db3eda4d71935032570423fb","path":"design/system/features/FEAT-004-assess-engineering-model-conformance.json"},{"identity":"sha256:933e5a978cf48d19dfdbf09d6fa44000042fc8ad802295ec0360ee17e10dd3a0","path":"design/system/features/FEAT-005-migrate-engineering-models-between-declared-profiles.json"},{"identity":"sha256:ab05cdad70e6a45cd246d6469f91b196e35d1bc5585b03845133c0ac64dc475a","path":"design/requirements/scenarios/SCN-011-read-a-retained-model-under-its-original-governing-rules.json"},{"identity":"sha256:b07ea37ecf83f7f232277898e1df62bbed604535bf04560bd469d930971d5e28","path":"design/requirements/scenarios/SCN-012-locate-model-violations-before-relying-on-an-authored-state.json"},{"identity":"sha256:977dc537e396f3efbcbd91e612b47f9651adb0c859a2e8372519ede22c928cff","path":"design/requirements/scenarios/SCN-013-distinguish-structural-conformance-from-engineering-adequacy.json"},{"identity":"sha256:879ddc7bffe06538f1afeb897ebb6d0613ec9fb4b86eedeeed68b2a5bd805f0f","path":"design/requirements/scenarios/SCN-014-prepare-a-profile-migration-while-preserving-historical-meaning.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Exact owner/source/profile selection and shared normative meaning give both participant presentations a common basis; unknown or incompatible scope remains visible.","number":1,"state":"covered"},{"explanation":"The worked need and seven activity examples connect owner rules to semantic results and checks; source navigation, clear distinctions and attributable corrections compose understandable authoring beyond field shape.","number":2,"state":"covered"},{"explanation":"Selection gaps and correction limits name the missing basis and responsible next action. Conceptual work remains bounded, and existing grants support only covered actions without invented answers or approval.","number":3,"state":"covered"},{"explanation":"Independently prepared expectations, actual output/checks/rule explanation and visible assistance support a bounded usefulness assessment. IF-014/004 preserve supplied meaning and actual retention separately from formal judgment or population inference.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-006\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Guide people and agents in authoring engineering models\",\n  \"status\": \"draft\",\n  \"statement\": \"People and engineering agents need understandable guidance for creating, refining, relating, and retiring engineering definitions so they can author and maintain engineering models that express the intended needs, behavior, and responsibilities.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Knowing which fields and relationships exist does not tell an author how to analyze a need, develop an engineering definition, or correct an inadequate one.\",\n      \"desired_outcome\": \"People and agents can use the applicable methods to produce understandable engineering definitions and identify information that still needs analysis or judgment.\"\n    },\n    \"why\": {\n      \"rationale\": \"Model rules alone do not explain how to investigate a need, choose the appropriate engineering concept, develop a clear definition, or resolve a gap. Without usable authoring guidance, participants can produce formally valid records that fail to communicate the engineering intent.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and other model authors\",\n        \"Model maintainers and reviewers\",\n        \"Engineering agents assisting with authoring\"\n      ],\n      \"affected_users\": [\n        \"Authors who understand basic engineering practice but are new to REM\",\n        \"Experienced REM authors and reviewers looking up applicable rules\",\n        \"Engineering agents authoring or reviewing within an authorized scope\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Applies when participants learn the model, begin an authoring activity, refine existing definitions, address review or validation findings, and adapt their authoring practice after the method changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within the supported authoring activities for Requirement Analysis, System Design, and Architecture Design, using the applicable methods and model rules maintained by Operational Support.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the same canonical engineering concepts, methods, and rules for people and agents. Human guidance provides concise rationale, worked examples, and navigation to the applicable owner. Agent guidance uses those same sources with deterministic record formats, identifiable validation diagnostics, and the authority context for the requested activity; it does not require a particular agent host or skill. Assess guidance with prepared task inputs and expected semantic outcomes: create an IR with all seven 5W2H answers and derive an SR with exactly one IR parent; analyze a black-box Scenario and distinguish a Feature from its logical Functions; allocate an AR and a Function consistently to a Module; define an Interface with an explicit provider and consumer; rename a requirement while preserving its identity and parentage and reconciling current references; identify and correct a wrongly typed or unresolved reference; and retire a definition while transferring current obligations and preserving recoverable historical meaning. A task passes when its intended outcome is produced using the stated inputs and canonical guidance, applicable checks pass, and the participant can explain the governing rule without relying on the originating conversation. Record incorrect outcomes, unresolved ambiguities, and additional help needed as findings. These are assessment conditions to apply as the relevant authoring formats become available, not observations that guidance has already passed an assessment.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The initial RigorLoop authoring profile covers one governed project's baseline-oriented model authoring: IR, SR, and AR analysis and derivation; black-box Scenario analysis; Feature and Function definition; Module and Interface definition; and relationship authoring, naming, retirement, and correction of review or validation findings. It supports the participant groups listed under Who. Representation rules for an entity type must be defined before creating records claimed to conform to that type; draft IR, SR, AR, Scenario, Feature, Function, Module, and Interface schemas now define record shapes. These schemas do not establish runtime authoring support or successful guidance assessment. Broader authoring support can be introduced through controlled profile evolution. Preserving authored knowledge belongs to IR-001, and authority for adopting changes or recovering prior states belongs to IR-003. Authoring guidance informs those activities without itself granting approval or establishing requirement satisfaction. The need does not prescribe an editing interface, automation mechanism, or agent provider.\"\n    }\n  },\n  \"assumptions\": [\n    \"Initial guidance assumes participants have basic engineering knowledge; it teaches REM concepts and authoring practice rather than serving as general engineering education.\"\n  ],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 22 and 33\",\n      \"basis\": \"Operational Support defines authoring and maintenance rules, and the engineering cycle describes the activities through which requirements and designs are developed and refined.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Durable lessons; Who it is for\",\n      \"basis\": \"Existing project intent includes improving guidance from engineering lessons and supporting contributors, maintainers, and teams working with engineering agents.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-EXPANSION\",\n      \"locator\": \"IR-006: Guide people and agents in authoring engineering models\",\n      \"basis\": \"The user authorized drafting this initial need as part of the expanded requirement inventory; the record remains a draft.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"IR-006\",\n      \"basis\": \"Selects the initial authoring activities, participant support, and observable assessment outcomes; these are draft profile decisions rather than usability evidence.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"IR-006\",\n      \"basis\": \"Complete the draft IR-to-SR and Scenario/Feature/Function analysis for the existing declared scope; preserve the original need and separate draft analysis from implementation, approval, and satisfaction.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PRODUCTS\",\n      \"locator\": \"IR-006; current authoring-schema availability\",\n      \"basis\": \"Reconcile the current analysis with the eight available authoring schemas introduced through the initial architecture pilot. The need, assessment conditions, runtime-support limits, and historical analysis remain unchanged.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-010\",\n    \"SCN-031\",\n    \"SCN-032\",\n    \"SCN-033\",\n    \"SCN-034\",\n    \"SCN-040\"\n  ]\n}\n","identity":"sha256:132bd2696b15f1690dc63a4d1b46620c4e221ea38c2bf72e268b05eecaf65ada","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/ir.json"},"limitations":["Design only; no implementation, executed verification, participant usability or installed-skill qualification. Delivery unchanged.","Participant-assisted exact source selection and semantic comparison; no automatic judge, universal performance claim, new schema/command or profile adoption.","Actual outcomes require observed tasks/checks/explanations; assistance, missing/unsupported scope and original bases remain explicit. Authority, formal assurance and confirmed retention keep separate owners.","Four reviewed outcomes decompose the existing need; they are not invented canonical IR criteria or observations that participants passed."],"outcome_basis":{"identity":"sha256:4d22802fea478fb8bdfb575589632c3f3271f7bd47e212655619ad228442c4db","outcomes":[{"number":1,"sources":[{"identity":"sha256:132bd2696b15f1690dc63a4d1b46620c4e221ea38c2bf72e268b05eecaf65ada","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/ir.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:11164a5918fbd34a517dd0139be01d9ba96652f4a021b8d5e4491e48ec21e1a6","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/sr.json"},{"identity":"sha256:77d7c993e82c80a9d8b796f87cc739f3072160b147b71ce4ca2ec4b9a1bbfcd2","path":"design/requirements/scenarios/SCN-031-derive-clear-requirements-and-system-definitions-with-canonical-guidance.json"},{"identity":"sha256:24c7f20283bc9189ab223a419d11567b7b2e44fec51c644f2ad54540ea800f91","path":"design/requirements/scenarios/SCN-033-select-authoring-guidance-after-a-profile-change.json"},{"identity":"sha256:24c1b6e3f1eaef9be7f3eec5f0db0d042a1c2cbe700610b12c0ef7aa364fd30f","path":"design/requirements/scenarios/SCN-040-define-architectural-responsibilities-with-canonical-guidance.json"}],"text":"People and agents can identify the same applicable canonical guidance for their selected authoring activity and profile."},{"number":2,"sources":[{"identity":"sha256:132bd2696b15f1690dc63a4d1b46620c4e221ea38c2bf72e268b05eecaf65ada","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/ir.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:11164a5918fbd34a517dd0139be01d9ba96652f4a021b8d5e4491e48ec21e1a6","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/sr.json"},{"identity":"sha256:0a98d6e691a745754a985a49e118bac13e85c508ea60235eb5f99617d903626f","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/sr.json"},{"identity":"sha256:77d7c993e82c80a9d8b796f87cc739f3072160b147b71ce4ca2ec4b9a1bbfcd2","path":"design/requirements/scenarios/SCN-031-derive-clear-requirements-and-system-definitions-with-canonical-guidance.json"},{"identity":"sha256:52ab1aea07fb7dfb5351c872c3b494403478092f032ec93ea6d251f6724d678b","path":"design/requirements/scenarios/SCN-032-correct-and-retire-engineering-definitions-using-their-governing-rules.json"},{"identity":"sha256:24c1b6e3f1eaef9be7f3eec5f0db0d042a1c2cbe700610b12c0ef7aa364fd30f","path":"design/requirements/scenarios/SCN-040-define-architectural-responsibilities-with-canonical-guidance.json"}],"text":"Authors can understand how to produce and correct engineering definitions that express the intended need, behavior and responsibility without the originating conversation."},{"number":3,"sources":[{"identity":"sha256:132bd2696b15f1690dc63a4d1b46620c4e221ea38c2bf72e268b05eecaf65ada","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/ir.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:11164a5918fbd34a517dd0139be01d9ba96652f4a021b8d5e4491e48ec21e1a6","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/sr.json"},{"identity":"sha256:0a98d6e691a745754a985a49e118bac13e85c508ea60235eb5f99617d903626f","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/sr.json"},{"identity":"sha256:52ab1aea07fb7dfb5351c872c3b494403478092f032ec93ea6d251f6724d678b","path":"design/requirements/scenarios/SCN-032-correct-and-retire-engineering-definitions-using-their-governing-rules.json"},{"identity":"sha256:24c7f20283bc9189ab223a419d11567b7b2e44fec51c644f2ad54540ea800f91","path":"design/requirements/scenarios/SCN-033-select-authoring-guidance-after-a-profile-change.json"},{"identity":"sha256:24c1b6e3f1eaef9be7f3eec5f0db0d042a1c2cbe700610b12c0ef7aa364fd30f","path":"design/requirements/scenarios/SCN-040-define-architectural-responsibilities-with-canonical-guidance.json"}],"text":"Participants can identify unresolved analysis, unsupported representations and authority boundaries instead of mistaking advice for a confirmed decision or satisfied requirement."},{"number":4,"sources":[{"identity":"sha256:132bd2696b15f1690dc63a4d1b46620c4e221ea38c2bf72e268b05eecaf65ada","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/ir.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:98bbb8a10d2c65ed2107ae29b9de5961e6374a8f57d20c6ca2c7a1b16cdc9978","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-034-assess-guidance-using-semantic-authoring-outcomes/sr.json"},{"identity":"sha256:eb9cf4117d17600948ce6d7e2f4d7ed1befef8ee8267ce2c12dcd2603308d07a","path":"design/requirements/scenarios/SCN-034-assess-authoring-guidance-with-prepared-engineering-tasks.json"}],"text":"Guidance maintainers can distinguish observed semantic-task success from errors, assistance and unassessed scope for each participant group and source version."}],"sr_children":["SR-032","SR-033","SR-034"],"support":[{"identity":"sha256:4525d53548ca21f96682317bb31b7445ab9af65007f9a18de774be18ccf0d494","requirement":"SR-032"},{"identity":"sha256:62470a80e606da771f8077155d6e0a47d34529a850adef94f4009a18e61e8d52","requirement":"SR-033"},{"identity":"sha256:e2ed9aea4d71204e6f278af9282748e3540b00a191f78878a937a151f5044a80","requirement":"SR-034"}]},"reported_at":"2026-10-06T07:59:52Z","requirement":"IR-006","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"Four direct stakeholder outcomes across all three SRs; independent of child-count rollup.","state":"covered","subjects":[{"identity":"sha256:132bd2696b15f1690dc63a4d1b46620c4e221ea38c2bf72e268b05eecaf65ada","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/ir.json"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:25d6e04a47206a5d83867259de252532bb9d2990707c12ff5f60290dad665e82","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7616f27fa93749af2e127663bcfd04fef9579dff8d3ed0c5d00f63f872a245de","path":"design/system/functions/FUNC-032-select-canonical-guidance-for-an-authoring-activity.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:77d7c993e82c80a9d8b796f87cc739f3072160b147b71ce4ca2ec4b9a1bbfcd2","path":"design/requirements/scenarios/SCN-031-derive-clear-requirements-and-system-definitions-with-canonical-guidance.json"},{"identity":"sha256:24c7f20283bc9189ab223a419d11567b7b2e44fec51c644f2ad54540ea800f91","path":"design/requirements/scenarios/SCN-033-select-authoring-guidance-after-a-profile-change.json"},{"identity":"sha256:24c1b6e3f1eaef9be7f3eec5f0db0d042a1c2cbe700610b12c0ef7aa364fd30f","path":"design/requirements/scenarios/SCN-040-define-architectural-responsibilities-with-canonical-guidance.json"},{"identity":"sha256:e1219ca351ff6b902a6da757148d0bfd1a837a7eeca90cbedb68fec13c1f06f1","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/AR-079-bind-authoring-guidance-to-its-applicable-source-basis.json"},{"identity":"sha256:92153a9115ae4d3b6e0184a95c89e6b3b6ade3f80793c097b715abbe4286c265","path":"design/system/functions/FUNC-033-explain-engineering-authoring-and-correction-steps.json"},{"identity":"sha256:52ab1aea07fb7dfb5351c872c3b494403478092f032ec93ea6d251f6724d678b","path":"design/requirements/scenarios/SCN-032-correct-and-retire-engineering-definitions-using-their-governing-rules.json"},{"identity":"sha256:6c44ffbbe94834879a1b7047b6961bb7ed9c1b923b445c29bb0b3059a9dbd999","path":"rem/methods/5w2h.md"},{"identity":"sha256:6973551e7d8b2d709a8a99c4d819af049a3bdc0e25ea06e5c64cc0c78e5468e1","path":"rem/methods/requirement-analysis.md"},{"identity":"sha256:a095ea5dc500a5afcfb1eb9875c05ca80111f3af82eb53c8ea22f3613c5079be","path":"rem/methods/scenario-analysis.md"},{"identity":"sha256:70aca72b937bc5063b2fd130d3e050d3973c16b478426bdf78e7b34bd3c80cb4","path":"rem/methods/functional-analysis.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:6ce1497da7edf831832acbb0299a145d4a40d33f211eba88b45c993d34f30475","path":"rem/models/architecture-design.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:4d6e2356f9a742c605f56e636f4ef29c979024cf8eae2432ec46aa32c98f7acf","path":"rem/models/operational-support.md"},{"identity":"sha256:305c34fc2c2fe2997a7e3d672ab04d6616af8f8421a50c9b53ef25176deb4d29","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/requirement-analysis.md"},{"identity":"sha256:cb6137d5432b1273021274aa372a71d4a54b024b151e9ab704fd7697049c724e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/design-authoring.md"},{"identity":"sha256:4f0b1cae66ccb72d183467b891306975c837f873cafc5d2ff2f6c765492c8110","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/AR-080-explain-checkable-authoring-corrections-within-owner-boundaries.json"},{"identity":"sha256:fee3866fd49b961a63f7a9fa282eaaa20ad87233786368a7fe856f015aa20f69","path":"design/system/functions/FUNC-034-assess-authoring-guidance-against-prepared-task-outcomes.json"},{"identity":"sha256:eb9cf4117d17600948ce6d7e2f4d7ed1befef8ee8267ce2c12dcd2603308d07a","path":"design/requirements/scenarios/SCN-034-assess-authoring-guidance-with-prepared-engineering-tasks.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:eb4023bc54f433e22abd94a88aed99eae8d976bb4671c4ff5860d58f187aed6b","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-034-assess-guidance-using-semantic-authoring-outcomes/AR-081-compare-prepared-guidance-tasks-without-manufacturing-success.json"},{"identity":"sha256:11164a5918fbd34a517dd0139be01d9ba96652f4a021b8d5e4491e48ec21e1a6","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/sr.json"},{"identity":"sha256:0a98d6e691a745754a985a49e118bac13e85c508ea60235eb5f99617d903626f","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/sr.json"},{"identity":"sha256:98bbb8a10d2c65ed2107ae29b9de5961e6374a8f57d20c6ca2c7a1b16cdc9978","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-034-assess-guidance-using-semantic-authoring-outcomes/sr.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:cd533c0f858a1e476ee79f4a39cb43527b284b19a947710d87f1eac863b679c0","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"}],"summary":"Design Covered; observed guidance usefulness remains separate."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"Source-bound characterization and explicit reuse conditions preserve facts, hypotheses, exclusions and local-only disposition. Existing contributor confirmation/custody governs topic effects; a written account alone cannot create a general rule.","number":1,"state":"covered"},{"explanation":"Scoped acquisition, comparability/exclusion reasoning and exact adoption association compose usable lesson selection. Unavailable sources, insufficient context and no match remain distinct; a recommendation cannot override current policy.","number":2,"state":"covered"},{"explanation":"The proposal connects mechanism and intended changed behavior to exact subjects, owners and independent criteria. Explicit authorized owner handoff and decision/result association make adoption assessable while preserving route completion, unperformed effects and original findings separately.","number":3,"state":"covered"},{"explanation":"Prepared criteria, adopted-version binding, known opportunity order and actual recurrence/intended/adverse observations compose an inspectable effect account. Reproduction and later use are separate; missing opportunities, mixed evidence and changed context remain unassessed or require accountable reassessment.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-007\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Improve engineering practice from recorded lessons\",\n  \"status\": \"draft\",\n  \"statement\": \"Engineering teams and project maintainers need to turn lessons from engineering failures and review findings into applicable improvements to guidance, checks, or artifacts so that subsequent work benefits from what was learned.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A recorded failure or review finding can remain isolated from the guidance, checks, and artifacts used in later work.\",\n      \"desired_outcome\": \"Reusable findings inform adopted improvements whose applicability and effect on subsequent engineering work can be assessed.\"\n    },\n    \"why\": {\n      \"rationale\": \"Retaining an account of a mistake does not by itself change future practice. Teams need to act on supported lessons and assess whether the resulting changes help.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents performing work\",\n        \"Reviewers identifying recurring problems\",\n        \"Project maintainers and decision owners responsible for engineering practice\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"After an engineering failure or review finding reveals a reusable lesson, when relevant future work is prepared, and when an adopted improvement is assessed.\",\n        \"Select a retained lesson when a supported finding reveals a recurring failure, a reusable weakness in guidance or controls, or a single high-consequence failure with broader applicability. An isolated local correction without reusable implications remains with its owning Change.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within the project's governed engineering guidance, checks, artifacts, and the work to which a lesson applies.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Distinguish observations from inferred causes, record the lesson and its applicability, identify an improvement and its responsible owner, adopt it through controlled change, and assess its effect on later work. Before adopting an improvement, record the failure mechanism, applicable situations, intended changed behavior, responsible owner, and observable success and adverse-effect criteria. Verify the correction against the triggering scenario when reproducible, then assess its use during the next comparable engineering activity. Record whether the mechanism recurred, whether the intended behavior was observed, and any new confusion or burden. Adoption or a period without comparable work is not evidence of effectiveness.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers supported lessons and their use in improving engineering practice. IR-001 owns preservation of the underlying knowledge; IR-003 owns controlled adoption of changes; IR-004 owns evidence supporting claims of improvement. This need does not require automatic policy changes, a lesson for every local correction, or a guarantee that failures never recur. The initial authoring profile uses an opportunity-based observation period: assess effectiveness when the next comparable activity occurs, and reassess on a subsequent recurrence or material context change. If no comparable activity has occurred, record effectiveness as unassessed. Conclusions remain bounded to the observed activities; there is no universal calendar period, sample count, or guarantee of permanent improvement.\"\n    }\n  },\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Principles: Durable lessons\",\n      \"basis\": \"The vision commits to turning failures into improved guidance, checks, or artifacts that influence later engineering work.\"\n    },\n    {\n      \"source\": \"SRC-CONSTITUTION\",\n      \"locator\": \"Documentation and governance maintenance\",\n      \"basis\": \"The existing Constitution calls for durable reusable lessons rather than relying on conversation memory; no existing learning contract is replaced.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-EXPANSION\",\n      \"locator\": \"IR-007: Improve engineering practice from recorded lessons\",\n      \"basis\": \"The user authorized drafting the proposed need for learning and improvement as an additional IR.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"IR-007\",\n      \"basis\": \"Resolution of the recorded questions for the initial RigorLoop authoring profile under the user's instruction to solve them; the source register preserves the original questions and rationale.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"IR-007\",\n      \"basis\": \"Complete the draft IR-to-SR and Scenario/Feature/Function analysis for the existing declared scope; preserve the original need and separate draft analysis from implementation, approval, and satisfaction.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-011\",\n    \"SCN-035\",\n    \"SCN-036\",\n    \"SCN-037\",\n    \"SCN-038\",\n    \"SCN-039\"\n  ]\n}\n","identity":"sha256:4f64c018a1867b527cba8612fcf7863ed620d20a32085efa70cb8575680353cf","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/ir.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners.","Four reviewed outcomes interpret the existing IR need; they are not canonical IR acceptance criteria or observed improvement results."],"outcome_basis":{"identity":"sha256:b171674571cf41a197a7b520b6f974b45eaaa94ea0f1e9a4450aff8b4f0ec542","outcomes":[{"number":1,"sources":[{"identity":"sha256:4f64c018a1867b527cba8612fcf7863ed620d20a32085efa70cb8575680353cf","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/ir.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:ebe79d84d659cd5f09959503a0f70fcb56bf4af24ea55d1aeb8d2e0fbcc73d3c","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/sr.json"},{"identity":"sha256:6e6e8f2b34df676236b803d626f98d59fd15ff1babea8dbd5c9db4bfd6898d94","path":"design/requirements/scenarios/SCN-035-distinguish-a-reusable-lesson-from-a-local-correction.json"}],"text":"Teams can distinguish supported reusable learning from local corrections, unproven causes and contradictory evidence."},{"number":2,"sources":[{"identity":"sha256:4f64c018a1867b527cba8612fcf7863ed620d20a32085efa70cb8575680353cf","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/ir.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:de50b9b375e6c6a0e5788b844574b22923e692c48fc8a829408dec013a8a3650","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-036-present-applicable-lessons-when-preparing-engineering-work/sr.json"},{"identity":"sha256:d5566474984975e7119540894b3ca1b41263fba1bbcf8487b388578923eb6cb2","path":"design/requirements/scenarios/SCN-038-reassess-a-lesson-after-recurrence-or-a-material-context-change.json"},{"identity":"sha256:58690bee501e26908c54bcda63a053e2e0531cb3adf9e38aee2c13a48502c435","path":"design/requirements/scenarios/SCN-039-consult-applicable-lessons-before-comparable-engineering-work.json"}],"text":"Participants preparing later work can consult relevant learning with context limits and actual improvement disposition understood."},{"number":3,"sources":[{"identity":"sha256:4f64c018a1867b527cba8612fcf7863ed620d20a32085efa70cb8575680353cf","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/ir.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:ebe79d84d659cd5f09959503a0f70fcb56bf4af24ea55d1aeb8d2e0fbcc73d3c","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/sr.json"},{"identity":"sha256:8f46aba0702296137e78cc1c876ed5fc3e89b59ab6bdce2dbc72312fb183cf8d","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-037-prepare-accountable-improvements-for-controlled-adoption/sr.json"},{"identity":"sha256:6e6e8f2b34df676236b803d626f98d59fd15ff1babea8dbd5c9db4bfd6898d94","path":"design/requirements/scenarios/SCN-035-distinguish-a-reusable-lesson-from-a-local-correction.json"},{"identity":"sha256:581e922560085444e807efc6f2949e77f3768a8680edc56fbd6241a031b02d45","path":"design/requirements/scenarios/SCN-036-prepare-a-lesson-based-improvement-for-controlled-adoption.json"}],"text":"Supported lessons can inform accountable controlled improvements to the actual guidance, checks or artifacts used in subsequent work."},{"number":4,"sources":[{"identity":"sha256:4f64c018a1867b527cba8612fcf7863ed620d20a32085efa70cb8575680353cf","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/ir.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:7027c6f3b9bdb62edeed73dc99c5c68a4eb4f292ae91aa999b32d647ed81e142","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-038-assess-improvement-effects-at-comparable-opportunities/sr.json"},{"identity":"sha256:0de05bdb28f4476460fdbc047f8a36e01207b24107d26b57c671c88394e0a2f7","path":"design/requirements/scenarios/SCN-037-assess-an-improvement-during-the-next-comparable-activity.json"},{"identity":"sha256:d5566474984975e7119540894b3ca1b41263fba1bbcf8487b388578923eb6cb2","path":"design/requirements/scenarios/SCN-038-reassess-a-lesson-after-recurrence-or-a-material-context-change.json"}],"text":"Improvement owners can assess actual effects during comparable work and reconsider changed reliance without inventing success or rewriting prior meaning."}],"sr_children":["SR-035","SR-036","SR-037","SR-038"],"support":[{"identity":"sha256:cf1a3247a0ddbc0afd951970bcd800e7ae1cc975f113e4a52a75fa2ae2cd34c8","requirement":"SR-035"},{"identity":"sha256:b5f379f187b0cc0d0ff67e759c165b9ac76b6636c15ad2bd3fb5b79ce3e3637b","requirement":"SR-036"},{"identity":"sha256:62df7eaa047b841b2be17a28eed7de2c583e46bedee10a470646a00959bf36b4","requirement":"SR-037"},{"identity":"sha256:f3cd18c52c8d0c1db6b09c99235b0168096cc2589c2124466a76f2a7ad3335eb","requirement":"SR-038"}]},"reported_at":"2026-10-06T07:59:52Z","requirement":"IR-007","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"Four direct stakeholder outcomes across all four SRs; independent of child-count rollup.","state":"covered","subjects":[{"identity":"sha256:4f64c018a1867b527cba8612fcf7863ed620d20a32085efa70cb8575680353cf","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/ir.json"},{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:7be9f608eb844fa4a727aa04970221394d750ce9db45170a46b1667828205935","path":"design/system/functions/FUNC-035-characterize-a-reusable-lesson-from-an-engineering-finding.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:6e6e8f2b34df676236b803d626f98d59fd15ff1babea8dbd5c9db4bfd6898d94","path":"design/requirements/scenarios/SCN-035-distinguish-a-reusable-lesson-from-a-local-correction.json"},{"identity":"sha256:5a8c0fb149340b3f144e8080956543701d72b2b2dd37324f4034b70abed6dd76","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/AR-082-preserve-supported-lesson-meaning-and-reuse-limits.json"},{"identity":"sha256:055557862da7bf1cf6d1bdd6979c8495ac7f3239d588d7139532a407ceab58c8","path":"design/system/functions/FUNC-036-select-lessons-applicable-to-planned-engineering-work.json"},{"identity":"sha256:d5566474984975e7119540894b3ca1b41263fba1bbcf8487b388578923eb6cb2","path":"design/requirements/scenarios/SCN-038-reassess-a-lesson-after-recurrence-or-a-material-context-change.json"},{"identity":"sha256:58690bee501e26908c54bcda63a053e2e0531cb3adf9e38aee2c13a48502c435","path":"design/requirements/scenarios/SCN-039-consult-applicable-lessons-before-comparable-engineering-work.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:a2f18deb20a0b5ccb4412c87546ea8399a56a97f6b051882a9191c6ed3f47c08","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-036-present-applicable-lessons-when-preparing-engineering-work/AR-083-select-lessons-with-explicit-context-and-adoption-basis.json"},{"identity":"sha256:4040eff5bf024090b9b5a19df8f123e957f836f4ac23459f9ac7238f8f6d0b2e","path":"design/system/functions/FUNC-037-formulate-an-accountable-engineering-improvement-proposal.json"},{"identity":"sha256:581e922560085444e807efc6f2949e77f3768a8680edc56fbd6241a031b02d45","path":"design/requirements/scenarios/SCN-036-prepare-a-lesson-based-improvement-for-controlled-adoption.json"},{"identity":"sha256:f0ad6bd5c8ba479eeacf98501e0932dada28061109957c814f9c9e95dc0c90fa","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-037-prepare-accountable-improvements-for-controlled-adoption/AR-084-prepare-owner-bound-improvements-without-implying-adoption.json"},{"identity":"sha256:0cddbc39afd8e0e53e405042586d32c7d2870815b52b5361ef5a273a41683ded","path":"design/system/functions/FUNC-038-assess-observed-effects-of-an-adopted-engineering-improvement.json"},{"identity":"sha256:0de05bdb28f4476460fdbc047f8a36e01207b24107d26b57c671c88394e0a2f7","path":"design/requirements/scenarios/SCN-037-assess-an-improvement-during-the-next-comparable-activity.json"},{"identity":"sha256:2e2e63a4435c76e75a35b0c6c60de50050f859c736b817c1a361f6a3de42e4c7","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-038-assess-improvement-effects-at-comparable-opportunities/AR-085-compare-improvement-effects-at-identified-opportunities.json"},{"identity":"sha256:ebe79d84d659cd5f09959503a0f70fcb56bf4af24ea55d1aeb8d2e0fbcc73d3c","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/sr.json"},{"identity":"sha256:de50b9b375e6c6a0e5788b844574b22923e692c48fc8a829408dec013a8a3650","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-036-present-applicable-lessons-when-preparing-engineering-work/sr.json"},{"identity":"sha256:8f46aba0702296137e78cc1c876ed5fc3e89b59ab6bdce2dbc72312fb183cf8d","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-037-prepare-accountable-improvements-for-controlled-adoption/sr.json"},{"identity":"sha256:7027c6f3b9bdb62edeed73dc99c5c68a4eb4f292ae91aa999b32d647ed81e142","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-038-assess-improvement-effects-at-comparable-opportunities/sr.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8659ac60a4ce99ae2d2060ce693370719d622f17ced4d8937b1fdccef1b806f4","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/README.md"}],"summary":"Design Covered; actual adopted effects remain separate."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"MOD-010 admission, actual help/capabilities and independent result contracts compose predictable caller action. Explicit authority remains actor-owned; unsupported/proposed capabilities cannot acquire runtime support from a diagram or saved record.","number":1,"state":"covered"},{"explanation":"The scoped current-reader and separately proposed association/state-bound history contract supply attributable facts, complete selected accounts, coverage gaps and original meaning. Their distinct recovery/no-write profiles prevent a broad history claim or inferred approval.","number":2,"state":"covered"},{"explanation":"Complete typed candidate construction, explicit comparable replacement, preserved open issues and dependency reconciliation compose lossless current handoff. The actor owns semantic decisions; records and receipts neither supply review independence nor widen authority.","number":3,"state":"covered"},{"explanation":"Writer exclusion, guarded revisions, coherent transaction/payload publication and the corrected final external-basis observation compose reliable saves. Ordinary engine recovery and explicit fenced backup/restore/transfer/import retain separate authority, exact scope and historical meaning; lost responses never authorize replay or rollback of committed work.","number":4,"state":"covered"},{"explanation":"Prepared mandatory receipts and equivalent semantic projections retain actual effects, limitations and safe continuation despite output/log failures. Private finite diagnostic collection/lookup supplies factual troubleshooting only, leaving engineering judgment and current reliance with their owners.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-008\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Operate on recorded engineering work through reliable explicit commands\",\n  \"status\": \"draft\",\n  \"statement\": \"Engineers and engineering agents need a reliable command-line interface for inspecting recorded work, recording explicitly chosen engineering decisions, and recovering interrupted updates without losing information or mistaking mechanical command success for engineering authority.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Published command behavior, record preservation, and failure outcomes are not explicit in the initial REM model; broad knowledge and change capabilities alone do not explain how callers safely operate on the delivered recording interface. Callers should not have to navigate operational storage files or manage manifests to obtain context or record decisions; separate local history also needs explicit availability and recovery outcomes.\",\n      \"desired_outcome\": \"Callers obtain a coherent current handoff and record explicit decision-relevant changes through supported tasks, without managing storage layout or reconstructing activity history.\"\n    },\n    \"why\": {\n      \"rationale\": \"Automation and people depend on predictable commands, precise selection, preserved neighboring work, and outcomes that separate storage success from approval. The same responsibility applies when multiple local agents share operational records and when storage realization changes.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When selecting a command, inspecting project facts or exact recorded work, preparing or saving a decision, retrying or recovering an interrupted operation, and investigating an invocation.\",\n        \"When several local agents inspect or update the same project work, when history is absent or unavailable, and when explicitly creating, restoring, transferring or migrating operational backups.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The published local command-line interface, selected project operational records and retained evidence artifacts, explicit engineering subjects, backup/restore destinations, and private diagnostics; initially one checkout and one user with one or more local agents.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Provide bounded current-state reads and explicit updates with actor attribution, reference integrity, stale-write protection, atomic publication and truthful recovery outcomes. Retain selected history only under its declared scope; unavailable information is not empty state or approval. IR-003 owns handoff and retention meaning; this IR owns reliable commands.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers command admission, discovery, selected reads, explicit recording, concurrent local access, transaction recovery, result projection and private diagnostics, extended to supported operational backup, restoration, transfer and migration commands. SR-040–047 and new SR-078 express the revised draft operational obligations. Current allocations and source-observed facets describe the successor v2/v4 scope. SR-078 cross-Change history query remains a separate draft capability, excluded from this adoption. Earlier assessments retain their exact original subjects and do not establish coverage of new obligations. Installation content and policy remain separately owned. The scope does not introduce command support for editing REM design JSON, a workflow decision engine, hosted services, distributed history merging or new platform/performance guarantees. Database transaction recovery and backup restoration remain distinct operations; a fresh engineering checkout alone supplies no operational-history availability claim.\"\n    }\n  },\n  \"assumptions\": [\n    \"The selected local execution environment and destination storage support the requested operation; unavailable sources or destinations require explicit outcomes.\",\n    \"Operational restoration relies on the usable-backup scope and retention assumptions owned by IR-003. No hosted backup or recovery of destroyed copies is implied.\"\n  ],\n  \"constraints\": [\n    \"The CLI does not grant permission, choose workflow progression, or infer actor decisions from role labels, record shape, or command success.\",\n    \"The detailed contracts under MOD-010 Command handling and MOD-011 Work record storage retain authority for command behavior and independent version domains; relocation does not adopt or reinterpret a historical protocol.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-01, CLI-SR-03, CLI-SR-05, CLI-SR-06, CLI-SR-11, CLI-SR-29, CLI-SR-30; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-01, RF-SR-03, RF-SR-06\",\n      \"basis\": \"Recognizes the published command-line product need and mechanical safety obligations not fully expressed by the initial seven IRs; this is analytical representation, not runtime adoption of REM or approval transfer.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-RECORDS\",\n      \"locator\": \"IR-008\",\n      \"basis\": \"User-requested RR/proposal analysis selects refinement of existing needs rather than a new IR. Extends local operational-history and command scope while preserving identity; draft analysis does not adopt SQLite, approve requirements, or establish downstream coverage.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"IR-008\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"IR-008\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    },\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"IR-008\",\n      \"basis\": \"Reconcile the complete existing allocation with the selected current v2/v4 contract, preserving independent admission, coherent state, explicit scope and actor judgment. Prior version-specific sources retain their historical meaning.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-012\",\n    \"FEAT-013\",\n    \"FEAT-014\",\n    \"SCN-041\",\n    \"SCN-042\",\n    \"SCN-043\",\n    \"SCN-044\",\n    \"SCN-045\",\n    \"SCN-046\",\n    \"SCN-047\",\n    \"SCN-048\",\n    \"SCN-049\",\n    \"SCN-074\"\n  ]\n}\n","identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval.","Five reviewed stakeholder outcomes interpret the IR need; they are not canonical IR acceptance criteria, observed satisfaction or automatic child rollup."],"outcome_basis":{"identity":"sha256:762bb5da075989a79f91935cd0656c9e286d1f07373c1bced0e18f6083cb564f","outcomes":[{"number":1,"sources":[{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:e304e00066c398fba035c8fee2830adce7ea0efa808610eb8612793a2017f253","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-040-preserve-explicit-command-admission-and-independent-interface-contracts/sr.json"},{"identity":"sha256:9edd655f49189ce4a3f5c07c6e2e86777637cbcc101592f300f2882f527302fd","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/sr.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:5629433dc27cb2b45944921611af247764f69da3a6fe11e6138ea1b7ff23a1b7","path":"design/requirements/scenarios/SCN-048-choose-a-supported-command-using-its-declared-usage.json"}],"text":"Callers can select and understand a supported explicit operation without accidental access, protocol fallback or invented authority."},{"number":2,"sources":[{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:3c2601dee21b1a7fe6e82bbfd1ed47a62d688a4113fc4592d21f993b7b62fe20","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-041-return-coherent-explicitly-selected-engineering-records-and-subject-identities/sr.json"},{"identity":"sha256:9edd655f49189ce4a3f5c07c6e2e86777637cbcc101592f300f2882f527302fd","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/sr.json"},{"identity":"sha256:7ebd9cd8729128c41367446a55b653064b9ccde5fa8cb917b61e96dad53b2190","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/sr.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:9f0b980de8e9d541750e92fb77501942c11e28a276f91512533a345079dcd063","path":"design/requirements/scenarios/SCN-041-inspect-project-capabilities-before-selecting-work.json"},{"identity":"sha256:493f3c1107304217d4b5de0c5496d8cd984f3ff7f9904e1bca83314c632d2b90","path":"design/requirements/scenarios/SCN-042-read-a-selected-assessment-with-its-explanation-and-scope.json"},{"identity":"sha256:ffe67097574f6881e49954d693004ee00a4cf0f1afda38c5b943659483e0cbd3","path":"design/requirements/scenarios/SCN-043-check-declared-subjects-before-recording-a-decision.json"},{"identity":"sha256:1b09d668b36443dce465d605279296ff3c1c8b61f2c67ecf3fb4e2844cb8ef30","path":"design/requirements/scenarios/SCN-074-inspect-retained-change-history-for-an-engineering-subject.json"}],"text":"Engineers can obtain coherent current work and explicitly bounded retained history without treating unavailable information as empty state or approval."},{"number":3,"sources":[{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:47d951f11efe0fe318382c04f401eec0d044537042aef6991c4172849fd817b6","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-042-validate-current-operational-candidates-without-inventing-decisions/sr.json"},{"identity":"sha256:9faf4546b6f931bfab3ee2ab3a25a6c54d6e149dd1ca696f60af47479f3dce20","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-043-construct-lossless-updates-from-explicit-engineering-decisions/sr.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:f3aeddef09c7da239b5431e88629b906e9e043bca9c5df5772eabc06038cfcb9","path":"design/requirements/scenarios/SCN-044-correct-an-assessment-without-losing-open-work.json"},{"identity":"sha256:5457eada63dd327c0ee77402a9052b3b2e87e5c8d64b6d9a39797674bf262d6d","path":"design/requirements/scenarios/SCN-045-record-a-discovered-problem-after-work-was-marked-complete.json"}],"text":"Actors can record chosen decision-relevant changes while preserving neighboring work, unresolved obligations and judgments still relied upon."},{"number":4,"sources":[{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:e304e00066c398fba035c8fee2830adce7ea0efa808610eb8612793a2017f253","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-040-preserve-explicit-command-admission-and-independent-interface-contracts/sr.json"},{"identity":"sha256:9b9091d0f23302efc6f9b390dfcf37b0a0147d81654b1414be5b959ac9576719","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-044-publish-record-updates-with-fresh-basis-and-coherent-durable-outcomes/sr.json"},{"identity":"sha256:0081301c4178d94946ea6ed316d9bdffeb4bb429934d6d8fcc35df17598abc0d","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-045-recover-interrupted-record-transactions-without-guessing-or-replaying-decisions/sr.json"},{"identity":"sha256:9edd655f49189ce4a3f5c07c6e2e86777637cbcc101592f300f2882f527302fd","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/sr.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:30d87e927c32b7c0e9cdbef10d645103f660ac4b5b636816b99ad4fe884fbbc4","path":"design/requirements/scenarios/SCN-046-publish-related-record-decisions-as-one-coherent-update.json"},{"identity":"sha256:66c20fce80f38f2429eb9c46d3b32364bed9b100a1613fa239894b46d46ce71c","path":"design/requirements/scenarios/SCN-047-establish-the-outcome-of-an-interrupted-recorded-update.json"}],"text":"Concurrent work, interruption and explicit operational preservation have coherent actual outcomes that callers can safely reconcile."},{"number":5,"sources":[{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:e304e00066c398fba035c8fee2830adce7ea0efa808610eb8612793a2017f253","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-040-preserve-explicit-command-admission-and-independent-interface-contracts/sr.json"},{"identity":"sha256:9edd655f49189ce4a3f5c07c6e2e86777637cbcc101592f300f2882f527302fd","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/sr.json"},{"identity":"sha256:a73868f4f79d0e8e41fd3594cb8ef1da0748b4acf6d3922447e70cd9ba44917f","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-047-keep-local-command-diagnostics-private-and-semantically-independent/sr.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:5629433dc27cb2b45944921611af247764f69da3a6fe11e6138ea1b7ff23a1b7","path":"design/requirements/scenarios/SCN-048-choose-a-supported-command-using-its-declared-usage.json"},{"identity":"sha256:eda2ed4b379547101bc67642f0c737a4dd3b41adb8a3a0a05e19a2acc91320e1","path":"design/requirements/scenarios/SCN-049-inspect-available-invocation-diagnostics-without-changing-command-meaning.json"}],"text":"Callers can understand bounded faithful outcomes and investigate private diagnostics without confusing mechanical success with engineering acceptance."}],"sr_children":["SR-040","SR-041","SR-042","SR-043","SR-044","SR-045","SR-046","SR-047","SR-078"],"support":[{"identity":"sha256:e2166ffe02f6c6c469cadb5f65ea5cccedfe0bd5579a04045f4885b671dc0dcb","requirement":"SR-040"},{"identity":"sha256:22ac93b007cc561c7c058e91600f2d7ce0b5b5a21169b2def159d4c79f9666eb","requirement":"SR-041"},{"identity":"sha256:c43ac0e3d880d48bec984415491e032648bdf625c190e2802c761679122ddc04","requirement":"SR-042"},{"identity":"sha256:2e861c6271ccad6c04fa80b3dc1aae4287c28b03ef70c0a0637a28a2b3dfa50c","requirement":"SR-043"},{"identity":"sha256:ae221676577f68c6f589f85479036038a8c2f1a1c33506db8d77100e709d0146","requirement":"SR-044"},{"identity":"sha256:e3e0e0e427b2a4ede459537f6f27f6e0d62893147f0b87be14fd284f067f99d2","requirement":"SR-045"},{"identity":"sha256:c66cf2a5cecb50259e790dd003984c2575c2ac739aba81425d2f953753ef0956","requirement":"SR-046"},{"identity":"sha256:4a5d264b53b6df4a86016981a2178b4aaae2bbe9781515dea31214517c5794b6","requirement":"SR-047"},{"identity":"sha256:0aa3a20268333171bbc578fdf65d573b972cc8c635d83bdee81b8311def661be","requirement":"SR-078"}]},"reported_at":"2026-10-06T07:59:52Z","requirement":"IR-008","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"Five direct stakeholder outcomes across all nine SRs; independent of child coverage counts.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:e304e00066c398fba035c8fee2830adce7ea0efa808610eb8612793a2017f253","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-040-preserve-explicit-command-admission-and-independent-interface-contracts/sr.json"},{"identity":"sha256:3c2601dee21b1a7fe6e82bbfd1ed47a62d688a4113fc4592d21f993b7b62fe20","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-041-return-coherent-explicitly-selected-engineering-records-and-subject-identities/sr.json"},{"identity":"sha256:47d951f11efe0fe318382c04f401eec0d044537042aef6991c4172849fd817b6","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-042-validate-current-operational-candidates-without-inventing-decisions/sr.json"},{"identity":"sha256:9faf4546b6f931bfab3ee2ab3a25a6c54d6e149dd1ca696f60af47479f3dce20","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-043-construct-lossless-updates-from-explicit-engineering-decisions/sr.json"},{"identity":"sha256:9b9091d0f23302efc6f9b390dfcf37b0a0147d81654b1414be5b959ac9576719","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-044-publish-record-updates-with-fresh-basis-and-coherent-durable-outcomes/sr.json"},{"identity":"sha256:0081301c4178d94946ea6ed316d9bdffeb4bb429934d6d8fcc35df17598abc0d","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-045-recover-interrupted-record-transactions-without-guessing-or-replaying-decisions/sr.json"},{"identity":"sha256:9edd655f49189ce4a3f5c07c6e2e86777637cbcc101592f300f2882f527302fd","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/sr.json"},{"identity":"sha256:a73868f4f79d0e8e41fd3594cb8ef1da0748b4acf6d3922447e70cd9ba44917f","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-047-keep-local-command-diagnostics-private-and-semantically-independent/sr.json"},{"identity":"sha256:7ebd9cd8729128c41367446a55b653064b9ccde5fa8cb917b61e96dad53b2190","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/sr.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:9f0b980de8e9d541750e92fb77501942c11e28a276f91512533a345079dcd063","path":"design/requirements/scenarios/SCN-041-inspect-project-capabilities-before-selecting-work.json"},{"identity":"sha256:493f3c1107304217d4b5de0c5496d8cd984f3ff7f9904e1bca83314c632d2b90","path":"design/requirements/scenarios/SCN-042-read-a-selected-assessment-with-its-explanation-and-scope.json"},{"identity":"sha256:ffe67097574f6881e49954d693004ee00a4cf0f1afda38c5b943659483e0cbd3","path":"design/requirements/scenarios/SCN-043-check-declared-subjects-before-recording-a-decision.json"},{"identity":"sha256:f3aeddef09c7da239b5431e88629b906e9e043bca9c5df5772eabc06038cfcb9","path":"design/requirements/scenarios/SCN-044-correct-an-assessment-without-losing-open-work.json"},{"identity":"sha256:5457eada63dd327c0ee77402a9052b3b2e87e5c8d64b6d9a39797674bf262d6d","path":"design/requirements/scenarios/SCN-045-record-a-discovered-problem-after-work-was-marked-complete.json"},{"identity":"sha256:30d87e927c32b7c0e9cdbef10d645103f660ac4b5b636816b99ad4fe884fbbc4","path":"design/requirements/scenarios/SCN-046-publish-related-record-decisions-as-one-coherent-update.json"},{"identity":"sha256:66c20fce80f38f2429eb9c46d3b32364bed9b100a1613fa239894b46d46ce71c","path":"design/requirements/scenarios/SCN-047-establish-the-outcome-of-an-interrupted-recorded-update.json"},{"identity":"sha256:5629433dc27cb2b45944921611af247764f69da3a6fe11e6138ea1b7ff23a1b7","path":"design/requirements/scenarios/SCN-048-choose-a-supported-command-using-its-declared-usage.json"},{"identity":"sha256:eda2ed4b379547101bc67642f0c737a4dd3b41adb8a3a0a05e19a2acc91320e1","path":"design/requirements/scenarios/SCN-049-inspect-available-invocation-diagnostics-without-changing-command-meaning.json"},{"identity":"sha256:1b09d668b36443dce465d605279296ff3c1c8b61f2c67ecf3fb4e2844cb8ef30","path":"design/requirements/scenarios/SCN-074-inspect-retained-change-history-for-an-engineering-subject.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:0f369ea622bb533f2d51e26efe1a11881d3671646f6e6be2b662af4c4afca819","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/history-selection.md"},{"identity":"sha256:d679737e5385227ecd2100b394060797eeb399de2c2821791d96bf30c9488a04","path":"design/architecture/modules/MOD-018-engineering-operations/test-design.md"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The current twenty-entry source catalog and common MOD-012 selection composition preserve responsibility, trigger, near-miss and specialist output meaning. Exact profile and installed availability remain explicit, so an unsuitable or unsupported activity stops without inventing capability.","number":1,"state":"covered"},{"explanation":"Corrected conditional FUNC-051 and the common invocation contract prepare real project scope, exact resource closure and actual output mode. Late triggers require fresh preparation before dependent work; sufficient portable work needs no internal documents or CLI, while actual governance cannot be bypassed.","number":2,"state":"covered"},{"explanation":"Complete applicable specialist procedures and output groups compose with existing authority, evidence and context owners. Retention returns actual persistence outcomes, while isolated scope, corrective ownership, independent judgment and separately authorized continuation remain distinguishable.","number":3,"state":"covered"},{"explanation":"Canonical requirement methods support justified reuse and the first independent gate; distinct System/Architecture authors feed one integrated Design assessment. Current milestones, advisory findings, one whole-change review and distinct Verify retain exact support and route defects without creating per-method or milestone approval gates.","number":4,"state":"covered"},{"explanation":"The accepted refined need is composed by new/compatible/incompatible-dependency dispositions, supported recording and qualified necessary migration. Explicit absence is admissible only with attributable inspection; missing facts remain unresolved. Fresh authority, exact work/candidate identities, guarded per-Change activation and recovery preserve original judgments and truthful partial scope. Unavailable required migration blocks affected adoption rather than forcing an unrelated import, empty-store substitution or unsupported fallback.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-009\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Carry out portable guided engineering work across the project lifecycle\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-05\",\n      \"basis\": \"The published Skills product provides distinct portable engineering capabilities across project lifecycle activities; this need restores that product scope to the REM draft without migrating every specialist clause or adopting new output formats.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-24\",\n      \"basis\": \"The published Skills product provides distinct portable engineering capabilities across project lifecycle activities; this need restores that product scope to the REM draft without migrating every specialist clause or adopting new output formats.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-25\",\n      \"basis\": \"The published Skills product provides distinct portable engineering capabilities across project lifecycle activities; this need restores that product scope to the REM draft without migrating every specialist clause or adopting new output formats.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-27\",\n      \"basis\": \"The published Skills product provides distinct portable engineering capabilities across project lifecycle activities; this need restores that product scope to the REM draft without migrating every specialist clause or adopting new output formats.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"IR-009\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-ADOPTION-DEPENDENCY-REFINEMENT\",\n      \"locator\": \"IR-009; SR-079–083; SCN-082\",\n      \"basis\": \"User-authorized scope refinement: compatible recording for selected work, historical import only when required by its dependencies, and blocked affected adoption when necessary migration is unavailable. Preserve identities, original judgments and separate portable authoring; no workflow activation or migration is performed.\"\n    }\n  ],\n  \"statement\": \"People working with engineering agents need discoverable and usable guidance for carrying out bounded engineering activities across a project lifecycle, so they can produce the appropriate artifacts, corrections, assessments, and handoffs under their own project authority without depending on RigorLoop repository internals.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Model-authoring guidance alone does not cover choosing a capability, investigating a project, implementing or repairing software, assessing work, and coordinating the resulting handoff in a customer project. A proposal-based entry and combined design authoring can confuse request sources with durable requirements, while milestone approval cycles can duplicate the complete-change review gate.\",\n      \"desired_outcome\": \"People can select an applicable engineering capability and use its project-portable instructions, resources, and specialist output contract to complete or explicitly stop the requested activity. Participants can establish a reviewed requirement basis, develop logical and architectural design under distinct ownership, and deliver through explicit assessment dependencies without unnecessary per-milestone approvals.\"\n    },\n    \"why\": {\n      \"rationale\": \"A reusable engineering method needs usable specialist guidance at the point of work while preserving local governance and the differences between making an artifact, judging it, and authorizing another action.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and maintainers using engineering agents\",\n        \"Reviewers and project decision owners\",\n        \"Maintainers of published engineering guidance\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When selecting, starting, resuming, correcting, reviewing, or handing off an engineering activity.\",\n        \"When analyzing a new request, reusing or revising existing requirements, composing System and Architecture Design, implementing milestones, correcting review findings, or adopting a replacement workflow.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Customer projects using published capabilities, including projects without RigorLoop-specific internal documents or CLI recording.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Provide distinct capability descriptions, resolve project context and authority, select applicable resources, guide the requested specialist procedure, and report usable outputs and remaining limits. Use the supported CLI procedure only when governed recording applies. Existing authority, work-context, evidence, model-authoring, and learning responsibilities remain shared rather than copied into this need. Treat requests, proposals, issues and incidents as RR input. Analyze existing needs before creating entities. Requirement Review establishes the first accepted basis; System Design and Architecture Design remain distinct authoring responsibilities with one integrated Design Review. Milestones organize implementation and proof, with optional interim advice and one independent whole-change Code Review gate before distinct final Verify. Reassessment may repeat within a gate. Scope and authority determine continuation; support methods are not automatic extra stages.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The refined scope covers the requirement-first workflow, authoring ownership, stage-specific assessment dependencies, bounded isolated activities and coordinated adoption of published guidance. Existing detailed specialist contracts remain active until reviewed replacement and explicit adoption; the draft does not claim that the new skill names or CLI operations already exist. It adds no new IR, universal requirement to edit already adequate entities, standalone RR file, preliminary proposal approval, mandatory milestone approval or per-method approval gates. Package generation, installation and release remain separately owned. Workflow authoring can precede storage delivery. Activation requires compatible recording for the selected work; migration is a prerequisite only where that work depends on incompatible earlier records. A fresh store cannot substitute for unresolved active-work dependencies.\"\n    }\n  },\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Requirement approval establishes a basis for design; it does not require complete Function or AR allocation or grant implementation or external-action authority.\",\n    \"One whole-change Code Review gate may contain several independent assessment attempts. Optional advisory feedback cannot settle that gate or be ignored when it exposes a material defect.\"\n  ],\n  \"confirms\": [\n    \"FEAT-015\",\n    \"FEAT-016\",\n    \"FEAT-017\",\n    \"SCN-050\",\n    \"SCN-051\",\n    \"SCN-052\",\n    \"SCN-053\",\n    \"SCN-054\",\n    \"SCN-055\",\n    \"SCN-056\",\n    \"SCN-057\",\n    \"SCN-075\",\n    \"SCN-076\",\n    \"SCN-077\",\n    \"SCN-078\",\n    \"SCN-079\",\n    \"SCN-080\",\n    \"SCN-081\",\n    \"SCN-082\"\n  ]\n}\n","identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history.","These five direct stakeholder outcomes interpret the IR need; they are not canonical IR acceptance criteria or a child-count rollup."],"outcome_basis":{"identity":"sha256:85adbf3376ee6f8613231825fabfedb2af4ae17b19b264a3146d953610393842","outcomes":[{"number":1,"sources":[{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:fd554559017ae6310fe77a7b15616391658fb8c502856be1a71b45d167aa234d","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-050-expose-distinct-published-engineering-capabilities/sr.json"},{"identity":"sha256:a7ad408882173736229e214d52b8c29f945bfd951e164b4613234b3d27f3d7cf","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-053-guide-specialist-engineering-work-with-usable-scoped-outputs/sr.json"},{"identity":"sha256:638ef3ed7e8a868af9ff1074050b045639478e92a9e0a0b238f0f14c1ae40a4f","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-056-preserve-guidance-meaning-and-evidence-quality-across-reading-paths/sr.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:f8fa34126526a01fb8243692317664d0bd6c08ca94c7172cd8479374e4596bea","path":"design/requirements/scenarios/SCN-050-choose-the-right-capability-for-an-engineering-task.json"},{"identity":"sha256:37218fceae718a00aa4098f326e0a598aa864d20dad72a2546209d541084514c","path":"design/requirements/scenarios/SCN-053-produce-a-usable-result-through-specialist-guidance.json"},{"identity":"sha256:0c1a5799fddeb358e853a424c93df29daee33388f4dd7aadabe23ec97fffb896","path":"design/requirements/scenarios/SCN-054-receive-a-scoped-independent-engineering-assessment.json"}],"text":"People can discover and select a capability matching a bounded engineering activity and understand its purpose, limits and useful output."},{"number":2,"sources":[{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1f319588cceff19d5d029028cfc591762ac34814ba448fea41734fdb09a33b46","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-051-prepare-project-portable-engineering-invocations/sr.json"},{"identity":"sha256:828670bc5b5cad21702122f5594b697b631f6fbcd4d785f5bae75fb39641ffe9","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-052-select-complete-resources-for-the-invoked-engineering-path/sr.json"},{"identity":"sha256:ad10d1c4ab270a32df2c440cc33cabb5106c2412ca392d51a07be01a62b9751f","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-055-separate-portable-output-from-governed-recording/sr.json"},{"identity":"sha256:638ef3ed7e8a868af9ff1074050b045639478e92a9e0a0b238f0f14c1ae40a4f","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-056-preserve-guidance-meaning-and-evidence-quality-across-reading-paths/sr.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:ad6614a6bb8310e00be68db5fd44eceba534c809e53d92d5a80348c4f726566d","path":"design/requirements/scenarios/SCN-051-start-portable-work-in-a-customer-project.json"},{"identity":"sha256:f60f67b331f0e449b8ed8cf380e397b3309f4fcf03b8ff20371396f1ba4ac09e","path":"design/requirements/scenarios/SCN-052-obtain-the-complete-guidance-required-by-a-selected-path.json"},{"identity":"sha256:25119c6158e04ad05f02b304fe49080e5ff4b2f77964aeb0b646481bb8c58f8b","path":"design/requirements/scenarios/SCN-055-hand-off-completed-work-without-overstating-readiness.json"},{"identity":"sha256:a6a92ffd6a680ff2850d3b708d816e7df3e0d4dfc674020b35682a538d634575","path":"design/requirements/scenarios/SCN-056-record-a-governed-activity-through-the-supported-procedure.json"},{"identity":"sha256:fc4741477bf090569c26f8f1260e4b4a6e78024a02a229e25f4fc630fc46bee9","path":"design/requirements/scenarios/SCN-057-recognize-a-recording-obligation-discovered-during-portable-work.json"}],"text":"Authorized customer-project work can use the required guidance and resources without depending on RigorLoop repository internals or unnecessary governed recording."},{"number":3,"sources":[{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:a7ad408882173736229e214d52b8c29f945bfd951e164b4613234b3d27f3d7cf","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-053-guide-specialist-engineering-work-with-usable-scoped-outputs/sr.json"},{"identity":"sha256:4cf6aab0d766d9d3981226919a3db62b3a11ff6c08f4170b9a150868067748cd","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-054-coordinate-engineering-handoffs-using-applicable-work-and-assessment-state/sr.json"},{"identity":"sha256:ad10d1c4ab270a32df2c440cc33cabb5106c2412ca392d51a07be01a62b9751f","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-055-separate-portable-output-from-governed-recording/sr.json"},{"identity":"sha256:638ef3ed7e8a868af9ff1074050b045639478e92a9e0a0b238f0f14c1ae40a4f","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-056-preserve-guidance-meaning-and-evidence-quality-across-reading-paths/sr.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:37218fceae718a00aa4098f326e0a598aa864d20dad72a2546209d541084514c","path":"design/requirements/scenarios/SCN-053-produce-a-usable-result-through-specialist-guidance.json"},{"identity":"sha256:0c1a5799fddeb358e853a424c93df29daee33388f4dd7aadabe23ec97fffb896","path":"design/requirements/scenarios/SCN-054-receive-a-scoped-independent-engineering-assessment.json"},{"identity":"sha256:25119c6158e04ad05f02b304fe49080e5ff4b2f77964aeb0b646481bb8c58f8b","path":"design/requirements/scenarios/SCN-055-hand-off-completed-work-without-overstating-readiness.json"},{"identity":"sha256:a6a92ffd6a680ff2850d3b708d816e7df3e0d4dfc674020b35682a538d634575","path":"design/requirements/scenarios/SCN-056-record-a-governed-activity-through-the-supported-procedure.json"},{"identity":"sha256:fc4741477bf090569c26f8f1260e4b4a6e78024a02a229e25f4fc630fc46bee9","path":"design/requirements/scenarios/SCN-057-recognize-a-recording-obligatio