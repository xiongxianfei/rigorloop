module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:bbab4a06bc1dfa726412666c9247c99c1c9c3e50f0e8fcf6ea25b7abb5e9e6b7","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/sr.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:6edf5726ab6d760956942141036b874a21934635a926169cb18d036c5303485f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-043-capture-attributable-customer-model-inputs.json"},{"identity":"sha256:f1ee063db8c6aeb54fa1f7fabffefb2d4abc1cd143eb56a69a16d0791aefd104","path":"design/requirements/scenarios/SCN-008-follow-responsibility-paths-within-a-selected-model-state.json"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:6ce1497da7edf831832acbb0299a145d4a40d33f211eba88b45c993d34f30475","path":"rem/models/architecture-design.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:4468263bc7759fe571752a4ec75f0b067f113a2163481df40c7c469e51777b1d","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/sr.json"},{"identity":"sha256:d4a820120577846f12878a269f912732b9e017ebfd09df84b9465410d38789b3","path":"design/system/functions/FUNC-008-author-typed-engineering-relationships.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:8660c0b4e3d969b44be6dd640f3a2d9ff4ad81c2d0202ea4ba6c33900ed0dd00","path":"design/system/functions/FUNC-005-revise-engineering-entity-while-preserving-identity.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:1b06bdee00ba1323e3ef88fcd3bd580f61d1df954e9393fae91f9101677f0861","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-001-retain-accepted-definitions-beyond-the-authoring-session.json"},{"identity":"sha256:47efc8fa6fe91e2947a1ac3fdd1a5dbb4a8328e4e89ec5dd16589def6703e104","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-003-check-candidate-identities-over-an-explicit-model-scope.json"},{"identity":"sha256:0b6d193cf874537ad68e03df84b6796763572c2a541210f1b75cba2f0631e941","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/AR-005-preserve-identity-when-applying-supported-definition-revisions.json"},{"identity":"sha256:eccf9da9452b46542f3f33d329f5124f982ca6f481bb28f07bb247b7269fed2b","path":"design/requirements/scenarios/SCN-007-apply-a-relationship-change-and-inspect-both-endpoint-views.json"},{"identity":"sha256:56978c46744fbe04bf2a3815ba42b6269d01f80c06202dfc9a1a0e65b96ead9a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/sr.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"},{"identity":"sha256:628f24b4ad9f21faa44d6bf3884f35b5a0be79430c8e39950cb648c570152350","path":"design/system/functions/FUNC-011-report-possible-change-impact.json"},{"identity":"sha256:c5424c9b92e6f55bcc1256fd46b6243ab1a21a1ee60f97ab085702b9e27d712f","path":"design/requirements/scenarios/SCN-009-review-converging-requirement-and-function-responsibilities.json"},{"identity":"sha256:a7e3dd88ebfa694d4d16ab8b1510ffc6ecf74e97b02a044253be8933f318abd3","path":"design/requirements/scenarios/SCN-010-investigate-possible-impact-of-a-proposed-engineering-change.json"},{"identity":"sha256:c400ae83432acce60523b9624b79d1d6fc59f316c41c22e4cd815645b7640089","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/AR-060-assess-declared-allocation-with-explicit-rule-and-scope.json"},{"identity":"sha256:ebc04b8f7806761e8d29769aa5b6721813f2dfa801a4cda0dc8bda178f31a7f9","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-011-explain-possible-change-impact-through-engineering-paths/sr.json"},{"identity":"sha256:49574e3fd17329f3aa794b8975763733d11bf912262da2158263b67ec88bfd4e","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-011-explain-possible-change-impact-through-engineering-paths/AR-061-compose-witnessed-potential-impact-with-traversal-limits.json"},{"identity":"sha256:04d46256b799f5ba92f3481ef6692ca5ecbab5c632ea507dc8f7fbcaa32f132a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/sr.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:d63539c2f78036f0df7d6ef45a9cf1cb726c55d1b833bd273be2192e8a48b2e4","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-044-interpret-the-selected-browser-model-profile.json"},{"identity":"sha256:7fbb360f4c9304bea3481d357750eff651b24061a4c702a317aae0c4dea94266","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-045-compose-customer-architecture-snapshot-content.json"},{"identity":"sha256:a449de0f92f9099ffef32cf3f6b42e39f06f6569ceedccfd2736a1487152ac39","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-086-read-portable-architecture-snapshots-offline/sr.json"},{"identity":"sha256:7cc7f61a3b2c12b5606b03c8ecf3ed719744b62cd23495e7cfe18b850109e7d6","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-086-read-portable-architecture-snapshots-offline/AR-047-provide-portable-offline-architecture-reading.json"},{"identity":"sha256:2844f7d466b58a52365f9e337cdb07f46da798a17e8edf3a64ca81b241d3b0f3","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-087-generate-architecture-snapshots-within-safe-output-boundaries/sr.json"},{"identity":"sha256:8c4e30b58e355580d1693a2c0fca19a572d660b2c1419f24887fd3c958533d4c","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-087-generate-architecture-snapshots-within-safe-output-boundaries/AR-048-preserve-source-and-output-boundaries-during-snapshot-publication.json"},{"identity":"sha256:0f980f9704b8d15537eb8254db2ee7a73bc77843930bb5c4b32e72a9640d60fc","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/ir.json"},{"identity":"sha256:24dac0c40541fae86a5565d514d1a91cd80df6fdca1d76eeec2f75704583691f","path":"design/requirements/scenarios/SCN-083-generate-architecture-views-for-a-customer-project.json"},{"identity":"sha256:af85807362a5790ca75c5747efc91132e6eae9438d006dd0b0a62beaa729e66d","path":"design/requirements/scenarios/SCN-084-read-a-copied-architecture-snapshot-offline.json"},{"identity":"sha256:c14916c265533dca374bb18d3f948cafbc3821c154ab1dc7c5452497b776d26a","path":"design/requirements/scenarios/SCN-085-preserve-prior-architecture-output-when-generation-fails.json"},{"identity":"sha256:e19e1827c421b667a80889ae8d918be9a1a75e0a885fe2fd397cbe36f32e7894","path":"design/requirements/scenarios/SCN-086-distinguish-proposed-behavior-from-observed-architecture.json"},{"identity":"sha256:ee1303ac9c01e11d53b3d6af2c47fc915d37488f8db490d9de524c106bc7f9f3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-delivery-format.md"},{"identity":"sha256:915876f00dba078b8ffefdcd17f951997f444485c5545548d679d2f2d1d2f477","path":"design/support/requirement-delivery-v2.schema.json"},{"identity":"sha256:740c7e8a8398bce4a2046ef49f685d37bf516875e7d562ae102464bff8579f1b","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-evaluation.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":null,"criteria":[{"explanation":"The current handoff’s seven single-owner sections, complete selectors and bounded coherent reads supply an eligible next action with known uncertainty. IF-009 applies exact existing grants/conditions without redundant session confirmation; missing/stale support withholds affected reliance. Supported Operations custody supplies current facts while current model definitions remain independent.","number":1,"state":"covered"},{"explanation":"Transition/resumption ownership composes attributable actual outcomes, before/result basis, explicit issue disposition, assessment-owned support and compact historical completion. Comparable routine evidence can be replaced without losing current reliance or cross-scope failures; unavailable older detail stays unavailable. This supplies useful continuity rather than assuming every activity was retained.","number":2,"state":"covered"},{"explanation":"State-control composition separates baseline identity/coherence in MOD-005, exact immutable custody in MOD-001 and transition/retirement semantics in MOD-006. Original rule/content/provenance integrity supports stable-ID comparison and verified isolated recovery without active-work overwrite; unavailable scope cannot claim complete meaning-preserving recovery.","number":3,"state":"covered"},{"explanation":"MOD-011 holds coherent record/payload capture, validates accessible complete backups without the lost source, and uses fenced exact staging/activation with new incarnation and truthful interruption outcomes. Same-project empty transfer preserves both histories; qualified migration preserves exact originals/dispositions and controls source writers/consumers before one target becomes authoritative.","number":4,"state":"covered"},{"explanation":"The two composition cases keep engineering Baselines and operational backups separate: restoring operational context references original model subjects and cannot recover later model edits or refresh approval. Migration of active findings and historical completion preserves original meanings, blocks unsupported live dependencies and returns facts to current authority/applicability owners. Retirement remains dependency-governed; discarded/unbacked-up work and unavailable copies cannot be invented.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"IR-003\",\n  \"type\": \"initial-requirement\",\n  \"title\": \"Control engineering changes and recover prior states\",\n  \"status\": \"draft\",\n  \"statement\": \"Project decision owners, engineers and maintainers need to resume controlled engineering work from a current structured handoff, understand important decisions and completed outcomes, and recover explicitly retained engineering states and operational information without depending on the originating conversation.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Interrupted work can lose its goal, authority, current progress and decision basis. Exhaustive activity recording adds effort without necessarily helping the next participant decide. Loss of local operational state also requires an explicit bounded recovery contract.\",\n      \"desired_outcome\": \"Another authorized participant can identify the next sound engineering action from current context. Important rationale and compact completion accounts remain understandable; older operational detail is retained only while it has decision value or an explicit preservation obligation.\"\n    },\n    \"why\": {\n      \"rationale\": \"Continuity requires useful current information, not reconstruction of every action. Engineering Baselines and explicitly retained backups remain recoverable within their declared scope; disposable working evidence does not become a permanent archive obligation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project decision owners\",\n        \"Engineers and architects\",\n        \"Maintainers and reviewers\",\n        \"Engineering agents acting within project authority\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Applies when changes are proposed, assessed, adopted, corrected, or retired, and when a retained baseline is inspected or recovered. It also applies when in-progress work is interrupted, resumed, or handed to another participant.\",\n        \"Keep active obligations, unresolved findings, important rationale and evidence needed for current reliance until explicitly resolved or coherently replaced. Working summaries and routine outputs may be replaced without historical copies. Retained engineering Baselines follow their separate preservation policy.\",\n        \"Also applies when creating an operational backup, restoring after loss or interruption, transferring retained work to another local environment, or migrating its storage representation. Backup and transfer do not renew assessments or authorize engineering actions.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Across Changes, Baselines, configuration management, and provenance in the governed engineering environment.\",\n        \"The selected project operational store, retained evidence artifacts, and explicitly selected backup or restoration destination, initially for one local checkout and one user with one or more local agents.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Maintain one current handoff with goal/authority, governing basis, progress, open issues, relevant evidence, review standing and next action. Reference current engineering definitions at their owners. Record at meaningful handoffs or material decision changes, not every edit or test run. Preserve compact completed outcomes and selected decision-relevant detail. Recover retained Baselines and coherent operational backups within their declared scope without inventing unavailable work or renewing approval. IR-001 owns current definitions and applicable rationale; IR-008 owns reliable command access.\"\n    },\n    \"how_much\": {\n      \"scope\": \"One checkout and one user with one or more local agents. Current handoff and selective supporting detail, not event sourcing or a complete activity history. Completed Changes are historical statements, not live monitors of the repository; new regressions become linked new work. Explicit engineering Baseline retention and supported backup/restore remain distinct obligations. No guaranteed recovery of discarded, unsaved or unbacked-up information; no hosted synchronization or automatic merging.\",\n      \"limits\": [\n        \"Zero loss or alteration of the selected baseline's recorded authoritative content, identities, relationships, and provenance in a recovery declared complete. This bound is relative to that baseline, not to later unrecorded work.\",\n        \"A restoration declared complete preserves the selected backup scope, record and subject identities, relationships, original decisions, assessment meaning and required retained artifact content. This claim does not include later unrecorded or unbacked-up work.\"\n      ]\n    }\n  },\n  \"assumptions\": [\n    \"Engineering Baseline recovery requires an intact retained Baseline and applicable interpretation rules. Operational restoration requires an accessible valid backup containing the declared records and retained artifact scope; the original operational store need not survive.\",\n    \"The user or selected backup arrangement keeps a usable copy outside the failure scope against which recovery is expected; no hosted storage service is supplied by this requirement.\"\n  ],\n  \"constraints\": [\n    \"Backup, import and restoration preserve historical meaning and do not grant fresh approval, evidence applicability or action authority.\",\n    \"Retirement and migration must resolve current dependencies and preserve required originals; a new storage representation does not authorize deletion of the only usable evidence.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 23, 24, 25, 31, and 32\",\n      \"basis\": \"Controlled transitions, identifiable baselines, recoverable states, and historical integrity.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"What it commits to; What it refuses to be\",\n      \"basis\": \"Recoverable retired material and independence from a particular platform.\"\n    },\n    {\n      \"source\": \"SRC-CONSTITUTION\",\n      \"locator\": \"Repository cleanup and historical retention\",\n      \"basis\": \"Related existing preservation and retention constraints; no retirement policy change is proposed here.\"\n    },\n    {\n      \"source\": \"SRC-REM-REFINEMENT\",\n      \"locator\": \"Requirement Analysis: Analyze the initial need; Name the initial requirement\",\n      \"basis\": \"Required 5W2H analysis and a clearer IR name, preserving the existing identity and need statement.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-EXPANSION\",\n      \"locator\": \"IR-003 expansion: Resume interrupted work; IR-003 expansion: Preserve human decision authority\",\n      \"basis\": \"The two proposed needs are drafted under controlled change as SR-006 and SR-007, interpreting the user's instruction to create all proposed needs; this parent placement remains a draft engineering judgment.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"IR-003\",\n      \"basis\": \"Resolution of the recorded questions for the initial RigorLoop authoring profile under the user's instruction to solve them; the source register preserves the original questions and rationale.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"IR-003\",\n      \"basis\": \"Complete the existing bounded initial need through the linked draft Scenarios, Features, and single-parent SR decomposition. Preserve the original statement, 5W2H scope, assumptions, and prior source history; author relationship facts once.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-RECORDS\",\n      \"locator\": \"IR-003\",\n      \"basis\": \"User-requested RR/proposal analysis selects refinement of existing needs rather than a new IR. Extends local operational-history and command scope while preserving identity; draft analysis does not adopt SQLite, approve requirements, or establish downstream coverage.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"IR-003\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"IR-003\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ],\n  \"confirms\": [\n    \"FEAT-006\",\n    \"FEAT-007\",\n    \"SCN-019\",\n    \"SCN-020\",\n    \"SCN-021\",\n    \"SCN-022\",\n    \"SCN-023\",\n    \"SCN-024\",\n    \"SCN-025\",\n    \"FEAT-021\",\n    \"SCN-070\",\n    \"SCN-071\",\n    \"SCN-072\",\n    \"SCN-073\"\n  ]\n}\n","identity":"sha256:6b8fc2b23b2e60a100ebc9539490ad89e9a40414f5ba030036ee599fdf93fe1a","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/ir.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/adapter qualification. Fence cannot control external/legacy writers: source quiescence and consumer reconciliation are required.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success cannot renew authority/judgments.","Five directly reviewed outcomes use eleven exact SR accounts, not child-count rollup or canonical criteria. No hosted sync, automatic merge, exhaustive archive, destroyed-copy recovery or automatic workflow adoption."],"outcome_basis":{"identity":"sha256:f60ea958469fc046501a782cc9b9dd482ec841056df468eb8793aa644d9ed579","outcomes":[{"number":1,"sources":[{"identity":"sha256:6b8fc2b23b2e60a100ebc9539490ad89e9a40414f5ba030036ee599fdf93fe1a","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/ir.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:42e35b2c42c1db2d416487b09de5aea0f0d9b84cdad9c3c3a20fe8ab7e6a41f9","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-006-resume-changes-from-recorded-work-context/sr.json"},{"identity":"sha256:a7dc9c043bd829f8b6cb241924bf0c62ca038d82ceb911064d1707b03033b4f2","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-007-preserve-human-authority-over-governed-decisions/sr.json"},{"identity":"sha256:539b34dcfdb521197a5939b2b027e8c0338880dcf5363662092ec0b35082d24c","path":"design/system/features/FEAT-007-control-and-resume-engineering-changes.json"},{"identity":"sha256:0b1d4af54d471a405d4ea149d8d064d03907ada697072094cd80193f4e9d5b4d","path":"design/requirements/scenarios/SCN-023-resume-interrupted-work-from-recorded-change-context.json"},{"identity":"sha256:b458e4583447bf9982560fded7156be3b2caa4d7539fcbe19c3b039e7616d7dc","path":"design/requirements/scenarios/SCN-024-determine-whether-a-proposed-action-is-already-authorized.json"}],"text":"Another authorized participant can resume controlled work from current structured context without the originating conversation."},{"number":2,"sources":[{"identity":"sha256:6b8fc2b23b2e6