sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:d71c9c7b3fe1dac754cb00c3f8ac78a8af838bc345aa4eff004b59c7412d988c","path":"design/system/functions/FUNC-060-build-supported-product-candidates.json"},{"identity":"sha256:d5a10410e8ad94a7c146d73ddabfaa18ac048ff056a918c46276c8fe38305a36","path":"design/system/functions/FUNC-061-derive-artifact-integrity-metadata.json"},{"identity":"sha256:6b71b5d41f40ed98c51cf39d27045200f4eea1544d1ac00ca2f56399cf0822eb","path":"design/system/functions/FUNC-062-assess-packed-cli-completeness.json"},{"identity":"sha256:535c0ad17e69d39e4b6035bc29a678322bdf5f3ed40918b817051db8ea882a93","path":"design/system/functions/FUNC-063-acquire-and-verify-an-installation-candidate.json"},{"identity":"sha256:7129691ef0d18646c943bc73209c91cccfff73b302bdbfa3287b19a1ab315c03","path":"design/system/functions/FUNC-064-apply-bounded-skill-installation-and-replacement.json"},{"identity":"sha256:b491cb46ef2bed16df6d4d6625c4bde28d7b3110027365348f3ee1b732a11b67","path":"design/system/functions/FUNC-065-present-installation-plans-and-outcomes.json"},{"identity":"sha256:d801c222b65606374572556046195ef6a34be043651caa398999a1c57468637b","path":"design/system/functions/FUNC-066-select-release-identity-and-execution-eligibility.json"},{"identity":"sha256:872d1ff1073efd84c0cfed22b50b55dd3d4c75aa2899d8ac40afa6b33db282bd","path":"design/system/functions/FUNC-067-prepare-profile-owned-release-projections.json"},{"identity":"sha256:2cdcd8449d7d5073d9a4b63879ab8acd2d91010979590d50f90ada2dbe8d8041","path":"design/system/functions/FUNC-068-assess-release-preflight-and-qualification.json"},{"identity":"sha256:3fccdb9c28d3ce5be453e76118f715fd5338bb6839617b50e158072d5e3def62","path":"design/system/functions/FUNC-069-seal-a-qualified-immutable-release-candidate.json"},{"identity":"sha256:417e1053c8fcafcdcf5ddf7a4f8a71958763c3215ff64419e675bee117d5cfe3","path":"design/system/functions/FUNC-070-publish-an-authorized-retained-candidate.json"},{"identity":"sha256:e70013a4f8fb30f56ecee6c674167b9fb4345ed8990094bd7c589fe8e24c3c26","path":"design/system/functions/FUNC-071-observe-public-release-and-record-closeout.json"},{"identity":"sha256:327dc84e155b9d6798372a24d56aeff638d573fd0a784c7f92c8a933a0e617b1","path":"design/system/functions/FUNC-072-determine-publication-recovery-disposition.json"},{"identity":"sha256:9315f23b8bd91f9e5f2f9b5e74e112f14510451350703c19aba20be0ec30fac5","path":"design/system/functions/FUNC-073-coordinate-an-eligible-routine-release.json"},{"identity":"sha256:ae5ea04bf84064fdccca4a7330ccd69fb35e7b79b8b3629c2151c5ce97e7353d","path":"design/system/functions/FUNC-083-qualify-browser-candidates-for-customer-generation-and-reading.json"},{"identity":"sha256:8cd48470112d1d1948365f950b015e92df117ac302661f26311de28f9b3e2b27","path":"design/system/functions/FUNC-040-admit-explicit-requests-under-declared-command-contracts.json"},{"identity":"sha256:302fb1f00c393413ca968a5be04118d06d452a75f31da200675fbe56bcbf27dd","path":"design/system/functions/FUNC-048-project-bounded-command-results-without-changing-meaning.json"},{"identity":"sha256:9b413889888a68c6eaf4a8e644d4c2bdda702de75b35f9db8a766f3f37ebcc08","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/ir.json"},{"identity":"sha256:cbf30a221903f1016f77f0a81efb4f49c111893e7202caea97a7d012a63b5cc4","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-060-produce-faithful-supported-product-candidates/sr.json"},{"identity":"sha256:1f8dc88c1b12604fef36e8533494341dfcc8471c6f6c69310375909224a5451c","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-061-generate-candidates-deterministically-outside-active-installations/sr.json"},{"identity":"sha256:ddbfe78793fae0b5cd04e22c731478d04af4520a97fef8be6fd5685e48f9469d","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-062-bind-artifact-metadata-to-actual-candidate-bytes/sr.json"},{"identity":"sha256:6cd35c19d5af82277b2a3e77e2681066960d98604241c68504babf6aae6ca4af","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-063-qualify-the-actual-executable-cli-package/sr.json"},{"identity":"sha256:0e7929ae307f0ca8a2bc70ecaad50862a26496fcb1faabcbc2f262291f6f2fd9","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-064-acquire-and-verify-a-supported-installation-candidate/sr.json"},{"identity":"sha256:812be496b53e4811a6fa386aaf35491507edd8a121a4838c674310849ff47733","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-065-install-verified-units-within-explicit-safe-replacement-boundaries/sr.json"},{"identity":"sha256:66e8c0aa1cf0ad06d5490a7902bdb615220b0eec386116c46d419235f5a993cc","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-066-report-installation-plans-and-outcomes-without-exposing-private-data/sr.json"},{"identity":"sha256:333899e5787719cf0d83ed3c8af264b446aad1054b37817c73ba4149c857868e","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-067-select-compatible-release-identity-and-supported-execution-scope/sr.json"},{"identity":"sha256:c347c8b5d465cea1a5ca4ea3f5e4c584c83dca9691db2865c7027b23496f936e","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-068-prepare-release-projections-from-one-authoritative-profile/sr.json"},{"identity":"sha256:ead1afb967844b9db53885912e86caa59b76b96a11935acda2f70577b17f78e6","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-069-qualify-the-exact-prepared-release-candidate/sr.json"},{"identity":"sha256:6e440519fe01ba815347443b2314e4d66adcec4606ba8a253aea0c305cb238c1","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-070-publish-only-the-authorized-immutable-candidate/sr.json"},{"identity":"sha256:feea5c5f17383ef7a32a495b31412e21bdeb80fc5e236f877cf0b7d05609425f","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-071-record-observed-public-release-outcomes-and-bounded-closeout/sr.json"},{"identity":"sha256:1381d02f3403f0a71e31f135324ac42047529ef024397d5b25a2a5c80b93d653","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-072-recover-publication-failures-without-overwriting-public-history/sr.json"},{"identity":"sha256:051752f9dc910379863b7f6ca4f961305f2706c6210f366f302f087dbe3ace60","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-073-coordinate-routine-releases-from-an-authorized-workflow-start/sr.json"},{"identity":"sha256:e54e6164b2031abaad4a91defa6784121b05573c5e2bbba2a9dc5114ce8565bd","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/sr.json"}],"summary":"The composed Design connects faithful identifiable tools, trusted bounded acquisition, exact-candidate authorized publication, truthful recovery and separately qualified customer browser use."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-001, AR-002 cover lower obligations; no further AR is needed. Owner/collaborator scope remains distinct.","state":"not-required"},"ar_children":["AR-001","AR-002"],"criteria":[{"explanation":"MOD-001 confirms only exact retained membership/bytes after staged writes, durable marker, final checks and readback; later sessions reopen authoritative files.","number":1,"state":"covered"},{"explanation":"IF-001 retrieves selected saved content directly; MOD-004 requires neither original chat, agent memory nor Change storage.","number":2,"state":"covered"},{"explanation":"MOD-001 retains definitions while currently relied on; SR-024 dependency disposition, not session cleanup or age, governs removal.","number":3,"state":"covered"},{"explanation":"IF-001 returns known content with explicit unavailable/incomplete scope; MOD-004 preserves gaps without false completeness.","number":4,"state":"covered"},{"explanation":"One captured model/state/profile binds requested identity, content and references. An entity ID never substitutes for state identity.","number":5,"state":"covered"},{"explanation":"Raw acquisition precedes IF-002 interpretation; unsupported profile, failed access and confirmed absence remain distinct, without fallback state.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-001\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Retain engineering definitions across sessions\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall retain explicitly saved engineering entity definitions for current reliance and retrieval in later sessions independently of the originating conversation or authoring process. Retrieval shall identify the selected subject and model state and explicitly report unavailable, unsupported, incomplete, or failed outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An explicitly saved entity definition may be inaccessible to later readers if retrieval still depends on the originating authoring process or its private session state.\",\n      \"desired_outcome\": \"A fresh session can retrieve the saved definition from the selected retained model state with its identity, type, and authored content intact, or identify the requested information that could not be retrieved.\"\n    },\n    \"why\": {\n      \"rationale\": \"Current engineering knowledge must remain available after the original author or agent stops working.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents saving definitions\",\n        \"Readers resuming work in a later session\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"After an entity definition has been explicitly saved and the originating authoring session has ended, while the information remains in the governed scope.\",\n        \"Apply IR-001's current-reliance retention rule; retention ends only through the controlled disposition described under IR-003.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"In the retained governed engineering model, accessible to a fresh authoring session.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Retain saved identity, entity type, and authored content under the parent IR retention policy. Retrieve from an identifiable selected model state independently of the originating conversation, agent memory, or authoring process; distinguish complete content from unavailable, unsupported, incomplete, or failed outcomes.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Applies to explicitly saved information while it remains in the governed scope. It does not claim preservation of unsaved conversations, unlimited retention, or recovery from storage loss; retained-baseline recovery is addressed under IR-003. Apply IR-001's retrieval service boundary and IR-003's selected retained-baseline recovery boundary. These answer the parent retention and scale dependency without introducing separate numerical guarantees.\",\n      \"scale\": \"Use the initial authoring profile's model scope and capacity policy in IR-001 analysis.how_much.scale; there is no independent size target for this SR.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"After saving a supported entity definition, close the originating authoring process. In a fresh session using the retained governed model, retrieve the same identity, entity type, and authored content when no intervening change has occurred.\",\n    \"A reader with access to the retained model can retrieve the saved definition without access to the originating chat transcript, agent memory, or private authoring-session state.\",\n    \"A saved definition still needed for current reliance remains retrievable when its authoring session ends or time passes; removal from current scope follows a recorded disposition that preserves surviving obligations and required history.\",\n    \"When a retained definition cannot be completely retrieved, the outcome identifies the unavailable or incomplete scope instead of reporting a complete definition.\",\n    \"For a requested identity in a selected retained model state, the retrieval outcome identifies both the requested subject and the selected state. A stable entity identity alone is not presented as a revision or state identifier.\",\n    \"When retrieval cannot interpret the selected model representation or fails while accessing it, the outcome distinguishes unsupported interpretation or failed access from an absent entity and does not report success or silently substitute a different state.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 3, 5, and 31\",\n      \"basis\": \"Durable engineering knowledge and directly understandable current assets.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Pitch; Resumable across sessions and agents\",\n      \"basis\": \"Project artifacts remain usable beyond their originating conversation.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"SR-001\",\n      \"basis\": \"Resolution of the recorded questions for the initial RigorLoop authoring profile under the user's instruction to solve them; the source register preserves the original questions and rationale.\"\n    },\n    {\n      \"source\": \"SRC-IR-001-SCENARIO-ANALYSIS\",\n      \"locator\": \"SR-001\",\n      \"basis\": \"Apply the renewed REM Scenario Analysis method to the existing IR-001 need; preserve requirement identities and reconcile scenario outcomes with obligations and logical behavior. Confirmation records draft analysis, not approval, implementation, or satisfaction.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-001\",\n      \"basis\": \"Reconcile the existing IR-001 boundary with the now-derived recovery and historical provenance obligations under IR-003; preserve the original obligation, acceptance criteria, and identity.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-001\",\n    \"FUNC-004\"\n  ]\n}\n","identity":"sha256:c3ec5eb0db9f8580e4b7a7c765cecad41288f8218fa88efe0c8b494ea9f87886","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Model-write adapters/filesystem behavior remain unqualified. Control relevant writers or withhold coherence; advisory locks do not control arbitrary editors.","Actor-supplied exact-content/profile rationale is not certification; unsupported/missing association stays a gap. IR-003 owns history, recovery, retirement and action authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-001","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-001 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"},{"identity":"sha256:1b06bdee00ba1323e3ef88fcd3bd580f61d1df954e9393fae91f9101677f0861","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-001-retain-accepted-definitions-beyond-the-authoring-session.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-003, AR-004 cover lower obligations; no further AR is needed. Owner/collaborator scope remains distinct.","state":"not-required"},"ar_children":["AR-003","AR-004"],"criteria":[{"explanation":"IF-002 checks every accepted candidate entity for a nonblank ID; MOD-001 applies bound findings at final retention.","number":1,"state":"covered"},{"explanation":"Complete resulting identity-bearing membership includes unchanged records; duplicate IDs conflict across names, types and paths.","number":2,"state":"covered"},{"explanation":"Identity comparison ignores matching display names; state-keyed resolution selects distinct IDs independently of their labels.","number":3,"state":"covered"},{"explanation":"MOD-001 reports absence only after complete inspection, ambiguity for multiple matches, and uncertainty for incomplete membership.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-002\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Unambiguous entity identity\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall identify every governed engineering entity by an explicit identity that distinguishes it from every other entity in the same governed engineering model.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Display names or physical locations can be ambiguous, and duplicate identities can make an engineering reference designate more than one entity.\",\n      \"desired_outcome\": \"An identity-based reference unambiguously designates one entity within the governed model, including when several entities share a display name.\"\n    },\n    \"why\": {\n      \"rationale\": \"Names alone cannot reliably distinguish entities or support durable references.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Authors creating governed engineering entities\",\n        \"Reviewers and tools checking model integrity\",\n        \"Readers and tools resolving identity-based references\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When entities enter a governed model and when their identities are used to distinguish or reference them.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within one governed engineering model, across entity names, types, and locations.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Require an explicit nonempty identity for each accepted entity, reject duplicate identities for distinct entities, and resolve references by identity independently of display names.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Uniqueness applies within one governed engineering model. It does not require globally unique identities across independent projects or make an entity identity identify a particular content revision.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Every entity accepted into a governed model has an explicit, nonempty identity.\",\n    \"A candidate model containing two distinct entities with the same identity is reported as invalid, even if their names, types, or locations differ.\",\n    \"Two entities may share a display name while retaining distinct identities, and an identity-based reference unambiguously identifies its intended entity.\",\n    \"An identity lookup that matches no entity reports that absence. A lookup encountering multiple entities with the requested identity reports ambiguity and does not arbitrarily select one entity.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 30, 35, and 42\",\n      \"basis\": \"Stable identities and references independent of display naming and location.\"\n    },\n    {\n      \"source\": \"SRC-IR-001-SCENARIO-ANALYSIS\",\n      \"locator\": \"SR-002\",\n      \"basis\": \"Apply the renewed REM Scenario Analysis method to the existing IR-001 need; preserve requirement identities and reconcile scenario outcomes with obligations and logical behavior. Confirmation records draft analysis, not approval, implementation, or satisfaction.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-002\",\n    \"FUNC-003\"\n  ]\n}\n","identity":"sha256:36c7c4bfe79272c50c73d43ba74ca8d3e2895538ea6034d5877df3bb5e23a8e2","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Model-write adapters/filesystem behavior remain unqualified. Control relevant writers or withhold coherence; advisory locks do not control arbitrary editors.","Actor-supplied exact-content/profile rationale is not certification; unsupported/missing association stays a gap. IR-003 owns history, recovery, retirement and action authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-002","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-002 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:e3fa23aeb0b639459320519bf9a382f1ee11c7696fce1f76c2b420c8cf061d1c","path":"design/system/functions/FUNC-002-check-entity-identity-presence-and-uniqueness.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:47efc8fa6fe91e2947a1ac3fdd1a5dbb4a8328e4e89ec5dd16589def6703e104","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-003-check-candidate-identities-over-an-explicit-model-scope.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-005 cover lower obligations; no further AR is needed. Owner/collaborator scope remains distinct.","state":"not-required"},"ar_children":["AR-005"],"criteria":[{"explanation":"MOD-002 preserves the resolved entity ID through a supported display rename; final retention and derived references use that same designation.","number":1,"state":"covered"},{"explanation":"A same-parent directory move covers all descendants and affected path references, checks collisions and preserves stable identities.","number":2,"state":"covered"},{"explanation":"A same-entity edit preserves ID while recomputing content/state and rationale applicability; earlier approval or evidence is not renewed.","number":3,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-003\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Preserve identity through entity evolution\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall preserve an existing entity's identity when its display name, physical location, or definition is changed as an evolution of that same entity.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Renaming, moving, or editing an existing entity can sever references if its identity is tied to its presentation or location.\",\n      \"desired_outcome\": \"Readers and tools can continue to designate the same engineering subject across supported edits while treating revision and evidence applicability separately.\"\n    },\n    \"why\": {\n      \"rationale\": \"References should continue to designate the same engineering subject when its presentation or definition evolves.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents evolving entity definitions\",\n        \"Readers and tools relying on existing identity-based references\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a supported rename, location change, or definition edit evolves the same existing entity.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within the same governed engineering model, including supported moves between physical locations.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Preserve the entity identity through the supported edit and keep identity-based references designating that entity.\"\n    },\n    \"how_much\": {\n      \"scope\": \"This requirement does not determine identity treatment for entity splits, merges, replacements, or reuse after retirement. Preserved entity identity does not imply an unchanged revision, renewed approval, or continued applicability of previous evidence; those concerns belong to controlled evolution and assessment. Identity preservation does not authorize a change of requirement parentage: a move to a different IR or SR parent is a semantic model change whose derivation must be reconsidered under the applicable change policy.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"After a supported display-name change, the entity retains its identity and existing identity-based references still designate that entity.\",\n    \"After a supported location change within the same governed model, the entity retains its identity and remains identifiable through that identity.\",\n    \"After a supported edit to the definition of the same entity, the entity retains its identity.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 13, 31, 35, and 42\",\n      \"basis\": \"Durable evolving assets and identity independent of name and location.\"\n    },\n    {\n      \"source\": \"SRC-DESIGN\",\n      \"locator\": \"DES-SR-11\",\n      \"basis\": \"Related existing distinction between stable identity and changed assessed subjects; this does not transfer its full scope.\"\n    },\n    {\n      \"source\": \"SRC-IR-001-SCENARIO-ANALYSIS\",\n      \"locator\": \"SR-003\",\n      \"basis\": \"Apply the renewed REM Scenario Analysis method to the existing IR-001 need; preserve requirement identities and reconcile scenario outcomes with obligations and logical behavior. Confirmation records draft analysis, not approval, implementation, or satisfaction.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-005\"\n  ]\n}\n","identity":"sha256:53517029dd4cc9c16636aeaf081f33ee8ef719b4c1f1032241bc0b77677585b8","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Model-write adapters/filesystem behavior remain unqualified. Control relevant writers or withhold coherence; advisory locks do not control arbitrary editors.","Actor-supplied exact-content/profile rationale is not certification; unsupported/missing association stays a gap. IR-003 owns history, recovery, retirement and action authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-003","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 3 canonical SR-003 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:8660c0b4e3d969b44be6dd640f3a2d9ff4ad81c2d0202ea4ba6c33900ed0dd00","path":"design/system/functions/FUNC-005-revise-engineering-entity-while-preserving-identity.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:0b6d193cf874537ad68e03df84b6796763572c2a541210f1b75cba2f0631e941","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/AR-005-preserve-identity-when-applying-supported-definition-revisions.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-006, AR-007 cover lower obligations; no further AR is needed. Owner/collaborator scope remains distinct.","state":"not-required"},"ar_children":["AR-006","AR-007"],"criteria":[{"explanation":"IF-001 reads authoritative current files and references, never reconstructing the definition from Change deltas.","number":1,"state":"covered"},{"explanation":"MOD-004 presents type-specific meaning and governing references from one captured state, allowing human inspection of the current obligation or responsibility.","number":2,"state":"covered"},{"explanation":"Optional history has a separate availability result; its absence does not block complete current definition content.","number":3,"state":"covered"},{"explanation":"Required reference/context gaps remain explicit alongside available content; summaries cannot invent missing facts from history.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-004\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Understand current definitions without history replay\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall make each current governed entity's definition understandable from current authoritative engineering information without requiring reconstruction from Change history or prior conversations.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A sequence of historical deltas can leave readers unable to determine an entity's current meaning without reconstructing its evolution.\",\n      \"desired_outcome\": \"Readers can explain the entity's current engineering meaning from its present definition and current authoritative references.\"\n    },\n    \"why\": {\n      \"rationale\": \"A current model must support inspection and continuation directly, even when earlier changes are numerous or stored separately.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers, reviewers, and maintainers reading current definitions\",\n        \"Engineering agents resuming work from the current model\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When determining an entity's current meaning, including after several Changes or when optional historical explanation is unavailable.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"In the current engineering model and its current authoritative references.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Maintain an understandable current definition that readers can obtain and interpret without reconstructing it from Change history. Present the current definition with its authoritative context for the selected state, identifying any required current information that is unavailable separately from optional historical explanation.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Current authoritative references may be followed; this does not require copying all related definitions into one file. A Change record or historical delta alone is insufficient as the current definition.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For an entity evolved through several Changes, a reader can obtain its current definition from the current model without replaying those Changes.\",\n    \"Using the entity's current definition and its current authoritative references, a reader can explain its obligation, capability, behavior, architectural responsibility, or other engineering meaning as appropriate to its type.\",\n    \"When optional historical explanation is unavailable but all required current information is present, the reader can still determine the entity's current definition.\",\n    \"When required current information is unavailable, identify the affected context and present any available definition with that limitation; do not present partial context as complete or replace it with an inferred reconstruction from history.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 3, 13, and 31\",\n      \"basis\": \"Durable current assets remain understandable without replaying their evolution.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"What it commits to; What would prove this wrong\",\n      \"basis\": \"Current reliance is understandable from current artifacts.\"\n    },\n    {\n      \"source\": \"SRC-DESIGN\",\n      \"locator\": \"DES-SR-21\",\n      \"basis\": \"Related existing current-reliance obligation; no replacement or complete migration is claimed.\"\n    },\n    {\n      \"source\": \"SRC-IR-001-SCENARIO-ANALYSIS\",\n      \"locator\": \"SR-004\",\n      \"basis\": \"Apply the renewed REM Scenario Analysis method to the existing IR-001 need; preserve requirement identities and reconcile scenario outcomes with obligations and logical behavior. Confirmation records draft analysis, not approval, implementation, or satisfaction.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-004\",\n    \"FUNC-007\"\n  ]\n}\n","identity":"sha256:4cbc2de2e82a9529fe5ae3d608e6de5b1f4817f7e8225a44b77e23550b4a1d21","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Model-write adapters/filesystem behavior remain unqualified. Control relevant writers or withhold coherence; advisory locks do not control arbitrary editors.","Actor-supplied exact-content/profile rationale is not certification; unsupported/missing association stays a gap. IR-003 owns history, recovery, retirement and action authority."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-004","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 4 canonical SR-004 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"},{"identity":"sha256:2469f00338b83e9a8a666c90c83cb079a52ea834241f9d0ec01c010066a50951","path":"design/system/functions/FUNC-007-present-current-engineering-definition-and-applicable-rationale.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:38f4a6afada36f8ba2852e9efe2a834bdd242a117717024ee65a6c72e0a9f67a","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-007-present-current-meaning-with-explicit-context-gaps.json"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-008, AR-009 cover lower obligations; no further AR is needed. Owner/collaborator scope remains distinct.","state":"not-required"},"ar_children":["AR-008","AR-009"],"criteria":[{"explanation":"IF-001 retains all five recorded reasoning fields, locator, actor and exact definition-content/profile association; later readers retrieve their captured basis.","number":1,"state":"covered"},{"explanation":"Owning-model rationale remains accessible while relied on even when the originating operational Change explanation is compacted.","number":2,"state":"covered"},{"explanation":"MOD-004 shows available definitions with separate missing-reasoning gaps; neither storage nor presentation invents rationale.","number":3,"state":"covered"},{"explanation":"A changed definition requires explicit newly recorded association and actor reason or unresolved/historical status; stable ID cannot carry applicability.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-005\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Retain applicable decision rationale\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall retain the recorded reasoning for engineering decisions on which current entity definitions rely and make that reasoning accessible from the current model. When required reasoning cannot be retrieved for the selected definition, the system shall identify the gap without presenting unrecorded or unrelated reasoning as its basis.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Keeping a chosen definition without the recorded decision context can hide the alternatives, tradeoffs, and consequences on which current work relies.\",\n      \"desired_outcome\": \"A later reader can retrieve the recorded reasoning relevant to a current definition even when the originating Change explanation is outside current working material.\"\n    },\n    \"why\": {\n      \"rationale\": \"Retaining a chosen design without its applicable reasoning prevents later engineers from understanding its constraints and tradeoffs.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and architects recording decision reasoning\",\n        \"Reviewers, maintainers, and engineering agents relying on current decisions\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"While current entity definitions rely on a recorded decision, including after its originating Change explanation leaves current working material.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Accessible from the current engineering model through the entity definitions that rely on the decision.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Retain the recorded decision context, chosen outcome, rationale, considered alternatives, and consequences, and make those details retrievable from the current model. Keep the recorded association to the definition and its applicable state identifiable, and distinguish unavailable required reasoning from a missing optional historical explanation. Access does not certify the reasoning or the decision.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers preservation and access to explicitly recorded reasoning needed for current reliance. It does not invent missing reasoning, certify the decision, require a separate decision file, or replace the historical provenance obligations under IR-003.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Record a decision's context, chosen outcome, rationale, considered alternatives, and consequences, and associate it with a current entity definition. A later reader can retrieve those recorded details from the current model.\",\n    \"When explanation of the Change that introduced that decision is moved out of current working material, the decision's still-applicable reasoning remains available through the current model.\",\n    \"When recorded reasoning required to understand a selected current definition is missing or unavailable, identify that gap while retaining access to any available definition; do not invent rationale or report complete explanatory context.\",\n    \"When a selected definition evolves, present only reasoning whose recorded association applies to that definition, or identify an unresolved applicability gap. A rationale associated with another state is not silently relabeled as current.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 5 and 31\",\n      \"basis\": \"Durable engineering knowledge and understandable current definitions.\"\n    },\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Pitch; Human-understandable AI work\",\n      \"basis\": \"Preserve why engineering choices were made and make reasoning visible.\"\n    },\n    {\n      \"source\": \"SRC-DESIGN\",\n      \"locator\": \"DES-SR-06 and DES-SR-21\",\n      \"basis\": \"Related existing decision-context and current-reliance obligations; their full scope remains with the existing owner.\"\n    },\n    {\n      \"source\": \"SRC-IR-001-SCENARIO-ANALYSIS\",\n      \"locator\": \"SR-005\",\n      \"basis\": \"Apply the renewed REM Scenario Analysis method to the existing IR-001 need; preserve requirement identities and reconcile scenario outcomes with obligations and logical behavior. Confirmation records draft analysis, not approval, implementation, or satisfaction.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-005\",\n      \"basis\": \"Reconcile the existing IR-001 boundary with the now-derived recovery and historical provenance obligations under IR-003; preserve the original obligation, acceptance criteria, and identity.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-006\",\n    \"FUNC-007\"\n  ]\n}\n","identity":"sha256:3b9163779c9558555f98297806e733ca2ed71637a3ae56f54c234990b3114a23","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-005-retain-applicable-decision-rationale/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Model-write adapters/filesystem behavior remain unqualified. Control relevant writers or withhold coherence; advisory locks do not control arbitrary editors.","Actor-supplied exact-content/profile rationale is not certification; unsupported/missing association stays a gap. IR-003 owns history, recovery, retirement and action authority."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-005","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 4 canonical SR-005 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:44ba17cf90ab0805af6fc8fd49d476d5e412fb9f345b8b9ae71f134551067958","path":"design/system/functions/FUNC-006-retain-applicable-decision-rationale.json"},{"identity":"sha256:2469f00338b83e9a8a666c90c83cb079a52ea834241f9d0ec01c010066a50951","path":"design/system/functions/FUNC-007-present-current-engineering-definition-and-applicable-rationale.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:4f3f0e177e943c01dffb6138a7372d2eba28dacf7085253942b4d087d5a8b905","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-005-retain-applicable-decision-rationale/AR-008-retain-decision-reasoning-and-its-definition-association.json"},{"identity":"sha256:87e292d1ec9678d8e04a417bfb82a198048a25c95e7cdfe48f0e7aebd62e501d","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-005-retain-applicable-decision-rationale/AR-009-present-applicable-rationale-separately-from-definition-completeness.json"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-077"],"criteria":[{"explanation":"MOD-006 current-handoff ownership table assigns all seven sections to their actual contributors; MOD-012 obtains supported IF-004 facts and presents references/derived summaries.","number":1,"state":"covered"},{"explanation":"FUNC-025 and IF-011 begin from identified project/Change/contract and complete selectors, using only bounded support needed for the impending decision.","number":2,"state":"covered"},{"explanation":"The contract explicitly separates missing/conflicting/unavailable facts, supported non-applicability, planned/not-run checks, no-findings assessments and approved judgments.","number":3,"state":"covered"},{"explanation":"Comparable working summaries may be replaced with scope/basis/result/limitations/current support intact; no permanent log or version chain is imposed.","number":4,"state":"covered"},{"explanation":"Open issues survive omissions and shortened context until explicit attributable resolution, withdrawal, supersession or transfer; transferred obligations keep a named owner/destination.","number":5,"state":"covered"},{"explanation":"Actual changed subjects, blockers, evidence basis, review standing and next action are supplied and recorded before the next dependent decision or transfer.","number":6,"state":"covered"},{"explanation":"Restored context reports its captured state and unavailable later work; current authority and applicability require their own owners without renewal by restoration.","number":7,"state":"covered"},{"explanation":"Completed Changes return original outcome, reason, accepted scope, acceptance support and limits as compact historical meaning, without continuous repository comparison.","number":8,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-006\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Resume changes from recorded work context\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall maintain and return a current structured handoff for each active Change so another authorized participant can identify an appropriate next action without the originating conversation or reconstructing activity history.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A new participant may have access to engineering definitions but lack the recorded state, ownership, outstanding issues, or next action needed to resume an interrupted Change.\",\n      \"desired_outcome\": \"An authorized participant can determine what remains to be done from the retained Change context and can recognize gaps without treating a suggested action as permission.\"\n    },\n    \"why\": {\n      \"rationale\": \"Preserving engineering definitions alone does not tell a new participant what work remains or how to continue a controlled Change.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents handing off or resuming work\",\n        \"Reviewers and project decision owners responsible for outstanding decisions\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When work on an in-progress Change is interrupted or handed to another participant, while the recorded context remains in the governed scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"In the current authoritative Change context and the current engineering records it references.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Retain the common resumption context with the Change and reference each activity's authoritative subjects and applicable basis revisions. Authoring context identifies affected definitions, derivation sources, decisions made, unresolved analysis, and proposed edits. Implementation context identifies the governing requirements and design, assigned work, changed realization, completed and remaining work, and relevant verification obligations. Verification context identifies the requirements and exact subjects assessed, assessment procedure and conditions, planned checks, actual execution state, observed results or failures, evidence locations, and remaining checks. Review context identifies the exact reviewed subjects, governing review basis, findings and their disposition or correction owner, unresolved decisions, and the next review or correction action. Reference facts at their authoritative owner rather than maintaining independent copies. Distinguish intended verification from observed evidence, and expose missing, conflicting, stale, or inapplicable context explicitly without inventing an action or authority.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers explicitly recorded Change context within the retained governed scope. The common resumption set is the scope, work state, responsible participants, outstanding findings or blockers, and next action. The initial RigorLoop authoring profile defines additional context for authoring, implementation, verification, and review of a Change within one governed project; the applicable activity determines which context is needed. A field that is inapplicable to an activity is identified as such with a reason rather than populated with invented work or evidence. These definitions specify intended support and do not claim that every activity has an implemented record format. IR-001 owns durability of engineering definitions; this obligation addresses continuity of controlled work. It does not preserve unsaved conversation state or make a suggested next action authorize execution. The local operational-history extension adds the criteria attributed to SRC-LOCAL-OPERATIONAL-ANALYSIS; retained product contracts and old allocation evidence do not establish implementation or coverage of that extension.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The handoff presents goal, scope and authority; governing requirement/design/plan references; current progress and remaining work; open issues and important rationale; relevant evidence; review standing; and the next action with reason and responsible participant. Each fact has one authoritative owner, not an independently editable duplicate.\",\n    \"After the originating session ends, another authorized participant can identify the next permitted step, its supporting basis and unresolved uncertainty from this handoff and bounded supporting reads.\",\n    \"Missing, conflicting or unavailable context is explicitly distinguished from not-applicable, not-run, no finding or approved. A suggested action never supplies its own execution authority.\",\n    \"Working state and equivalent evidence summaries may be explicitly replaced without preserving prior versions or recording every local action. Relevant scope, assessed basis, result, limitations and reporting source remain available for conclusions currently relied upon.\",\n    \"Open findings cannot disappear through omitted fields or shorter handoffs. An explicit attributable disposition is needed; resolved detail may later be compacted when no current reliance requires it.\",\n    \"Changes to material scope, blockers, evidence applicability, review standing or next action require a current handoff at the next dependent decision or transfer. Routine edits and intermediate test runs require no permanent record.\",\n    \"A restored backup identifies its retained state and unavailable later work; it does not renew authority or applicability. An unavailable store cannot be presented as an empty or completed Change.\",\n    \"Completion retains a compact account of outcome, reason, delivered scope, acceptance support and limitations. It is historical and is not continuously compared with the current repository; a later regression becomes a new linked problem or Change.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Resumable across sessions and agents; What it commits to\",\n      \"basis\": \"Current authoritative records carry task state so another participant can continue from the artifacts.\"\n    },\n    {\n      \"source\": \"SRC-REM\",\n      \"locator\": \"Sections 23 and 31\",\n      \"basis\": \"A Change controls engineering evolution, while current state remains understandable without replaying history.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-EXPANSION\",\n      \"locator\": \"IR-003 expansion: Resume interrupted work\",\n      \"basis\": \"Drafted under IR-003 as an interpretation of the user's instruction to create all proposed needs, using the proposed continuity need and its suggested parent.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"SR-006\",\n      \"basis\": \"Defines activity-specific resumption context and observable acceptance outcomes for authoring, implementation, verification, and review within the initial profile.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-006\",\n      \"basis\": \"Preserve this existing IR-003 obligation and its acceptance criteria; confirm FUNC-025 as the logical behavior derived from it during the complete analysis pass.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-006\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-006\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-025\"\n  ]\n}\n","identity":"sha256:42e35b2c42c1db2d416487b09de5aea0f0d9b84cdad9c3c3a20fe8ab7e6a41f9","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-006-resume-changes-from-recorded-work-context/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No workflow adoption. Participant interpretation and CLI custody retain separate owners; no automatic permission enforcement, new record schema or global coordinator.","Maintenance execution and whole-IR outcomes remain separately assessed. State exclusion, exact release candidate and current effect/source reconciliation remain execution prerequisites; authority assessment does not satisfy them. AR-046 history remains."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-006","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 8 canonical SR-006 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:81dd26f1870a5ef8570e5e5d14e1ea012bebb1569be9f2d51dc1e3fd94ddd791","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-006-resume-changes-from-recorded-work-context/AR-077-interpret-current-handoffs-with-explicit-reliance-and-gaps.json"},{"identity":"sha256:b5bbfbf03874ea29120c3443bd5efc8160f8cbbf230286fde5316d5fee495ef1","path":"design/system/functions/FUNC-025-retain-and-retrieve-activity-specific-change-context.json"},{"identity":"sha256:539b34dcfdb521197a5939b2b027e8c0338880dcf5363662092ec0b35082d24c","path":"design/system/features/FEAT-007-control-and-resume-engineering-changes.json"},{"identity":"sha256:0b1d4af54d471a405d4ea149d8d064d03907ada697072094cd80193f4e9d5b4d","path":"design/requirements/scenarios/SCN-023-resume-interrupted-work-from-recorded-change-context.json"},{"identity":"sha256:b458e4583447bf9982560fded7156be3b2caa4d7539fcbe19c3b039e7616d7dc","path":"design/requirements/scenarios/SCN-024-determine-whether-a-proposed-action-is-already-authorized.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-078"],"criteria":[{"explanation":"FUNC-026 through parent IF-009 assesses the exact action, subject/state, participant, scope and conditions against attributable policy/decision owner/grant.","number":1,"state":"covered"},{"explanation":"The README and IF-009 explicitly preserve valid prior grants and standing delegations across resumed sessions and covered steps.","number":2,"state":"covered"},{"explanation":"Favorable review, passing checks, next-action suggestion and permission for another subject remain separate from action authority.","number":3,"state":"covered"},{"explanation":"The initial policy classes include beyond-mandate scope, governing policy, reserved tradeoffs and release; external mutation and destruction need explicit applicable authority.","number":4,"state":"covered"},{"explanation":"Completion, revocation, supersession, scope excess and failed conditions invalidate the affected grant reliance while preserving any separately covered action.","number":5,"state":"covered"},{"explanation":"Higher-authority conflicts and expressly nondelegable decisions cannot be overridden by a standing delegation, and work permission does not waive independent assessment.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-007\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Preserve human authority over governed decisions\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall require applicable authorization before performing governed actions reserved by project policy for human decision, and shall not treat recorded evidence, review results, or suggested next actions as substitutes for that authorization.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A favorable assessment or recorded next action can be mistaken for authorization to perform a decision-sensitive action outside the actor's granted scope.\",\n      \"desired_outcome\": \"Governed actions respect the project's human decision boundaries and applicable prior grants, independently of whether assessments or suggested actions are present.\"\n    },\n    \"why\": {\n      \"rationale\": \"Engineering evidence can support a decision without granting authority to make it, and automated progression must respect the project's decision owners.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project decision owners granting or withholding authority\",\n        \"Engineers and engineering agents acting within authorized scope\",\n        \"Reviewers supplying assessments rather than execution permission\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Before a governed action subject to a project-defined human decision boundary, including after work resumes or its scope changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"At the project's decision boundaries for controlled engineering changes.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Determine the action's governing policy, decision owner, and applicable authorization. For the initial RigorLoop authoring profile, retain human authority for accepting new scope beyond the existing mandate, changing governing policy, accepting project-level tradeoffs reserved to the decision owner, and release decisions. External mutations and destructive actions require explicit applicable authorization under the existing Constitution. A decision owner may authorize a defined action or delegate a bounded class of actions with its subject, scope, conditions, and limits; the grant remains applicable until completed, revoked, superseded, or invalidated by a relevant scope or condition change. Carry out covered authoring, implementation, verification, or correction work without demanding fresh confirmation for every step or resumed session. Escalate the particular boundary when an action exceeds the grant or conflicts with governing policy, and distinguish assessment results from authority.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Applies to governed actions reserved by the project's selected policy for human decision. The initial profile uses this repository's existing authority rules; other projects retain their selected policies, and future profile expansion requires controlled change. An existing applicable authorization may cover subsequent actions within its scope; a new confirmation is not required merely because a session or participant changes. Delegation cannot override higher-authority rules, transfer a decision the policy makes nondelegable, or substitute for required independent assessment. This obligation does not prescribe a universal approval workflow, require human approval for every engineering action, or mandate skills or a particular execution host.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For an action that the selected project policy reserves for human decision, the system does not perform the action when applicable authorization is absent and identifies the unmet decision boundary.\",\n    \"When a valid prior authorization covers the proposed action and remains applicable, the system recognizes that grant without requiring another confirmation solely because work resumed in a new session.\",\n    \"A passing verification result, favorable review, recorded next action, or authorization for a different scope does not by itself authorize the proposed action.\",\n    \"For the selected initial profile, an action accepting scope beyond the mandate, changing governing policy, accepting a reserved project-level tradeoff, or making a release decision identifies the governing policy and applicable human authorization before execution. An external mutation or destructive action has explicit authorization covering that action.\",\n    \"A bounded standing delegation permits covered actions across successive steps and sessions without repeated confirmation. A revoked or superseded grant, an exceeded scope, or an unmet condition prevents reliance on that delegation for the affected action and identifies the specific unmet authority boundary.\",\n    \"A delegation that conflicts with a higher-authority rule or an expressly nondelegable decision is not treated as permission, and a grant to perform work does not waive required independent assessment.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Apply the existing Constitution's authority order and approved owning contracts, subject to higher-priority runtime and direct user instructions; this draft does not establish a new authority policy.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-VISION\",\n      \"locator\": \"Who it is for; What it refuses to be\",\n      \"basis\": \"The vision retains human approval of scope, tradeoffs, and release decisions and rejects autonomous merge or replacement of engineering judgment.\"\n    },\n    {\n      \"source\": \"SRC-CONSTITUTION\",\n      \"locator\": \"Authority and ownership; Security and permissions\",\n      \"basis\": \"Existing instructions distinguish recording, assessment, and execution authority and require actors to respect authorized scope; the full contracts retain their existing owners.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-EXPANSION\",\n      \"locator\": \"IR-003 expansion: Preserve human decision authority\",\n      \"basis\": \"Drafted under IR-003 as an interpretation of the user's instruction to create all proposed needs, using the proposed authority need and its suggested parent.\"\n    },\n    {\n      \"source\": \"SRC-QUESTION-RESOLUTION\",\n      \"locator\": \"SR-007\",\n      \"basis\": \"Applies the existing authority policy to decision classes and bounded standing delegation without creating a universal approval gate.\"\n    },\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-007\",\n      \"basis\": \"Preserve this existing IR-003 obligation and its acceptance criteria; confirm FUNC-026 as the logical behavior derived from it during the complete analysis pass.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-026\"\n  ],\n  \"constrains\": [\n    \"FUNC-022\",\n    \"FUNC-023\",\n    \"FUNC-024\",\n    \"FUNC-025\",\n    \"FUNC-031\"\n  ]\n}\n","identity":"sha256:a7dc9c043bd829f8b6cb241924bf0c62ca038d82ceb911064d1707b03033b4f2","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-007-preserve-human-authority-over-governed-decisions/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No workflow adoption. Participant interpretation and CLI custody retain separate owners; no automatic permission enforcement, new record schema or global coordinator.","Maintenance execution and whole-IR outcomes remain separately assessed. State exclusion, exact release candidate and current effect/source reconciliation remain execution prerequisites; authority assessment does not satisfy them. AR-046 history remains."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-007","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-007 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:a256787d50b7e520c3d828c35b8ff67e93b9cf7a5519bf9e23a82f514c2a3b6f","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-007-preserve-human-authority-over-governed-decisions/AR-078-assess-exact-action-authority-without-redundant-confirmation.json"},{"identity":"sha256:e2d0fbfe210afa2888bbdd1061ab5a4b3783292b44a7ab374b73beaa3203d869","path":"design/system/functions/FUNC-026-determine-applicable-authority-before-governed-actions.json"},{"identity":"sha256:539b34dcfdb521197a5939b2b027e8c0338880dcf5363662092ec0b35082d24c","path":"design/system/features/FEAT-007-control-and-resume-engineering-changes.json"},{"identity":"sha256:0b1d4af54d471a405d4ea149d8d064d03907ada697072094cd80193f4e9d5b4d","path":"design/requirements/scenarios/SCN-023-resume-interrupted-work-from-recorded-change-context.json"},{"identity":"sha256:b458e4583447bf9982560fded7156be3b2caa4d7539fcbe19c3b039e7616d7dc","path":"design/requirements/scenarios/SCN-024-determine-whether-a-proposed-action-is-already-authorized.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-057","AR-058","AR-059"],"criteria":[{"explanation":"MOD-002 owns explicit participant create/replace/remove admission under FUNC-008 and AR-057. One type/source/target/provenance fact is authored in the profile-selected representation. IF-002 checks the resulting candidate and IF-001 confirms that exact state before MOD-002 derives both endpoint views. Inverse orientation is a read projection, not another persisted fact.","number":1,"state":"covered"},{"explanation":"MOD-002 forms replacements/removals against the original fact and complete candidate. IF-001 retains all requested effects before confirmation. Derived endpoint indexes bind exact state/profile/content; rebuilding from the confirmed resulting state and changing the current cache selection prevents an old inverse surviving as a current edge while leaving older frozen views explicitly historical.","number":2,"state":"covered"},{"explanation":"Parentage uses the governing profile’s one containment representation; physical containment is explicitly selected for this repository.","number":3,"state":"covered"},{"explanation":"IF-002 check_candidate_relationships rejects unknown operation/type before consistency, reuses identity findings for ambiguity/absence, and checks endpoint kinds, representation, required incoming cardinalities and parent ancestry over complete necessary candidate scope.","number":4,"state":"covered"},{"explanation":"IF-001/002 findings, retention references and endpoint projections retain selected model/state/profile and content identity.","number":5,"state":"covered"},{"explanation":"AR-059 and IF-001 define exact write/read scope, final base comparison and checks under model write exclusion, coherent read exclusion/snapshot and a durable unresolved-write marker before authoritative changes.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-008\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Author engineering relationships once and derive inverse views\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall represent each governed requirement-parent or typed cross-domain relationship through one authoritative fact and provide consistent forward and reverse views of that fact within the selected model state. If the relationship change cannot complete or its selected state changes before completion, the system shall report the known outcome and affected scope without claiming a completed accepted change.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Independently authored forward and reverse relationships can disagree about responsibility or parentage.\",\n      \"desired_outcome\": \"Readers see the same relationship meaning from either endpoint without maintaining a duplicate fact.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-002 requires explicit traceability and derived inverse views while preserving the single-parent requirement tree.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When an author creates, changes, or removes a relationship and a participant inspects either endpoint.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within one selected project model state and its declared relationship profile.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the authoritative parent representation selected by the profile and explicitly typed cross-domain facts. Present inverse navigation as a derived view. Validate the proposed relationship against declared endpoint types and cardinalities before accepting it as a valid fact.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers relationship authorship and inverse consistency for declared relationship types. It does not prescribe a storage direction, duplicate parent fields, or establish satisfaction from a link. Mechanically checking the whole model belongs to IR-005.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Create a compatible typed relationship once; views from both endpoints identify the same relationship, entities, direction, and selected state without a separately authored inverse.\",\n    \"After replacing or removing the authoritative relationship, neither current endpoint view presents its old inverse as a surviving fact.\",\n    \"Derive SR and AR parent navigation from the declared single authoritative containment representation; a second independently maintained parent is not required.\",\n    \"For an unknown relationship type, incompatible endpoint, ambiguous identity, or forbidden cardinality, report the invalid proposal and do not present it as an accepted relationship.\",\n    \"Keep relationship observations tied to the selected state; inspecting a newer state does not rewrite the relationship meaning recorded in an older state.\",\n    \"When an edit is interrupted, cannot complete, or encounters a changed selected state, report the known relationship outcome and affected scope without claiming a completed accepted change; do not silently treat observations from different states as one completed edit.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-008\",\n      \"basis\": \"Derived from IR-002 and its selected initial-profile scope: IR-002 requires explicit traceability and derived inverse views while preserving the single-parent requirement tree.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-008\",\n    \"FUNC-003\"\n  ],\n  \"constrains\": [\n    \"FUNC-009\"\n  ]\n}\n","identity":"sha256:4468263bc7759fe571752a4ec75f0b067f113a2163481df40c7c469e51777b1d","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Custody must enforce exclusion/snapshot and durable recovery or refuse coherence; advisory locks/unfenced rescans cannot control arbitrary writers.","Participant logical admission only; callable adapters and any MOD-010 external boundary require separate review."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-008","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-008 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:d4a820120577846f12878a269f912732b9e017ebfd09df84b9465410d38789b3","path":"design/system/functions/FUNC-008-author-typed-engineering-relationships.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:f4725d5e0241b4f19d29689d2654ef746035f3d86404e2a7de323303e4b76ff6","path":"design/system/functions/FUNC-001-retain-engineering-definition.json"},{"identity":"sha256:8660c0b4e3d969b44be6dd640f3a2d9ff4ad81c2d0202ea4ba6c33900ed0dd00","path":"design/system/functions/FUNC-005-revise-engineering-entity-while-preserving-identity.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:1b06bdee00ba1323e3ef88fcd3bd580f61d1df954e9393fae91f9101677f0861","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-001-retain-accepted-definitions-beyond-the-authoring-session.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"},{"identity":"sha256:47efc8fa6fe91e2947a1ac3fdd1a5dbb4a8328e4e89ec5dd16589def6703e104","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-003-check-candidate-identities-over-an-explicit-model-scope.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"},{"identity":"sha256:0b6d193cf874537ad68e03df84b6796763572c2a541210f1b75cba2f0631e941","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-003-preserve-identity-through-entity-evolution/AR-005-preserve-identity-when-applying-supported-definition-revisions.json"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:eccf9da9452b46542f3f33d329f5124f982ca6f481bb28f07bb247b7269fed2b","path":"design/requirements/scenarios/SCN-007-apply-a-relationship-change-and-inspect-both-endpoint-views.json"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:c0f370b5564e4e3a7fa5dc00a9276755929c35d0d9793e4c56552d785a5eb9e2","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/README.md"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-056"],"criteria":[{"explanation":"FUNC-009 already requires complete selected reachability. traversal.md Admission and coherent inventory requires full source membership, coherent bytes and same-state/profile interpretation via IF-001/002, including all possible incoming sources.","number":1,"state":"covered"},{"explanation":"Authoritative edge source/type/target and field/containment provenance are retained. Incoming reverses traversal orientation over the same inventory; both admits either direction without authoring duplicate facts. IF-001 complete relationship-bearing membership prevents an outgoing-only partial index from falsely establishing incoming completeness. Parentage follows the governing profile representation.","number":2,"state":"covered"},{"explanation":"The selected-state plus entity visited key is sufficient because one request fixes types and direction.","number":3,"state":"covered"},{"explanation":"Depth zero returns starts without adjacency expansion; depth N expands only minimum-depth nodes below N.","number":4,"state":"covered"},{"explanation":"Acquisition and exploration outcomes are separate. Complete inventory enumeration, reads and interpretation are required before a positive result. Missing eligible targets, uninterpretable required content, interruption and resource exhaustion retain only same-state attributable observations with affected member/path/frontier and reason. Incomplete takes precedence over a simultaneous requested bound. Unestablished coherence or response loss cannot become complete empty; MOD-010 preserves diagnostics.","number":5,"state":"covered"},{"explanation":"Admission requires one project/state/profile, nonempty unique-resolvable starts, declared relationship types, outgoing/incoming/both direction and valid explicit bounds.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-009\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Traverse selected engineering relationships with explicit completeness\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall let a participant traverse requirement parentage and declared typed relationships in either direction within one selected project model state, and distinguish complete results for the requested scope from limited or incomplete exploration.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Navigation may hide broken links or silently stop, making a partial relationship view look complete.\",\n      \"desired_outcome\": \"Participants can inspect connected obligations and responsibilities and understand the limits of the returned paths.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-002 selects starting entities, relationship types, direction, state, and optional limits as the traversal scope.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a participant requests ancestors, descendants, responsibility paths, or related engineering entities.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within the selected project and model state; no continuation across projects or baseline boundaries.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Identify the requested scope and return reachable entities and typed paths in that scope. Terminate cycles without repeated traversal of the same state. Identify requested limits and any unresolved references, interruptions, or resource limitations that restrict the result.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers full reachability within the selected relationship scope and explicitly limited exploration. It adds no implicit depth limit, result cap, response-time target, or user-interface prescription.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Given a finite connected model and no requested limit, return all reachable entities within the selected types and direction, including valid requirement ancestor and descendant paths.\",\n    \"Changing only the traversal direction exposes the corresponding incoming relationships derived from the same authored facts.\",\n    \"For a cyclic cross-domain graph, terminate and report reachable entities without treating the cycle as a requirement-parent cycle or repeatedly processing the same traversal state.\",\n    \"For an explicit depth or result limit, identify that limit and distinguish completion within the requested boundary from unrestricted reachability.\",\n    \"For a missing reference, interrupted read, or resource limit, identify the affected scope and incomplete outcome; do not report a complete empty result.\",\n    \"Reject an unresolved start, unknown relationship type, unsupported direction, or selection spanning models or baselines with an actionable scope diagnostic.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-009\",\n      \"basis\": \"Derived from IR-002 and its selected initial-profile scope: IR-002 selects starting entities, relationship types, direction, state, and optional limits as the traversal scope.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-009\",\n    \"FUNC-003\"\n  ]\n}\n","identity":"sha256:bbab4a06bc1dfa726412666c9247c99c1c9c3e50f0e8fcf6ea25b7abb5e9e6b7","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Coherent capture/traversal remains target Design; navigation/schemas cannot prove it. System proof requires MOD-001/003/004/010 composition. Historical delivery may remain stale."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-009","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 6 canonical SR-009 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:df135bcb902ffda46dbd2f735a38623cceeee5850c9c98857bf8e928c9b93f4d","path":"design/system/functions/FUNC-003-resolve-engineering-entity-by-stable-id.json"},{"identity":"sha256:7560d10784271c838deed35d3cd28879bfc4a5789a4d4324c0ea1db3bae8f842","path":"design/system/functions/FUNC-004-retrieve-engineering-definition-from-selected-model-state.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:ed45e0f248e77c6f6ab103a85517d95306e6279d96863145897cae2076272338","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-001-retain-engineering-definitions-across-sessions/AR-002-retrieve-definitions-with-explicit-state-and-completeness.json"},{"identity":"sha256:2e698cfd16e79197efd1204c4c5429167345cbf56e2b4a3581350b695be27665","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-002-unambiguous-entity-identity/AR-004-resolve-identities-without-hiding-absence-or-ambiguity.json"},{"identity":"sha256:6e2776414fdd6a37236d5a58e2cd72edcc99d87b3fcbb3e1ce3029b2de624b8c","path":"design/requirements/IR-001-preserve-engineering-knowledge-across-sessions/SR-004-understand-current-definitions-without-history-replay/AR-006-expose-current-authoritative-content-without-history-replay.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:6edf5726ab6d760956942141036b874a21934635a926169cb18d036c5303485f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-043-capture-attributable-customer-model-inputs.json"},{"identity":"sha256:f1ee063db8c6aeb54fa1f7fabffefb2d4abc1cd143eb56a69a16d0791aefd104","path":"design/requirements/scenarios/SCN-008-follow-responsibility-paths-within-a-selected-model-state.json"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:6ce1497da7edf831832acbb0299a145d4a40d33f211eba88b45c993d34f30475","path":"rem/models/architecture-design.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-060"],"criteria":[{"explanation":"The allocation request binds lifecycle applicability and required owner/deferral rules to exact selected-profile/project sources.","number":1,"state":"covered"},{"explanation":"For every relevant AR constraint the algorithm returns the AR-to-Module and AR-to-Function-to-Module paths, authored provenance and known/unresolved endpoint identities, together with the exact deciding rule.","number":2,"state":"covered"},{"explanation":"The contract supports explicit equality or declared directed ancestry predicates; different owner IDs alone do not decide a violation.","number":3,"state":"covered"},{"explanation":"Acquisition and evaluated-scope completeness are separate. IF-002 diagnostic interpretation preserves invalid/missing/unresolved facts while refusing invented complete interpretation. Unmodeled architecture, unfinished required constraints, ambiguous endpoints, interruption and missing membership remain incomplete; no applicable subjects is explicitly reported rather than vacuous consistency. Known violations survive partial scope.","number":4,"state":"covered"},{"explanation":"Only a nonempty fully evaluated applicable scope free of violation, deferral, question or gap may be summarized as mechanically consistent under the selected rules.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-010\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Expose gaps and conflicts in architectural allocation\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall expose missing, unresolved, or inconsistent declared allocations between applicable Allocated Requirements, constrained Functions, and accountable Modules, using the selected model state and declared allocation rules, while distinguishing unresolved review questions from mechanically established violations.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Requirement responsibility and functional responsibility can appear connected while assigning incompatible or missing architectural accountability.\",\n      \"desired_outcome\": \"An architect can locate allocation gaps or conflicts and see their requirement, Function, Module, and rule basis.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-002 and REM require requirement allocation and functional allocation to remain mutually consistent without reducing engineering judgment to link presence.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When reviewing declared responsibility for Functions and active Allocated Requirements.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Across the selected requirement, system-design, and architecture relationships in one model state.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Compare applicable requirement-to-Function constraints and their declared Module responsibilities under the selected metamodel. Identify absent or unresolved allocation and explicit exceptions. Only label a mismatch a violation where the declared rule establishes that conclusion; otherwise expose the different responsibilities for engineering review.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers inspectable allocation findings and their limits. It does not invent Module ownership, assume every pair must share one Module, prove architectural adequacy, or create ARs automatically.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For an active AR or Function lacking a required allocation under the selected rule, identify the entity and the missing responsibility; retain a declared permitted deferral as visible deferral rather than invented allocation.\",\n    \"For an AR constraining a Function, show both applicable allocation paths and identify the rule used to assess their agreement.\",\n    \"When allocations violate an explicit consistency rule, report the affected identities and rule; when responsibility differs without a decisive rule, report the need for engineering review instead of asserting a violation.\",\n    \"When architecture or relevant constraints are not yet modeled, state the unassessed or incomplete scope rather than reporting complete consistency.\",\n    \"Distinguish a mechanically consistent allocation set from an engineering judgment that the architecture satisfies its requirements.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-010\",\n      \"basis\": \"Derived from IR-002 and its selected initial-profile scope: IR-002 and REM require requirement allocation and functional allocation to remain mutually consistent without reducing engineering judgment to link presence.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-010\"\n  ],\n  \"constrains\": [\n    \"FUNC-009\"\n  ]\n}\n","identity":"sha256:56978c46744fbe04bf2a3815ba42b6269d01f80c06202dfc9a1a0e65b96ead9a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Logical analysis results only; callable protocols/adoption and runtime qualification remain separate. Repository views do not execute allocation/impact analysis."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-010","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 5 canonical SR-010 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"},{"identity":"sha256:628f24b4ad9f21faa44d6bf3884f35b5a0be79430c8e39950cb648c570152350","path":"design/system/functions/FUNC-011-report-possible-change-impact.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:c5424c9b92e6f55bcc1256fd46b6243ab1a21a1ee60f97ab085702b9e27d712f","path":"design/requirements/scenarios/SCN-009-review-converging-requirement-and-function-responsibilities.json"},{"identity":"sha256:a7e3dd88ebfa694d4d16ab8b1510ffc6ecf74e97b02a044253be8933f318abd3","path":"design/requirements/scenarios/SCN-010-investigate-possible-impact-of-a-proposed-engineering-change.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:98c94da392584be5a65a45b09120621d96fa4d26e157ae0e7294414d3b64ddb3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-tree.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:c400ae83432acce60523b9624b79d1d6fc59f316c41c22e4cd815645b7640089","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/AR-060-assess-declared-allocation-with-explicit-rule-and-scope.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-061"],"criteria":[{"explanation":"The composed result retains each non-seed candidate once with a named changed subject and finite typed witness containing intermediate identities, authored edge provenance and distinct original/traversal orientations.","number":1,"state":"covered"},{"explanation":"A nonempty normalized set of relationship-type/orientation pairs filters every edge of one combined influence graph, preserving alternating-type paths.","number":2,"state":"covered"},{"explanation":"Only Complete exploration permits the qualified no-additional-relationship-based-impact statement.","number":3,"state":"covered"},{"explanation":"Internal reuse preserves AR-056 acquisition, witness, cycle, minimum-depth and complete/bounded/incomplete/rejected meanings.","number":4,"state":"covered"},{"explanation":"Every candidate is potential impact for engineering review. Reached Evidence/Implementation references cannot invalidate support, establish behavior change, select required tests, authorize mutation or approve a change. MOD-007 and responsible domain owners retain consequence and evidence applicability decisions.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-011\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Explain possible change impact through engineering paths\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall identify entities potentially affected by a proposed change using explicitly selected relationship scope in one model state, and associate each reported impact with its supporting path while stating uncertainty and traversal limits.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An impact list without its relation to the proposed change can hide omissions or be mistaken for proven behavioral effects.\",\n      \"desired_outcome\": \"A participant can inspect why an entity may require review and distinguish potential impact from a confirmed consequence.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-002 requires assessable effects of proposed changes while limiting graph analysis to declared relationships and one selected state.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a participant investigates the possible effects of changing selected engineering entities.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within the selected project model state and relationship scope.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the changed-entity selection and declared influence directions to expose reachable entities and a supporting typed path for each. Carry through missing-reference, requested-limit, and interruption diagnostics and identify uncovered domains. Leave the effect judgment to the responsible engineering assessment.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers relationship-based potential impact. It does not infer unrecorded dependencies, predict code behavior, approve a change, or establish the required verification set by graph reachability alone.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For each potentially affected entity, present the selected change subject and at least one supporting typed path in the selected state.\",\n    \"Respect the requested relationship types and influence directions; do not silently broaden the selected scope or include unrelated entities as established impact.\",\n    \"Where no entity is reachable in a fully assessed scope, report no relationship-based impact in that scope without claiming the change has no real-world effects.\",\n    \"Carry limited or incomplete traversal status into the impact result and identify the omitted or unresolved scope.\",\n    \"Label the result as potential impact for review; a reachable Evidence or Implementation reference does not establish invalidation or behavior change by itself.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-011\",\n      \"basis\": \"Derived from IR-002 and its selected initial-profile scope: IR-002 requires assessable effects of proposed changes while limiting graph analysis to declared relationships and one selected state.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-011\"\n  ],\n  \"constrains\": [\n    \"FUNC-009\"\n  ]\n}\n","identity":"sha256:ebc04b8f7806761e8d29769aa5b6721813f2dfa801a4cda0dc8bda178f31a7f9","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-011-explain-possible-change-impact-through-engineering-paths/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Logical analysis results only; callable protocols/adoption and runtime qualification remain separate. Repository views do not execute allocation/impact analysis."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-011","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 5 canonical SR-011 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"},{"identity":"sha256:628f24b4ad9f21faa44d6bf3884f35b5a0be79430c8e39950cb648c570152350","path":"design/system/functions/FUNC-011-report-possible-change-impact.json"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:c5424c9b92e6f55bcc1256fd46b6243ab1a21a1ee60f97ab085702b9e27d712f","path":"design/requirements/scenarios/SCN-009-review-converging-requirement-and-function-responsibilities.json"},{"identity":"sha256:a7e3dd88ebfa694d4d16ab8b1510ffc6ecf74e97b02a044253be8933f318abd3","path":"design/requirements/scenarios/SCN-010-investigate-possible-impact-of-a-proposed-engineering-change.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:98c94da392584be5a65a45b09120621d96fa4d26e157ae0e7294414d3b64ddb3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-tree.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:1e9e1dcb3067d35425dd7af171dccc3cfb97f7793bdc6c92a405f38a2e191200","path":"design/system/features/FEAT-003-trace-engineering-relationships-and-change-impact.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:49574e3fd17329f3aa794b8975763733d11bf912262da2158263b67ec88bfd4e","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-011-explain-possible-change-impact-through-engineering-paths/AR-061-compose-witnessed-potential-impact-with-traversal-limits.json"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-010"],"criteria":[{"explanation":"Existing FUNC-012/AR-010 and IF-002 interpretation identify selected metamodel/profile content and provide governing definitions or state-bound resolvable references.","number":1,"state":"covered"},{"explanation":"Source and target/historical states retain separately identified profile definitions. The interpreter uses the supplied declaration, never the latest profile; the migration pipeline interprets source under source rules and validates target under target rules.","number":2,"state":"covered"},{"explanation":"Missing, conflicting, ambiguous, inaccessible and unsupported declarations or definitions yield explicit unavailable interpretation with affected scope.","number":3,"state":"covered"},{"explanation":"Current authoring explicitly selects its target profile; existing capture/read and candidate preparation preserve retained source rules and current selection.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-012\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Interpret model states using their identified metamodel\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall identify the governing metamodel and representation profile for a selected engineering state and interpret that state using those identified rules, reporting missing, unsupported, or inconsistent rule selections instead of silently applying another profile.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"The same retained content can acquire a different meaning when a reader silently applies the latest rules.\",\n      \"desired_outcome\": \"Readers can determine which definitions and conventions govern the selected state and when interpretation is unsupported.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-005 requires consistent meaning and retains each baseline with the metamodel and rules applicable to it.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When reading, checking, authoring, or migrating a selected current or historical model state.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Across governed entities and the Operational Support definitions identified by the selected state.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Make the selected metamodel and profile identifiable with their entity, relationship, identity, naming, lifecycle, and validity rules. Interpret supported content under that selection, preserving the difference between current authoring rules and retained historical interpretation.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers attributable rule selection and interpretation. The current implementation need not accept every historical format; unavailable historical interpretation is an explicit result. Storage and version-control technology remain replaceable.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For a supported selected state, identify its metamodel and profile and make the governing definitions available alongside interpretation results.\",\n    \"Select two states governed by different retained profiles; each result identifies its own governing rules rather than relabeling both with the current profile.\",\n    \"For a missing, ambiguous, unavailable, or unsupported profile, report the specific interpretation limit without asserting conformance under a substitute.\",\n    \"A current authoring action identifies the selected target profile; the existence of a newer profile does not silently adopt it for an existing state.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-012\",\n      \"basis\": \"Derived from IR-005 and its selected initial-profile scope: IR-005 requires consistent meaning and retains each baseline with the metamodel and rules applicable to it.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-012\"\n  ],\n  \"constrains\": [\n    \"FUNC-004\"\n  ]\n}\n","identity":"sha256:7339aa1fe37276f6f66e70aebd926c728add51dabd808d23f4769c147f845de5","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw-capture/pure-check/candidate design needs adapter, mapping, capacity and platform qualification; adoption/persistence writers remain separate.","Semantic equivalence, mapping adequacy and consumer judgments require attributable assessment, not hashes/counts. No operational migration, workflow/profile adoption or transition authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-012","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-012 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3e22cfeeefcf0f6f0e2eb88c37865ac8babcaea6ab4909d3961fb23d6fd74044","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-012-interpret-model-states-using-their-identified-metamodel/AR-010-interpret-content-under-the-selected-state-profile.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:c6ff789592c958e5a125e72e8d7c081a3293b9b8db3eda4d71935032570423fb","path":"design/system/features/FEAT-004-assess-engineering-model-conformance.json"},{"identity":"sha256:ab05cdad70e6a45cd246d6469f91b196e35d1bc5585b03845133c0ac64dc475a","path":"design/requirements/scenarios/SCN-011-read-a-retained-model-under-its-original-governing-rules.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-067"],"criteria":[{"explanation":"Whole-model checking starts with decoding, shape, required fields, known properties/types and closed values.","number":1,"state":"covered"},{"explanation":"The deterministic full relevant inventory supports identity/naming, typed-reference, parent-kind/cardinality and cycle checks.","number":2,"state":"covered"},{"explanation":"Cardinality checks use authoritative profile facts and complete relevant membership, including exactly one owning IR for a Scenario.","number":3,"state":"covered"},{"explanation":"Transition checks require matching prior/proposed identities and states plus required decision input and provenance.","number":4,"state":"covered"},{"explanation":"Results return exact state/profile, governing rule identities, requested/evaluated families, checked subjects, findings and unassessed dependencies.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-013\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Diagnose violations of declared model rules\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall assess a selected engineering model against its declared mechanically checkable rules and report actionable violations, unsupported checks, and incomplete assessment scope with the affected subjects and governing rules identifiable.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Shape-valid records can still have duplicate identities, conflicting containment, unresolved references, or invalid state transitions.\",\n      \"desired_outcome\": \"Authors can distinguish a valid assessed scope from concrete violations and from portions that could not be checked.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-005 explicitly separates automated record, identity, naming, hierarchy, reference, and lifecycle checks from engineering review.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When checking an authored or proposed engineering state against the selected profile.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Across the selected model and the previous state when a declared transition rule requires it.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Check record shape, required values, closed vocabularies, identity uniqueness, naming agreement, exclusive acyclic requirement parentage, typed reference resolution, declared cardinalities, and lifecycle transitions for which the necessary state is available. Report subjects, violated rules, and assessment limits; unknown vocabulary is invalid before dependent consistency checks.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers only rules declared as mechanically decidable by the selected profile. A state-only check cannot claim a transition was authorized or valid without its required prior-state and authority inputs.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For a missing required value, unknown property or closed-vocabulary value, or invalid shape, identify the affected record and rule rather than treating it as a supported variant.\",\n    \"For duplicate identities, mismatched derived names, multiple or incompatible requirement parents, requirement-parent cycles, and unresolved or wrongly typed references, identify the affected subjects and specific violation.\",\n    \"Apply declared relationship cardinalities, including exactly one owning IR per Scenario, independently from filename or display-name similarity.\",\n    \"For a lifecycle transition rule, assess the supplied prior and proposed states and required decision input; when a needed input is unavailable, report the transition unassessed rather than passed.\",\n    \"Return the checked model state, profile, assessed rule families, violations, and unassessed scope; an interrupted check cannot yield an unqualified success.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-013\",\n      \"basis\": \"Derived from IR-005 and its selected initial-profile scope: IR-005 explicitly separates automated record, identity, naming, hierarchy, reference, and lifecycle checks from engineering review.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-013\",\n    \"FUNC-002\"\n  ],\n  \"constrains\": [\n    \"FUNC-008\",\n    \"FUNC-012\"\n  ]\n}\n","identity":"sha256:ba9b9c6484825cad6d913f09ee95bbc00d29eab5a2b8db8f574ad34b6d98676c","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-013-diagnose-violations-of-declared-model-rules/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw-capture/pure-check/candidate design needs adapter, mapping, capacity and platform qualification; adoption/persistence writers remain separate.","Semantic equivalence, mapping adequacy and consumer judgments require attributable assessment, not hashes/counts. No operational migration, workflow/profile adoption or transition authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-013","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-013 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:91db4b6dead35ecf421671f0c5f7af85b8b85882bf4748581e08d41b83b201cc","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-013-diagnose-violations-of-declared-model-rules/AR-067-diagnose-model-rules-over-explicit-complete-scope.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:e3fa23aeb0b639459320519bf9a382f1ee11c7696fce1f76c2b420c8cf061d1c","path":"design/system/functions/FUNC-002-check-entity-identity-presence-and-uniqueness.json"},{"identity":"sha256:c6ff789592c958e5a125e72e8d7c081a3293b9b8db3eda4d71935032570423fb","path":"design/system/features/FEAT-004-assess-engineering-model-conformance.json"},{"identity":"sha256:b07ea37ecf83f7f232277898e1df62bbed604535bf04560bd469d930971d5e28","path":"design/requirements/scenarios/SCN-012-locate-model-violations-before-relying-on-an-authored-state.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-068"],"criteria":[{"explanation":"The result contract limits a mechanical account to exact checked state/profile/rules/scope and distinguishes known violations from assessment completeness.","number":1,"state":"covered"},{"explanation":"Clarity, rationale, derivation and evidence adequacy remain semantic review questions even when two model definitions pass the same structural rules.","number":2,"state":"covered"},{"explanation":"Supplied judgments retain purpose, assessor, exact subject/basis, conclusion and limitations in separate accounts.","number":3,"state":"covered"},{"explanation":"MOD-004/FUNC-010/AR-060 already own allocation analysis and deciding-rule attribution. New MOD-003 presentation preserves a supplied undecidable allocation difference as review-needed, without duplicating the allocation owner or promoting it to conflict/adequacy.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-014\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Separate model conformance results from engineering judgments\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall distinguish mechanically established model-conformance results from supplied engineering-review judgments when presenting an assessment, identify each subject, scope, and basis, and prevent a structural result from being presented as requirement approval, design adequacy, or requirement satisfaction.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A passing schema or relationship check can be mistaken for evidence that the model is meaningful, complete, or implemented correctly.\",\n      \"desired_outcome\": \"Participants understand what a result establishes and which conclusions still require engineering assessment.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-005 assigns clarity, derivation, allocation adequacy, assumptions, and evidence adequacy to engineering review rather than mechanical conformance.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When presenting a model-conformance result alone or alongside a supplied engineering-review judgment.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Within assessment of the selected engineering model and its declared rules.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Label the kind, subjects, governing rules, and assessed scope of each result. Keep supplied engineering judgments attributable to their review basis and separate from mechanical findings. Expose a review need where the rules cannot decide adequacy, without manufacturing a positive or negative judgment.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers presentation and interpretation of model-assessment outcomes, including supplied judgments; it does not create or approve those judgments. Review authority and controlled adoption belong to IR-003; evidence-backed satisfaction and its applicability belong to IR-004. This obligation constrains existing assessment behavior without introducing a separate Function merely to mirror this SR.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A successful mechanical result states which rules and state were checked and does not report the requirement approved, implemented, or satisfied.\",\n    \"Present two structurally valid definitions with different clarity or unsupported reasoning; leave adequacy to identified engineering review rather than inferring it from structural success.\",\n    \"When a supplied review judgment accompanies a mechanical result, preserve its identified subject and basis and present it distinctly from the mechanical observation; do not infer or fabricate review approval.\",\n    \"An allocation result needing semantic review is not silently promoted to a mechanically established conflict or a confirmed adequate design.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-014\",\n      \"basis\": \"Derived from IR-005 and its selected initial-profile scope: IR-005 assigns clarity, derivation, allocation adequacy, assumptions, and evidence adequacy to engineering review rather than mechanical conformance.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PRODUCTS\",\n      \"locator\": \"rem/methods/functional-analysis.md#confirm-relationships; SR-014\",\n      \"basis\": \"Reconcile this existing constraint obligation with refined Functional Analysis by confirming the two existing Functions whose behavior it governs. Independent review found their current definitions already distinguish mechanical findings from supplied engineering judgments and expose undecidable allocation adequacy for review. Original obligation, acceptance criteria, constraints, and Function behavior remain unchanged; this relationship grants no approval or satisfaction.\"\n    }\n  ],\n  \"constrains\": [\n    \"FEAT-004\",\n    \"FUNC-013\",\n    \"FUNC-010\"\n  ],\n  \"confirms\": [\n    \"FUNC-013\",\n    \"FUNC-010\"\n  ]\n}\n","identity":"sha256:f604dc48c793d58415de03fe757ec249e4ac699a87772a92b179a96c31bbffdc","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-014-separate-model-conformance-results-from-engineering-judgments/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw-capture/pure-check/candidate design needs adapter, mapping, capacity and platform qualification; adoption/persistence writers remain separate.","Semantic equivalence, mapping adequacy and consumer judgments require attributable assessment, not hashes/counts. No operational migration, workflow/profile adoption or transition authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-014","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-014 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:bbd6122b7db81a96e903822946d66cef75296ea29cc782bff310ffce39dfdcb3","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-014-separate-model-conformance-results-from-engineering-judgments/AR-068-keep-conformance-observations-distinct-from-supplied-judgments.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:5f5e1c57cc33f21b0825964cf0bae0bbbbf7c006b279c50ba413231add48b663","path":"design/system/functions/FUNC-010-assess-declared-architectural-allocation-consistency.json"},{"identity":"sha256:c6ff789592c958e5a125e72e8d7c081a3293b9b8db3eda4d71935032570423fb","path":"design/system/features/FEAT-004-assess-engineering-model-conformance.json"},{"identity":"sha256:977dc537e396f3efbcbd91e612b47f9651adb0c859a2e8372519ede22c928cff","path":"design/requirements/scenarios/SCN-013-distinguish-structural-conformance-from-engineering-adequacy.json"},{"identity":"sha256:c400ae83432acce60523b9624b79d1d6fc59f316c41c22e4cd815645b7640089","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-010-expose-gaps-and-conflicts-in-architectural-allocation/AR-060-assess-declared-allocation-with-explicit-rule-and-scope.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-069"],"criteria":[{"explanation":"Explicit immutable source, source/target profile content and finite mapping identity feed isolated candidate construction.","number":1,"state":"covered"},{"explanation":"Mapping primitives account for source fields/members and typed relationship meaning. Representation-only changes preserve stable IDs and normalized authoritative facts; every addition/removal/default/identity or semantic change needs supplied intentional-change basis. Counts or target schema success cannot substitute for equivalence.","number":2,"state":"covered"},{"explanation":"Every included source member, governed field and relationship receives copy/transform/intentional-removal/unmapped disposition.","number":3,"state":"covered"},{"explanation":"Whole target conformance and each declared consumer are checked against the exact staged candidate/profile.","number":4,"state":"covered"},{"explanation":"All preparation uses immutable inputs and separate target buffers, with no source alias/write or current-profile switch.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-015\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Prepare explicit model migrations without rewriting history\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall prepare a new current-model candidate from an identified source state and explicit source-to-target profile mapping, preserving stable identities and engineering meaning unless an intentional semantic change is recorded, and report target conformance and consumer-reconciliation results before adoption.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Changing representation rules can silently change model meaning, break references, or reinterpret historical decisions.\",\n      \"desired_outcome\": \"Maintainers can review an attributable migration candidate, its intentional changes, and remaining incompatibilities while the source remains recoverable.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-005 selects explicit reviewed mappings, preserved meaning or recorded semantic change, and checked current references and consumers before profile adoption.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and model authors\",\n        \"Architects, reviewers, and engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a maintainer proposes moving the current model from one declared profile to another.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Between identified source and target profiles for a selected project model state.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply a supplied mapping to a candidate state; retain the source state and applicable rules. Preserve identities and meanings for representational transformations, report intentional semantic changes and unmapped content, and assess target rules plus declared current consumers. Keep candidate preparation separate from controlled adoption.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers migration analysis and candidate production, including fail-safe incomplete results. It does not guarantee universal historical parser compatibility, invent unmapped decisions, or authorize profile adoption; controlled change and baseline recovery belong to IR-003.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Given a complete mapping and compatible source, produce an identifiable target candidate and a report relating it to the source state and both profiles.\",\n    \"For an identity-preserving representation change, retain entity IDs and equivalent authoritative relationships; flag each intentional semantic change with its supplied basis instead of treating it as a cosmetic rename.\",\n    \"For unknown source content, ambiguous mapping, conflicting target identities, or failed transformation, report the affected subjects and unresolved candidate status without silently dropping or inventing content.\",\n    \"Report target validation and declared consumer compatibility, including unassessed consumers; unresolved required checks prevent a claim that the candidate is ready for adoption.\",\n    \"Preparing or abandoning a candidate leaves the retained source and historical interpretation unchanged; candidate creation does not itself adopt the target profile.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-015\",\n      \"basis\": \"Derived from IR-005 and its selected initial-profile scope: IR-005 selects explicit reviewed mappings, preserved meaning or recorded semantic change, and checked current references and consumers before profile adoption.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-014\"\n  ],\n  \"constrains\": [\n    \"FUNC-012\",\n    \"FUNC-013\",\n    \"FUNC-002\"\n  ]\n}\n","identity":"sha256:2492fd1f6ec886ec844338117be9a3ca27efb8575df1c3c5c7e9b9e36fb84cdd","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-015-prepare-explicit-model-migrations-without-rewriting-history/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Rust raw-capture/pure-check/candidate design needs adapter, mapping, capacity and platform qualification; adoption/persistence writers remain separate.","Semantic equivalence, mapping adequacy and consumer judgments require attributable assessment, not hashes/counts. No operational migration, workflow/profile adoption or transition authority."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-015","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-015 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:0ddf0e66a59db268afe1d3af8a671f4df82eac6cf63f8b6840b5b1b336c97eba","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/README.md"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:498980aa84b8f81dbed673d802a7357f8adc63d69636c842316e9ab01acc09c4","path":"design/requirements/IR-005-keep-engineering-models-valid-and-consistently-interpreted/SR-015-prepare-explicit-model-migrations-without-rewriting-history/AR-069-prepare-attributable-migrations-without-source-mutation.json"},{"identity":"sha256:0d2329f7158503cbd7b1cb43508d0707c45aa284c7efb8b97bad0cc4540da704","path":"design/system/functions/FUNC-014-prepare-a-model-migration-candidate.json"},{"identity":"sha256:933e5a978cf48d19dfdbf09d6fa44000042fc8ad802295ec0360ee17e10dd3a0","path":"design/system/features/FEAT-005-migrate-engineering-models-between-declared-profiles.json"},{"identity":"sha256:879ddc7bffe06538f1afeb897ebb6d0613ec9fb4b86eedeeed68b2a5bd805f0f","path":"design/requirements/scenarios/SCN-014-prepare-a-profile-migration-while-preserving-historical-meaning.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-070","AR-071"],"criteria":[{"explanation":"MOD-005 descriptor binds unique project baseline identity, exact membership/definitions/relationships, original rules, provenance, included realization/assurance content and exclusions.","number":1,"state":"covered"},{"explanation":"Sealed immutable bundles and non-overwriting catalog descriptors preserve original bytes/profile definitions through later current-model changes.","number":2,"state":"covered"},{"explanation":"Included material requires supplied immutable bytes or supported exact acquisition observations.","number":3,"state":"covered"},{"explanation":"Complete required acquisition, original interpretation, full selected conformance and accountable cross-material coherence precede establishment.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-020\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Identify and preserve coherent engineering baselines\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall identify each retained Baseline and preserve its declared engineering scope, authoritative content, applicable interpretation rules, and provenance so participants can distinguish that state from subsequent changes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An unlabeled collection of current files cannot establish which engineering state was retained or what interpretation and scope belong to it.\",\n      \"desired_outcome\": \"A participant can select a retained state and understand exactly what is included, how its content is interpreted, and what lies outside its recoverable scope.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-003 requires identifiable coherent states whose historical meaning remains available under the retention policy.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers establishing baselines\",\n        \"Maintainers and reviewers relying on retained states\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a Baseline is established, inspected, or retained while later Changes proceed.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The declared governed scope of each retained Baseline.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Associate a stable Baseline identity with its scope and authoritative requirement and asset definitions, relationship facts, metamodel and rules, and source provenance. Identify any included realization or assurance material. Preserve the selected historical content when later states evolve, and distinguish external references from content actually retained. Report missing required content or unresolved interpretation rather than describing an incomplete collection as a coherent recoverable Baseline.\"\n    },\n    \"how_much\": {\n      \"scope\": \"One governed project and its declared retained Baselines. Coherence is assessed against the rules applicable to that state; this obligation does not approve its engineering decisions, require a particular storage technology, or promise recovery of unavailable external material. Retention release is governed by SR-024 and the selected policy.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For a retained Baseline, a participant can identify its unique identity, declared scope, authoritative definitions and relationships, applicable metamodel and rules, and source provenance, including which realization or assurance material is included.\",\n    \"After a later Change modifies a definition, relationship, or rule, inspecting the earlier Baseline still returns its original content and original interpretation basis.\",\n    \"When an external item is only referenced, the Baseline identifies the reference and does not claim that the external content is retained or recoverable.\",\n    \"When required content or applicable interpretation rules are missing or conflicting, the affected scope is reported and the collection is not represented as a complete coherent Baseline.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-020\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-020\",\n      \"basis\": \"Derived from IR-003: IR-003 requires identifiable coherent states whose historical meaning remains available under the retention policy. The criteria describe intended observable behavior, not executed verification.\"\n    }\n  ]\n}\n","identity":"sha256:e17161533905669c22742041d92755248e13b1ca007a9a4ed0091eaaf635c46c","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-020","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-020 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:f1e92fd3eb2e227c9a5e2b2fd2fdf75717bba8ffd77ca60fc3821c55ca1a5a16","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/AR-070-establish-baselines-from-confirmed-coherent-retained-scope.json"},{"identity":"sha256:ba41087b0df1d5c12ae152e35397deb80e06e0a31302e87be22f54da8e44fb02","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-020-identify-and-preserve-coherent-engineering-baselines/AR-071-preserve-immutable-baseline-content-with-attributable-custody.json"},{"identity":"sha256:2fb519f924328c02ff8c7d8c3657576c556804cd831d07150f6cac1412e4e3d6","path":"design/system/functions/FUNC-020-establish-and-inspect-retained-engineering-baselines.json"},{"identity":"sha256:ea072d90d827e5b0e26681e813dc4225f4aad0f4b9abefc2a6e55fbe0924f340","path":"design/system/features/FEAT-006-inspect-compare-and-recover-retained-engineering-baselines.json"},{"identity":"sha256:c36930c8b2bfd4a5de8dcf7412df4c1a03438ad334c4dfb8f8cdaed41c63a154","path":"design/requirements/scenarios/SCN-019-establish-an-identifiable-baseline-for-later-engineering-reliance.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-072"],"criteria":[{"explanation":"MOD-005 independently resolves both exact descriptors/bundles and matches entities by stable identity.","number":1,"state":"covered"},{"explanation":"Comparison returns directed before/after content, typed relations/endpoints, lifecycle/retirement, titles/locations, rules and relevant provenance under both original interpretation bases without rewriting either state.","number":2,"state":"covered"},{"explanation":"No recorded difference is limited to inspected selected facts and available scope. Hash equality, names and matching counts do not imply semantic equivalence, approval or satisfaction.","number":3,"state":"covered"},{"explanation":"Missing/corrupt membership, ambiguous identities or unsupported interpretation remain explicit comparison gaps.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-021\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Compare retained engineering states with their original meaning\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall compare two identified retained engineering states and expose additions, modifications, removals, and unchanged identities within the selected scope, using the interpretation rules applicable to each state and identifying any limits on the comparison.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A difference in physical location or display name can be mistaken for a new entity, while a changed rule can make a seemingly unchanged record mean something different.\",\n      \"desired_outcome\": \"A participant can distinguish changes to identity, definition, relationship, and governing interpretation and understand the completeness of the comparison.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-003 requires comparison of engineering states without rewriting the decisions or meaning of either state.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers assessing a Change\",\n        \"Reviewers investigating historical differences\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When two retained states are compared for review, investigation, or recovery planning.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Selected comparable scope within two identifiable retained engineering states.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Select both states and scope explicitly. Match governed entities by stable identity, expose changed content and typed relationships, and distinguish additions and removals from naming or location changes. Include differences in applicable rules and retain both interpretation bases. Mark unavailable content or incompatible interpretation as a comparison limitation rather than assuming equality.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Recorded content and relationships within the selected scope, including interpretation and provenance differences when they affect meaning. No automatic semantic equivalence judgment, performance target, or comparison of unrecorded work is required.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Comparing states in which the same entity was renamed or moved reports a change to the same identity; a distinct new identity is reported as an addition.\",\n    \"A changed obligation, relationship target, retirement state, or applicable rule is identifiable with the before and after states and their interpretation bases.\",\n    \"Comparing identical selected content reports no recorded difference within that scope without making a broader satisfaction or approval claim.\",\n    \"When either state or a required portion cannot be interpreted or retrieved, the comparison identifies that limitation and does not report the unknown portion as unchanged.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-021\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-021\",\n      \"basis\": \"Derived from IR-003: IR-003 requires comparison of engineering states without rewriting the decisions or meaning of either state. The criteria describe intended observable behavior, not executed verification.\"\n    }\n  ]\n}\n","identity":"sha256:8a96525ea64d7cc0aac2d1fcc94bd8d7e9bb1aae4577b212ecdb7590daa2abd4","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-021-compare-retained-engineering-states-with-their-original-meaning/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-021","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-021 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:51916da9d431a87db354b9da8b26c22a7c4142763cf19a4d5441c6a9204d26e2","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-021-compare-retained-engineering-states-with-their-original-meaning/AR-072-compare-retained-states-under-their-original-bases.json"},{"identity":"sha256:27c06f8dfa8680d7c9a5490dd7f21c3e6699cd0362187a777dcf4239d958b01c","path":"design/system/functions/FUNC-021-compare-selected-retained-engineering-states.json"},{"identity":"sha256:ea072d90d827e5b0e26681e813dc4225f4aad0f4b9abefc2a6e55fbe0924f340","path":"design/system/features/FEAT-006-inspect-compare-and-recover-retained-engineering-baselines.json"},{"identity":"sha256:f896ef17c06179be5b5a8b8dd4576f97623a3317356de4895a4250b9c319f6fa","path":"design/requirements/scenarios/SCN-020-understand-what-changed-between-two-retained-engineering-states.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-073"],"criteria":[{"explanation":"MOD-005 selects the immutable descriptor and sealed scope, IF-015/001 reproduces original manifest/material, and full inventory/byte/length/recorded-attribute comparison establishes fidelity.","number":1,"state":"covered"},{"explanation":"Historical definitions, typed relationships, allocation and included judgment/provenance content remain bound to retained rules; current owners or conclusions cannot retarget the recovered account.","number":2,"state":"covered"},{"explanation":"Corrupt/missing/inaccessible/unsupported members or rules, partial output and lost receipts preserve exact known and uncertain scope and prevent complete recovery.","number":3,"state":"covered"},{"explanation":"The declared manifest and explicit external-only/excluded scope bound recovery. Later unsaved work and content never retained are not claimed recovered.","number":4,"state":"covered"},{"explanation":"Recovery writes only a newly created owned isolated area; existing/active-work destinations and escaped/aliased paths reject.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-022\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Recover retained baselines without altering historical meaning\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall reproduce the recorded authoritative content, identities, relationships, interpretation rules, and provenance of an available intact retained Baseline when recovery is declared complete, and shall explicitly report unavailable, incomplete, or failed recovery.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Recovery can silently substitute current content or rules for the historical state, losing the engineering meaning the participant intended to restore.\",\n      \"desired_outcome\": \"A participant obtains the selected state with its original meaning and can distinguish complete recovery from known missing or unavailable content.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-003 explicitly requires recovery with zero loss or alteration relative to the selected intact retained Baseline.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Maintainers recovering prior states\",\n        \"Reviewers inspecting an exact historical engineering basis\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"On demand when a participant selects an available intact retained Baseline for recovery.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The scope recorded by the selected retained Baseline.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Identify the requested Baseline and declared retained scope, reproduce its authoritative content together with the interpretation and provenance needed to preserve its meaning, and report the recovered state and completeness. Do not retarget historical relationships to current owners. Recovery availability does not authorize replacing active work; any destructive adoption remains subject to SR-007.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Recovery from intact accessible retained storage. Complete recovery permits zero loss or alteration relative to the selected Baseline. There is no elapsed recovery-time commitment, storage-disaster guarantee, preservation of unsaved work, or guarantee of unavailable external content.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Recovering an intact retained Baseline reproduces all authoritative content in its declared scope, including original identities, relationships, interpretation rules, and provenance, without substituting later definitions.\",\n    \"If an earlier requirement was allocated to one architectural responsibility and a later state changes that allocation, the recovered earlier state retains the original allocation and decision meaning.\",\n    \"Missing, inaccessible, uninterpretable, or partially recovered content is identified with its affected scope; the result is not reported as complete.\",\n    \"Material outside the selected Baseline, including later unsaved work and external content not retained with it, is not implied to have been recovered.\",\n    \"A request to recover a Baseline alone does not authorize overwriting active work or performing another action reserved by the selected project policy.\"\n  ],\n  \"assumptions\": [\n    \"The selected retained Baseline and its applicable interpretation rules remain intact and accessible.\"\n  ],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-022\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-022\",\n      \"basis\": \"Derived from IR-003: IR-003 explicitly requires recovery with zero loss or alteration relative to the selected intact retained Baseline. The criteria describe intended observable behavior, not executed verification.\"\n    }\n  ]\n}\n","identity":"sha256:df0f264c8b823ade0379862fe0930249fdbf84863a605db728c09bf5edec9138","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-022-recover-retained-baselines-without-altering-historical-meaning/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-022","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-022 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:7b02f92249e05ee103d919e7ee0360a05a744992c1be69cdd329f4f59228d682","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-022-recover-retained-baselines-without-altering-historical-meaning/AR-073-recover-baselines-into-isolated-verified-output.json"},{"identity":"sha256:b492e30e5151f3b6ee34063dd17874f32b96b9975c645c837dc0b23aa98cc3c5","path":"design/system/functions/FUNC-022-recover-the-recorded-content-of-a-retained-baseline.json"},{"identity":"sha256:ea072d90d827e5b0e26681e813dc4225f4aad0f4b9abefc2a6e55fbe0924f340","path":"design/system/features/FEAT-006-inspect-compare-and-recover-retained-engineering-baselines.json"},{"identity":"sha256:385e0822df58215815ad39c8c777052317df9834a033095df9026f250d9d9399","path":"design/requirements/scenarios/SCN-021-recover-an-earlier-baseline-with-its-original-engineering-meaning.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-074"],"criteria":[{"explanation":"IF-016 transition preparation binds project/Change, initiating basis, exact before/result descriptors, affected subjects/revisions, accountable decisions/actors and observed outcome.","number":1,"state":"covered"},{"explanation":"Prepared intent, observed execution, recorded decision and confirmed retention remain separate.","number":2,"state":"covered"},{"explanation":"Significant adopted/completion corrections add attributable explanatory support referring to original basis; routine working summaries may be replaced when reliance is preserved.","number":3,"state":"covered"},{"explanation":"Current definitions remain readable through their owning model boundary without replaying Change history.","number":4,"state":"covered"},{"explanation":"Authority uses the existing selected-policy/grant meaning; favorable assessments and suggestions are labeled separately.","number":5,"state":"covered"},{"explanation":"Actual prepared transition content is retained through MOD-012→IF-004→IF-003 using existing fields and exact attachments, with readback after uncertain effects.","number":6,"state":"covered"},{"explanation":"Compact completed operational acceptance accounts preserve important outcome/basis and current support without every implementation action/check.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-023\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Record controlled transitions and their engineering provenance\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall retain each governed Change as an identifiable transition with its scope, initiating basis, affected engineering subjects, recorded decisions, and resulting state, distinguishing proposed or incomplete work from an established transition between Baselines.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A final state alone hides why it changed, while a proposed action can be mistaken for an adopted engineering decision.\",\n      \"desired_outcome\": \"Participants can explain an established transition from its recorded basis and recognize unfinished work without reconstructing a private conversation.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-003 separates current definitions, Change history, and configuration history and requires controlled transitions with provenance.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers carrying out Changes\",\n        \"Reviewers and project decision owners inspecting transitions\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a Change is proposed, revised, adopted, corrected, or inspected after completion.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The governed Change and its referenced before and after engineering states.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Identify the Change, its initiating needs or source basis, intended scope, affected subjects and revisions, actor and decision provenance, and actual disposition. Associate an established transition with its before and resulting Baselines and the applicable decision basis. Preserve the difference between proposals, assessments, authorizations, and adopted outcomes. Current definitions remain directly understandable without replaying these records.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Recorded transitions within one governed project. This does not prescribe branch, review-host, or approval technology; SR-007 determines applicable authority. Actual verification evidence is governed by IR-004 and is referenced at its owner rather than copied or implied by completion labels. The local operational-history extension adds the criteria attributed to SRC-LOCAL-OPERATIONAL-ANALYSIS; retained product contracts and old allocation evidence do not establish implementation or coverage of that extension.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"An established Change identifies its originating and resulting Baselines, affected subjects, initiating basis, adopted outcome, and recorded actor and decision provenance.\",\n    \"A proposed or interrupted Change remains distinguishable from an established transition and does not claim a resulting Baseline or decision that has not been recorded.\",\n    \"A correction to a significant adopted decision or completion statement is explicit and attributable to its original basis. Routine working-state updates need not preserve every previous version.\",\n    \"Reading the current engineering model does not require replaying Changes to obtain its current definitions; inspecting the Change explains the transition and its recorded provenance.\",\n    \"Assessment results and suggested actions are identifiable as such and do not become authorization merely because they appear in the Change history.\",\n    \"Change provenance remains inspectable independently of current engineering definitions, and unavailable history is reported without invented decisions or a false claim that no Change occurred.\",\n    \"The provenance of a completed operational Change may be a compact outcome and acceptance account. Engineering Baseline provenance does not require logging all implementation actions or intermediate checks.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-023\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-023\",\n      \"basis\": \"Derived from IR-003: IR-003 separates current definitions, Change history, and configuration history and requires controlled transitions with provenance. The criteria describe intended observable behavior, not executed verification.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-023\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-023\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ]\n}\n","identity":"sha256:b70f07a016cc975c404dc99533736cacd6a3f240681b9211d75619e891bab658","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-023-record-controlled-transitions-and-their-engineering-provenance/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-023","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical SR-023 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:9016671af0f96818a9607a01582c800ae503996de827f14dbb0b6fad237e244d","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-023-record-controlled-transitions-and-their-engineering-provenance/AR-074-prepare-attributable-controlled-transition-accounts.json"},{"identity":"sha256:8985e5e5c42ec020c0b2d188d84ad38fb9e11a68701cf956767f9dc9e5cd3304","path":"design/system/functions/FUNC-023-record-controlled-change-transitions-and-provenance.json"},{"identity":"sha256:539b34dcfdb521197a5939b2b027e8c0338880dcf5363662092ec0b35082d24c","path":"design/system/features/FEAT-007-control-and-resume-engineering-changes.json"},{"identity":"sha256:a9e2e87df49df0372ad3e707a5ed28c99d59b5992f5356c234caef5bc2950638","path":"design/requirements/scenarios/SCN-022-explain-an-adopted-change-from-its-recorded-transition.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-075","AR-076"],"criteria":[{"explanation":"The corrected Scenario and MOD-006 classification distinguish preserved engineering/history material requiring recoverable originals from superseded operational detail with no reliance/retention obligation.","number":1,"state":"covered"},{"explanation":"Complete bounded model and non-model consumer/reliance inspection includes active work, findings, evidence, prose/file readers and current obligations.","number":2,"state":"covered"},{"explanation":"Uncommitted or otherwise unretained required originals need explicit confirmed recovery before removal.","number":3,"state":"covered"},{"explanation":"Replacements must already be readable and semantically adequate at current owners with usable current references.","number":4,"state":"covered"},{"explanation":"Age and import success cannot decide disposal or authority. Explicitly retained history release remains a distinct policy decision and dependency review; ordinary current-view cleanup cannot delete sealed bundles.","number":5,"state":"covered"},{"explanation":"Model effects use IF-015/001 guarded custody, operational detail uses existing IF-004 retention tasks, and external source cleanup is participant-controlled under the corrected stability boundary.","number":6,"state":"covered"},{"explanation":"Comparable working evidence cannot erase relevant failure/contrary support for another scope. Completion records actual partial/removed/unresolved members and intentionally discarded detail; later reads report unavailable material rather than substituting new bytes.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-024\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Retire current-view material only after resolving surviving dependencies\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall permit compaction of superseded operational detail after resolving current reliance, while preserving unresolved obligations, meaningful completed accounts and explicitly retained engineering material under its applicable retention policy.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Cleanup can discard uncommitted knowledge, active findings, current evidence, or links still needed by current engineering work.\",\n      \"desired_outcome\": \"Maintainers can reduce obsolete working-view material while preserving current reliance and recoverable original history.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-003 requires retention of active work and current-reliance material and permits cleanup only after historical recoverability and dependency reconciliation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Maintainers retiring engineering material\",\n        \"Owners of surviving obligations and consumers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Before material leaves the current working view or the project releases retained material under a controlled retention-policy decision.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Candidate retired material, retained historical states, and surviving governed dependencies.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Separate replaceable operational detail from explicitly retained engineering history. Resolve current obligations and reliance before compaction; no historical copy is required for superseded working information with no decision value. Retained Baselines, selected completion meaning and migration originals keep their applicable preservation rules.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Governed engineering material and its declared current consumers. Removal from the current working view differs from destruction of retained history. No permanent duplicate archive, automatic age-based expiry, or universal retention duration is required. SR-007 governs authorization for destructive actions and policy changes. The local operational-history extension adds the criteria attributed to SRC-LOCAL-OPERATIONAL-ANALYSIS; retained product contracts and old allocation evidence do not establish implementation or coverage of that extension.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For engineering definitions, retained Baselines and explicitly preserved history, cleanup identifies recoverable originals and reconciles consumers. Superseded working summaries and routine logs need no historical copy when no open obligation, current conclusion or explicit retention decision relies on them.\",\n    \"When active work, unresolved findings, required evidence, or another current dependency still relies on the material without a coherent replacement, removal is prevented and the unmet reliance is identified.\",\n    \"Uncommitted or otherwise unretained content cannot be described as historically recoverable without first establishing a retained recovery basis.\",\n    \"After permitted cleanup, current obligations and references remain usable without retrieving retired definitions to operate the current model, while historical inspection preserves the retired material's original meaning.\",\n    \"Age alone cannot decide usefulness. Operational detail may be discarded when current dependencies are resolved; release of explicitly retained engineering history remains subject to its selected retention policy.\",\n    \"Before retiring operational source files, current consumers and required evidence must have a coherent replacement or explicit disposition, and original content required for historical reliance remains recoverable. A successful import alone does not authorize deletion.\",\n    \"Replacing comparable working evidence cannot erase a failure for another scope. Unavailable discarded detail is reported honestly and cannot silently resolve to newer bytes.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-024\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-024\",\n      \"basis\": \"Derived from IR-003: IR-003 requires retention of active work and current-reliance material and permits cleanup only after historical recoverability and dependency reconciliation. The criteria describe intended observable behavior, not executed verification.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-024\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-024\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ]\n}\n","identity":"sha256:1e8332fabc5d1038e4c0eaaf3b5d31fcc230e7a0eb5ac576f50d12fa4bee9d19","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No qualified catalog/custody, recovery/retirement executor or filesystem platform, interruption/race proof. Rust custody and participant preparation remain target realization.","Recovery is isolated, not adoption. Maintenance, full resumption and whole-IR outcomes are separate account scopes. Semantic coherence, authority, reliance completeness and adoption require judgments; storage/schema success is insufficient. AR-046 delivery history/staleness remain."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-024","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical SR-024 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:5fd3e768592c85688ced0f7b973c93e806741d8930d754efce8b59322783040e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-005-engineering-baseline-management/module.json"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:15e4dd1181e56262d6452dac66b161b6b6fee11c7c0314bf1c3849e47fb2c598","path":"design/architecture/interfaces/IF-007-engineering-state-content-and-interpretation/interface.json"},{"identity":"sha256:fa8ca0d659be092453eae8b0cf7ccb2e0b1d47852760a820d18ee8e21822eab8","path":"design/architecture/interfaces/IF-015-engineering-baseline-content-custody/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:4917081e867bd98336b3da64e9208e06f5ad5c31b78754b209dfb334e5910c61","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/conformance-and-migration.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:dc45b900e32b344fb193aef3bba305bef515cb305d54e80aa62be811e71f3704","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/AR-075-resolve-reliance-before-authorizing-current-material-retirement.json"},{"identity":"sha256:49b7f04d8890a8af9ff9b5ec67c4c7d07ecf47010f32ad90a65e1a0c885dd344","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-024-retire-current-view-material-only-after-resolving-surviving-dependencies/AR-076-apply-state-bound-model-retirement-without-corrupting-retained-history.json"},{"identity":"sha256:a1950aba542f169c423b1352b1533716ef92894a540bf9c339a02f2a5d908de4","path":"design/system/functions/FUNC-024-assess-and-apply-retirement-of-current-view-material.json"},{"identity":"sha256:539b34dcfdb521197a5939b2b027e8c0338880dcf5363662092ec0b35082d24c","path":"design/system/features/FEAT-007-control-and-resume-engineering-changes.json"},{"identity":"sha256:f6fcb78dab4247ceac142cd0021b1075e27c60fbeaedcf9640ed727cac01a704","path":"design/requirements/scenarios/SCN-025-retire-completed-material-while-preserving-current-reliance-and-history.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-062"],"criteria":[{"explanation":"MOD-007 method preparation binds exact criterion content/revision, subject/state, technique, conditions, expected observations, intended scope and author.","number":1,"state":"covered"},{"explanation":"Common admission and method checks distinguish omitted state, condition or criterion from an explicitly irrelevant condition.","number":2,"state":"covered"},{"explanation":"Revised criteria, expectations or subject binding create a new identified method basis; relied-on earlier observations retain their actual method text or immutable reference.","number":3,"state":"covered"},{"explanation":"The method-only v4 Evidence mapping is explicitly inconclusive for unperformed target verification, with reported/unknown method basis, exact attachment and no-execution/no-satisfaction limits.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-025\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Define verification against identifiable requirement criteria\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall retain a verification definition that identifies its requirement and acceptance criteria, assessed subject and state, selected technique, conditions, and expected observations, without treating that definition as executed verification or evidence.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An unscoped test or review plan cannot show which obligation and exact subject it would assess.\",\n      \"desired_outcome\": \"A reviewer can determine what a planned assessment is intended to establish and distinguish its method from actual observations.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-004 requires identifiable verification methods and a clear separation between obligations, verification definitions, observed evidence, and judgments.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Verification engineers defining assessments\",\n        \"Reviewers interpreting planned verification\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When verification is defined or revised before an engineering claim is assessed.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The requirement criteria and exact subject state addressed by the selected verification definition.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Retain the relevant requirement and criterion basis, exact assessed subject and state, verification technique, assessment conditions, expected observations, and intended claim scope. Allow test, analysis, inspection, demonstration, review, or measurement as appropriate. Keep any unbound subject state or missing conditions explicit until they are supplied rather than implying an executable complete method.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Verification definitions for the declared claim scope. This does not require an automated technique, prescribe a test framework or CI, or impose a universal number of checks. The profile records assessment meaning; architectural realization of assurance records is deferred.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A reviewer can identify the requirement criteria and their basis, assessed subject and state, selected technique, conditions, expected observations, and intended claim scope from a complete verification definition.\",\n    \"A definition with a missing subject state, condition, or criterion remains visibly incomplete for that scope and cannot be presented as a completed observation.\",\n    \"Changing the criterion basis or expected observation preserves the distinction between the revised definition and earlier observations made using an older definition.\",\n    \"A retained test file, review checklist, or verification definition with no execution observations does not establish that any criterion has been satisfied.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-027\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-025\",\n      \"basis\": \"Derived from IR-004: IR-004 requires identifiable verification methods and a clear separation between obligations, verification definitions, observed evidence, and judgments. The criteria describe intended observable behavior, not executed verification.\"\n    }\n  ]\n}\n","identity":"sha256:a9ccdbfde2fe8a260c232bea8fb9cb8e575d4a7d723f5c69dc386b97891a3a19","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-025-define-verification-against-identifiable-requirement-criteria/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-025","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-025 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:3e0839c2e595f5c53faac3c12c0b04d67b00369df010e0b4876c280a7e2fee77","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-025-define-verification-against-identifiable-requirement-criteria/AR-062-prepare-state-bound-verification-definitions.json"},{"identity":"sha256:3da76ed9a92f8ff53dc84cd3256a7926a595e356aef80be434f9faa1084d0e75","path":"design/system/functions/FUNC-027-retain-criterion-based-verification-definitions.json"},{"identity":"sha256:4cbdf8b7833af39c36824391966613150bdefbbc99657dce553f5e5e836d31e8","path":"design/system/features/FEAT-008-define-verification-and-record-observed-evidence.json"},{"identity":"sha256:8817920591acf5bd89a27594440919b6c9486c6fc830202666aad9e4f89e4b93","path":"design/requirements/scenarios/SCN-026-define-how-a-requirement-criterion-will-be-verified.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-063"],"criteria":[{"explanation":"Occurrence content identifies the actual method/criterion basis, occurrence, exact observed state, conditions, observing actor/source and supporting bytes.","number":1,"state":"covered"},{"explanation":"Planned/unperformed work has no claimed actual observations. Interrupted activity retains attributable obtained results and an explicit unassessed remainder; this remains separate from criterion outcome and does not expand the assessed scope.","number":2,"state":"covered"},{"explanation":"Execution state distinguishes unable-to-assess, interrupted and completed from favorable/adverse/inconclusive criterion outcomes.","number":3,"state":"covered"},{"explanation":"Relevant adverse/contradictory content and original provenance survive a later favorable occurrence or replacement summary until an accountable scoped disposition.","number":4,"state":"covered"},{"explanation":"Unavailable attachment bytes, missing provenance, state or conditions remain explicit reliance gaps even for reported success.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-026\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Retain actual verification observations and execution state\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall retain identifiable observed verification results with their method, exact assessed subject and state, assessment conditions, provenance, and supporting evidence, distinguishing completed observations from planned, unperformed, interrupted, or failed assessment activity.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A planned check, partial execution, or untraceable result can be presented as if it were actual complete proof.\",\n      \"desired_outcome\": \"A participant can inspect what actually happened, under which assessment basis, and which intended observations remain absent.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-004 defines Evidence as actual observations and forbids treating plans or the existence of a test as proof.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Verification engineers recording results\",\n        \"Reviewers and decision owners relying on observations\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When verification is performed, interrupted, fails to execute, or is inspected later.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The execution occurrence, its verification definition and exact assessed state, and retained supporting evidence.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Associate each observed result with its assessment occurrence, applicable verification definition and criterion basis, exact subject state, actual conditions, source or observing participant, and supporting evidence. Preserve negative and contradictory observations. Record partial scope, inability to assess, or unavailable support explicitly. Do not convert an execution failure into either a passing result or an unsupported conclusion that the requirement itself failed.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Actual observations within the declared assessment scope. Evidence may come from automated or human techniques; no universal evidence medium, observation duration, numerical confidence, or passing threshold is introduced. History and retention follow IR-003.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A recorded observation identifies what was observed, its assessment occurrence and method, exact subject state, conditions, provenance, and supporting evidence needed to inspect the result.\",\n    \"A planned or unperformed check contains no claimed execution observations; an interrupted check identifies observations actually obtained and the scope that remains unassessed.\",\n    \"An inability to perform the technique is distinguishable from an observed failure of an acceptance criterion; neither is silently converted into a passing result.\",\n    \"Conflicting or failing observations retain their content and provenance rather than being overwritten by a later favorable observation.\",\n    \"Unavailable supporting evidence or incomplete provenance is reported as a limit on reliance on that result.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-028\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-026\",\n      \"basis\": \"Derived from IR-004: IR-004 defines Evidence as actual observations and forbids treating plans or the existence of a test as proof. The criteria describe intended observable behavior, not executed verification.\"\n    }\n  ]\n}\n","identity":"sha256:e96a55c71ccf89fa5837e964dc4b0019b36742d6dfd781559a8ed66e740d4133","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-026-retain-actual-verification-observations-and-execution-state/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-026","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-026 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:8766875a4f5c42af78d715aeed0f1688e708c5672d65e02b4f48977d3888dbea","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-026-retain-actual-verification-observations-and-execution-state/AR-063-preserve-actual-observation-meaning-through-recording.json"},{"identity":"sha256:0d4c34a662fae8b74f1c59da1062b9094d557cbfc2130c89975f5a1703af4cf6","path":"design/system/functions/FUNC-028-retain-actual-verification-observations-and-provenance.json"},{"identity":"sha256:4cbdf8b7833af39c36824391966613150bdefbbc99657dce553f5e5e836d31e8","path":"design/system/features/FEAT-008-define-verification-and-record-observed-evidence.json"},{"identity":"sha256:b28936ae77c000f5752e98e1a61b34975a1fcc17dd9367e3e23274fb081a713d","path":"design/requirements/scenarios/SCN-027-record-what-actually-happened-during-a-verification-assessment.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-064"],"criteria":[{"explanation":"Applicability compares selected subject/state, exact criterion basis, scope, method/conditions, provenance, availability and required freshness.","number":1,"state":"covered"},{"explanation":"Missing applicability fields, unknown materiality and incomplete dependency information yield named unknowns and potentially affected scope.","number":2,"state":"covered"},{"explanation":"Attributable applicability includes assessed scope, reporter reasoning and selected support/basis necessary for interpretation.","number":3,"state":"covered"},{"explanation":"Stable IDs, stored method files, labels and hash equality alone provide no semantic current-applicability conclusion.","number":4,"state":"covered"},{"explanation":"The contract keeps requirement, integrated Design, advisory, whole-change Code Review and final Verify purposes separate.","number":5,"state":"covered"},{"explanation":"Reassessment explicitly distinguishes actor-reported no-change from defined mechanical comparison with its actual scope.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-027\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Assess evidence applicability to the claimed engineering state\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall expose whether recorded evidence applies to the exact requirement criteria, assessed subject and state, and conditions of a proposed engineering claim, retaining the basis and limits of that applicability assessment.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A stable entity identity or an earlier passing result can disguise changes that make evidence irrelevant to the present claim.\",\n      \"desired_outcome\": \"Reviewers can distinguish applicable observations from missing, stale, or uncertain support and see the engineering basis for any claimed continued applicability.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-004 requires applicability to assessed revisions and states that unchanged identity does not by itself carry satisfaction across changes.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Reviewers evaluating evidence reuse\",\n        \"Verification engineers planning reassessment\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Whenever evidence is offered for a claim and whenever its subject, criteria, or relevant assessment conditions change.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The proposed claim basis and the independently recorded evidence basis.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Compare the claim's subject state, criterion basis, scope, and relevant conditions with those of the observations. Expose concrete mismatches and unknowns. Record semantic applicability judgments with their rationale and source instead of equating mechanical identity matches with sufficient proof. Preserve the original evidence basis when assessing a different state.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Applicability within the declared claim scope. A matching recorded basis supports applicability checks but does not itself establish criterion satisfaction; a semantic equivalence or reuse conclusion requires its own recorded engineering basis. No automatic carry-forward of satisfaction is allowed. The requirement-first workflow extension is draft; existing Function/AR and product-contract coverage must be reassessed before its adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Evidence for a different subject revision, criterion basis, scope, or materially different condition is identified with the mismatch and is not silently used as current support.\",\n    \"When relevant applicability information is missing, the result is explicitly unknown or incomplete and identifies the missing basis.\",\n    \"A current applicability conclusion states its scope, rationale and reporter. Preserve the assessed basis and selected support needed for that conclusion; no full source archive or old-run inventory is required.\",\n    \"An unchanged entity identity, existing test definition, or passing label alone cannot establish applicability to a changed claim basis.\",\n    \"Advisory scope, whole-change review scope and final verification scope remain distinguishable when assessing applicability. A clean narrower advisory judgment cannot support a whole-change approval merely because the inspected files are part of the Change.\",\n    \"A claim of no relevant changes distinguishes an actor report from a defined mechanical comparison and states its scope. Timestamps, current labels and saved summaries alone do not establish unchanged subjects.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-029\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-027\",\n      \"basis\": \"Derived from IR-004: IR-004 requires applicability to assessed revisions and states that unchanged identity does not by itself carry satisfaction across changes. The criteria describe intended observable behavior, not executed verification.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-027\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-027\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ]\n}\n","identity":"sha256:ffc96ad018255d8dac9f312f828f22e72ccf2c03c5f12ec15266c036dd8c5bfe","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-027-assess-evidence-applicability-to-the-claimed-engineering-state/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-027","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-027 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:7a0893bf829f001663df33e9f27723998adf501899f3d8394af833f65f8d2568","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-027-assess-evidence-applicability-to-the-claimed-engineering-state/AR-064-expose-scoped-evidence-applicability-with-attributable-comparisons.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"},{"identity":"sha256:3b50e839f6dd83d2c1b4105fb44d5a3fed99e3120f281ad3bc64f49629937fa5","path":"design/system/features/FEAT-009-assess-evidence-supporting-engineering-claims.json"},{"identity":"sha256:881973be3aea9c08cd74fd628bed7a40bda6191ad72255dd81940c1fe4a2b6ff","path":"design/requirements/scenarios/SCN-028-judge-a-claim-against-applicable-observations-and-uncovered-criteria.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-065"],"criteria":[{"explanation":"Every included criterion has explicit applicable and contrary observations, unknown/gap status and accountable reasoning bound to exact subject and criterion basis.","number":1,"state":"covered"},{"explanation":"Known missing required support or unresolved material contradiction leaves the claim unestablished and prevents justified favorable reliance.","number":2,"state":"covered"},{"explanation":"A narrower supported conclusion requires the assessor to name included and excluded scope; preparation cannot silently shrink an unsuccessful full claim or present the entire requirement as supported.","number":3,"state":"covered"},{"explanation":"Complete references, passing labels and machine coverage are explicitly insufficient for semantic adequacy.","number":4,"state":"covered"},{"explanation":"Judgment, accepted exception/tradeoff and execution authority remain separate; IF-009 and MOD-006 retain authority and IF-010 support does not waive it.","number":5,"state":"covered"},{"explanation":"The existing Assessment policy and contract separate independent requirement reuse from later integrated System/Architecture completeness.","number":6,"state":"covered"},{"explanation":"Current conclusions retain sufficient support and unresolved obligations without a mandatory permanent attempt archive.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-028\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Record scoped engineering judgments from criterion coverage\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall make an engineering judgment traceable to its declared claim scope, requirement criteria, applicable supporting and contradictory evidence, unresolved gaps, and recorded reasoning, and shall not present satisfaction as established where a required criterion lacks support or a material contradiction remains unresolved.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A favorable summary can conceal uncovered criteria, conflicting observations, or a decision whose scope exceeds the available evidence.\",\n      \"desired_outcome\": \"A decision owner can understand what the evidence supports, what remains unestablished, and which conclusion requires engineering judgment.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-004 selects criterion coverage and applicability as its sufficiency rule and distinguishes mechanical inspection from semantic engineering judgment.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Reviewers forming engineering judgments\",\n        \"Project decision owners using scoped conclusions\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When satisfaction, readiness, or another engineering conclusion is asserted or reassessed.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The exact subject, state, criteria, and scope declared by the engineering claim.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Account for every criterion in the claim, identify applicable observations and gaps, and preserve material contradictory evidence with its disposition or unresolved status. Record the judging participant or accountable source, conclusion, scope, and rationale. Allow a narrower supported claim only when its boundaries and excluded criteria remain explicit. Mechanical coverage checks expose support and inconsistencies; they do not supply unstated semantic judgments or action authority.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Claims within explicitly stated criterion and subject scope. No universal test count, coverage percentage, confidence score, or review-vote threshold is required. Judgment is separate from the authorization governed by SR-007 and does not itself execute a governed action. The requirement-first workflow extension is draft; existing Function/AR and product-contract coverage must be reassessed before its adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A reviewer can trace each criterion within a satisfaction claim to applicable observations and inspect the judgment's subject state, scope, author or accountable source, and reasoning.\",\n    \"A missing applicable observation or unresolved material contradictory observation leaves the affected claim unestablished and is visible in its coverage and judgment.\",\n    \"A narrower supported conclusion names its supported scope and excludes the unsupported portion without presenting the entire requirement or broader readiness claim as satisfied.\",\n    \"A mechanical check reporting complete references or passing labels does not substitute for a recorded semantic conclusion that the evidence supports the criteria.\",\n    \"A judgment does not confer execution authority, and a permitted exception or accepted tradeoff is not mislabeled as observed requirement satisfaction.\",\n    \"A requirement-review judgment may accept a reuse conclusion or assessable requirement basis before Function/AR design is complete; a design-review judgment assesses that later completeness separately. Each judgment names its scope and independence basis rather than substituting one gate for another.\",\n    \"Retain attributable current conclusions and sufficient supporting summaries, not every intermediate assessment file. Updating working progress cannot author reviewer approval or change the meaning of support still being relied upon.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-030\",\n    \"FUNC-031\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-028\",\n      \"basis\": \"Derived from IR-004: IR-004 selects criterion coverage and applicability as its sufficiency rule and distinguishes mechanical inspection from semantic engineering judgment. The criteria describe intended observable behavior, not executed verification.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-028\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-028\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ]\n}\n","identity":"sha256:e2378e5f388d6d54c50f8427ca9b9a0fbaf3cb9553dc5d6ac912f13b19d7cd50","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-028-record-scoped-engineering-judgments-from-criterion-coverage/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-028","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical SR-028 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:0027c0caec17687fe548b67ec08c12586e7bb87fa6c0394066d6931aed84bcde","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-028-record-scoped-engineering-judgments-from-criterion-coverage/AR-065-prepare-accountable-judgments-from-explicit-criterion-coverage.json"},{"identity":"sha256:85db55d933a26a2b6840d630caab1172dc9c820486bfca845444ab3fdf81fc59","path":"design/system/functions/FUNC-030-expose-claim-criterion-coverage-and-contradictory-evidence.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"},{"identity":"sha256:3b50e839f6dd83d2c1b4105fb44d5a3fed99e3120f281ad3bc64f49629937fa5","path":"design/system/features/FEAT-009-assess-evidence-supporting-engineering-claims.json"},{"identity":"sha256:881973be3aea9c08cd74fd628bed7a40bda6191ad72255dd81940c1fe4a2b6ff","path":"design/requirements/scenarios/SCN-028-judge-a-claim-against-applicable-observations-and-uncovered-criteria.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-066"],"criteria":[{"explanation":"Reassessment compares current reliance with changes to subject, criteria, conditions, evidence, dependencies and governing rules; it identifies affected criteria/interactions and necessary repeated verification under AR-066.","number":1,"state":"covered"},{"explanation":"Planned repeated checks supply no observations. Affected support remains unestablished until actual applicable observations and an accountable conclusion justify the current scope.","number":2,"state":"covered"},{"explanation":"Replacement judgments name new assessed basis, assessor, reason and limitations; unresolved findings and still-relied-on prior conclusions survive.","number":3,"state":"covered"},{"explanation":"Incomplete dependencies and uncertain materiality expose potentially affected scope instead of no-impact.","number":4,"state":"covered"},{"explanation":"Correction review covers changed subjects and affected interactions while retaining only explicitly justified unaffected support.","number":5,"state":"covered"},{"explanation":"Demonstrably immaterial bookkeeping edits and equivalent collection retries may use an attributable scoped applicability disposition.","number":6,"state":"covered"},{"explanation":"Completed Change accounts remain historical. Later regressions become linked new work; original-account errors receive explicit accountable annotations preserving the declared outcome rather than continuous monitoring or silent rewriting.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-029\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Reassess claim support after engineering changes\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall expose reassessment needs when the basis of a currently relied-on engineering claim changes, retaining enough assessed context to judge applicability without requiring every superseded observation or judgment to remain stored.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An engineering Change can leave an earlier satisfaction claim appearing current even though its supporting assessment no longer addresses the changed subject or obligation.\",\n      \"desired_outcome\": \"Participants know which relied-upon claim support needs reassessment and can distinguish historical conclusions from newly established support.\"\n    },\n    \"why\": {\n      \"rationale\": \"IR-004 explicitly requires applicability reassessment and repetition of affected verification after changes rather than inheritance from stable identity.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers changing assessed subjects\",\n        \"Verification engineers and reviewers reassessing affected claims\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"After changes to the subject, governing criterion, or relevant conditions of a relied-upon engineering claim.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Affected claim support and its recorded subject, criterion, evidence, and judgment relationships.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Assess changed scope, criteria and conditions for currently relied-on claims. Keep sufficient assessed basis and concise support for the current judgment, expose uncertainty, and repeat only affected verification. Superseded detail need not be archived. Completed Changes remain historical; new regressions are linked new work.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Changes within the governed scope and explicit assessment dependencies. The system exposes unresolved impact or applicability when dependencies are incomplete. This obligation defines required reassessment behavior without prescribing automatic execution, CI triggers, or an unrestricted inference engine. The requirement-first workflow extension is draft; existing Function/AR and product-contract coverage must be reassessed before its adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Changing an assessed subject or acceptance criterion makes the affected earlier support subject to applicability reassessment and identifies verification that requires repetition.\",\n    \"Planning a repeated check does not restore current satisfaction; the affected scope remains unestablished until applicable observations and a justified conclusion support it.\",\n    \"A replacement current judgment names its assessed basis, accountable assessor, reasoning and limitations. Preserve unresolved obligations and any prior conclusion still being relied upon; superseded detail without decision value may be compacted.\",\n    \"When incomplete dependencies prevent determining which support is affected, the uncertainty and potentially affected scope are visible rather than treated as unaffected.\",\n    \"Correction reassessment examines the changes and affected interactions and explicitly preserves only still-applicable prior support. It establishes adequate coverage for the current claim without automatically rereading unchanged files or repeating unaffected checks.\",\n    \"Bookkeeping changes, evidence-collection retries or edits shown to leave assessed meaning and support unchanged do not require a new Review. A concise applicability disposition identifies the changed scope and why prior approval remains sufficient. Material effects require affected reassessment; unknown impact or contradictory evidence prevents unsupported renewed reliance. Changed file bytes alone do not decide approval applicability.\",\n    \"Completed Change accounts are historical, not continuously reassessed against the repository. A later regression becomes linked new work; a discovered mistake in the original account is explicitly annotated without silently rewriting the declared outcome.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-029\",\n    \"FUNC-030\",\n    \"FUNC-031\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-029\",\n      \"basis\": \"Derived from IR-004: IR-004 explicitly requires applicability reassessment and repetition of affected verification after changes rather than inheritance from stable identity. The criteria describe intended observable behavior, not executed verification.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-029\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-PROPORTIONATE-REVIEW\",\n      \"locator\": \"SR-029\",\n      \"basis\": \"User-directed refinement of review applicability after subsequent edits: preserve original judgments, allow justified harmless-change continuation and independently reassess material effects. Author-assessed design/requirement refinement only; no runtime adoption or independent approval is claimed.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-029\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ]\n}\n","identity":"sha256:ee2d4a2a69ce348cef2cfbcc49b09a3127d164bbcd40ebfaddbb592cdc8f9eba","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-029-reassess-claim-support-after-engineering-changes/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","Assessor-assisted preparation/inspection and explicit recording; no automatic semantic sufficiency, universal evidence discovery, actor authentication or installed guidance qualification.","Native attachments/prose add no command, wire grammar or record type. Provenance, sufficiency, independence and authority require accountable judgment, not save/render success; no release approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-029","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical SR-029 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:dcd46f9c5050b448c22730968f518884a887b023c250a534277737a6de5f9f86","path":"design/architecture/interfaces/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:3425c4ac2c6872d28034c0068b02470bb3cf036d18f484238890894632c6e171","path":"design/requirements/IR-004-assess-engineering-claims-using-applicable-evidence/SR-029-reassess-claim-support-after-engineering-changes/AR-066-reassess-current-reliance-without-rewriting-historical-meaning.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"},{"identity":"sha256:85db55d933a26a2b6840d630caab1172dc9c820486bfca845444ab3fdf81fc59","path":"design/system/functions/FUNC-030-expose-claim-criterion-coverage-and-contradictory-evidence.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"},{"identity":"sha256:3b50e839f6dd83d2c1b4105fb44d5a3fed99e3120f281ad3bc64f49629937fa5","path":"design/system/features/FEAT-009-assess-evidence-supporting-engineering-claims.json"},{"identity":"sha256:86db1f2d61934c0bf540249997135aff4dd2bed6ccd47c1caf46456879eb900e","path":"design/requirements/scenarios/SCN-029-reassess-earlier-claim-support-after-a-subject-or-criterion-changes.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-079 covers the required MOD-008 contribution; existing assurance and recording owners are reused. No further AR is needed for this scoped obligation.","state":"not-required"},"ar_children":["AR-079"],"criteria":[{"explanation":"FUNC-032 and IF-008 bind both presentations to one activity/profile and exact inspected canonical content; differing prose cannot alter governing meaning.","number":1,"state":"covered"},{"explanation":"guidance.md records owner, locator, content identity, applicability and normative/example role; its worked batch example navigates each relevant method.","number":2,"state":"covered"},{"explanation":"A changed activity, source or profile is compared with the captured selection; incompatible, superseded, missing and unresolved material stays distinct without latest-version fallback.","number":3,"state":"covered"},{"explanation":"Missing activity, profile, owner guidance or required example yields named affected scope. A mixed read requires captured-basis reuse or renewed preparation, never false applicability.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-032\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Select applicable canonical authoring guidance\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall make the canonical concepts, methods, rules, and worked examples applicable to a requested authoring activity and declared profile version identifiable to human and agent authors, including their owning sources and any unavailable or incompatible guidance.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Authors can apply outdated or unrelated instructions without recognizing a mismatch with the model they are editing.\",\n      \"desired_outcome\": \"An author can identify which guidance applies, why it applies, and where its authoritative explanation resides.\"\n    },\n    \"why\": {\n      \"rationale\": \"People and agents need one engineering meaning across presentation forms and profile changes.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"New REM authors with basic engineering knowledge\",\n        \"Experienced model maintainers and reviewers\",\n        \"Engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When beginning an authoring activity or using guidance after the selected profile changes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Authoring within one governed project and its declared method and model profile.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Identify the requested activity and selected profile, present applicable canonical owners with rationale and worked examples, and distinguish unavailable, superseded, and incompatible material. Human and agent presentations preserve the same normative meaning and disclose the applicable source version.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers locating and explaining applicable guidance for requirements, Scenarios, system and architecture definitions, relationships, naming, correction, and retirement. Interpretation and migration of profiles are owned by IR-005; selecting guidance does not migrate a model or make unsupported authoring formats available.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For the same activity and profile, a human and an agent can identify the same governing definitions, rules, and source versions despite different presentations.\",\n    \"Given an authoring activity, provide its owning guidance, a relevant worked example, and the reason that guidance applies; distinguish required rules from explanatory examples.\",\n    \"After a profile selection changes, identify guidance that applies to the selected version and flag previously used incompatible or superseded material instead of silently applying it.\",\n    \"When the activity, profile version, or applicable guidance cannot be identified, report the missing context and unsupported scope without claiming an applicable authoring method.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-032\",\n      \"basis\": \"Derived from IR-006 and its declared initial authoring scope; the acceptance criteria describe assessment intent, not observed results.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-032\"\n  ]\n}\n","identity":"sha256:11164a5918fbd34a517dd0139be01d9ba96652f4a021b8d5e4491e48ec21e1a6","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/sr.json"},"limitations":["Design only; no implementation, executed verification, participant usability or installed-skill qualification. Delivery unchanged.","Participant-assisted exact source selection and semantic comparison; no automatic judge, universal performance claim, new schema/command or profile adoption.","Actual outcomes require observed tasks/checks/explanations; assistance, missing/unsupported scope and original bases remain explicit. Authority, formal assurance and confirmed retention keep separate owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-032","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-032 criteria; target participant-assisted Design.","state":"covered","subjects":[{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:25d6e04a47206a5d83867259de252532bb9d2990707c12ff5f60290dad665e82","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:7616f27fa93749af2e127663bcfd04fef9579dff8d3ed0c5d00f63f872a245de","path":"design/system/functions/FUNC-032-select-canonical-guidance-for-an-authoring-activity.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:77d7c993e82c80a9d8b796f87cc739f3072160b147b71ce4ca2ec4b9a1bbfcd2","path":"design/requirements/scenarios/SCN-031-derive-clear-requirements-and-system-definitions-with-canonical-guidance.json"},{"identity":"sha256:24c7f20283bc9189ab223a419d11567b7b2e44fec51c644f2ad54540ea800f91","path":"design/requirements/scenarios/SCN-033-select-authoring-guidance-after-a-profile-change.json"},{"identity":"sha256:24c1b6e3f1eaef9be7f3eec5f0db0d042a1c2cbe700610b12c0ef7aa364fd30f","path":"design/requirements/scenarios/SCN-040-define-architectural-responsibilities-with-canonical-guidance.json"},{"identity":"sha256:e1219ca351ff6b902a6da757148d0bfd1a837a7eeca90cbedb68fec13c1f06f1","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-032-select-applicable-canonical-authoring-guidance/AR-079-bind-authoring-guidance-to-its-applicable-source-basis.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-080 covers the required MOD-008 contribution; existing assurance and recording owners are reused. No further AR is needed for this scoped obligation.","state":"not-required"},"ar_children":["AR-080"],"criteria":[{"explanation":"The worked need supplies all seven 5W2H answers and single-parent derivation; the invalid-batch Scenario states external outcomes without internal calls.","number":1,"state":"covered"},{"explanation":"The batch capability is distinguished from validation/retention Functions, with inputs, accepted/rejected/incomplete outcomes and canonical clarity rules.","number":2,"state":"covered"},{"explanation":"Worked allocation assigns the complete retention obligation and Function to one owner; the Interface names provider, consumer, inputs and failures, while unsupported formats cannot claim conformance.","number":3,"state":"covered"},{"explanation":"Corrections bind the finding, diagnostic, rule and exact affected state to a proposed result and checks; missing or changed basis blocks an unsupported fix claim.","number":4,"state":"covered"},{"explanation":"Rename keeps identity/parentage and reconciles references; semantic reparenting is separate. Retirement resolves obligations and required recoverable meaning through existing owners.","number":5,"state":"covered"},{"explanation":"Unresolved decisions remain explicit, with responsible clarification and only independent work proceeding. Guidance neither edits nor grants authority, and a valid example cannot establish satisfaction.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-033\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Guide bounded engineering authoring and correction\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall guide people and agents through the declared model-authoring activities using applicable canonical methods, explaining the governing rules and distinguishing supported edits, unresolved engineering decisions, and actions requiring separate authority.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Formally valid fields do not explain how to derive an obligation, express behavior, allocate responsibility, or correct a finding.\",\n      \"desired_outcome\": \"Authors can produce and explain coherent engineering definitions without relying on the originating conversation.\"\n    },\n    \"why\": {\n      \"rationale\": \"Guidance must support engineering judgment across entity boundaries rather than treating a filled form as a correct design.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Human and agent model authors\",\n        \"Reviewers and maintainers correcting definitions\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When creating, refining, relating, renaming, retiring, or correcting definitions in a declared authoring activity.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Requirement Analysis, System Design, and Architecture Design activities supported by the selected profile.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Explain the activity inputs, steps, expected semantic outcome, and applicable checks. Use 5W2H for requirements; preserve the single-parent requirement tree; analyze black-box Scenarios; distinguish capabilities from logical behavior and architectural responsibility. Relate identifiable diagnostics to their owning rules. Where clarification is necessary, expose only the highest-value unresolved question at a time without concealing uncertainty or inventing an answer.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers guidance for IR/SR/AR, Scenario, Feature/Function, Module/Interface, typed relationships, naming, retirement, and correction. Representation rules must exist before records are claimed conformant. Guidance may explain architecture analysis before its record formats exist, but cannot claim those formats are implemented. Validation, retention, historical recovery, and authorization remain with their existing requirements.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Given a prepared need, guidance explains all seven 5W2H answers, one IR parent per SR and one SR parent per AR, and how black-box Scenarios inform obligations without becoming requirements or internal call sequences.\",\n    \"For Feature and Function authoring, explain stakeholder capability versus logical behavior and the clarity criteria for names, scope, inputs, outputs, and failure outcomes.\",\n    \"For architecture authoring, explain consistent Function and AR allocation to an accountable Module and an Interface interaction with explicit provider and consumer; identify unavailable representation formats before claiming conformance.\",\n    \"Given a wrongly typed or unresolved reference, identify the diagnostic, owning rule, affected definition, and a correction path whose result is subject to the applicable checks.\",\n    \"For a rename, explain identity preservation, unchanged requirement parentage, and reconciliation of current references; for retirement, explain disposition of current obligations and preservation of recoverable historical meaning.\",\n    \"Distinguish an analysis question from a confirmed decision and an authoring recommendation from execution or adoption authority; a valid record or completed example is not presented as requirement satisfaction.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-033\",\n      \"basis\": \"Derived from IR-006 and its declared initial authoring scope; the acceptance criteria describe assessment intent, not observed results.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-033\"\n  ],\n  \"constrains\": [\n    \"FEAT-010\"\n  ]\n}\n","identity":"sha256:0a98d6e691a745754a985a49e118bac13e85c508ea60235eb5f99617d903626f","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/sr.json"},"limitations":["Design only; no implementation, executed verification, participant usability or installed-skill qualification. Delivery unchanged.","Participant-assisted exact source selection and semantic comparison; no automatic judge, universal performance claim, new schema/command or profile adoption.","Actual outcomes require observed tasks/checks/explanations; assistance, missing/unsupported scope and original bases remain explicit. Authority, formal assurance and confirmed retention keep separate owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-033","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-033 criteria; target participant-assisted Design.","state":"covered","subjects":[{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:25d6e04a47206a5d83867259de252532bb9d2990707c12ff5f60290dad665e82","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:92153a9115ae4d3b6e0184a95c89e6b3b6ade3f80793c097b715abbe4286c265","path":"design/system/functions/FUNC-033-explain-engineering-authoring-and-correction-steps.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:77d7c993e82c80a9d8b796f87cc739f3072160b147b71ce4ca2ec4b9a1bbfcd2","path":"design/requirements/scenarios/SCN-031-derive-clear-requirements-and-system-definitions-with-canonical-guidance.json"},{"identity":"sha256:52ab1aea07fb7dfb5351c872c3b494403478092f032ec93ea6d251f6724d678b","path":"design/requirements/scenarios/SCN-032-correct-and-retire-engineering-definitions-using-their-governing-rules.json"},{"identity":"sha256:24c1b6e3f1eaef9be7f3eec5f0db0d042a1c2cbe700610b12c0ef7aa364fd30f","path":"design/requirements/scenarios/SCN-040-define-architectural-responsibilities-with-canonical-guidance.json"},{"identity":"sha256:6c44ffbbe94834879a1b7047b6961bb7ed9c1b923b445c29bb0b3059a9dbd999","path":"rem/methods/5w2h.md"},{"identity":"sha256:6973551e7d8b2d709a8a99c4d819af049a3bdc0e25ea06e5c64cc0c78e5468e1","path":"rem/methods/requirement-analysis.md"},{"identity":"sha256:a095ea5dc500a5afcfb1eb9875c05ca80111f3af82eb53c8ea22f3613c5079be","path":"rem/methods/scenario-analysis.md"},{"identity":"sha256:70aca72b937bc5063b2fd130d3e050d3973c16b478426bdf78e7b34bd3c80cb4","path":"rem/methods/functional-analysis.md"},{"identity":"sha256:675b1b02d083815c4563baacefc2bc53e9de19eee1c735559af1c0baae218388","path":"rem/methods/architecture-allocation.md"},{"identity":"sha256:6ce1497da7edf831832acbb0299a145d4a40d33f211eba88b45c993d34f30475","path":"rem/models/architecture-design.md"},{"identity":"sha256:91e68cf217ed10cf4c794722bb48718926d3994f3495089f36fbd8a8372c88a8","path":"rem/models/requirements.md"},{"identity":"sha256:4d6e2356f9a742c605f56e636f4ef29c979024cf8eae2432ec46aa32c98f7acf","path":"rem/models/operational-support.md"},{"identity":"sha256:305c34fc2c2fe2997a7e3d672ab04d6616af8f8421a50c9b53ef25176deb4d29","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/requirement-analysis.md"},{"identity":"sha256:cb6137d5432b1273021274aa372a71d4a54b024b151e9ab704fd7697049c724e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/design-authoring.md"},{"identity":"sha256:4f0b1cae66ccb72d183467b891306975c837f873cafc5d2ff2f6c765492c8110","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-033-guide-bounded-engineering-authoring-and-correction/AR-080-explain-checkable-authoring-corrections-within-owner-boundaries.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-081 covers the required MOD-008 contribution; existing assurance and recording owners are reused. No further AR is needed for this scoped obligation.","state":"not-required"},"ar_children":["AR-081"],"criteria":[{"explanation":"Before performance, the maintainer identifies participant group, exact source/profile basis, task input/state, independent expectation, rule explanation, checks and assistance conditions.","number":1,"state":"covered"},{"explanation":"The task matrix covers all specified analysis, Scenario, capability/behavior, allocation, Interface, rename, reference correction and retirement activities; subsets remain explicitly bounded.","number":2,"state":"covered"},{"explanation":"Comparison requires actual semantic output, passed applicable checks and an adequate rule explanation from selected guidance. Structural validity or conversation-only help cannot alone establish success.","number":3,"state":"covered"},{"explanation":"Actual wrong outcomes, ambiguity, help and interruption remain visible; unsupported formats separate conceptual observations from unperformed conformance, and missing observations stay unassessed.","number":4,"state":"covered"},{"explanation":"Participant groups, exact versions and assistance are separate dimensions. Bounded findings cannot become universal usability or population claims; changed expectations retain old observations under their original basis.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-034\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Assess guidance using semantic authoring outcomes\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall support assessment of authoring guidance with prepared task inputs and expected semantic outcomes for the declared participant groups, recording the produced outcome, applicable check results, explanation of governing rules, ambiguities, and additional help required.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A readable guide can still cause incorrect engineering definitions or require undocumented assistance.\",\n      \"desired_outcome\": \"Maintainers can identify which guidance works for the intended activities and which gaps require correction.\"\n    },\n    \"why\": {\n      \"rationale\": \"Usability and semantic correctness require observed task outcomes rather than the existence of documentation.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Guidance maintainers\",\n        \"Human authors new to REM\",\n        \"Experienced authors and reviewers\",\n        \"Engineering agents\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When assessing guidance for initial use or a material change in the guidance or applicable profile.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Prepared authoring assessments within the declared project profile and supported activity scope.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Identify the participant group, guidance and profile versions, supplied inputs, expected semantic outcomes, and applicable checks before assessment. Record actual results and whether the participant explains the governing rule without the originating conversation. Report incorrect results, ambiguities, unsupported activities, and extra assistance; leave unobserved tasks unassessed.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers qualitative task outcomes across requirement derivation, Scenario/system definition, consistent architectural allocation and interactions, naming, reference correction, and retirement. It sets no invented time limit, pass rate, population size, or claim of general usability. Evidence capture and claim applicability reuse IR-004.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"An assessment identifies its participant group, guidance/profile versions, prepared inputs, expected outcome, and applicable checks before a result is judged.\",\n    \"Prepared tasks include IR 5W2H and SR parentage, black-box Scenario and Feature/Function distinctions, consistent AR/Function allocation, explicit Interface interaction, identity-preserving rename, reference correction, and retirement with surviving obligations addressed.\",\n    \"A task is reported successful only when its expected semantic outcome is produced, applicable checks pass, and the governing rule can be explained from the canonical guidance without the originating conversation.\",\n    \"Record incorrect outcomes, unresolved ambiguities, and additional assistance alongside successful results; identify unavailable authoring formats and unperformed tasks rather than reporting them passed.\",\n    \"A report distinguishes results for new authors, experienced authors/reviewers, and agents and limits conclusions to the observed tasks and stated versions.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-034\",\n      \"basis\": \"Derived from IR-006 and its declared initial authoring scope; the acceptance criteria describe assessment intent, not observed results.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-034\"\n  ]\n}\n","identity":"sha256:98bbb8a10d2c65ed2107ae29b9de5961e6374a8f57d20c6ca2c7a1b16cdc9978","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-034-assess-guidance-using-semantic-authoring-outcomes/sr.json"},"limitations":["Design only; no implementation, executed verification, participant usability or installed-skill qualification. Delivery unchanged.","Participant-assisted exact source selection and semantic comparison; no automatic judge, universal performance claim, new schema/command or profile adoption.","Actual outcomes require observed tasks/checks/explanations; assistance, missing/unsupported scope and original bases remain explicit. Authority, formal assurance and confirmed retention keep separate owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-034","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-034 criteria; target participant-assisted Design.","state":"covered","subjects":[{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:25d6e04a47206a5d83867259de252532bb9d2990707c12ff5f60290dad665e82","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:fee3866fd49b961a63f7a9fa282eaaa20ad87233786368a7fe856f015aa20f69","path":"design/system/functions/FUNC-034-assess-authoring-guidance-against-prepared-task-outcomes.json"},{"identity":"sha256:c7d7afecb25c31ac460ff49e3565c9685d41e24702fe0790c80daa7ff7489fe2","path":"design/system/features/FEAT-010-guide-engineering-model-authors.json"},{"identity":"sha256:eb9cf4117d17600948ce6d7e2f4d7ed1befef8ee8267ce2c12dcd2603308d07a","path":"design/requirements/scenarios/SCN-034-assess-authoring-guidance-with-prepared-engineering-tasks.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:eb4023bc54f433e22abd94a88aed99eae8d976bb4671c4ff5860d58f187aed6b","path":"design/requirements/IR-006-guide-people-and-agents-in-authoring-engineering-models/SR-034-assess-guidance-using-semantic-authoring-outcomes/AR-081-compare-prepared-guidance-tasks-without-manufacturing-success.json"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-082 covers the MOD-009 obligation; existing authority, assurance and retention owners supply their distinct contributions. No further AR is required.","state":"not-required"},"ar_children":["AR-082"],"criteria":[{"explanation":"FUNC-035/IF-017 bind observations and their original sources/context separately from inferred mechanisms, alternatives and contrary information; writing a topic cannot turn a hypothesis into fact.","number":1,"state":"covered"},{"explanation":"improvement.md applies recurrence, reusable weakness or supported high-consequence relevance with explicit mechanism, situations and exclusions; recurrence alone does not prove cause.","number":2,"state":"covered"},{"explanation":"Findings without a supported broader implication return to the owning work as local corrections; no durable topic or generally applicable rule is manufactured.","number":3,"state":"covered"},{"explanation":"Missing or contradictory support keeps the causal conclusion provisional and names the required assessment while preserving actual observations and their limits.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-035\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Characterize reusable engineering lessons from supported findings\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall support selecting and characterizing reusable lessons from engineering failures and review findings, distinguishing observed facts from inferred causes and recording the supporting sources, failure mechanism, applicability, and limits of the lesson.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An isolated finding can be generalized into a rule without evidence of its cause or relevance outside the original event.\",\n      \"desired_outcome\": \"Maintainers can distinguish supported reusable knowledge from a local correction or an unconfirmed causal hypothesis.\"\n    },\n    \"why\": {\n      \"rationale\": \"Improvements must address a justified mechanism within a stated context rather than perpetuating unsupported explanations.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents reporting failures\",\n        \"Reviewers\",\n        \"Maintainers responsible for engineering practice\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"After a finding suggests recurrence, reusable guidance or control weakness, or a single high-consequence failure with broader applicability.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Learning from governed project work and its attributable observations.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Associate the finding with its observations and original context, record causal interpretations explicitly as inferences, and assess whether the finding meets the declared reuse criteria. Preserve uncertainty and identify applicable situations and counterconditions. Keep a local correction with its Change when no reusable implication is supported.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers selection and characterization of lessons, without requiring one for every defect or establishing a new mandatory lesson record format. Preservation is governed by IR-001; evidence authenticity and applicability by IR-004.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For a supplied finding, distinguish observations and their sources from an inferred cause; an unproven hypothesis remains labeled and does not become an observed fact.\",\n    \"Record why a recurring failure, reusable guidance/control weakness, or high-consequence broadly relevant event justifies a retained lesson, together with its mechanism and applicability limits.\",\n    \"For a local correction without reusable implications, record that disposition with the owning Change instead of presenting it as a generally applicable lesson.\",\n    \"When evidence is missing or contradicts the proposed cause, expose the unsupported inference and prevent a conclusive lesson claim on that basis.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-035\",\n      \"basis\": \"Derived from IR-007 and its declared initial authoring scope; the acceptance criteria describe assessment intent, not observed results.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-035\"\n  ]\n}\n","identity":"sha256:ebe79d84d659cd5f09959503a0f70fcb56bf4af24ea55d1aeb8d2e0fbcc73d3c","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/sr.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-035","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-035 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:7be9f608eb844fa4a727aa04970221394d750ce9db45170a46b1667828205935","path":"design/system/functions/FUNC-035-characterize-a-reusable-lesson-from-an-engineering-finding.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:6e6e8f2b34df676236b803d626f98d59fd15ff1babea8dbd5c9db4bfd6898d94","path":"design/requirements/scenarios/SCN-035-distinguish-a-reusable-lesson-from-a-local-correction.json"},{"identity":"sha256:5a8c0fb149340b3f144e8080956543701d72b2b2dd37324f4034b70abed6dd76","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-035-characterize-reusable-engineering-lessons-from-supported-findings/AR-082-preserve-supported-lesson-meaning-and-reuse-limits.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-083 covers the MOD-009 obligation; existing authority, assurance and retention owners supply their distinct contributions. No further AR is required.","state":"not-required"},"ar_children":["AR-083"],"criteria":[{"explanation":"Explicit available lesson scope and exact inspected content bind candidate selection; context/mechanism comparison and authoritative decision/version establish the supported disposition.","number":1,"state":"covered"},{"explanation":"Material exclusions and context differences produce inapplicable or limited results, not unconditional instructions; adopted policy remains linked to its authoritative owner.","number":2,"state":"covered"},{"explanation":"Insufficient work context, inaccessible sources and no match within completely inspected scope are distinct. Partial acquisition cannot justify an unqualified no-match result.","number":3,"state":"covered"},{"explanation":"Proposal, rejection, revision need and unknown disposition remain separate from adopted current rules. Consultation is read-only and supplies neither policy nor mutation authority.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-036\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Present applicable lessons when preparing engineering work\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall allow participants preparing engineering work to identify retained lessons relevant to the stated activity and context, with the recorded basis and limits of applicability and the current disposition of any associated improvement.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Retained lessons have little effect when authors cannot relate them to the next activity or distinguish a proposal from adopted practice.\",\n      \"desired_outcome\": \"Participants can understand relevant prior learning and decide how it applies to the work they are preparing.\"\n    },\n    \"why\": {\n      \"rationale\": \"Learning must be accessible at a useful decision point without converting every past recommendation into current policy.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents preparing work\",\n        \"Reviewers\",\n        \"Practice maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When preparing comparable work or reassessing a lesson after a material context change.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected project activity and available retained lessons, with their recorded applicability conditions.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Compare the stated work context with recorded lesson conditions, show the supporting reasoning and exclusions, and distinguish applicable, inapplicable, and unresolved cases. Present the associated improvement disposition from current authoritative change information rather than inferring adoption from the existence of a lesson.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers context-based use of lessons within one governed project, not automatic policy adoption, exhaustive prediction of all failures, or unrestricted search of external knowledge.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For a comparable activity within a lesson's stated conditions, identify the lesson, its supported mechanism, applicability basis, and associated improvement disposition.\",\n    \"When a stated exclusion or material context difference applies, disclose that difference and avoid presenting the lesson as an unconditional instruction.\",\n    \"When context is insufficient, distinguish unresolved applicability from a known lack of relevant lessons; identify unavailable lesson sources separately from no match.\",\n    \"A proposed or rejected improvement remains visibly distinct from an adopted current rule, and consulting a lesson grants no authority to change the model.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-036\",\n      \"basis\": \"Derived from IR-007 and its declared initial authoring scope; the acceptance criteria describe assessment intent, not observed results.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-036\"\n  ]\n}\n","identity":"sha256:de50b9b375e6c6a0e5788b844574b22923e692c48fc8a829408dec013a8a3650","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-036-present-applicable-lessons-when-preparing-engineering-work/sr.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-036","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-036 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:055557862da7bf1cf6d1bdd6979c8495ac7f3239d588d7139532a407ceab58c8","path":"design/system/functions/FUNC-036-select-lessons-applicable-to-planned-engineering-work.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:d5566474984975e7119540894b3ca1b41263fba1bbcf8487b388578923eb6cb2","path":"design/requirements/scenarios/SCN-038-reassess-a-lesson-after-recurrence-or-a-material-context-change.json"},{"identity":"sha256:58690bee501e26908c54bcda63a053e2e0531cb3adf9e38aee2c13a48502c435","path":"design/requirements/scenarios/SCN-039-consult-applicable-lessons-before-comparable-engineering-work.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:a2f18deb20a0b5ccb4412c87546ea8399a56a97f6b051882a9191c6ed3f47c08","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-036-present-applicable-lessons-when-preparing-engineering-work/AR-083-select-lessons-with-explicit-context-and-adoption-basis.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-084 covers the MOD-009 obligation; existing authority, assurance and retention owners supply their distinct contributions. No further AR is required.","state":"not-required"},"ar_children":["AR-084"],"criteria":[{"explanation":"Before adoption the exact proposal names lesson/mechanism, applicability, affected authoritative subjects, destination owner, intended behavior and independent success/adverse-effect criteria.","number":1,"state":"covered"},{"explanation":"Missing support, owner, subject or criterion is an explicit incomplete proposal; a desired success label or candidate answer is not an assessable expectation.","number":2,"state":"covered"},{"explanation":"MOD-012 carries the exact proposal to the authorized decision/artifact owner through existing IF-009/016. Requested revision or rejection preserves original finding/proposal meaning.","number":3,"state":"covered"},{"explanation":"Adopted scope binds lesson/proposal, governing decision, before/result basis and required owner-produced effects. Scheduled route completion and an approved direction do not establish changed artifacts or effectiveness.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-037\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Prepare accountable improvements for controlled adoption\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall support turning a supported lesson into an improvement proposal that identifies the affected guidance, checks, or artifacts, the responsible owner, applicable situations, intended behavior, and observable success and adverse-effect criteria before adoption through controlled change.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A lesson can lead to vague action or an unreviewed rule change with no owner or way to assess its effect.\",\n      \"desired_outcome\": \"Decision owners receive a bounded, attributable proposal that can be reviewed, adopted, revised, or rejected through the existing change controls.\"\n    },\n    \"why\": {\n      \"rationale\": \"A concrete improvement and assessment intent connect retained knowledge to accountable changes in engineering practice.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Lesson authors\",\n        \"Owners of affected guidance, checks, or artifacts\",\n        \"Change decision owners\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"After a lesson is sufficiently supported to propose an improvement and before that improvement is adopted.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Governed changes to project engineering practice.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Derive the proposal from the supported mechanism and applicability, identify its current authoritative subjects and accountable owner, and specify the expected changed behavior and potential adverse effects. Pass the proposal and assessment criteria to controlled change. Keep proposal, adoption, and observed effectiveness distinct.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers preparing an improvement and preserving its association to the governed adoption decision. IR-003 owns change control and authority; this requirement neither grants adoption permission nor prescribes a separate lesson or improvement schema.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Before adoption, an improvement proposal identifies its supporting lesson, failure mechanism, applicable situations, affected subjects, responsible owner, intended behavior, and observable success/adverse-effect criteria.\",\n    \"If a responsible owner, applicable subject, or assessable criterion is missing, identify the gap and do not describe the proposal as ready for adoption.\",\n    \"Record a proposed improvement as proposed until the applicable controlled-change decision establishes adoption; rejection or required revision is visible without rewriting the original finding.\",\n    \"Adoption retains a traceable connection to the lesson and affected baseline while leaving effectiveness unassessed until applicable observations exist.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-037\",\n      \"basis\": \"Derived from IR-007 and its declared initial authoring scope; the acceptance criteria describe assessment intent, not observed results.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-037\"\n  ]\n}\n","identity":"sha256:8f46aba0702296137e78cc1c876ed5fc3e89b59ab6bdce2dbc72312fb183cf8d","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-037-prepare-accountable-improvements-for-controlled-adoption/sr.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-037","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-037 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:4040eff5bf024090b9b5a19df8f123e957f836f4ac23459f9ac7238f8f6d0b2e","path":"design/system/functions/FUNC-037-formulate-an-accountable-engineering-improvement-proposal.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:581e922560085444e807efc6f2949e77f3768a8680edc56fbd6241a031b02d45","path":"design/requirements/scenarios/SCN-036-prepare-a-lesson-based-improvement-for-controlled-adoption.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:aafeb950529a4ca93e43655784dd760a484b6174ed292dd1efc7e0c369cbdd8c","path":"design/architecture/modules/MOD-017-engineering-governance/state-control.md"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:472f88e95a821c7d28a3ae5b38311b7f3a44ebbf40ce1ef74e09d03dacc1c3f6","path":"design/architecture/interfaces/IF-016-controlled-state-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:f0ad6bd5c8ba479eeacf98501e0932dada28061109957c814f9c9e95dc0c90fa","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-037-prepare-accountable-improvements-for-controlled-adoption/AR-084-prepare-owner-bound-improvements-without-implying-adoption.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-085 covers the MOD-009 obligation; existing authority, assurance and retention owners supply their distinct contributions. No further AR is required.","state":"not-required"},"ar_children":["AR-085"],"criteria":[{"explanation":"Triggering reproduction binds the actual adopted version and criteria; nonreproducibility, planned activity and unrelated checks remain distinct from observed correction results.","number":1,"state":"covered"},{"explanation":"Known activity scope/order and accountable comparability reasoning identify the next comparable opportunity; recurrence, intended behavior and new confusion/burden are compared without skipping an earlier comparable failure.","number":2,"state":"covered"},{"explanation":"No comparable work leaves effectiveness unassessed despite adoption/reproduction success; an actual opportunity with missing observations instead reports its evidence gap.","number":3,"state":"covered"},{"explanation":"Actual contrary, mixed and incomplete results remain visible with exact context and criterion basis. Conclusions remain bounded and cannot promise permanent recurrence prevention.","number":4,"state":"covered"},{"explanation":"Recurrence or material mechanism/version/context/criterion change identifies affected reliance and new assessment needs; earlier observations retain original meaning and planned reassessment supplies no result.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-038\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Assess improvement effects at comparable opportunities\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall support assessing an adopted improvement against its triggering situation when reproducible and during the next comparable engineering activity, recording recurrence, intended behavior, adverse effects, and the observation context, with reassessment after recurrence or material context change.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Adoption, a single passing reproduction, or elapsed time can be mistaken for proof that an improvement works in later practice.\",\n      \"desired_outcome\": \"Effectiveness conclusions remain limited to actual comparable observations and are reconsidered when their basis changes.\"\n    },\n    \"why\": {\n      \"rationale\": \"Opportunity-based assessment tests both the intended correction and its effect on real subsequent work without promising permanent prevention.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Improvement owners\",\n        \"Reviewers observing subsequent work\",\n        \"Maintainers assessing engineering practice\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"At a reproducible triggering situation, the next comparable activity after adoption, and subsequent recurrence or material context change.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The adopted improvement and the governed work contexts to which its recorded applicability extends.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the recorded success and adverse-effect criteria to identifiable observations. Distinguish triggering-situation reproduction from later comparable use. Record nonreproducibility, absent comparable opportunities, unsupported comparisons, and mixed results explicitly. Preserve previous context-bounded conclusions when a fresh assessment is required.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Covers the selected opportunity-based observation period: no universal calendar duration, sample count, pass-rate target, or permanent-effectiveness guarantee. Evidence and judgment authority reuse IR-004. Lack of comparable work leaves effectiveness unassessed.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"When the triggering situation is reproducible, record the correction outcome for the adopted version; when it is not, identify that limit without inventing a reproduction result.\",\n    \"At the next comparable activity, record whether the mechanism recurred, the intended behavior occurred, and new confusion or burden appeared, with the activity context and applicable criteria.\",\n    \"If no comparable activity has occurred, report effectiveness unassessed even if the improvement was adopted or its triggering reproduction passed.\",\n    \"Contradictory or incomplete observations remain visible; conclusions identify the observed scope and do not assert that failures can never recur.\",\n    \"After recurrence or material context change, mark the prior conclusion as needing reassessment for the new context, preserving the original observation and bounded conclusion.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-COMPLETE-ANALYSIS\",\n      \"locator\": \"SR-038\",\n      \"basis\": \"Derived from IR-007 and its declared initial authoring scope; the acceptance criteria describe assessment intent, not observed results.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-038\"\n  ]\n}\n","identity":"sha256:7027c6f3b9bdb62edeed73dc99c5c68a4eb4f292ae91aa999b32d647ed81e142","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-038-assess-improvement-effects-at-comparable-opportunities/sr.json"},"limitations":["Design only; no implementation, performed Learn session, adopted improvement, observed effectiveness or installed-skill qualification. Delivery unchanged.","Participant-supplied causal/comparability reasoning and exact scoped sources; no automatic discovery, owner polling, causal judge, universal duration/sample target or permanent improvement guarantee.","Selected Learn confirmation, guarded local custody and narrow route-result effects remain mandatory; unavailable guards prevent mutation. Controlled authority, formal assurance and confirmed retention retain distinct owners."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-038","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-038 criteria; participant-assisted target Design.","state":"covered","subjects":[{"identity":"sha256:0fd6cc8de6c5ba790883e7b0a13e2f558a4311a20b6421a598e557f6ab309df6","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/improvement.md"},{"identity":"sha256:cdef154e3f6bdba1ed488c8b87fe1e037049a54ede6d532877dc7da516c3bb7e","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/learning.md"},{"identity":"sha256:0d8bbaba67a6b39ec2d2805265091eaa1387d18f81d2d1d8e5b81a853824a668","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-009-engineering-learning/module.json"},{"identity":"sha256:41c512e97305f145c0a7f4b14c0bfea8faf5720466000375fdb5f273cc0a5f1c","path":"design/architecture/modules/MOD-017-engineering-governance/module.json"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:5b62b3f07fb5d2be0630f34bf04248ca0537642a754fffd96287dfac5d1c0053","path":"design/architecture/interfaces/IF-017-engineering-lesson-and-improvement-preparation/interface.json"},{"identity":"sha256:0cddbc39afd8e0e53e405042586d32c7d2870815b52b5361ef5a273a41683ded","path":"design/system/functions/FUNC-038-assess-observed-effects-of-an-adopted-engineering-improvement.json"},{"identity":"sha256:a3cf6f2a42f9d7175802d9c8d1bf092d8317d61052e24f0c702ae5ffb2b7b660","path":"design/system/features/FEAT-011-apply-and-assess-engineering-lessons.json"},{"identity":"sha256:0de05bdb28f4476460fdbc047f8a36e01207b24107d26b57c671c88394e0a2f7","path":"design/requirements/scenarios/SCN-037-assess-an-improvement-during-the-next-comparable-activity.json"},{"identity":"sha256:d5566474984975e7119540894b3ca1b41263fba1bbcf8487b388578923eb6cb2","path":"design/requirements/scenarios/SCN-038-reassess-a-lesson-after-recurrence-or-a-material-context-change.json"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:2e2e63a4435c76e75a35b0c6c60de50050f859c736b817c1a361f6a3de42e4c7","path":"design/requirements/IR-007-improve-engineering-practice-from-recorded-lessons/SR-038-assess-improvement-effects-at-comparable-opportunities/AR-085-compare-improvement-effects-at-identified-opportunities.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-011, AR-012 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-011","AR-012"],"criteria":[{"explanation":"MOD-010 owns operation-specific help and pre-access admission; actual executing help/version identify supported tasks, while proposed browser/history extensions are not advertised as current.","number":1,"state":"covered"},{"explanation":"The command contract rejects closed syntax/configuration violations at the declared pre-access boundary and uses safe error codes rather than echoing rejected values or inventing selectors.","number":2,"state":"covered"},{"explanation":"The fixed v2/schema-4 operational, maintenance-v1, installation-schema-2 and diagnostic contracts are separately selected by dispatch; untrusted payload versions cannot choose response families.","number":3,"state":"covered"},{"explanation":"MOD-011 checks association, record contract and PRAGMA schema independently; unsupported/corrupt sources stop, while explicit qualified maintenance preserves selected originals instead of ordinary fallback.","number":4,"state":"covered"},{"explanation":"MOD-010's family result tables bind formats and exits to actual effects, with pure receipt preparation and explicit unknown/output-failure handling; a save remains persistence rather than approval.","number":5,"state":"covered"},{"explanation":"Maintenance selects explicit project/scope and verifies wrong-project sources before activation. Separately proposed IF-003/004 history selection binds project and state without collapsing its profile into ordinary reads.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-040\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Preserve explicit command admission and independent interface contracts\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall admit only explicitly selected supported command operations and inputs under their declared interface contracts, preserve independent version and outcome domains, and reject unsupported or ambiguous input at the required boundary without inventing selectors or operational support.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Callers can accidentally invoke withdrawn commands, mix transport versions with stored versions, or supply ambiguous selectors that would direct unintended work.\",\n      \"desired_outcome\": \"Each invocation has one understood public operation, exact input contract, and accurate response domain before dependent work begins.\"\n    },\n    \"why\": {\n      \"rationale\": \"Predictable admission prevents an automation client from acting on an unintended operation or fabricated contract selection.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"For public command selection, help/version, current operational tasks, maintenance, installation and diagnostics.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Published command surfaces and their separately owned request, result, stored-record, document, configuration, and diagnostic version domains.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply each command family’s closed grammar and required selectors before dependent access. Preserve independent request, response, stored-schema and backup versions; reject retired public interfaces without residue-based fallback.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All current public command families and the exact declared retired set. Generic installation outcomes remain governed by Installation. This does not reintroduce compact, lifecycle, new-change, the withdrawn query shim, the spec configuration kind, or a REM-record CLI. The local operational-history extension adds the criteria attributed to SRC-LOCAL-OPERATIONAL-ANALYSIS; retained product contracts and old allocation evidence do not establish implementation or coverage of that extension.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Recognized commands disclose operation-specific help without repository access when the contract requires it; help/version accurately identify supported commands and the delivered package.\",\n    \"Unknown or duplicate flags, extra positionals, missing or contradictory selectors, unsupported operations, and unknown configuration kinds reject before filesystem or stdin access where the owning command requires that order; rejected raw values are not echoed.\",\n    \"Operational v2 requests and schema-4 results, store-maintenance-v1 requests, installation schema-2 results and diagnostic interfaces retain independent version domains. No untrusted request or stored version selects another response family.\",\n    \"Retired or unknown ordinary record contracts, unsupported database schemas and mismatched projects receive safe rejection without conversion or fallback. Only explicit qualified maintenance may import selected supported source facts while preserving required originals.\",\n    \"Human and structured forms preserve each family’s defined actual outcome and exit meaning; presentation never establishes semantic approval.\",\n    \"Backup, restoration, transfer, migration and history queries require explicit supported project and scope selection. Storage schema versions, backup versions and command-interface versions are not interchangeable; wrong-project inputs reject before mutation.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-02, CLI-SR-10, CLI-SR-17, CLI-SR-18, CLI-SR-27, CLI-SR-28, CLI-SR-30, CLI-SR-31, CLI-SR-32; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-01, RF-SR-06, RF-SR-09, RF-SR-12, RF-SR-14\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-040 AC1; allocated contributors: AR-011\",\n      \"basis\": \"Operation-specific help without prohibited repository access, accurate supported package/command identity\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-040 AC2; allocated contributors: AR-011\",\n      \"basis\": \"Closed grammar, selector validation order, unknown configuration and safe diagnostics\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-040 AC3; allocated contributors: AR-011, AR-012\",\n      \"basis\": \"Independent public/transport dispatch plus separate operational stored contract; IF-003 must not infer stored identity from response version\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-040 AC4; allocated contributors: AR-012, AR-011\",\n      \"basis\": \"Persistence rejects unsupported stores/journals and cross-version material; command boundary preserves exact rejection and withdrawn dispatch\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-040 AC5; allocated contributors: AR-011\",\n      \"basis\": \"Generic and recording-specific presentation and exit domains remain distinct; detailed actual-outcome reporting composes with SR-046\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-040\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"SR-040\",\n      \"basis\": \"Reconcile the complete existing allocation with the selected current v2/v4 contract, preserving independent admission, coherent state, explicit scope and actor judgment. Prior version-specific sources retain their historical meaning.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-040\",\n    \"FUNC-048\"\n  ]\n}\n","identity":"sha256:e304e00066c398fba035c8fee2830adce7ea0efa808610eb8612793a2017f253","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-040-preserve-explicit-command-admission-and-independent-interface-contracts/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-040","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-040 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8cd48470112d1d1948365f950b015e92df117ac302661f26311de28f9b3e2b27","path":"design/system/functions/FUNC-040-admit-explicit-requests-under-declared-command-contracts.json"},{"identity":"sha256:302fb1f00c393413ca968a5be04118d06d452a75f31da200675fbe56bcbf27dd","path":"design/system/functions/FUNC-048-project-bounded-command-results-without-changing-meaning.json"},{"identity":"sha256:69ebec21dd9480253545e958d94c0fc31642df4025816225ac21c326cd50c0c0","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-040-preserve-explicit-command-admission-and-independent-interface-contracts/AR-011-admit-supported-commands-under-independent-public-contracts.json"},{"identity":"sha256:062be55f60c780c095201a39be8120fdfac040f7c106d072801f5ddc63ae9f3d","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-040-preserve-explicit-command-admission-and-independent-interface-contracts/AR-012-enforce-the-operational-stored-contract-without-historical-reinterpretation.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-013, AR-014, AR-015 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-013","AR-014","AR-015"],"criteria":[{"explanation":"One MOD-011 snapshot supplies typed current facts and revisions; MOD-010 projects seven-section context or exact items with selections and omissions, without assessing engineering adequacy.","number":1,"state":"covered"},{"explanation":"Bounded selector groups return complete Review, Verification, Evidence and Decision accounts including support and unavailable retained bytes, avoiding an exhaustive database dump.","number":2,"state":"covered"},{"explanation":"Typed outcome distinctions preserve absent store/item, corruption and missing payload; the associated-store reader cannot silently initialize an empty substitute or infer approval.","number":3,"state":"covered"},{"explanation":"The 1 MiB complete-output bound and candidate/account admission limits prevent silent truncation; oversized aggregate context offers smaller explicit selectors rather than hiding issues.","number":4,"state":"covered"},{"explanation":"Declared subject comparison returns scoped observed identities and explicit gaps; reported and unknown basis retain their different meaning without requiring a standalone hash command.","number":5,"state":"covered"},{"explanation":"Capabilities is a project-scoped factual query for executable tasks/contracts and backend standing; it selects no Change, authority or workflow decision.","number":6,"state":"covered"},{"explanation":"Ordinary inspection does not initialize or import; only SQLite recovery of an already determined transaction is allowed. Replacement and proposed nonmutating history access retain separate rules.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-041\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Return coherent explicitly selected engineering records and subject identities\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall provide read-only project capability inspection and explicit actor-selected current record queries with coherent identity, bounded complete meaning and observable absence or failure, without deriving workflow authority or choosing a recovery action.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Broad or inferred reads can conceal missing selected information, combine different states, or be mistaken for authoritative progression advice.\",\n      \"desired_outcome\": \"Callers obtain the requested recorded content or subject identity with enough state and scope information to decide their next action explicitly.\"\n    },\n    \"why\": {\n      \"rationale\": \"Useful scoped information reduces accidental dependence on unrelated records, stale pages, or an inferred next stage.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"A caller inspects executable capabilities, resumes an explicitly selected Change, reads a selected Review or Verification, or supplies compared reads for a task.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Public CLI operations over the associated project store and explicitly selected contained engineering subjects.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Provide explicit scoped current-context and item queries plus project capability inspection through the current CLI, preserving coherent values and truthful limitations.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Current operational query responsibility; no requirement to scan docs/changes, expose SQL, enumerate the database or preserve the predecessor query grammar.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Change context and item reads preserve explicit selected scope, complete current values, contract, revision, limitations and omissions; retrieval is not engineering adequacy.\",\n    \"Selected Review, Verification, Evidence and Decision accounts expose the meaning and support needed for current decisions without requiring the entire database.\",\n    \"Missing store, absent selected item, invalid/corrupt state and missing retained payload remain distinguishable. None becomes inferred approval or an empty substitute database.\",\n    \"A bounded selection returns complete admissible accounts or an explicit size failure; it never silently truncates rationale or unresolved issues.\",\n    \"Compared subject observations identify the explicitly compared scope; reported and unknown basis remain distinct. No standalone subject-hashing command is required.\",\n    \"Project capabilities reports executable contract/task availability and observed backend standing without selecting a Change or workflow authority.\",\n    \"Reads never initialize, import or restore a store implicitly; only storage-internal atomic recovery may establish an already determined ordinary outcome.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Current selected task/query contract; predecessor filesystem discovery and field-projection interfaces are retired in the successor.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-01, CLI-SR-14, CLI-SR-19, CLI-SR-21, CLI-SR-22, CLI-SR-23, CLI-SR-24, CLI-SR-28, CLI-SR-32; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-02, RF-SR-07\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-041 AC1; allocated contributors: AR-013, AR-014\",\n      \"basis\": \"Exact query scope and metadata derived from coherent registered state\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-041 AC2; allocated contributors: AR-013, AR-014\",\n      \"basis\": \"Complete selected narrative/applicability and field projections with explicit omission/absence; storage remains unchanged\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-041 AC3; allocated contributors: AR-014, AR-013\",\n      \"basis\": \"Provider preserves exact availability; consumer preserves those distinctions in each specific command outcome\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-041 AC4; allocated contributors: AR-013, AR-014\",\n      \"basis\": \"Query ordering/cursor/whole-item limits and selection binding to coherent state identity\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-041 AC5; allocated contributors: AR-015\",\n      \"basis\": \"Same-byte subject identity/content, explicit absence and no partial incoherent subject set; public receipt still composes with SR-046\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-041 AC6; allocated contributors: AR-013, AR-014\",\n      \"basis\": \"Exact candidate classification and visible interrupted/malformed state without automatic selection or cross-change atomicity claim\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-041\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"MOD-010 current task/query contract; MOD-011 typed read boundary\",\n      \"basis\": \"Refines the existing inspection need to the selected successor task interface; no new IR or implementation approval.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-041\",\n    \"FUNC-042\",\n    \"FUNC-043\"\n  ]\n}\n","identity":"sha256:3c2601dee21b1a7fe6e82bbfd1ed47a62d688a4113fc4592d21f993b7b62fe20","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-041-return-coherent-explicitly-selected-engineering-records-and-subject-identities/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-041","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical SR-041 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:aeebb69c87ad3b4a58af3ea78b5440819747af148aa693fb7380ab38b64c4b02","path":"design/system/functions/FUNC-041-inspect-project-capabilities-and-selected-current-context.json"},{"identity":"sha256:e68e25ece2077c38e01cd2a3f707d754b3787bc5acd067b400def1426bdd5d96","path":"design/system/functions/FUNC-042-read-explicitly-selected-engineering-records.json"},{"identity":"sha256:434f43bf113bed30acca0f4a0d1b2d5134b3d2a2c4ff36858b1b93ac27145901","path":"design/system/functions/FUNC-043-compare-declared-engineering-subjects.json"},{"identity":"sha256:39cac611055b8763e6db96c8ea08583328f52e1d540e9b4b718d0f1b330a3683","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-041-return-coherent-explicitly-selected-engineering-records-and-subject-identities/AR-013-return-exactly-selected-records-and-factual-discovery-context.json"},{"identity":"sha256:93be579848c63a430c50793e27cb3da84a757398f43d41945c40a6a50a022676","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-041-return-coherent-explicitly-selected-engineering-records-and-subject-identities/AR-014-supply-coherent-registered-snapshots-with-explicit-availability.json"},{"identity":"sha256:302f427261aabad0c2b47017f3c5a71fa3e4aedae6c73a970dac8038c72fd041","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-041-return-coherent-explicitly-selected-engineering-records-and-subject-identities/AR-015-compare-explicitly-declared-engineering-subjects-safely.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-016, AR-017 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-016","AR-017"],"criteria":[{"explanation":"Closed task and v4 record schemas plus complete candidate validation reject unknown values, malformed encoding, duplicate identities and incompatible representations before authoritative mutation.","number":1,"state":"covered"},{"explanation":"The typed registry, same-Change foreign references and field-kind validation establish one admissible target in the complete candidate; filesystem adjacency and cross-Change fallback supply no authority.","number":2,"state":"covered"},{"explanation":"Candidate construction preserves actor-supplied meaning; current support reconciliation permits adverse evidence/invalidation while independently checking the prerequisites of new acceptance or success.","number":3,"state":"covered"},{"explanation":"Omission preserves current findings; explicit attributed disposition and dependency-free compaction own removal. Qualified v3 import preserves its original semantics rather than applying v4 rules retrospectively.","number":4,"state":"covered"},{"explanation":"Review and Verification have distinct closed shapes and explicit basis/support. Final success requires applicable mandatory support; adverse scoped assessments remain recordable without fabricated positive prerequisites.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-042\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Validate current operational candidates without inventing decisions\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall validate complete current operational candidates against the selected supported contract and preservation rules, resolving typed references while separating structural validity from engineering judgment.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A superficially valid update can contain ambiguous references, mixed formats, rewritten concern history, or inferred approval and applicability.\",\n      \"desired_outcome\": \"Only structurally admissible, explicitly authored record candidates proceed, and correction remains possible when substantive work is incomplete or observations contradict a recorded claim.\"\n    },\n    \"why\": {\n      \"rationale\": \"Preserving both record meaning and the ability to report problems prevents mechanical validation from fabricating authority or blocking necessary correction.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When previewing or publishing an ordinary task candidate, or validating a staged maintenance candidate.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The complete candidate for one selected project Change and its supporting records, with prior state for preservation checks.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Validate closed types before dependent reference and preservation rules. Preserve undispositioned issues and assessor attribution; typed support checks expose reliance gaps without authenticating judgments.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Supported operational record shapes, identities, applicability, reference namespaces and preservation rules. Storage registration is tool-owned; a physical path or schema version alone grants no authority. Retired history remains archival unless explicitly supported for migration under SR-077; REM engineering entity conformance is a separate responsibility.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Unknown fields or vocabularies, duplicate keys or identities, missing required values, unsupported encodings/versions, mixed stores, dual report representations, and malformed current records reject before authoritative writes.\",\n    \"Every supporting record has an unambiguous identity, owning Change and kind, with explicit applicability wherever the selected contract requires a reliance decision. References resolve exactly one admissible object in the complete candidate; storage-layout adjacency grants no authority and cross-Change fallback cannot repair an unresolved reference.\",\n    \"Supplied scope, subjects, narrative, provenance and decisions are preserved. Adverse evidence and explicit invalidation remain recordable; new success claims must meet the selected contract’s current support requirements.\",\n    \"Omitted issues remain unchanged, and open findings/blockers require explicit attributable disposition. The selected v4 contract permits later compaction and current-assessment replacement without permanent history; v3 retains its finding and immutable-origin rules. Validation must not infer resolution or reviewer judgment.\",\n    \"Reviews and Verifications use distinct closed assessment shapes with explicit scope, governing basis, support and limitations. Final successful Verify requires applicable mandatory review and accepted bases; scoped adverse results can be recorded without inventing missing success prerequisites.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Current allocations describe v4 SQLite; historical contribution arguments retain their original criterion subjects and do not prove current satisfaction.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-02, CLI-SR-07, CLI-SR-26, CLI-SR-27; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-01, RF-SR-02, RF-SR-03, RF-SR-04, RF-SR-05, RF-SR-08, RF-SR-09, RF-SR-10, RF-SR-11, RF-SR-13\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-042 AC1; allocated contributors: AR-016\",\n      \"basis\": \"Closed shape/type/version/encoding and required-value rejection before authoritative writes\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-042 AC2; allocated contributors: AR-016\",\n      \"basis\": \"Complete manifest registration/applicability and exact field-compatible references\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-042 AC3; allocated contributors: AR-017\",\n      \"basis\": \"Supplied meanings retained; substantive inadequacy alone does not block correction or imply approval\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-042 AC4; allocated contributors: AR-017\",\n      \"basis\": \"Existing finding IDs, complete findings on assessment edits, immutable blocker-origin basis\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-042 AC5; allocated contributors: AR-016, AR-017\",\n      \"basis\": \"Closed explanation/conditional-basis shape plus separate reliance meaning; absent basis remains valid\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-042\",\n      \"basis\": \"Refines the proposed operational representation and safety boundary. Prior allocation contribution arguments retain their original v3 criterion subjects under the historical source marker.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-CONTRACTS\",\n      \"locator\": \"SR-042; immutable assessment correction and explicit commit boundary\",\n      \"basis\": \"Refine the existing IR-008 obligation for v4 without rewriting historical v3 meaning: preserve original assessments, actor decisions and truthful commitment rather than requiring in-place explanation mutation or rollback after commit. Author-assessed under the scoped Constitution exception; not runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-042\",\n      \"basis\": \"Reconcile current-state replacement, unresolved issue preservation and selective retention; retain version-specific v3 behavior until adoption.\"\n    },\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"SR-042\",\n      \"basis\": \"Reconcile the complete existing allocation with the selected current v2/v4 contract, preserving independent admission, coherent state, explicit scope and actor judgment. Prior version-specific sources retain their historical meaning.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-044\"\n  ]\n}\n","identity":"sha256:47d951f11efe0fe318382c04f401eec0d044537042aef6991c4172849fd817b6","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-042-validate-current-operational-candidates-without-inventing-decisions/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-042","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-042 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:08ebb8b4277641cf25e8a4513093c053cc6ddc5740fdb9c6fb53660f8f27ede8","path":"design/system/functions/FUNC-044-validate-registered-recording-candidates-and-preservation-rules.json"},{"identity":"sha256:30a475c3fb3efa93871de6f8332fe83a30b595a0af9bb81bf305676922f53c26","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-042-validate-current-operational-candidates-without-inventing-decisions/AR-016-validate-complete-candidates-against-the-closed-registered-record-contract.json"},{"identity":"sha256:1ea3f2c4b43573ba1f6ab13278c3eba0f060fe541869331503e8947534ae8366","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-042-validate-current-operational-candidates-without-inventing-decisions/AR-017-preserve-actor-decisions-and-distinct-concern-identity-rules.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-018, AR-019 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-018","AR-019"],"criteria":[{"explanation":"The bounded task interface asks for semantic decisions, actor and current scope; MOD-011 constructs typed identities, relationships and storage bookkeeping behind IF-003.","number":1,"state":"covered"},{"explanation":"Targeted construction preserves omitted and unrelated facts; comparable replacement is explicit, and immutable selected attachment names protect the meaning of retained support.","number":2,"state":"covered"},{"explanation":"The complete in-transaction candidate resolves related new references before publication and rejects overlapping assignments; no arbitrary public batch or SQL interface is required.","number":3,"state":"covered"},{"explanation":"Current-account replacement preserves open issues and assessment-owned attribution/support; dependency changes expose reassessment needs rather than silently renewing review, Verify or authority.","number":4,"state":"covered"},{"explanation":"Preview uses the same candidate invariants on a coherent read, makes no persistent reservation, and execution independently rechecks the current revision and declared reads.","number":5,"state":"covered"},{"explanation":"Explicit creation requires absent admissible targets; occupied, unreadable or unsupported state cannot become empty creation. Restore has its separate expected-destination and preservation protocol.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-043\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Construct lossless updates from explicit engineering decisions\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall construct complete recording candidates from explicitly targeted actor decisions while preserving omitted semantic content, identities and unrelated records, composing only compatible requested edits, and offering equivalent non-writing preview without requiring callers to build storage scaffolding.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Reconstructing storage representations or inferring defaults can overwrite neighboring decisions or refresh assessment bases without an actor decision.\",\n      \"desired_outcome\": \"Actors can supply a bounded meaningful edit or batch and see exactly its intended candidate effects without hidden semantic changes.\"\n    },\n    \"why\": {\n      \"rationale\": \"Narrow, lossless authoring makes correction practical while retaining the integrity of recorded judgments and unrelated work.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During explicit targeted or complete record updates, batch preparation and non-writing previews.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Named entries and fields in one selected supported change store; candidate construction operates on one coherent before-state.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Construct the complete candidate from explicitly supplied edits, generating only mechanical storage metadata. Preserve omitted records, values, narrative, ordering and identities; require new-record applicability and validate final references. Preserve exact external evidence bytes where their digest is part of retained identity.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Explicit targeted and complete record updates and bounded batch composition. Operational serialization is implementation-owned; preserved semantic narrative and ordered values are not permission to rewrite original evidence artifacts. No arbitrary repository patch, implicit deletion, cross-Change batch or automatic retry merge is introduced.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The actor supplies required semantic inputs; the tool constructs identities and storage bookkeeping without requiring directories, manifests or database fields from callers.\",\n    \"Only explicitly selected values and necessary metadata change. Omitted fields and unrelated records remain unchanged. Explicit replacement of comparable working information is permitted; attachments still supporting retained conclusions cannot silently change meaning.\",\n    \"A task submission constructs one coherent candidate containing its related facts. Same-request references resolve before publication; conflicting assignments reject. This does not require a public arbitrary batch interface.\",\n    \"Current evidence and assessment accounts may be replaced through their owning tasks without permanent predecessor chains. Retain open findings until explicit disposition, the attribution and basis of judgments still relied upon, and compact completed accounts. Progress updates cannot create reviewer judgments or widen authority.\",\n    \"Preview validates the same intended semantic candidate without authoritative writes, persistent reservations or a saved claim. Execution checks freshness again and does not treat preview as authority.\",\n    \"Unavailable known records or occupied destinations cannot be treated as empty creation targets. Explicit restoration remains subject to its own supported operation and normal integrity, authority and conflict checks.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Current allocations and source-observed facets describe v4 SQLite. Source availability does not establish passing execution, project adoption or requirement satisfaction; historical v3 contribution arguments retain their original subjects.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-03, CLI-SR-12, CLI-SR-13, CLI-SR-15, CLI-SR-16, CLI-SR-25, CLI-SR-26; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-02, RF-SR-03, RF-SR-04, RF-SR-08, RF-SR-10, RF-SR-11, RF-SR-13\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-043 AC1; allocated contributors: AR-018, AR-019\",\n      \"basis\": \"Adapter requires actor semantic decisions; persistence constructs only mechanical metadata/registry/scaffolding\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-043 AC2; allocated contributors: AR-019\",\n      \"basis\": \"Only named values/necessary adjacent syntax change; unselected and no-op source bytes preserved; new-file encoding retained\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-043 AC3; allocated contributors: AR-018, AR-019, AR-016\",\n      \"basis\": \"Bounded admitted batch, deterministic complete candidate, overlap rejection and final reference validation\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-043 AC4; allocated contributors: AR-019, AR-017\",\n      \"basis\": \"Full Review versus explicit finding edits; complete Verify replacement versus narrow explanation updates\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-043 AC5; allocated contributors: AR-018, AR-019\",\n      \"basis\": \"Honest nonwriting preview and pure construction; actual-execution freshness and publication require the SR-044 allocated executor obligations\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-043 AC6; allocated contributors: AR-019, AR-016\",\n      \"basis\": \"Missing registered content is unavailable, unregistered existing files cannot be creation targets; explicit advanced restoration still crosses shared validation and SR-044 safety\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-043\",\n      \"basis\": \"Refines the proposed operational representation and safety boundary. Prior allocation contribution arguments retain their original v3 criterion subjects under the historical source marker.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-CONTRACTS\",\n      \"locator\": \"SR-043; immutable assessment correction and explicit commit boundary\",\n      \"basis\": \"Refine the existing IR-008 obligation for v4 without rewriting historical v3 meaning: preserve original assessments, actor decisions and truthful commitment rather than requiring in-place explanation mutation or rollback after commit. Author-assessed under the scoped Constitution exception; not runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-043\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-045\"\n  ]\n}\n","identity":"sha256:9faf4546b6f931bfab3ee2ab3a25a6c54d6e149dd1ca696f60af47479f3dce20","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-043-construct-lossless-updates-from-explicit-engineering-decisions/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-043","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-043 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:727fa9085fec8f699361fc73b5e16db4a695ea168c91ffaffe5b5b56d5ee1b46","path":"design/system/functions/FUNC-045-construct-lossless-candidates-from-explicit-record-edits.json"},{"identity":"sha256:2634ca278cdefc262af88e13a9910dd9168a5d51854a68fbe01b153884c802cb","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-043-construct-lossless-updates-from-explicit-engineering-decisions/AR-018-admit-explicit-recording-intent-and-nonwriting-preview-requests.json"},{"identity":"sha256:d8693af6d082d058dcb41281b3204a79b136ae7823bad0bdbc63c04be42c4e1c","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-043-construct-lossless-updates-from-explicit-engineering-decisions/AR-019-construct-lossless-complete-candidates-from-explicit-targeted-edits.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-020, AR-021 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-020","AR-021"],"criteria":[{"explanation":"The closed typed task carries current opaque revision, selected identities and original declared expectations; mismatches conflict without automatic refresh or semantic merge.","number":1,"state":"covered"},{"explanation":"BEGIN IMMEDIATE serializes supported writers; coherent SQLite read snapshots and verified WAL/FULL transaction settings define durable complete publication or explicit busy/unavailable standing.","number":2,"state":"covered"},{"explanation":"Project association, same-Change references and contained no-clobber payload paths protect unrelated work; unsupported paths and unexpected destinations reject before publication.","number":3,"state":"covered"},{"explanation":"Candidate equivalence is considered only after fresh preconditions; unchanged does not advance revision, while a retry using an old revision conflicts even if a prior save succeeded.","number":4,"state":"covered"},{"explanation":"Corrected MOD-011 execution compares declared external basis before commit and again before reporting. Late drift or unestablished comparison keeps saved/committed=true plus a bounded observation and explicit reassessment, never rollback or automatic judgment.","number":5,"state":"covered"},{"explanation":"The transaction publishes the whole validated candidate only after required payloads are safely captured. Interruption exposes an established SQLite outcome or uncertainty; external engineering-file edits remain outside database atomicity.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-044\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Publish record updates with fresh basis and coherent durable outcomes\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall publish structurally valid explicit record updates as one coherent durable transaction after checking expected revision, target identities, and declared decision-basis identities under writer exclusion, with contained writes, safe stale retries, and no usable mixed state.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Competing writers, stale decisions, or partial publication can lose work or leave a reader with a combination of states that never existed coherently.\",\n      \"desired_outcome\": \"Readers observe one coherent recorded state; contention, drift and interruption do not overwrite winning work or conceal missing evidence.\"\n    },\n    \"why\": {\n      \"rationale\": \"Reliable mechanical publication is necessary even when the stored engineering judgment is incomplete, adverse, or awaiting review.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During initial creation, targeted or advanced record publication, batch publication, repeated submissions, and concurrent supported reads/writes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"One explicitly selected Change, its referenced artifacts and declared engineering decision basis, under the supported local writer boundary.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Check expected state and declared decision basis, validate the complete candidate and coordinate supported writers before coherent durable publication. Preserve existing successful work and expose interruption without inventing decisions; external engineering-file edits remain subject to observed checks rather than a universal atomicity claim.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Preserves the published local save-safety boundary. CLI writers coordinate; outside edits are protected at observed identity checks only. An exact-target outside edit after the final check can be overwritten; no atomic exclusion of all external writers, platform expansion, or disaster-recovery service is promised.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Every write names its expected revision, target set and identities, and declared decision-basis identities. Observed mismatches produce conflict requiring reread and a new actor decision, with no silent refresh or merge.\",\n    \"Competing supported writers cannot overwrite one another. Supported readers obtain coherent before/after state or an explicit unavailable/busy/recovery outcome, never a usable mixed state; saved means all selected record effects are durably committed.\",\n    \"Every supported path preserves selected project and Change boundaries and unrelated content. Cross-project or cross-Change mutation, unsafe file destinations where applicable, and unexpected overwrite reject before publication; the physical containment mechanism is an architecture responsibility.\",\n    \"A fresh identical candidate returns unchanged only after current preconditions pass. A lost-response retry with the old revision conflicts even if the earlier save succeeded; no retry duplicates entries, increments semantic state, or creates new approval.\",\n    \"Observed decision-basis drift is checked before publication and again before commitment is reported. Before commit it prevents publication or requires supported uncommitted recovery. If detected after commit, report the actual committed outcome and drift for renewed applicability assessment; never roll back acknowledged commitment or conceal the external-edit timing limitation.\",\n    \"A batch publishes its complete validated candidate coherently. Interruption exposes either an established before/committed state or an explicit recovery condition; a record claiming available evidence cannot commit with an incomplete required payload. Record publication does not atomically govern arbitrary engineering-file edits.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Current allocations and source-observed facets describe v4 SQLite. Source availability does not establish passing execution, project adoption or requirement satisfaction; historical v3 contribution arguments retain their original subjects.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-03, CLI-SR-04, CLI-SR-05, CLI-SR-08, CLI-SR-09, CLI-SR-12, CLI-SR-15, CLI-SR-16; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-08\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-044 AC1: explicit revision, targets, identities and declared basis; conflict rather than refresh/merge; allocated contributors: AR-020 AC1, 6\",\n      \"basis\": \"SCN-043, SCN-044, SCN-046; FUNC-046 compares caller-supplied expectations IF-003 `publish_record_candidate` consumes exact candidate/basis; actor selection and subject acquisition remain with SR-040/041 allocations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-044 AC2: competing writers, coherent reads, saved means durable exact bytes; allocated contributors: AR-020 AC2; AR-021 AC2, 3\",\n      \"basis\": \"SCN-046; FUNC-046 owns exclusion and actual publication IF-003 publication and inspection must expose coherent before/after or busy/recovery-required, never mixed usable state.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-044 AC3: every path shares containment and rejects unsafe writes; allocated contributors: AR-020 AC2, 3; shared AR-022 AC2 for the recovery path\",\n      \"basis\": \"SCN-044, SCN-046, SCN-047; FUNC-046/047 IF-003 publication/recovery share the same selected-change safety boundary. AR-022 retains SR-045 as its sole parent; its reuse here does not duplicate that obligation. Observed external-edit timing limits remain.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-044 AC4: fresh no-op versus stale lost-response retry; no semantic increments; allocated contributors: AR-020 AC5\",\n      \"basis\": \"SCN-044, SCN-046; FUNC-046 IF-003 returns unchanged only after current expectations pass; IF-004 reporting preserves conflict instead of retrying or inventing authority.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-044 AC5: basis checks before publication and before commitment; restoration or recovery after observed drift; allocated contributors: AR-020 AC6; AR-021 AC4, 6\",\n      \"basis\": \"SCN-043, SCN-046; FUNC-046 IF-003 checks declared basis at both source-defined boundaries. No atomic protection from all external edits is promised.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-044 AC6: complete batch candidate, recovery information first, no usable incomplete publication; allocated contributors: AR-020 AC4; AR-021 AC1, 2, 5\",\n      \"basis\": \"SCN-046, SCN-047; FUNC-046 IF-003 prepare/publication composition uses one complete candidate and prepared exact before/candidate state; recovery itself follows AR-022.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-044\",\n      \"basis\": \"Refines the proposed operational representation and safety boundary. Prior allocation contribution arguments retain their original v3 criterion subjects under the historical source marker.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-CONTRACTS\",\n      \"locator\": \"SR-044; immutable assessment correction and explicit commit boundary\",\n      \"basis\": \"Refine the existing IR-008 obligation for v4 without rewriting historical v3 meaning: preserve original assessments, actor decisions and truthful commitment rather than requiring in-place explanation mutation or rollback after commit. Author-assessed under the scoped Constitution exception; not runtime adoption.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-046\"\n  ]\n}\n","identity":"sha256:9b9091d0f23302efc6f9b390dfcf37b0a0147d81654b1414be5b959ac9576719","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-044-publish-record-updates-with-fresh-basis-and-coherent-durable-outcomes/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-044","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-044 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:baddee11461c8f1fed6430cc5e0709c002aa3b406905220d7118f4996e06165c","path":"design/system/functions/FUNC-046-publish-fresh-record-candidates-as-coherent-transactions.json"},{"identity":"sha256:398973e3ee18f6d2e454dd5a9c1f967afd5132226041076a11121d0ab23cddb0","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-044-publish-record-updates-with-fresh-basis-and-coherent-durable-outcomes/AR-020-admit-record-publication-only-against-a-fresh-contained-basis.json"},{"identity":"sha256:d7ebbb30ecd1380277e398fff9081c4c506fb6715657acff2e03688e04437c64","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-044-publish-record-updates-with-fresh-basis-and-coherent-durable-outcomes/AR-021-publish-exact-record-candidates-as-coherent-durable-transactions.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:d679737e5385227ecd2100b394060797eeb399de2c2821791d96bf30c9488a04","path":"design/architecture/modules/MOD-018-engineering-operations/test-design.md"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-022, AR-023 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-022","AR-023"],"criteria":[{"explanation":"Associated-store admission rejects corruption, unsupported schemas and unrecognized recovery state; neither ordinary inspection nor maintenance guesses replacements for foreign/newer bytes.","number":1,"state":"covered"},{"explanation":"SQLite ordinary recovery establishes an already determined outcome. Explicit maintenance finish/rollback instead binds exact staged candidate or verified prior units and fresh recovery observations.","number":2,"state":"covered"},{"explanation":"Confirmed commitment cannot be reversed because output was lost. Precommit rollback preserves other committed work; staged payloads are nonauthoritative leftovers subject only to guarded cleanup.","number":3,"state":"covered"},{"explanation":"Fresh repeated inspection has no semantic replay; fenced maintenance recovery reconciles exact path identities after interruption and withholds terminal success when state is ambiguous.","number":4,"state":"covered"},{"explanation":"The command exposes ordinary context reads rather than a record-replay command. Only explicitly selected supported maintenance may choose finish or rollback; reads never choose adoption, import or replacement.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-045\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Recover interrupted record transactions without guessing or replaying decisions\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall establish the verified outcome of an interrupted supported record transaction without guessing or replaying actor decisions, preserving committed and unrelated work and requiring explicit actor selection when recovery involves a choice of engineering effect.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"An interruption can leave incomplete publication; guessed repair or replay against newer state can create decisions never supplied by the actor or overwrite unrelated work.\",\n      \"desired_outcome\": \"An operator obtains an exact attributable terminal state or a safe recovery stop while retaining enough valid information for subsequent recovery.\"\n    },\n    \"why\": {\n      \"rationale\": \"Recoverability must protect both recorded engineering meaning and acknowledged successful work.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When supported transaction interruption is detected or an actor requests recovery of unresolved publication.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected interrupted transaction and its verified supported recovery basis; operational backup restoration remains SR-075.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Allow storage-engine recovery to establish an already determined committed or uncommitted transaction outcome without choosing new engineering effects. If exact completion versus restoration is an exposed supported choice, require explicit selection and verify the corresponding prepared/before state. Stop on untrusted or unknown recovery information and never replay semantic edits against newer work.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Interrupted supported operational transactions only, distinct from Baseline recovery and backup restoration. Deterministic storage recovery is not authority to select a new decision, infer workflow progression, convert old formats or overwrite foreign content. MOD-011 owns ordinary engine recovery; explicit whole-store replacement follows the separate maintenance contract.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Unavailable, corrupted, unsupported or unrecognized recovery information causes an explicit safe stop; foreign or newer work is not overwritten through guessed repair.\",\n    \"Where explicit completion or restoration is supported, completion reproduces the exact prepared candidate with applicable fresh basis checks and restoration reproduces the verified before-state; neither replays actor operations or edits external basis subjects.\",\n    \"Committed success cannot be rolled back as interruption repair. Recovery of uncommitted creation preserves all preexisting and externally added content.\",\n    \"Interruption during recovery remains attributable and repeatable without duplicate semantic effects; an unverified terminal state is never reported as complete.\",\n    \"Automatic storage recovery may only establish the transaction outcome already determined by the supported storage contract. Ordinary reads never choose completion versus restoration, import history or apply a new actor decision. An unresolved choice requires explicit recovery selection.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [\n    \"Current allocations and source-observed facets describe v4 SQLite. Source availability does not establish passing execution, project adoption or requirement satisfaction; historical v3 contribution arguments retain their original subjects.\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-05, CLI-SR-06, CLI-SR-09, CLI-SR-10, CLI-SR-26, CLI-SR-27, CLI-SR-28; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-04, RF-SR-06, RF-SR-08, RF-SR-12, RF-SR-14\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-045 AC1: missing/tampered/unsupported recovery and third state stop; allocated contributors: AR-022 AC1, 2, 6; AR-023 AC1, 3, 4\",\n      \"basis\": \"SCN-047; FUNC-047 verifies storage, FUNC-040/048 admit and report IF-004 supplies explicit selectors/action; IF-003 validates current journal/snapshots and reports established stop context. No guessed repair or legacy handler.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-045 AC2: exact complete with fresh reads or verified restore; no invented decisions; allocated contributors: AR-022 AC3; AR-023 AC3\",\n      \"basis\": \"SCN-047; FUNC-047 IF-003 recovery consumes exact prepared candidate/before snapshots, never replays targeted operations or changes external basis files.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-045 AC3: acknowledged commit cannot roll back; creation restore preserves other content; allocated contributors: AR-022 AC4; AR-023 AC4\",\n      \"basis\": \"SCN-047 alternatives; FUNC-047 IF-003 checks journal committed state even if the caller lost the success response, and transaction-created membership; IF-004 cannot label an unsupported rollback successful.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-045 AC4: interruption/retry with refreshed identity; terminal private cleanup is not evidence; allocated contributors: AR-022 AC5, 6; AR-023 AC5\",\n      \"basis\": \"SCN-047 failure/retry boundary; FUNC-047/048 IF-003 returns actual recovery identity where available; IF-004 requires later explicit selection, with no automatic retry.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION-BEFORE-LOCAL-STORE\",\n      \"locator\": \"SR-045 AC5: no implicit recovery in reads/check/preview/discovery/log lookup; retired history remains untouched; allocated contributors: AR-023 AC2, 3, 5; AR-022 AC1, 6\",\n      \"basis\": \"SCN-041, SCN-044 preview, SCN-047, SCN-049; FUNC-040/042/048 dispatch boundary IF-004 admits recovery explicitly; IF-003 inspection/check do not repair. The command Module's dispatch obligation covers all listed ordinary paths, including its discovery/log Functions.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-045\",\n      \"basis\": \"Refines the proposed operational representation and safety boundary. Prior allocation contribution arguments retain their original v3 criterion subjects under the historical source marker.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-047\"\n  ]\n}\n","identity":"sha256:0081301c4178d94946ea6ed316d9bdffeb4bb429934d6d8fcc35df17598abc0d","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-045-recover-interrupted-record-transactions-without-guessing-or-replaying-decisions/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-045","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-045 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:6f6c1c3dca121c812995f64590227d2aab3c7054d7c51394eaad27cd1a317331","path":"design/system/functions/FUNC-047-recover-exact-interrupted-record-transactions.json"},{"identity":"sha256:fe01a896ef0ad18a8e6c0cda9325115f2c54a7ba1ee8d4060bee9266b717d6e0","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-045-recover-interrupted-record-transactions-without-guessing-or-replaying-decisions/AR-022-recover-only-exact-verified-operational-record-transactions.json"},{"identity":"sha256:4b57b7d2bbcbddaadfe2bc47a200ee8834688979b869bb27fa0922e555599b00","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-045-recover-interrupted-record-transactions-without-guessing-or-replaying-decisions/AR-023-require-explicit-recovery-selection-and-preserve-its-actual-outcome.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:d679737e5385227ecd2100b394060797eeb399de2c2821791d96bf30c9488a04","path":"design/architecture/modules/MOD-018-engineering-operations/test-design.md"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-024, AR-025, AR-026 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-024","AR-025","AR-026"],"criteria":[{"explanation":"MOD-010's family outcome tables retain actual saved/unchanged/preview/conflict/busy/recovery meanings, available identities and exits; errors and observations are separate and privacy bounded.","number":1,"state":"covered"},{"explanation":"The shared projection preserves decoded narrative, ordered arrays, optional absence and selected fields in human/JSON forms; complete encoding precedes output and budget failure cannot emit a truncated account.","number":2,"state":"covered"},{"explanation":"The pure codec prepares the exact fixed-profile mandatory receipt before commit, reserving bounded late-basis observations and omitting optional expansion explicitly; diagnostic volume cannot undo a valid save.","number":3,"state":"covered"},{"explanation":"Context supplies a complete bounded selector index and explicit omissions; compared scopes/gaps remain visible without introducing a cursor into ordinary current reads.","number":4,"state":"covered"},{"explanation":"Review/Verification projections derive from stored assessor content and support state; retrieval never supplies invented rationale or substitutes for engineering adequacy.","number":5,"state":"covered"},{"explanation":"Independent operational, maintenance, installation and diagnostic projections preserve their actual effects and safe continuation; unknown commitment/output loss requires inspection rather than retry inference.","number":6,"state":"covered"},{"explanation":"Maintenance receipts identify project, selected scope, captured/restored identity, exclusions and completeness; preserved historical judgments require separate current applicability assessment.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-046\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Return bounded faithful command outcomes and selected explanations\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall return operation-specific bounded outcomes whose human and machine forms preserve the same recorded meaning, selected scope, and failure distinctions, with safe diagnostics and a fitting publication receipt independent of diagnostic volume.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Large diagnostics, unreadable narrative encoding, or misleading success and completeness labels can hide a saved correction or cause callers to infer approval.\",\n      \"desired_outcome\": \"Callers can understand the exact command result and selected explanations without sensitive error echoes, partial output, or semantic dependence on log lookup.\"\n    },\n    \"why\": {\n      \"rationale\": \"An automation result must support safe continuation while preserving the actor-authored evidence and reasoning needed for engineering judgment.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"For selected query, preview, mutation, maintenance, installation and diagnostic outcomes.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Each published result/projection domain, its selected records, bounded receipt, and separately requested observations.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Preserve actual outcome and complete selected meaning in the family-specific bounded result. Establish a fitting receipt before commitment; never convert a committed effect into rejection because output failed.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Current family-specific outcome/exit meanings and bounded result schemas remain authoritative in CLI. Mechanical detail is opt-in; logs are not a prerequisite for understanding the semantic result. This adds no alternative authoritative assessment or cached report. The local operational-history extension adds the criteria attributed to SRC-LOCAL-OPERATIONAL-ANALYSIS; retained product contracts and old allocation evidence do not establish implementation or coverage of that extension.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Saved, unchanged, preview, rejected, conflict, busy, and recovery-needed outcomes retain their exact operation/version/exit meanings and available identities. A recording receipt claims persistence only; errors and observations remain distinct and never echo arbitrary payloads or secrets.\",\n    \"Text and JSON preserve equivalent selected fields, state, omissions, optional absence, and decoded narrative, including paragraphs, code, Unicode, literal backslash sequences, and ordered arrays. Budget failure occurs before output rather than emitting truncated content.\",\n    \"Every admissible mutation has a prepublication mandatory receipt that fits independently of diagnostic volume. Excess optional details are explicitly omitted; increasing diagnostics cannot reject a sound correction or turn completed publication into rejected output.\",\n    \"Current context identifies the selected scope, available selectors and explicit omissions. Compared observations remain scope-limited and separate from attributed judgments; no cursor or observation-detail continuation protocol is required.\",\n    \"Selected Review and Verification accounts derive from stored values without inventing rationale, conflating absent support with approval or treating complete retrieval as engineering adequacy.\",\n    \"Each supported public family preserves actual effects, safe-continuation facts and its declared exit meaning across admitted output formats.\",\n    \"Backup, restoration, transfer and migration receipts identify their selected project, captured or restored scope, state identity, exclusions and actual completeness. Storage completion does not establish current evidence applicability or engineering approval.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-07, CLI-SR-11, CLI-SR-14, CLI-SR-17, CLI-SR-20, CLI-SR-21, CLI-SR-22, CLI-SR-24, CLI-SR-26, CLI-SR-27, CLI-SR-29, CLI-SR-30; design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md#RF-SR-03, RF-SR-07, RF-SR-10\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-046 AC1: faithful family outcome/version/exit/identity; storage-only claims and safe diagnostics; allocated contributors: AR-024 AC1, 7; AR-026 AC4, 5\",\n      \"basis\": \"SCN-041, SCN-044 through SCN-049; FUNC-048 with actual FUNC-046/047 facts IF-003 returns actual effects and available identities; IF-004 preserves each owning result contract rather than normalizing them into one envelope.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-046 AC2: equivalent decoded text/JSON with scope and absence; pre-output read budget failure; allocated contributors: AR-024 AC2, 3; AR-025 AC1, 4 for mutation receipt serialization\",\n      \"basis\": \"SCN-042, SCN-048; FUNC-042/048 IF-004 selects actual format and projection; read overflow fails before partial output. Mutation diagnostic overflow uses the separate guaranteed receipt rule.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-046 AC3: fitting receipt before mutation, independent of diagnostics and later output failure; allocated contributors: AR-025 AC1 through 5; AR-026 AC1, 3 through 5\",\n      \"basis\": \"SCN-046 diagnostic-detail alternative; FUNC-048 prepares output and FUNC-046 publishes IF-003 must expose exact candidate facts before publication and honor readiness bound to operation/candidate/format; MOD-010 owns serialization and source output limits. No callback, token, transport schema, or co-owned Function is prescribed.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-046 AC4: honest summary counts/scope; continuation binds revision plus actual observed subject/diagnostic basis; allocated contributors: AR-024 AC5, 6; AR-026 AC1, 2\",\n      \"basis\": \"SCN-046 omitted-detail alternative and SCN-042 selected-scope understanding; FUNC-042/048 IF-003 must expose attributable observation facts including actual complete source-defined subject basis; IF-004 continuation checks the resulting identity before returning detail. These Scenarios expose the stakeholder need but do not individually enumerate every cursor/hash boundary. Source CLI-SR-20 retains exact algorithm/limits; no historical replay or atomic external snapshot claim.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-046 AC5: actual stored Review/Verify explanation, no invented rationale/applicability/adequacy; allocated contributors: AR-024 AC2, 4\",\n      \"basis\": \"SCN-042; FUNC-042/048 IF-003 supplies selected recorded facts and availability; IF-004 derives presentation without becoming a second authority.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-046 AC6: generic projections preserve exits/effects/safe continuation; recording/discovery stay distinct; allocated contributors: AR-024 AC1, 7; AR-025 AC5 where reporting follows mutation\",\n      \"basis\": \"SCN-041, SCN-048; FUNC-048 IF-004 owns independent public result domains. Logs are never necessary to recover omitted semantic continuation facts.\"\n    },\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-046\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    },\n    {\n      \"source\": \"SRC-SQLITE-ADOPTION\",\n      \"locator\": \"SR-046\",\n      \"basis\": \"Reconcile current bounded task receipts with complete selected results and truthful commit outcomes; predecessor cursor/ordinary-journal protocols remain historical.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-048\",\n    \"FUNC-042\"\n  ]\n}\n","identity":"sha256:9edd655f49189ce4a3f5c07c6e2e86777637cbcc101592f300f2882f527302fd","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-046","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical SR-046 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:302fb1f00c393413ca968a5be04118d06d452a75f31da200675fbe56bcbf27dd","path":"design/system/functions/FUNC-048-project-bounded-command-results-without-changing-meaning.json"},{"identity":"sha256:e68e25ece2077c38e01cd2a3f707d754b3787bc5acd067b400def1426bdd5d96","path":"design/system/functions/FUNC-042-read-explicitly-selected-engineering-records.json"},{"identity":"sha256:9bcb6bea2f0d73fc1b0bd8c30afdba0200f2bac04cc14b8e2939a36576e3cb2f","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/AR-024-present-faithful-bounded-command-outcomes-and-selected-explanations.json"},{"identity":"sha256:c3c216543b9e151ca82f6d6140dc3a490e875e00dcc83dc87a4b176e69912776","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/AR-025-prepare-fitting-publication-receipts-before-authoritative-mutation.json"},{"identity":"sha256:eafbcddc06dfd0c094310a3d9416b7bf5f8d796e95290faf73d0612a8c68f7d2","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-046-return-bounded-faithful-command-outcomes-and-selected-explanations/AR-026-bind-publication-to-prepared-receipts-and-report-actual-storage-effects.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"},{"identity":"sha256:d679737e5385227ecd2100b394060797eeb399de2c2821791d96bf30c9488a04","path":"design/architecture/modules/MOD-018-engineering-operations/test-design.md"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-027, AR-028 allocate the complete lower obligations to MOD-010/MOD-011 across IF-004/003; the corrected owning contracts close the integration gaps. No additional AR is needed.","state":"not-required"},"ar_children":["AR-027","AR-028"],"criteria":[{"explanation":"The diagnostic contract defines bounded start/completion events with independent invocation IDs, closed family/severity, sequence and timing; clock failure or interruption cannot alter the semantic result.","number":1,"state":"covered"},{"explanation":"Allowlisted event fields exclude raw inputs, request-derived hashes, secrets and identifying environment/path data; safe bounded replacement handles oversized/control-bearing input rather than raw truncation.","number":2,"state":"covered"},{"explanation":"Verified private roots, restrictive permissions, owned filenames and observed no-follow/identity checks bound log effects; unsafe paths or exhausted locks degrade without permission repair or stealing.","number":3,"state":"covered"},{"explanation":"Logging is an independent observer of stdout, exit and transaction outcome. Explicit closed option/environment precedence rejects invalid vocabulary before dispatch without echoing raw values.","number":4,"state":"covered"},{"explanation":"Exact-ID lookup scans only the bounded retained files, returns supported matching events and safe corruption/unavailability distinctions; it neither logs its own search nor reruns work or manufactures evidence.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-047\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Keep local command diagnostics private and semantically independent\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall retain and inspect bounded private local diagnostics for the declared observed command path without allowing logging configuration or availability to change semantic command behavior, authoritative repository state, stdout results, or exit status.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Logging can leak sensitive inputs, corrupt records under contention, or become an accidental condition for command success or engineering authority.\",\n      \"desired_outcome\": \"An operator can inspect the available diagnostics for one invocation while ordinary commands remain semantically reliable when logging is recorded, disabled, degraded, or interrupted.\"\n    },\n    \"why\": {\n      \"rationale\": \"Diagnostic usefulness must not compromise confidentiality, local safety, or the independence of engineering recording and decisions.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and reviewers operating on recorded engineering work\",\n        \"Engineering agents acting on explicit actor decisions\",\n        \"Maintainers and consumers of the published command-line interface\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"At the declared observed invocation boundary, during bounded event writes or rotation, and when an operator requests a log directory or exact invocation events.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The private platform user-state logging root or explicit configured root, outside governed records and limited to the declared owned log names.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use allowlisted event projections, closed families/severities, bounded whole-event writes, private containment and access rules, finite rotation/lock attempts, and exact-invocation read-only lookup. Apply the current diagnostic contract without wrapping dedicated recording interfaces in a new generic envelope.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Current generic/discovery observed path only; primary recording, advanced record-store, and retired-command dispatch retain their dedicated boundaries. Exact event, rotation, lock, ownership, and privacy limits remain in the retained Local diagnostic logging contract; no daemon, network log service, or authority-bearing audit ledger is introduced.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Observed invocations attempt bounded start/completion events with declared identities, timing, family, severity, and sequence; interruption may leave a start only, and diagnostic clock failures do not change command meaning.\",\n    \"Events exclude raw arguments/requests/bodies, request-derived hashes, secrets, arbitrary environment, remotes, usernames/hosts, and absolute repository paths; unsafe controls and oversized input cannot enter logs through truncation or raw error echoes.\",\n    \"Only declared owned names within a verified private root are created, rotated, or read. Unsafe permissions/paths, observed substitution, exhausted or unverifiable locks, and I/O failure degrade without repairing permissions, stealing locks, or changing repository bytes.\",\n    \"Recorded, disabled, and degraded logging preserve command results, semantic exit, transaction/recovery behavior, and stdout. Invalid closed logging vocabulary rejects at its declared admission boundary without echoing raw values.\",\n    \"Exact invocation lookup scans only bounded retained log files, returns only matching supported events, distinguishes not-found/unavailable/corrupt-entry outcomes, and reports unsupported or corrupt lines without returning raw content, rerunning a command, or manufacturing workflow evidence.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-CLI\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md#CLI-SR-11, CLI-SR-29, CLI-SR-30\",\n      \"basis\": \"Derives this bounded published-product obligation from IR-008 and the named current CLI/Record Format contracts. Detailed schemas, command catalogs, limits and completed-retirement dispositions remain at those owners; this record does not transfer approval or implement REM-record operations.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-047 AC1: bounded start/completion event identity/timing/sequence; interruption/clock handling; allocated contributors: AR-027 AC1, 4\",\n      \"basis\": \"SCN-049 available/degraded diagnostic account; FUNC-049 MOD-010 internal diagnostic responsibility behind IF-004; no separate Module or cross-Module Interface is needed for currently co-owned logging.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-047 AC2: exclude raw/private content; reject injection/oversize safely; allocated contributors: AR-027 AC2; AR-028 AC2, 3, 4 for lookup\",\n      \"basis\": \"SCN-049; FUNC-049 IF-004 log inspection projects safe supported events/warnings, not raw retained lines or invalid selectors. Exact event schema and allowlist stay source-owned.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-047 AC3: owned names/private root; containment/permissions/locks/I/O degrade without unsafe repairs; allocated contributors: AR-027 AC3, 4; AR-028 AC1, 4\",\n      \"basis\": \"SCN-049 degraded/unsafe-path outcomes; FUNC-049 Private local state remains outside MOD-011 governed records. Current source exact permissions/names and bounded attempts remain applicable; no universal atomic pathname defense.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-047 AC4: logging state preserves semantics; closed invalid vocabulary rejects correctly; allocated contributors: AR-027 AC5, 6; AR-028 AC5\",\n      \"basis\": \"SCN-049; FUNC-049 with FUNC-040 admission IF-004 retains owning public result domain and safe admission outcome. Primary and advanced recording retain their dedicated observed-path exclusions.\"\n    },\n    {\n      \"source\": \"SRC-CLI-ALLOCATION\",\n      \"locator\": \"SR-047 AC5: bounded exact lookup, safe missing/unavailable/corrupt distinction, no replay/evidence; allocated contributors: AR-028 AC1 through 5\",\n      \"basis\": \"SCN-049; FUNC-049 IF-004 log inspection remains bounded read-only selection with only supported matching events. Not-found does not prove an invocation never occurred.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-049\"\n  ]\n}\n","identity":"sha256:a73868f4f79d0e8e41fd3594cb8ef1da0748b4acf6d3922447e70cd9ba44917f","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-047-keep-local-command-diagnostics-private-and-semantically-independent/sr.json"},"limitations":["Design coverage only: no runtime qualification, implemented criterion claim, executed recovery, delivery approval, adoption or authority expansion. Source-observed realization is not proof of target behavior.","Ordinary v2/v4 tasks, qualified maintenance and separately proposed SR-078 history have distinct contracts. Historical v3 executables do not supply successor fallback.","Local associated storage and compatible writer/maintenance assumptions apply. External subjects are observed at declared boundaries, not held globally stable; diagnostics and retrieved records do not confer engineering approval."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-047","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-047 criteria, integrated current command/persistence Design with explicit target refinements.","state":"covered","subjects":[{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:7b285e6e49fd80673fbe56702208b9c54614b3303d1927b15b0e09a746b00536","path":"design/system/functions/FUNC-049-retain-and-inspect-private-invocation-diagnostics.json"},{"identity":"sha256:b33285b2729eb856b3434624680722c22d406737be530e1bc7f8834d631539dc","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-047-keep-local-command-diagnostics-private-and-semantically-independent/AR-027-record-bounded-private-diagnostics-without-changing-command-semantics.json"},{"identity":"sha256:17325c318f4d7578b481dd0d85909a320462f2aa2e8f788ff1c709df0e62c651","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-047-keep-local-command-diagnostics-private-and-semantically-independent/AR-028-inspect-exact-retained-invocation-diagnostics-safely.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:5aa93b72e01dc537c34bf65899fe2a496ad2a12cdedb791e2d1b56f5db10b0e5","path":"design/system/features/FEAT-013-record-and-recover-explicit-engineering-decisions.json"},{"identity":"sha256:4d0c853a0c47434f676704e22cb93f1caa7c11fec9472ef6a4f4e92ad9ae6570","path":"design/system/features/FEAT-014-understand-command-usage-and-invocation-outcomes.json"}],"summary":"Design Covered; implementation and verification remain separately assessed."},{"actor":"requirements-design-review","allocation":{"explanation":"MOD-012 directly owns capability selection through FUNC-050 and the complete purpose/trigger/output contract. No separate lower collaborator obligation needs a new AR.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"MOD-012 selection compares the requested outcome with public purpose, triggers and near misses, distinguishing authoring, assessment, execution, options and factual investigation before performing work.","number":1,"state":"covered"},{"explanation":"The twenty-entry source catalog maps each recurring capability to its behavioral contract and bounded Function contribution; a package directory neither creates responsibility nor proves complete runtime realization.","number":2,"state":"covered"},{"explanation":"The capability contract preserves essential selection logic, exclusions and side-effect/handoff limits in descriptions; corrected catalog wording removes obsolete proposal routes and misleading rollout prerequisites.","number":3,"state":"covered"},{"explanation":"FUNC-050 returns the missing distinction or unsupported scope when task fit is unclear; the composition starts no unrelated activity and does not promise deterministic agent routing.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-050\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Expose distinct published engineering capabilities\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-02\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-03\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-24\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-35\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    }\n  ],\n  \"statement\": \"The system shall describe each published engineering capability with its purpose, invocation triggers, relevant exclusions, and behavioral owner so a participant can select work suited to the requested outcome before entering its detailed procedure.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Similar capability names can cause a participant to choose review for authoring, implementation for an unsettled design, or factual research for an unresolved direction.\",\n      \"desired_outcome\": \"The participant can distinguish supported capabilities and their relevant near misses from their public descriptions.\"\n    },\n    \"why\": {\n      \"rationale\": \"Selection must expose actual responsibility and side effects before work begins.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants invoking published engineering capabilities\",\n        \"Project decision owners and reviewers\",\n        \"Published guidance maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When discovering a capability or comparing neighboring capabilities for a requested task.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected capability path in the participant's project context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Present the current public name, purpose, triggers, important exclusions, specialist owner, and local handoff without requiring internal body headings or adapter-only metadata to make selection understandable.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All currently published capabilities. Preserve the selected metadata and description constraints at their existing owner. Descriptions support selection but do not guarantee deterministic agent routing.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A participant can distinguish a request to create an artifact, review it, execute implementation, investigate options, or resolve a factual uncertainty using the applicable capability descriptions.\",\n    \"Each published capability identifies one current behavioral owner and a justified recurring responsibility; a package folder alone is insufficient justification.\",\n    \"A description exposes important near misses and applicable scope without hidden mutation or handoff duties, historical rollout labels as runtime prerequisites, or synonym-only selection text.\",\n    \"Unsupported or ambiguous task fit is reported with the missing decision or relevant owner rather than silently selecting an unrelated capability.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-050\"\n  ]\n}\n","identity":"sha256:fd554559017ae6310fe77a7b15616391658fb8c502856be1a71b45d167aa234d","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-050-expose-distinct-published-engineering-capabilities/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-050","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-050 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:0fe876daf9b266220b1bbb39b2d24c7cf78cc4dab173cb20b620defa368cdbb6","path":"design/system/functions/FUNC-050-identify-a-suitable-published-engineering-capability.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:f8fa34126526a01fb8243692317664d0bd6c08ca94c7172cd8479374e4596bea","path":"design/requirements/scenarios/SCN-050-choose-the-right-capability-for-an-engineering-task.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"MOD-012 owns invocation preparation while existing MOD-006/IF-009 owns current authority. Corrected FUNC-051 distinguishes portable and adopted workflow scope; no new authority or lower service is introduced.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"The corrected FUNC-051 and MOD-012 acceptance case explicitly permit sufficient authorized local work without RigorLoop internals, workflow adoption, records or CLI.","number":1,"state":"covered"},{"explanation":"The prepared invocation binds requested outcome, subject, exact target, applicable project authority and supported output/mode before dependent action.","number":2,"state":"covered"},{"explanation":"Missing or conflicting target, essential inputs and actual governed signals stop only affected work; neither a target nor a portable fallback is invented.","number":3,"state":"covered"},{"explanation":"MOD-012 consumes existing action-bound authority through IF-009 and preserves valid standing grants; package validity, installation and saved status do not authorize execution.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-051\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Prepare project-portable engineering invocations\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-05\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-15\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-16\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-31\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-34\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    }\n  ],\n  \"statement\": \"The system shall establish the requested capability scope, applicable project authority, sufficient project-local inputs, and a safe target before dependent engineering work, supporting authorized portable invocation without requiring unavailable RigorLoop repository internals.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Guidance written for its own repository can impose missing internal paths or infer unsafe targets in another project.\",\n      \"desired_outcome\": \"The requested activity has a bounded, applicable project context and target, or an explicit unresolved prerequisite.\"\n    },\n    \"why\": {\n      \"rationale\": \"Portability must preserve customer governance and existing authorization rather than exchanging them for repository-specific defaults.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants invoking published engineering capabilities\",\n        \"Project decision owners and reviewers\",\n        \"Published guidance maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Before artifact generation, judgment, mutation, or handoff, and when a new material condition changes invocation scope.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected capability path in the participant's project context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Classify the requested outcome and project context, inspect relevant supplied or project-local authority and evidence, choose an already authorized portable target when one is clear, and reuse the common authority decision behavior for reserved actions.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Common invocation preparation across published capabilities. Missing repository-specific internals are not a customer defect. Specialist command, write, privileged, and external-action classifications remain at their existing detailed owners; this draft adds no universal approval prompt or automatic fallback for malformed governed signals.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"In a customer project without RigorLoop internal designs, plans, or change records, an otherwise sufficient authorized portable invocation can proceed using its supported local inputs and target.\",\n    \"The prepared context identifies the requested outcome, subject, applicable project authority, target, and relevant capability mode before dependent action.\",\n    \"If target, authority, or an essential input is ambiguous, conflicting, or unavailable, the system identifies that exact gap and stops dependent action instead of inventing a target or bypassing project rules.\",\n    \"A valid prior grant remains usable within its scope through the existing authority behavior; installation, package validity, and stored status do not supply execution authority.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-051\",\n    \"FUNC-026\"\n  ]\n}\n","identity":"sha256:1f319588cceff19d5d029028cfc591762ac34814ba448fea41734fdb09a33b46","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-051-prepare-project-portable-engineering-invocations/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-051","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-051 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:c8152391e8dc91c31d65e24620ef5380cf62f0c1088be69833e9db0b0923ab16","path":"design/system/functions/FUNC-051-prepare-a-portable-or-governed-capability-invocation.json"},{"identity":"sha256:e2d0fbfe210afa2888bbdd1061ab5a4b3783292b44a7ab374b73beaa3203d869","path":"design/system/functions/FUNC-026-determine-applicable-authority-before-governed-actions.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:ad6614a6bb8310e00be68db5fd44eceba534c809e53d92d5a80348c4f726566d","path":"design/requirements/scenarios/SCN-051-start-portable-work-in-a-customer-project.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"MOD-012 directly owns triggered resource closure, source/profile binding and late-trigger reclassification. Package qualification remains separately owned; no additional lower runtime responsibility is required.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"MOD-012 resolves the triggered Resource map closure, including normative methods, output structure and transitive procedure, before use; missing required content is a scoped stop rather than memory reconstruction.","number":1,"state":"covered"},{"explanation":"Untriggered missing resources do not block unrelated invocation, while MOD-013 separately owns complete package qualification; local success cannot certify all members.","number":2,"state":"covered"},{"explanation":"New scope, source version, authority or recording triggers invalidate affected preparation and require reclassification/loading before dependent work; unsafe or incompatible content blocks reliance.","number":3,"state":"covered"},{"explanation":"The retained COPY/READ/RUN resource contract distinguishes package paths from project inputs and negative examples and requires script inputs, exit/result meaning and failure action.","number":4,"state":"covered"},{"explanation":"Only a disclosed redundant convenience fallback is allowed when the complete needed contract is already loaded; it cannot replace missing normative content or establish package validity.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-052\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Select complete resources for the invoked engineering path\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-07\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-08\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-09\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-11\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-12\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    }\n  ],\n  \"statement\": \"The system shall identify the evidence and mapped resources required by the selected capability path, make their complete applicable procedure available before dependent work, and stop that work on missing or inconsistent required content without making untriggered resources runtime prerequisites.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A selected reading path can omit a transitive rule, resource, or usable output shape even while its entrypoint is present.\",\n      \"desired_outcome\": \"The participant receives the complete resources needed for the current task and an actionable stop when the selected procedure cannot be supported.\"\n    },\n    \"why\": {\n      \"rationale\": \"A compact entrypoint must remain executable and understandable under ordinary and exceptional conditions.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants invoking published engineering capabilities\",\n        \"Project decision owners and reviewers\",\n        \"Published guidance maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When preparing an invocation and whenever a late resource, evidence, or recording trigger appears.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected capability path in the participant's project context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Resolve declared load/use conditions, distinguish supplied project evidence from package resources, verify selected resource availability and consistency, and expose required script inputs, result meaning, and failure action. Preserve the exact COPY/assets, READ/references, and RUN/scripts package mapping contract at its current owner.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The currently invoked path and its transitive required procedure. Package-wide resource completeness and byte parity remain separate conformance obligations, including untriggered resources; a successful portable invocation does not certify a broken package. A fallback is limited to a disclosed redundant convenience resource whose complete needed contract is already loaded.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The selected path supplies every required normative method, output structure, and transitive procedure before it is used; absent mandatory content produces a bounded stop rather than reconstruction from memory or examples.\",\n    \"Untriggered resources are not loaded or treated as invocation prerequisites, while the result does not turn that local success into a package-integrity claim.\",\n    \"A newly triggered resource is selected and read before dependent work, including after invocation reclassification; missing, escaped, contradictory, stale, or mixed-version required content prevents dependent reliance.\",\n    \"Mapped script use identifies accepted inputs, result or exit meaning, and the action on failure. Resource selection distinguishes packaged paths from project-local paths and negative examples.\",\n    \"A convenience fallback is disclosed and preserves the entire needed contract already available in loaded instructions; it never excuses missing required methods or establishes package validity.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-052\"\n  ]\n}\n","identity":"sha256:828670bc5b5cad21702122f5594b697b631f6fbcd4d785f5bae75fb39641ffe9","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-052-select-complete-resources-for-the-invoked-engineering-path/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-052","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-052 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:61b35b781e3b5fbc866a359b9fd4bd1b56e7570de824f410bf71514680fc5641","path":"design/system/functions/FUNC-052-resolve-resources-for-a-selected-capability-path.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:f60f67b331f0e449b8ed8cf380e397b3309f4fcf03b8ff20371396f1ba4ac09e","path":"design/requirements/scenarios/SCN-052-obtain-the-complete-guidance-required-by-a-selected-path.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"MOD-012 composes each retained specialist contract and complete applicable output groups. Existing IF-008/014 and specialist ownership are reused without copying their decisions into an invocation AR.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"The source catalog and owning specialist contracts bind each invoked activity to its inputs, procedure, usable output, failure disposition and local handoff; MOD-012 composes rather than replaces them.","number":1,"state":"covered"},{"explanation":"The capability output rules require complete applicable groups, omission of inapplicable groups and no placeholders; templates are structural aids and cannot become policy or lifecycle authority.","number":2,"state":"covered"},{"explanation":"Implementation, diagnosis, independent assessment and external handoff retain their separate mutation/evidence rules, including the bounded bugfix and privileged CI contracts.","number":3,"state":"covered"},{"explanation":"The corrected catalog distinguishes current source entrypoints from installed support; unsupported outputs or unadopted procedures stop without reviving retired proposal/combined-design operations.","number":4,"state":"covered"},{"explanation":"Results distinguish actual work, blocked or partial scope, observations, judgments and remaining obligations; procedural completion does not become approval or final satisfaction.","number":5,"state":"covered"},{"explanation":"Adopted REM authoring consumes IF-008 and canonical methods under distinct requirement, logical and architecture ownership; justified reuse is a valid output and no duplicate standalone report is imposed.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-053\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Guide specialist engineering work with usable scoped outputs\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-03\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-04\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-12\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-24\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-27\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-29\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-053\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    }\n  ],\n  \"statement\": \"The system shall guide each invoked engineering capability through its current specialist procedure and produce or assess the complete applicable output with explicit scope, evidence, stops, and claim limits, preserving the specialist behavioral owner and project authority.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A common checklist or empty template can hide the actual reasoning, failure handling, and usable result required by a specialist activity.\",\n      \"desired_outcome\": \"The requested activity yields the appropriate usable artifact, scoped correction, assessment, or explanation, or a precise supported stop.\"\n    },\n    \"why\": {\n      \"rationale\": \"Guidance must preserve the differences between engineering disciplines while remaining usable to a person or agent.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants invoking published engineering capabilities\",\n        \"Project decision owners and reviewers\",\n        \"Published guidance maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"While carrying out an authorized specialist activity and preparing its bounded result.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected capability path in the participant's project context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the specialist-owned procedure, required evidence, output shape, failure disposition, and handoff. Reuse model-authoring guidance when the task is within the adopted REM profile and reuse authority and assurance behavior where applicable; do not replace specialist rules with a universal procedure.\"\n    },\n    \"how_much\": {\n      \"scope\": \"All published capability families. This common obligation preserves the detailed currently supported authoring, implementation, assessment, foundations, discovery, learning, and handoff contracts; their individual requirement tables and closed classifications remain at existing owners pending migration. Newly drafted REM entity authoring is not automatic adoption by published commands or skills, and currently retired public output formats remain retired until deliberately changed. The requirement-first workflow extension is draft; existing Function/AR and product-contract coverage must be reassessed before its adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"An invoked activity identifies its specialist owner, sufficient inputs, scoped procedure, required usable output, material failure disposition, and next local handoff.\",\n    \"Artifact output contains all applicable required groups and no unfilled placeholders; a structural aid does not introduce hidden policy, judgments, or mutable lifecycle state.\",\n    \"Implementation, diagnosis, review, and external handoff retain their distinct mutation and evidence boundaries; guidance for one activity does not silently execute another.\",\n    \"An unsupported output format or unresolved adoption boundary is reported explicitly; the REM target model does not itself authorize retired feature, proof, or standalone architecture operations.\",\n    \"Reported results distinguish produced work, partial or blocked scope, observations, judgments, and remaining obligations rather than presenting progress as approved completion.\",\n    \"Under the adopted requirement-first workflow, specialist outputs are the scoped engineering model changes or justified reuse conclusions: Requirement Analysis authors requirements, System Design logical behavior, and Architecture Design accountable realization and ARs. A skill invocation does not require a duplicate standalone report or ownership of another authoring stage.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-053\",\n    \"FUNC-032\",\n    \"FUNC-033\"\n  ]\n}\n","identity":"sha256:a7ad408882173736229e214d52b8c29f945bfd951e164b4613234b3d27f3d7cf","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-053-guide-specialist-engineering-work-with-usable-scoped-outputs/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-053","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-053 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:aa83665c5155a32aa129ebb62e1179f03935efc4cb3b6a06613fe709deb02211","path":"design/system/functions/FUNC-053-guide-a-bounded-specialist-engineering-activity.json"},{"identity":"sha256:7616f27fa93749af2e127663bcfd04fef9579dff8d3ed0c5d00f63f872a245de","path":"design/system/functions/FUNC-032-select-canonical-guidance-for-an-authoring-activity.json"},{"identity":"sha256:92153a9115ae4d3b6e0184a95c89e6b3b6ade3f80793c097b715abbe4286c265","path":"design/system/functions/FUNC-033-explain-engineering-authoring-and-correction-steps.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:37218fceae718a00aa4098f326e0a598aa864d20dad72a2546209d541084514c","path":"design/requirements/scenarios/SCN-053-produce-a-usable-result-through-specialist-guidance.json"},{"identity":"sha256:0c1a5799fddeb358e853a424c93df29daee33388f4dd7aadabe23ec97fffb896","path":"design/requirements/scenarios/SCN-054-receive-a-scoped-independent-engineering-assessment.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"MOD-012 supplies the handoff while existing IF-009/010/011 and Workflow/Assessment retain authority, evidence and progression. Existing workflow ARs remain under their actual SR parents; no additional allocation is necessary here.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"MOD-012's handoff includes actual outputs/subjects, completed and remaining scope, current findings and the receiving activity, using IF-011 context and responsible source owners.","number":1,"state":"covered"},{"explanation":"IF-010 support and IF-011 context preserve missing/stale/conflicting basis; the consumer withholds unsupported readiness and routes the exact correction or decision need.","number":2,"state":"covered"},{"explanation":"Workflow/Assessment and the parent composition distinguish checked implementation, independent review, final Verify and separately authorized external handoff.","number":3,"state":"covered"},{"explanation":"The invocation binds isolated versus broader authorized scope: isolated work reports its handoff, while eligible broader progression reuses existing authority without redundant permission.","number":4,"state":"covered"},{"explanation":"The correction matrix returns faulty obligations, behavior, architecture, plans or implementation to the proper owner; explicit reassessment, not saving or rewording, restores reliance.","number":5,"state":"covered"},{"explanation":"The accepted requirement-first dependency chain is composed through existing authoring and review roles, with integrated Design and reviewed delivery preceding implementation and one whole-change gate before distinct Verify.","number":6,"state":"covered"},{"explanation":"FUNC-054 and the governing workflow map correction by defect meaning; affected independent basis is reconsidered before renewed reliance rather than hidden in a downstream task.","number":7,"state":"covered"},{"explanation":"Checked authorized milestones can continue without review IDs; only complete delivered scope enters the whole-change gate, with corrections and reassessments inside that same gate.","number":8,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-054\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Coordinate engineering handoffs using applicable work and assessment state\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-03\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-04\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-24\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-27\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-29\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-054\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    }\n  ],\n  \"statement\": \"The system shall identify the appropriate next engineering activity and receiving owner from the requested outcome, applicable workflow policy, work state, and assessment basis, preserving prerequisite, independence, correction, and authority boundaries before any dependent continuation.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A completed local action or stored result can be mistaken for permission to enter the next lifecycle activity or for evidence that its prerequisite assessment is current.\",\n      \"desired_outcome\": \"Participants understand the next responsible activity and its actual prerequisites, including whether continuation is authorized or blocked.\"\n    },\n    \"why\": {\n      \"rationale\": \"Guided engineering needs coherent cooperation between specialists while maintaining independent judgments and accountable correction.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants invoking published engineering capabilities\",\n        \"Project decision owners and reviewers\",\n        \"Published guidance maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"At activity completion, review findings, correction, resumption, and requests for authorized continuation.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected capability path in the participant's project context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Interpret the selected workflow and assessment rules against current attributable subjects and evidence, reuse recorded activity context and authority decisions, and prepare a scoped handoff or responsible stop. Isolated capabilities remain isolated unless broader progression is authorized.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Workflow composition across published activities; detailed stage vocabularies, review precedence, exact evidence-identity rules, correction routing, and final-closeout contracts remain at Workflow and Assessment. The Function recommends or prepares the next activity; neither its result nor a favorable judgment independently grants an external action. The requirement-first workflow extension is draft; existing Function/AR and product-contract coverage must be reassessed before its adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A handoff identifies completed and remaining scope, current authoritative outputs and subjects, findings or blockers, the receiving owner, and the next applicable activity.\",\n    \"Missing, stale, inaccessible, or conflicting prerequisite evidence prevents a readiness or continuation claim and identifies the responsible correction or decision owner.\",\n    \"A local implementation result remains distinguishable from independent review, successful verification, and authorized external handoff.\",\n    \"An isolated invocation can report its local handoff without automatically starting it; already authorized broader progression follows the applicable prerequisites and authority rather than seeking redundant permission.\",\n    \"A correction follows its responsible owner and required reassessment; persisting a result or changing explanatory text does not renew approval or stale evidence.\",\n    \"For a requirement-affecting request, route prepares RR intake and Requirement Analysis, then Requirement Review, System/Architecture Design and integrated Design Review, Plan and Delivery Review, authorized implementation, one whole-change Code Review gate and distinct Verify. Optional PR retains separate authority; feasibility and design iteration do not silently bypass these reliance dependencies.\",\n    \"A requirement/scope defect returns to Requirement Analysis; a logical behavior defect to System Design; a Module/Interface/allocation or AR defect to Architecture Design; a sequencing/proof-allocation defect to Plan; and an implementation or fixture defect to Implement. The affected independent review basis is reconsidered before renewed reliance.\",\n    \"Milestone progress is distinct from gate approval. Satisfying authorized implementation dependencies permits the next milestone without a milestone-review handoff; after complete implementation, review attempts and corrections remain within the whole-change gate defined by SR-082.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-054\",\n    \"FUNC-025\",\n    \"FUNC-026\",\n    \"FUNC-029\",\n    \"FUNC-031\"\n  ]\n}\n","identity":"sha256:4cf6aab0d766d9d3981226919a3db62b3a11ff6c08f4170b9a150868067748cd","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-054-coordinate-engineering-handoffs-using-applicable-work-and-assessment-state/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-054","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 8 canonical SR-054 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:72ed79db6e5aabe502b0d82ce6215409a69dfb1610502dcd458250607f97ba1a","path":"design/system/functions/FUNC-054-determine-an-applicable-engineering-handoff.json"},{"identity":"sha256:b5bbfbf03874ea29120c3443bd5efc8160f8cbbf230286fde5316d5fee495ef1","path":"design/system/functions/FUNC-025-retain-and-retrieve-activity-specific-change-context.json"},{"identity":"sha256:e2d0fbfe210afa2888bbdd1061ab5a4b3783292b44a7ab374b73beaa3203d869","path":"design/system/functions/FUNC-026-determine-applicable-authority-before-governed-actions.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:25119c6158e04ad05f02b304fe49080e5ff4b2f77964aeb0b646481bb8c58f8b","path":"design/requirements/scenarios/SCN-055-hand-off-completed-work-without-overstating-readiness.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"MOD-012 detects recording applicability and consumes IF-004; MOD-010/011 retain admission/publication authority. Complete recording and late-trigger cases already allocate this cooperation, so no duplicate recording AR is needed.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"The corrected invocation branch supports a valid portable artifact/advisory result without CLI or Change, explicitly withholding any governed completion claim.","number":1,"state":"covered"},{"explanation":"SCN-056/057 now correctly anchor the complete recording and late-trigger paths; affected work pauses until the applicable full procedure, resources, actual CLI support and authority are available.","number":2,"state":"covered"},{"explanation":"FUNC-055 uses IF-004 with explicit selected scope, current revision/read basis and actor-owned decisions, then inspects the returned actual result.","number":3,"state":"covered"},{"explanation":"Conflict or uncertain commitment returns to current scoped inspection and the command/storage owner's recovery contract; no stale overwrite, semantic replay or invented saved outcome occurs.","number":4,"state":"covered"},{"explanation":"A saved record supplies persistence only; assessment applicability, continuation and external action still require their separate accountable basis.","number":5,"state":"covered"},{"explanation":"Current records preserve distinct progress, advisory findings and formal assessment scope/basis without manufacturing milestone approval or reclassifying earlier judgments as a new gate.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-055\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Separate portable output from governed recording\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-16\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-17\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-25\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-26\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-31\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-34\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-055\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    }\n  ],\n  \"statement\": \"The system shall support the selected capability's authorized portable output without CLI recording, and shall activate the complete supported recording procedure when a governed or durable-recording trigger applies, preserving exact scope, explicit decisions, conflict handling, and truthful recording results.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Always requiring recording prevents legitimate portable use, while silently remaining portable after a governed trigger omits required evidence and scope controls.\",\n      \"desired_outcome\": \"Participants receive a valid portable result or a correctly bounded governed recording result under the selected capability contract.\"\n    },\n    \"why\": {\n      \"rationale\": \"Optional adoption of record tooling must coexist with complete recording duties wherever the project requires them.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants invoking published engineering capabilities\",\n        \"Project decision owners and reviewers\",\n        \"Published guidance maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"At invocation classification, a late governed or durable trigger, and before any required record read or write.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected capability path in the participant's project context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Identify portable versus governed obligations from the actual capability and project context. Load the applicable supported CLI procedure when required, prepare explicit scope and decisions, inspect operation results, and handle conflicts without treating persistence as approval.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The common boundary between published guidance and the currently supported CLI. Current stored-format details, selectors, revision identities, atomicity and recovery remain with CLI/Records; this draft introduces no new command or record version and no fallback from malformed governed context to ungoverned writes. The requirement-first workflow extension is draft; existing Function/AR and product-contract coverage must be reassessed before its adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"An authorized portable invocation can produce its supported artifact or advisory result without a CLI or change record and makes no governed completion claim.\",\n    \"A governed or durable trigger, including one discovered late, activates the complete applicable recording procedure before dependent action; missing authority, resources, or CLI support results in an explicit stop.\",\n    \"Recording requests use current supported commands and selectors with explicit target, scope, applicable read or revision identity, and actor-owned decisions; the agent inspects actual results.\",\n    \"A conflict, interruption, or unexpected response is handled through the current owner's recovery procedure, preserving existing records and historical meaning without an invented success claim.\",\n    \"Successful recording establishes only the observed persistence outcome; it grants neither assessment approval nor permission to continue or publish.\",\n    \"Under the adopted workflow, operational recording preserves separate milestone progress, advisory findings, formal review scope and exact attempt subjects; it does not synthesize milestone approvals or relabel historical proposal or milestone judgments to satisfy a new gate.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-051\",\n    \"FUNC-052\",\n    \"FUNC-055\"\n  ]\n}\n","identity":"sha256:ad10d1c4ab270a32df2c440cc33cabb5106c2412ca392d51a07be01a62b9751f","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-055-separate-portable-output-from-governed-recording/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-055","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-055 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:c8152391e8dc91c31d65e24620ef5380cf62f0c1088be69833e9db0b0923ab16","path":"design/system/functions/FUNC-051-prepare-a-portable-or-governed-capability-invocation.json"},{"identity":"sha256:61b35b781e3b5fbc866a359b9fd4bd1b56e7570de824f410bf71514680fc5641","path":"design/system/functions/FUNC-052-resolve-resources-for-a-selected-capability-path.json"},{"identity":"sha256:b60652833ad97e4ba54d70e04ffbcb50943eec3c64417d4d1de7b21d5b57c93e","path":"design/system/functions/FUNC-055-prepare-and-interpret-governed-recording-operations.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:a6a92ffd6a680ff2850d3b708d816e7df3e0d4dfc674020b35682a538d634575","path":"design/requirements/scenarios/SCN-056-record-a-governed-activity-through-the-supported-procedure.json"},{"identity":"sha256:fc4741477bf090569c26f8f1260e4b4a6e78024a02a229e25f4fc630fc46bee9","path":"design/requirements/scenarios/SCN-057-recognize-a-recording-obligation-discovered-during-portable-work.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"Cross-cutting normative-source, complete-scope, vocabulary and privacy obligations directly constrain MOD-012 invocation and retained specialist contracts. No new distinct lower responsibility is exposed.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"The identified capability, canonical methods and specialist owner remain the normative sources; summaries/reminders and proposed mappings cannot establish competing policy or historical authority.","number":1,"state":"covered"},{"explanation":"MOD-012 explicitly broadens a navigational summary to the complete subject when a dependent judgment needs it, preserving missing detail and failures rather than relying on an output cap.","number":2,"state":"covered"},{"explanation":"Unknown closed values stop before consistency inference, and the selected owner defines spelling/membership; resource/profile fallback cannot silently reinterpret vocabulary.","number":3,"state":"covered"},{"explanation":"The retained privacy contract excludes secrets, private environment and unrelated machine-local content from instructions/examples/results; scoped evidence does not require unsafe disclosure.","number":4,"state":"covered"},{"explanation":"Actual observations, mechanical conformance and actor judgments retain distinct scope and limits; one invocation or a readable artifact cannot establish semantic quality, package validity or approval.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-056\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Preserve guidance meaning and evidence quality across reading paths\",\n  \"status\": \"draft\",\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-01\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-06\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-07\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-14\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-15\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-18\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-SKILLS\",\n      \"locator\": \"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md#SKL-SR-35\",\n      \"basis\": \"Derives the stated common Skills-product obligation while preserving the cited clause population and retained specialist or package-owner detail; this draft is not source retirement or runtime adoption.\"\n    }\n  ],\n  \"statement\": \"The system shall present sufficient authoritative guidance and evidence for each selected activity while preserving rule coverage, specialist meaning, source applicability, privacy, and observable claim limits across concise entrypoints and conditionally loaded resources.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Shortened or duplicated guidance can change a rule, hide required evidence, expose private environment information, or imply stronger assurance than its checks establish.\",\n      \"desired_outcome\": \"Participants can find and apply the complete current rule and required evidence without reconciling competing policy copies or relying on unsafe disclosure.\"\n    },\n    \"why\": {\n      \"rationale\": \"Clarity and concise presentation are useful only when engineering obligations and supported conclusions remain intact.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Participants invoking published engineering capabilities\",\n        \"Project decision owners and reviewers\",\n        \"Published guidance maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When reading instructions, selecting evidence, producing results, or refining a published reading path.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The selected capability path in the participant's project context.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Keep the owning rule and its applicability identifiable, use bounded summaries and excerpts when sufficient, and obtain complete subjects where the decision requires them. Preserve current vocabulary and distinguish examples and structural aids from policy. Explain meaningful evidence gaps and protect private information.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Current invoked guidance and result meaning. Mechanical package conformance, package-wide refinement assessments, and historical pilot adoption remain separately owned obligations; structure, fewer words, static counts, or target invocation success do not establish semantic quality, universal compliance, or customer adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Each applicable rule can be located at its authoritative owner, and an intentional reminder agrees with that owner; historical policies or copied aids do not establish conflicting current authority.\",\n    \"A decision that requires a complete subject receives that subject; summaries, output caps, or conditional loading do not remove required coverage, failure information, or obtainable material details.\",\n    \"Required closed values preserve their current owning spelling and membership; an unknown value is not interpreted as a supported fallback.\",\n    \"Guidance, examples, and results do not require secrets, credentials, raw private environment data, or unrelated machine-local information.\",\n    \"Results distinguish mechanical conformance, observed capability outcomes, and engineering judgment, preserving their actual scope and evidence limits.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-052\",\n    \"FUNC-053\"\n  ]\n}\n","identity":"sha256:638ef3ed7e8a868af9ff1074050b045639478e92a9e0a0b238f0f14c1ae40a4f","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-056-preserve-guidance-meaning-and-evidence-quality-across-reading-paths/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-056","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-056 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:61b35b781e3b5fbc866a359b9fd4bd1b56e7570de824f410bf71514680fc5641","path":"design/system/functions/FUNC-052-resolve-resources-for-a-selected-capability-path.json"},{"identity":"sha256:aa83665c5155a32aa129ebb62e1179f03935efc4cb3b6a06613fe709deb02211","path":"design/system/functions/FUNC-053-guide-a-bounded-specialist-engineering-activity.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:f8fa34126526a01fb8243692317664d0bd6c08ca94c7172cd8479374e4596bea","path":"design/requirements/scenarios/SCN-050-choose-the-right-capability-for-an-engineering-task.json"},{"identity":"sha256:ad6614a6bb8310e00be68db5fd44eceba534c809e53d92d5a80348c4f726566d","path":"design/requirements/scenarios/SCN-051-start-portable-work-in-a-customer-project.json"},{"identity":"sha256:f60f67b331f0e449b8ed8cf380e397b3309f4fcf03b8ff20371396f1ba4ac09e","path":"design/requirements/scenarios/SCN-052-obtain-the-complete-guidance-required-by-a-selected-path.json"},{"identity":"sha256:37218fceae718a00aa4098f326e0a598aa864d20dad72a2546209d541084514c","path":"design/requirements/scenarios/SCN-053-produce-a-usable-result-through-specialist-guidance.json"},{"identity":"sha256:0c1a5799fddeb358e853a424c93df29daee33388f4dd7aadabe23ec97fffb896","path":"design/requirements/scenarios/SCN-054-receive-a-scoped-independent-engineering-assessment.json"},{"identity":"sha256:25119c6158e04ad05f02b304fe49080e5ff4b2f77964aeb0b646481bb8c58f8b","path":"design/requirements/scenarios/SCN-055-hand-off-completed-work-without-overstating-readiness.json"},{"identity":"sha256:a6a92ffd6a680ff2850d3b708d816e7df3e0d4dfc674020b35682a538d634575","path":"design/requirements/scenarios/SCN-056-record-a-governed-activity-through-the-supported-procedure.json"},{"identity":"sha256:fc4741477bf090569c26f8f1260e4b4a6e78024a02a229e25f4fc630fc46bee9","path":"design/requirements/scenarios/SCN-057-recognize-a-recording-obligation-discovered-during-portable-work.json"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-013 retained owner contract already define all concrete lower obligations for SR-060; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"MOD-013 Packaging derives inventory from canonical skills and declared resource projections, walks transitive resources and preserves unchanged relative paths/raw bytes; actual archive inspection checks the emitted candidate rather than a generated registry alone.","number":1,"state":"covered"},{"explanation":"Packaging's target descriptors and transform/exclusion rules reject unsupported fields or dependencies; semantic comparison of generated guidance remains a separate required assessment from byte parity.","number":2,"state":"covered"},{"explanation":"Generated-only adapter support derives manifest version/inventory from canonical inputs in isolated output, validates actual candidate consistency and forbids fallback to a tracked manifest.","number":3,"state":"covered"},{"explanation":"Packaging's selected two-target design removes OpenCode output, command wrappers and exclusive resources while preserving historical artifact identities; coordinated consumer and public-guide reconciliation is explicit.","number":4,"state":"covered"},{"explanation":"MOD-013's browser contract fixes generator/template/profile/engine/D2/license inventory and compatibility declarations, packaged separately from reference-site content. It requires exact-candidate independent customer and offline qualification.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-060\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Produce faithful supported product candidates\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall derive the supported skill archives, CLI package candidate and architecture browser product resources from canonical authored product sources and declared target transformations, preserving complete intended behavior, required resources, and an accurate supported inventory.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A generated package can omit a required resource or silently alter instructions while appearing to represent the authored product.\",\n      \"desired_outcome\": \"Users and reviewers can identify a complete candidate whose target adaptations preserve the selected product behavior.\"\n    },\n    \"why\": {\n      \"rationale\": \"Faithful portable distribution connects authored product meaning to the artifact a user actually obtains.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Product maintainers\",\n        \"Users of supported agent targets\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating a candidate or changing a target transformation or included resource.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Canonical sources, target descriptors, generated inventory, and actual candidate artifacts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply declared inclusion and transformation rules to canonical skills and CLI inputs. Preserve untransformed resource paths and bytes and complete transitive resource coverage. Record exclusions with reasons instead of shipping unsupported dependencies. Derive support manifests in candidate output and keep the selected target population consistent across package metadata and public guidance. Include declared browser generation, profile and reading resources with exact dependency and compatibility information.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The existing Packaging profile owns exact target roots, archive names, entrypoint rules, projection manifests, and transformation semantics. The selected current direction has Codex and Claude Code targets; old OpenCode evidence is historical, not current install eligibility. This obligation does not introduce a target or claim completed adoption. Browser distribution is an additional proposed product surface whose exact format remains to be designed; it is not another agent target.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The candidate inventory agrees with canonical sources and declared inclusion/transform rules; required mapped and transitive resources are present, and untransformed content retains its skill-relative path and raw bytes.\",\n    \"Declared transformations preserve selected skill behavior; unsupported fields or runtime dependencies reject or have an explicit exclusion reason rather than silently losing behavior.\",\n    \"Generated support manifests agree with the candidate version and actual inventory and do not use a tracked generated manifest as source truth.\",\n    \"Candidates and current guidance agree on the selected supported targets and omit retired target output, wrappers, exclusive resources, and permission-broadening instructions. Historical records are not rewritten.\",\n    \"A browser candidate includes all declared generation, profile and offline-reading resources and licenses; runtime dependencies and supported configurations are explicit. A reference documentation snapshot cannot substitute for the reusable product inventory.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-060\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-03\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Faithful portable distribution connects authored product meaning to the artifact a user actually obtains. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-04\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Faithful portable distribution connects authored product meaning to the artifact a user actually obtains. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-17\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Faithful portable distribution connects authored product meaning to the artifact a user actually obtains. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-21\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Faithful portable distribution connects authored product meaning to the artifact a user actually obtains. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-24\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Faithful portable distribution connects authored product meaning to the artifact a user actually obtains. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"SR-060\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    }\n  ]\n}\n","identity":"sha256:cbf30a221903f1016f77f0a81efb4f49c111893e7202caea97a7d012a63b5cc4","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-060-produce-faithful-supported-product-candidates/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-060","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-060 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:82066c3e9bcd225911a63d1e7e94ca165fc61f0e31ceff04af4607dc21dc6190","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/deployment.json"},{"identity":"sha256:0599f8c7b958658757f82b63dc636ac22851c3ea38bbfacffa9ebaaf8475e6fc","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/software.json"},{"identity":"sha256:d71c9c7b3fe1dac754cb00c3f8ac78a8af838bc345aa4eff004b59c7412d988c","path":"design/system/functions/FUNC-060-build-supported-product-candidates.json"},{"identity":"sha256:73ff3e3062b71339125a07c062cbb554e5751ff5f1d7c1847fc363f5c2496302","path":"design/requirements/scenarios/SCN-060-build-a-faithful-candidate-from-reviewed-product-sources.json"},{"identity":"sha256:25abac5d288035dd2f7402f66c4e6c4793f046846917f09d12227a291d9df814","path":"design/requirements/scenarios/SCN-069-prepare-an-approved-support-withdrawal-for-release.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-013 retained owner contract already define all concrete lower obligations for SR-061; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"Packaging selects deterministic transforms and byte ordering with isolated explicit output; its acceptance design compares repeated independent outputs for identical input and factual metadata.","number":1,"state":"covered"},{"explanation":"The generated-only contract makes check mode produce and inspect a temporary candidate without tracked adapter support or installation effects. The separately recorded default-sync implementation discrepancy is not concealed.","number":2,"state":"covered"},{"explanation":"Packaging requires explicit persistent output and containment outside canonical/active roots before writes; unsafe or overlapping destinations reject rather than being repaired by generation.","number":3,"state":"covered"},{"explanation":"Packaging retires the alternate mirror producer and excludes existing runtime directories from source, cleanup and synchronization. Installation remains a separately requested consumer.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-061\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Generate candidates deterministically outside active installations\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall generate equivalent product candidate contents from identical declared inputs in isolated temporary or explicitly selected safe output locations, without mutating canonical sources or active installations.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A build can unexpectedly install or overwrite user tooling or derive future candidates from generated copies.\",\n      \"desired_outcome\": \"Maintainers can inspect reproducible candidate output while authored sources and active installations remain intact.\"\n    },\n    \"why\": {\n      \"rationale\": \"Candidate production and user-authorized installation have different responsibility and mutation boundaries.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Product maintainers\",\n        \"Project users whose installed files must remain intact\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When building or checking a product candidate.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Canonical source, isolated package output, and supported or existing skill discovery roots.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use the existing canonical-input generation path. Check output containment before writes; reject overlap with source or active installation roots and unsafe paths. Check mode generates and validates temporary output. Persistent output requires explicit safe selection. Keep existing runtime mirrors outside authored input and build cleanup.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Candidate contents and declared deterministic metadata for identical inputs, not a promise that observation timestamps are identical. Exact command options and retired producer handling remain in Packaging. No build action grants installation or cleanup authority.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Identical declared inputs produce equivalent declared candidate contents and deterministic metadata in separate safe output locations.\",\n    \"Check mode succeeds without a tracked adapter manifest by generating a fresh isolated candidate and does not change source or installed roots.\",\n    \"An unspecified persistent destination, source/output overlap, active-root overlap, or unsafe containment rejects before writes with corrective information.\",\n    \"Existing runtime directories are not deleted, synchronized, or treated as authored input by build/check operations.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-060\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-04\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Candidate production and user-authorized installation have different responsibility and mutation boundaries. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-05\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Candidate production and user-authorized installation have different responsibility and mutation boundaries. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-21\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Candidate production and user-authorized installation have different responsibility and mutation boundaries. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-22\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Candidate production and user-authorized installation have different responsibility and mutation boundaries. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:1f8dc88c1b12604fef36e8533494341dfcc8471c6f6c69310375909224a5451c","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-061-generate-candidates-deterministically-outside-active-installations/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-061","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-061 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:82066c3e9bcd225911a63d1e7e94ca165fc61f0e31ceff04af4607dc21dc6190","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/deployment.json"},{"identity":"sha256:0599f8c7b958658757f82b63dc636ac22851c3ea38bbfacffa9ebaaf8475e6fc","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/software.json"},{"identity":"sha256:d71c9c7b3fe1dac754cb00c3f8ac78a8af838bc345aa4eff004b59c7412d988c","path":"design/system/functions/FUNC-060-build-supported-product-candidates.json"},{"identity":"sha256:73ff3e3062b71339125a07c062cbb554e5751ff5f1d7c1847fc363f5c2496302","path":"design/requirements/scenarios/SCN-060-build-a-faithful-candidate-from-reviewed-product-sources.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-013 retained owner contract already define all concrete lower obligations for SR-062; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"FUNC-061 and Packaging bind member names, version, source/generator, archive digests, normalized tree hashes and independent counts to actual candidate bytes; IF-005 transfers this same attributable inventory.","number":1,"state":"covered"},{"explanation":"Packaging defines exact UTF-8 path ordering, normalization and v2 preimage while preserving historical v1 verification. Unknown algorithms reject before consistency, and no historical digest is rewritten.","number":2,"state":"covered"},{"explanation":"Packaging and IF-005 distinguish production facts from actual validator observations. Release seals only checks applicable to the produced artifacts; pending/generated expectations supply no passing judgment.","number":3,"state":"covered"},{"explanation":"Release's build order derives metadata from real archives, the index from exact metadata bytes and then packs the consuming CLI. Installation verifies this bundled chain for network and local input; changed components invalidate reliance.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-062\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Bind artifact metadata to actual candidate bytes\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall describe each candidate artifact using factual source, generator, version, target, inventory, integrity, and observed-validation information that agrees with the actual artifact bytes and the selected compatibility representation.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Self-asserted metadata or a mismatched digest chain can make the wrong archive appear trustworthy.\",\n      \"desired_outcome\": \"Consumers can verify the exact candidate and distinguish artifact facts, generated expectations, and observed checks.\"\n    },\n    \"why\": {\n      \"rationale\": \"The archive producer, installer, and release operation must agree on the artifact identity they exchange.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Package and release maintainers\",\n        \"Users acquiring verified artifacts\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When candidate metadata is generated, consumed, or qualified.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Versioned target archives, npm-bundled metadata, release indexes, and their consumer verification boundary.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Derive inventory, size, checksums, tree hashes, file counts, and source/generator identity from actual artifacts. Preserve the specified current tree-hash representation and its retained historical verification path; reject unknown algorithms before consistency checks. Keep validation intent separate from actual observed results and bind package-bundled metadata to its release index.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Packaging owns exact regular-file membership, text normalization, UTF-8 ordering, hash rows, metadata fields, and versioned archive representation. Current v2 and historical v1 meanings remain distinct, including the historical meaning of a missing algorithm field. Hash exclusion does not authorize unsafe path writes.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Artifact names, target/version, archive members, checksums, tree hashes, counts, and recorded source/generator facts agree with the inspected candidate bytes.\",\n    \"An unknown integrity algorithm rejects; current candidates use the declared current representation while historical trusted metadata retains its specified verification meaning without recomputation or rewriting.\",\n    \"A generated descriptor does not mark an unexecuted check as passed; actual validation observations identify their subject and result.\",\n    \"Installer-consumed bundled metadata matches the trusted release index; a changed archive, index, or metadata invalidates the prior integrity chain.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-061\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-06\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. The archive producer, installer, and release operation must agree on the artifact identity they exchange. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-09\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. The archive producer, installer, and release operation must agree on the artifact identity they exchange. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-18\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. The archive producer, installer, and release operation must agree on the artifact identity they exchange. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-21\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. The archive producer, installer, and release operation must agree on the artifact identity they exchange. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:ddbfe78793fae0b5cd04e22c731478d04af4520a97fef8be6fd5685e48f9469d","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-062-bind-artifact-metadata-to-actual-candidate-bytes/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-062","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-062 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:82066c3e9bcd225911a63d1e7e94ca165fc61f0e31ceff04af4607dc21dc6190","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/deployment.json"},{"identity":"sha256:0599f8c7b958658757f82b63dc636ac22851c3ea38bbfacffa9ebaaf8475e6fc","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/software.json"},{"identity":"sha256:d5a10410e8ad94a7c146d73ddabfaa18ac048ff056a918c46276c8fe38305a36","path":"design/system/functions/FUNC-061-derive-artifact-integrity-metadata.json"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:73ff3e3062b71339125a07c062cbb554e5751ff5f1d7c1847fc363f5c2496302","path":"design/requirements/scenarios/SCN-060-build-a-faithful-candidate-from-reviewed-product-sources.json"},{"identity":"sha256:fdd6b4bce5854ed8fbbef211ebc0c865df4c8f7608e26c9ad636ae0e97b6af70","path":"design/requirements/scenarios/SCN-061-assess-the-actual-packed-cli-before-release.json"},{"identity":"sha256:25abac5d288035dd2f7402f66c4e6c4793f046846917f09d12227a291d9df814","path":"design/requirements/scenarios/SCN-069-prepare-an-approved-support-withdrawal-for-release.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-013 retained owner contract already define all concrete lower obligations for SR-063; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"Packaging's npm allowlist and actual-tarball inspection require one executable, runtime/trust inputs and license metadata while excluding tests, secret material, copied archives and installed trees.","number":1,"state":"covered"},{"explanation":"The packed-consumer contract prohibits hidden acquisition and install-time product generation, requires justified runtime dependencies and exercises the emitted executable without checkout imports.","number":2,"state":"covered"},{"explanation":"Packaging and Installation share actual packed-CLI smoke for both targets, including conflict, force, preservation and unsafe-destination partitions. Known missing packed assertions remain proof work, not replaced by helper success.","number":3,"state":"covered"},{"explanation":"FUNC-062 and Packaging reject missing/forbidden members, unusable runtime or inconsistent bundled metadata before candidate qualification; the release consumer cannot bypass a failed package boundary.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-063\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Qualify the actual executable CLI package\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall produce and qualify a complete self-contained CLI package with the declared executable, runtime inputs, public metadata, and trusted installation metadata, excluding forbidden content and consumer-side generation or hidden acquisition.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A source checkout can run correctly while the published tarball omits runtime data or depends on repository-only files.\",\n      \"desired_outcome\": \"A clean consumer can execute the actual packed CLI and its supported installation path without repository internals or installation-time product generation.\"\n    },\n    \"why\": {\n      \"rationale\": \"The published executable is the user-visible artifact, so source configuration alone cannot establish package completeness.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"CLI users\",\n        \"Product maintainers and package reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Before a CLI candidate is accepted for publication.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The actual packed npm artifact and a clean consumer installation of those bytes.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Inspect actual packed members against the explicit inclusion and exclusion policy. Require the single public binary, required built runtime, license/public metadata, and bundled trust data. Reject unjustified runtime dependencies, hooks, forbidden files, secrets, and missing runtime inputs. Exercise the packed CLI against real generated target archives under the composed proof contract.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The retained npm content/dependency policy and supported executable contract, not a new runtime framework. Packaging owns exact file lists and hook constraints; external registry publication proof remains a later Release responsibility.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Inspecting the actual tarball confirms the declared single binary, required runtime and trusted metadata, matching public/license metadata, and absence of forbidden repository, test, secret, archive-copy, installation, and temporary contents.\",\n    \"A fresh consumer can execute the packed binary without repository imports, consumer generation, hidden network/credential use, or an unapproved runtime dependency or install hook.\",\n    \"Qualification exercises actual packed-CLI installation with generated archives and trusted metadata for each selected target, including conflicts, force replacement, preservation, and unsafe destinations; helper or dry-run success alone is insufficient.\",\n    \"Any missing required member, forbidden inclusion, unusable executable, or package/metadata mismatch prevents qualification.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-062\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-18\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. The published executable is the user-visible artifact, so source configuration alone cannot establish package completeness. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-PACKAGING\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md#DIST-SR-23\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. The published executable is the user-visible artifact, so source configuration alone cannot establish package completeness. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:6cd35c19d5af82277b2a3e77e2681066960d98604241c68504babf6aae6ca4af","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-063-qualify-the-actual-executable-cli-package/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-063","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-063 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:82066c3e9bcd225911a63d1e7e94ca165fc61f0e31ceff04af4607dc21dc6190","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/deployment.json"},{"identity":"sha256:0599f8c7b958658757f82b63dc636ac22851c3ea38bbfacffa9ebaaf8475e6fc","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/software.json"},{"identity":"sha256:6b71b5d41f40ed98c51cf39d27045200f4eea1544d1ac00ca2f56399cf0822eb","path":"design/system/functions/FUNC-062-assess-packed-cli-completeness.json"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:73ff3e3062b71339125a07c062cbb554e5751ff5f1d7c1847fc363f5c2496302","path":"design/requirements/scenarios/SCN-060-build-a-faithful-candidate-from-reviewed-product-sources.json"},{"identity":"sha256:fdd6b4bce5854ed8fbbef211ebc0c865df4c8f7608e26c9ad636ae0e97b6af70","path":"design/requirements/scenarios/SCN-061-assess-the-actual-packed-cli-before-release.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-014 retained owner contract already define all concrete lower obligations for SR-064; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"MOD-014/FUNC-063 parses the exact supported target and options before acquisition. Installation explicitly rejects retired aliases and state-writing syntax across pinned/local/dry-run forms.","number":1,"state":"covered"},{"explanation":"Installation verifies package-bundled metadata against the matching release index. A supplied local ZIP supplies bytes only and cannot introduce its own trust root or incompatible version.","number":2,"state":"covered"},{"explanation":"The acquisition contract verifies filename, target, release, checksum and size before extraction; traversal, absolute/drive paths, links and unexpected members reject before installed-unit mutation.","number":3,"state":"covered"},{"explanation":"The verified staged candidate is checked against declared roots, tree representation and counts. Unrelated project files and governance state are excluded from verification and installation admission.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-064\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Acquire and verify a supported installation candidate\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall reject unsupported installation requests before acquisition or mutation and shall acquire, verify, and safely stage a selected target archive only against compatible package-bundled trusted metadata.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A user-supplied archive, retired target, or hostile member path can bypass artifact trust or installation boundaries.\",\n      \"desired_outcome\": \"Installation begins only with an identified supported candidate whose archive and extracted contents satisfy the retained trust and containment rules.\"\n    },\n    \"why\": {\n      \"rationale\": \"Users must be able to obtain tooling without trusting arbitrary metadata or exposing their project to unsafe extraction.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Users installing supported skills\",\n        \"Maintainers supplying trusted artifacts\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a real network or local-archive installation is requested.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"CLI request admission, trusted archive acquisition, verification, and isolated staging.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Reject unknown or retired targets and removed syntax/state-writing options before network, extraction, or writes. Verify package-bundled metadata against its release index, then use only the trusted official source or explicit local archive. Check filename, target, compatible release, digest, declared size, supported hash algorithm, roots, tree hashes, and counts. Reject unsafe member paths and unsupported links; never install an out-of-root package support entrypoint.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The existing install-only Codex/Claude direction and retained historical metadata verification rules. A pinned old archive cannot restore a retired target. Local archives change acquisition location, not the trust root. Exact metadata and extraction representations remain owned by Installation and Packaging.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Unsupported or missing targets, retired OpenCode aliases, removed adapter syntax, and write-state requests reject before acquisition, extraction, or filesystem mutation, including local, pinned, and dry-run forms.\",\n    \"Missing or incompatible bundled trusted metadata blocks installation; metadata supplied beside a local archive does not replace the bundled trust root.\",\n    \"Wrong filename, target, release, digest, or declared size rejects before extraction, and hostile or out-of-root members reject before installation.\",\n    \"The staged candidate inventory, tree hashes, and file counts agree with trusted metadata; unrelated project content is outside candidate verification.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-063\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-02\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Users must be able to obtain tooling without trusting arbitrary metadata or exposing their project to unsafe extraction. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-07\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Users must be able to obtain tooling without trusting arbitrary metadata or exposing their project to unsafe extraction. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-08\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Users must be able to obtain tooling without trusting arbitrary metadata or exposing their project to unsafe extraction. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-11\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Users must be able to obtain tooling without trusting arbitrary metadata or exposing their project to unsafe extraction. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:0e7929ae307f0ca8a2bc70ecaad50862a26496fcb1faabcbc2f262291f6f2fd9","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-064-acquire-and-verify-a-supported-installation-candidate/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-064","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-064 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:8826cafce61e450491f674a84da5ba1bcc8717a2f3328f2e6a2db1c29bccce23","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/module.json"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:6a72685271f50c40a3033f8037c56e4482af8ad408163cfddf8ef155ff6aefe2","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/deployment.json"},{"identity":"sha256:e848618a5884e938c5b55135f4668edeaa9b92d723cc5efb9b55a59cc6afb28c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/runtime.json"},{"identity":"sha256:d42f60a86223d1fd4090771892efe71dfd116ef89d5e0539c6777485223074c9","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/software.json"},{"identity":"sha256:535c0ad17e69d39e4b6035bc29a678322bdf5f3ed40918b817051db8ea882a93","path":"design/system/functions/FUNC-063-acquire-and-verify-an-installation-candidate.json"},{"identity":"sha256:7d865f34261a719d99a95927549ae1516da52b5dc19aefe4b634407a12493916","path":"design/architecture/interfaces/IF-006-verified-skill-installation-execution/interface.json"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:dff13a6adf41c9e90941a751ed6ac4b5626613f77d880c21965f50a7b8e651c0","path":"design/requirements/scenarios/SCN-062-install-supported-skills-into-an-available-destination.json"},{"identity":"sha256:a2c5f84cbfcf9f90bd2aee92a8dc12ab1ecea8d198ff00c94eeb56f094f19fa0","path":"design/requirements/scenarios/SCN-064-inspect-an-installation-plan-without-acquiring-or-changing-files.json"},{"identity":"sha256:a8ac526c74661c00b6594c1d9a546b02bd870b5e8d79e66696fdf4cefb0f1d0e","path":"design/system/features/FEAT-019-install-verified-skills-for-a-selected-supported-target.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-014 retained owner contract already define all concrete lower obligations for SR-065; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"Complete candidate preflight discovers all existing selected units, including empty or identical ones; any default conflict stops the entire installation, including otherwise absent units.","number":1,"state":"covered"},{"explanation":"MOD-014 replaces whole conflicting candidate units under explicit force, preserving shared parents, unrelated units and uninterpreted project state. Overlay installation is explicitly rejected.","number":2,"state":"covered"},{"explanation":"The owner requires anchored parent access, captured membership/identity rechecks and no-clobber publication. Missing primitives or changed scope stops; a newly appearing destination is never a second implied replacement.","number":3,"state":"covered"},{"explanation":"The per-unit detach protocol retains originals outside all discovery roots and checks detached identity. Failures report actual completed/detached/partial/untouched scope without multi-unit rollback or perpetual writer-exclusion claims.","number":4,"state":"covered"},{"explanation":"Retry starts with fresh acquisition, verification and complete destination preflight. Completed/partial units conflict again by default; private retained paths supply neither restoration nor replacement authority.","number":5,"state":"covered"},{"explanation":"MOD-014's exact replacement profile plus force selects only three named obsolete units and candidate units. Complete-union preflight, outside-discovery retention and absence rechecks preserve partial effects without workflow activation.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-065\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Install verified units within explicit safe replacement boundaries\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall install only verified candidate units after complete destination preflight, stop on every existing candidate-unit conflict by default, and permit complete replacement only under explicit applicable force authority while preserving unrelated content and reporting partial effects. Separately authorized workflow replacement may also retire an explicitly bounded set of obsolete installed units, with complete preflight, original retention and truthful per-unit effects.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Overlay updates, partial default installs, unsafe paths, or concurrent changes can destroy local work or leave misleading installed state.\",\n      \"desired_outcome\": \"Users obtain the intended complete units or an honest bounded failure without implicit replacement of other skills or project state.\"\n    },\n    \"why\": {\n      \"rationale\": \"Installation must respect the user's explicit replacement choice and remain safe when the filesystem changes or an operation fails.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project users installing or replacing skills\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"After archive verification and before any installed-unit mutation, including retries.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Verified candidate unit destinations, their ancestors, and any retained originals outside discovery roots.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Preflight all units and report all default conflicts, including empty and identical destinations, before changing any. Force replaces selected whole units rather than overlaying them, never shared parents or unrelated units. Preserve containment and link protection in both modes, detect changed destination bases, use no-clobber publication, and retain detached originals outside discovery roots. Stop on unsafe capability or partial failure, report completed/failed/untouched units, and require a fresh explicit replacement decision on retry. For explicitly selected workflow replacement, include the supported obsolete-unit set in complete preflight and retention; ordinary force never implies this extra scope.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Installation's exact destination, anchored filesystem, original-retention, and partial-retry contract remains authoritative. Project-root state is neither read for admission nor changed. No managed upgrade, automatic restoration, automatic retired-skill cleanup, whole-project replacement, exclusion of all concurrent writers, or automatic filesystem-wide rollback is promised.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Without force, any existing candidate unit, including identical or empty content, produces the complete discovered conflict set and prevents changes to every candidate unit.\",\n    \"An ordinary authorized force request replaces only conflicting candidate units completely, including obsolete files, and installs absent units while preserving unrelated skills, shared parents, and project-root state.\",\n    \"Unsafe or inaccessible destinations, links, unsupported required safety primitives, or changed preflight bases block in both modes; a newly appearing destination is not silently acquired as another force replacement.\",\n    \"Detached originals remain outside skill discovery after success or failure. A failure identifies completed, failed, detached, partial, retained-original, and untouched scope without claiming rollback or success.\",\n    \"Retry repeats verification and preflight; current partial or completed units conflict by default, and retained originals do not authorize restoration or further replacement.\",\n    \"A supported workflow replacement request separately identifies and authorizes its bounded obsolete-unit retirement scope. Ordinary force does not authorize removal of noncandidate units. Preflight covers all selected units before mutation; originals remain outside discovery, unrelated content is preserved, and partial effects never imply workflow activation.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-064\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-10\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Installation must respect the user's explicit replacement choice and remain safe when the filesystem changes or an operation fails. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-12\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Installation must respect the user's explicit replacement choice and remain safe when the filesystem changes or an operation fails. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-13\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Installation must respect the user's explicit replacement choice and remain safe when the filesystem changes or an operation fails. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-14\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Installation must respect the user's explicit replacement choice and remain safe when the filesystem changes or an operation fails. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-CONTRACTS\",\n      \"locator\": \"SR-065; explicit workflow replacement only\",\n      \"basis\": \"Requirement-first workflow boundary refinement. Existing identities and historical judgments retain their original scope; this target contract is not implemented or adopted behavior.\"\n    }\n  ]\n}\n","identity":"sha256:812be496b53e4811a6fa386aaf35491507edd8a121a4838c674310849ff47733","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-065-install-verified-units-within-explicit-safe-replacement-boundaries/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-065","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-065 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:8826cafce61e450491f674a84da5ba1bcc8717a2f3328f2e6a2db1c29bccce23","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/module.json"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:6a72685271f50c40a3033f8037c56e4482af8ad408163cfddf8ef155ff6aefe2","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/deployment.json"},{"identity":"sha256:e848618a5884e938c5b55135f4668edeaa9b92d723cc5efb9b55a59cc6afb28c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/runtime.json"},{"identity":"sha256:d42f60a86223d1fd4090771892efe71dfd116ef89d5e0539c6777485223074c9","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/software.json"},{"identity":"sha256:7129691ef0d18646c943bc73209c91cccfff73b302bdbfa3287b19a1ab315c03","path":"design/system/functions/FUNC-064-apply-bounded-skill-installation-and-replacement.json"},{"identity":"sha256:7d865f34261a719d99a95927549ae1516da52b5dc19aefe4b634407a12493916","path":"design/architecture/interfaces/IF-006-verified-skill-installation-execution/interface.json"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:dff13a6adf41c9e90941a751ed6ac4b5626613f77d880c21965f50a7b8e651c0","path":"design/requirements/scenarios/SCN-062-install-supported-skills-into-an-available-destination.json"},{"identity":"sha256:3412f104d692c7bf9c5a51b98321ea26e40d5a712c205dd56639f13890d19e96","path":"design/requirements/scenarios/SCN-063-replace-selected-installed-skill-units-explicitly.json"},{"identity":"sha256:a8ac526c74661c00b6594c1d9a546b02bd870b5e8d79e66696fdf4cefb0f1d0e","path":"design/system/features/FEAT-019-install-verified-skills-for-a-selected-supported-target.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-014 retained owner contract already define all concrete lower obligations for SR-066; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"FUNC-065 and IF-006 keep dry-run to preliminary bundled-inventory/destination checks with no acquisition, extraction or mutation; incomplete archive verification remains explicitly unperformed.","number":1,"state":"covered"},{"explanation":"Installation defines supported exit classes and truthful planned, blocked and actual effects; the successor result's per-unit action/outcome/retained-path fields preserve partial replacement and retirement.","number":2,"state":"covered"},{"explanation":"The owner fixes help/result warnings to selected whole-unit local modifications, explains retained originals and excludes shared-parent and unrelated-state replacement from permission.","number":3,"state":"covered"},{"explanation":"Installation restricts proxy names and closed diagnostic values, uses explicit unknowns and trusted public identity, excludes private values/paths, performs no diagnostic probes and keeps local fallback fully verified.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-066\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Report installation plans and outcomes without exposing private data\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall present nonmutating preliminary installation plans and distinguish blocked, planned, actual, and partial outcomes with actionable supported diagnostics while excluding private environment and credential information.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A dry-run can be mistaken for verified installation, or an error report can expose secrets while hiding unperformed checks.\",\n      \"desired_outcome\": \"Users can decide what an installation would affect and understand what actually happened without sensitive diagnostics or false completion.\"\n    },\n    \"why\": {\n      \"rationale\": \"Planning and honest limited results support safe user choice without manufacturing package verification or installation evidence.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Users planning or diagnosing installation\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When installation help, dry-run, verification, conflict handling, or actual operation results are presented.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Human-readable and structured CLI outcomes, destination planning, and bounded network diagnostics.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use bundled inventory for preliminary dry-run checks without downloading, extracting, or changing project files. Distinguish those checks from full verified-archive preflight and preserve existing result envelopes, exit classes, conflict and force warnings, and actual-effect reporting. Use only the declared safe network/proxy fields and closed values, without extra probes or a new proxy dispatcher.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Installation's existing public result/exit contract and privacy vocabulary. Results do not claim state writes; no raw credentials, private hosts/users, headers, proxy values, or machine-local archive paths enter public diagnostics or durable generated material.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Dry-run describes candidate destinations, potential conflicts, and explicit whole-unit replacement scope without acquisition, extraction, or project mutation; unperformed verification remains visible.\",\n    \"Human and structured results preserve the supported envelopes and exit distinctions and separate planned replacements from actual or partial effects.\",\n    \"Help and replacement results identify that local modifications inside replaced skill directories will be lost, without implying shared-parent or unrelated-state replacement.\",\n    \"Network diagnostics contain only allowed bounded public fields and variable names, identify uncertainty honestly, and retain verified local-archive fallback without exposing secrets or performing additional probes.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-065\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-13\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Planning and honest limited results support safe user choice without manufacturing package verification or installation evidence. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-15\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Planning and honest limited results support safe user choice without manufacturing package verification or installation evidence. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-INSTALLATION\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md#DIST-SR-16\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Planning and honest limited results support safe user choice without manufacturing package verification or installation evidence. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:66e8c0aa1cf0ad06d5490a7902bdb615220b0eec386116c46d419235f5a993cc","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-066-report-installation-plans-and-outcomes-without-exposing-private-data/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-066","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-066 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:8826cafce61e450491f674a84da5ba1bcc8717a2f3328f2e6a2db1c29bccce23","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/module.json"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:6a72685271f50c40a3033f8037c56e4482af8ad408163cfddf8ef155ff6aefe2","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/deployment.json"},{"identity":"sha256:e848618a5884e938c5b55135f4668edeaa9b92d723cc5efb9b55a59cc6afb28c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/runtime.json"},{"identity":"sha256:d42f60a86223d1fd4090771892efe71dfd116ef89d5e0539c6777485223074c9","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/realization/software.json"},{"identity":"sha256:b491cb46ef2bed16df6d4d6625c4bde28d7b3110027365348f3ee1b732a11b67","path":"design/system/functions/FUNC-065-present-installation-plans-and-outcomes.json"},{"identity":"sha256:7d865f34261a719d99a95927549ae1516da52b5dc19aefe4b634407a12493916","path":"design/architecture/interfaces/IF-006-verified-skill-installation-execution/interface.json"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:dff13a6adf41c9e90941a751ed6ac4b5626613f77d880c21965f50a7b8e651c0","path":"design/requirements/scenarios/SCN-062-install-supported-skills-into-an-available-destination.json"},{"identity":"sha256:3412f104d692c7bf9c5a51b98321ea26e40d5a712c205dd56639f13890d19e96","path":"design/requirements/scenarios/SCN-063-replace-selected-installed-skill-units-explicitly.json"},{"identity":"sha256:a2c5f84cbfcf9f90bd2aee92a8dc12ab1ecea8d198ff00c94eeb56f094f19fa0","path":"design/requirements/scenarios/SCN-064-inspect-an-installation-plan-without-acquiring-or-changing-files.json"},{"identity":"sha256:a8ac526c74661c00b6594c1d9a546b02bd870b5e8d79e66696fdf4cefb0f1d0e","path":"design/system/features/FEAT-019-install-verified-skills-for-a-selected-supported-target.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-015 retained owner contract already define all concrete lower obligations for SR-067; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"MOD-015/FUNC-066 resolves source, version rationale, package/channel/targets and profile from reviewed inputs. The immutable candidate and initiating run retain their exact identities before publication.","number":1,"state":"covered"},{"explanation":"The resolver observes public identity for duplicate/no-op/conflict classification and rejects unsupported automation instead of inventing a version or relabeling special handling as routine.","number":2,"state":"covered"},{"explanation":"Release's compatibility policy makes support withdrawal a major-version decision, composes Packaging's two-target transition and preserves earlier public artifacts and historical population evidence.","number":3,"state":"covered"},{"explanation":"The current-qualification contract admits matching current source/profile or prepared candidate and rejects retired recipe-dependent replay before generation or external activity, without hardcoded newest-version eligibility.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-067\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Select compatible release identity and supported execution scope\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall identify each release attempt's reviewed source, release type, version rationale, package, tag, channel, supported targets, and applicable execution profile, rejecting unsupported or conflicting selections without overwriting an existing publication.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A routine operation can silently introduce product decisions or apply an old release recipe to a different candidate.\",\n      \"desired_outcome\": \"Maintainers know the exact product and compatibility decision being released and which selected path can legitimately handle it.\"\n    },\n    \"why\": {\n      \"rationale\": \"Version and support compatibility are public product obligations, not consequences inferred from a successful build.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Release maintainers\",\n        \"Users affected by public compatibility changes\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Before release preparation or publication and when support is added or withdrawn.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Existing reviewed product decisions, selected source/profile, and observed external version conflicts.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the retained patch/minor/major and stable/prerelease policy to the recorded compatibility decision. Routine publication introduces no new engineering or publish-mechanics decision; routine automation admits only its separately supported population. Require a precise owner intervention for ambiguity or special handling. Qualify selected current source or an explicit candidate, not hardcoded historical production reports or retired bootstrap recipes. Keep historical target/evidence meanings unchanged.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The existing Release profile and Distribution support-transition scope. A generally allowed prerelease or approved special change does not make it supported by stable-only routine automation. Support withdrawal is a compatibility break requiring its applicable version decision. This definition neither selects a new release nor certifies that a source transition has completed adoption.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"An attempt identifies release type, justified version, reviewed source commit/branch, package, tag, channel, target population, and applicable profile before publication.\",\n    \"No-change and already-published attempts report their no-op, conflict, or recovery meaning without overwriting a version; an unsupported population stops with a specific owner decision rather than being relabeled routine.\",\n    \"Public compatibility withdrawals are disclosed and feed the major-version decision; old artifacts and historical target populations remain unchanged.\",\n    \"Current qualification rejects unsupported historical replay before generation or publication and does not require retired production reports, generators, bootstrap recipes, or activation ledgers as current inputs.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-066\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-01\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Version and support compatibility are public product obligations, not consequences inferred from a successful build. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-02\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Version and support compatibility are public product obligations, not consequences inferred from a successful build. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-03\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Version and support compatibility are public product obligations, not consequences inferred from a successful build. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-25\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Version and support compatibility are public product obligations, not consequences inferred from a successful build. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-26\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Version and support compatibility are public product obligations, not consequences inferred from a successful build. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#Distribution support transition\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Version and support compatibility are public product obligations, not consequences inferred from a successful build. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:333899e5787719cf0d83ed3c8af264b446aad1054b37817c73ba4149c857868e","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-067-select-compatible-release-identity-and-supported-execution-scope/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-067","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-067 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:d801c222b65606374572556046195ef6a34be043651caa398999a1c57468637b","path":"design/system/functions/FUNC-066-select-release-identity-and-execution-eligibility.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:75837ee278b87c2ae6ad15bb6a0b2e30a100ba76ff827ef7f3a37193da07c940","path":"design/requirements/scenarios/SCN-065-prepare-and-qualify-a-concrete-release-candidate.json"},{"identity":"sha256:25abac5d288035dd2f7402f66c4e6c4793f046846917f09d12227a291d9df814","path":"design/requirements/scenarios/SCN-069-prepare-an-approved-support-withdrawal-for-release.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qualified-rigorloop-releases-with-observed-outcomes.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-015 retained owner contract already define all concrete lower obligations for SR-068; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"FUNC-067 and Release classify profile-owned generated, human and historical surfaces; fixed generated regions and allowed prepared-source diffs retain narrative/test logic/history and distinguish expectations from observations.","number":1,"state":"covered"},{"explanation":"Preparation prohibits registry queries and public writes; eligibility resolution observes registry state outside that helper. Interrupted preparation requires actual-output inspection and reconciliation before readiness.","number":2,"state":"covered"},{"explanation":"Cheap preflight checks profile/version, metadata pointers, literal ownership, pending inputs, outputs and tag conflicts under a side-effect-limited contract, distinct from full candidate and public qualification.","number":3,"state":"covered"},{"explanation":"The required literal-audit resource identifies classifications and dispositions; baseline drift remains visible and unavailable remote facts remain uncertain rather than clear.","number":4,"state":"covered"},{"explanation":"Release's closed schemas and matched nonnested region markers reject unknown or malformed representations; manual overrides require attributable rationale and independent assessment rather than replacing profile authority.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-068\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Prepare release projections from one authoritative profile\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall prepare reviewable release projections deterministically from the selected complete profile and source, preserving authored narrative and historical records, and shall expose cheap completeness or ownership defects without publishing or manufacturing observed success.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Duplicated version values and generated success assertions can make a prepared release incoherent or falsely qualified.\",\n      \"desired_outcome\": \"Maintainers receive a reproducible candidate basis whose generated expectations, human content, and historical facts are distinguishable.\"\n    },\n    \"why\": {\n      \"rationale\": \"One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Release maintainers\",\n        \"Reviewers inspecting generated candidate changes\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a supported release is prepared, checked, interrupted, or resumed.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Selected release profile, controlled generated regions, human-authored material, immutable historical evidence, and local preflight results.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Classify surfaces by their source authority and derive only permitted current projections and fixture data. Preserve narrative outside declared regions, never generate test logic, and treat unexpected semantic edits as engineering changes. Make preparation idempotent and nonpublishing; it does not query registry publication state. Use side-effect-light preflight for profile/version/pointer/literal/evidence/input/output/tag consistency and reject unknown closed values or malformed representation.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The existing profile, generated-region, literal-classification, pending-evidence, and preflight representations remain owned by Release. Preflight does not require credentials or substitute for artifact construction, full checks, or public smoke. Remote unavailability is uncertainty, not a pass; requested diagnostic logs are the limited write exception.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The same complete profile and source produce the same permitted projections; generated regions are identifiable, current facts have owners, human narrative and historical evidence remain unchanged, and generated expectations never become observed passes.\",\n    \"Preparation does not publish, create/push tags, create hosted releases, or query registry publication state; interrupted preparation remains unready until its actual outputs are reconciled.\",\n    \"Preflight exposes missing/malformed profile values, version/pointer mismatches, unauthorized new current literals, invalid pending evidence, missing inputs, conflicting outputs/tags, and unsupported representations without performing full release checks.\",\n    \"Baseline drift remains reported until disposition, historical literals retain explicit classification, and ambiguous or unavailable remote state is not reported as clear.\",\n    \"Unknown closed values or broken generated-region boundaries reject; a justified manual override stays visible for assessment rather than silently becoming a new source of truth.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-067\",\n    \"FUNC-068\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-03\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-04\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-05\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-06\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-07\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-19\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-24\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. One authoritative profile and explicit projection ownership prevent competing release identities and preparation from masquerading as publication. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:c347c8b5d465cea1a5ca4ea3f5e4c584c83dca9691db2865c7027b23496f936e","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-068-prepare-release-projections-from-one-authoritative-profile/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-068","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-068 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:872d1ff1073efd84c0cfed22b50b55dd3d4c75aa2899d8ac40afa6b33db282bd","path":"design/system/functions/FUNC-067-prepare-profile-owned-release-projections.json"},{"identity":"sha256:2cdcd8449d7d5073d9a4b63879ab8acd2d91010979590d50f90ada2dbe8d8041","path":"design/system/functions/FUNC-068-assess-release-preflight-and-qualification.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:75837ee278b87c2ae6ad15bb6a0b2e30a100ba76ff827ef7f3a37193da07c940","path":"design/requirements/scenarios/SCN-065-prepare-and-qualify-a-concrete-release-candidate.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qualified-rigorloop-releases-with-observed-outcomes.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-015 retained owner contract already define all concrete lower obligations for SR-069; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"FUNC-069 seals reviewed source S, permitted prepared source C, generated overlay, final artifacts, profile, destinations/configuration and observed checks into one retained manifest bound to initiation.","number":1,"state":"covered"},{"explanation":"Release consumes actual emitted tarball/archive checks through Packaging and Installation. Missing content, failed/inapplicable evidence or unresolved blockers withhold qualification regardless of source-only success.","number":2,"state":"covered"},{"explanation":"The ordered build constructs archives, metadata/index, then consuming tarball and outer binding. Provider artifact identity and later public observations remain outside their own hashed candidate inputs.","number":3,"state":"covered"},{"explanation":"Release and IF-010 require every applicable nondeferred check on the exact candidate. Exceptional deferrals retain owner/risk/follow-up and cannot waive identity, privacy, mandatory public verification or recovery evidence.","number":4,"state":"covered"},{"explanation":"Local and hosted qualification use shared repository-owned commands and consumed owner proof; explicit fresh public observations remain later obligations that preflight or package-only success cannot establish.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-069\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Qualify the exact prepared release candidate\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall qualify the exact prepared source and product artifacts against every applicable non-deferred release obligation before publication, retaining actual applicable evidence and rejecting stale, incomplete, contradictory, or mismatched candidate support.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A source-tree check or rebuilt artifact can be substituted for the actual package selected for publication.\",\n      \"desired_outcome\": \"The publication subject is a concrete qualified candidate with inspectable identities and honest limits.\"\n    },\n    \"why\": {\n      \"rationale\": \"Release readiness must compose packaging, installed-consumer, security, and release evidence against the same candidate.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Release reviewers and maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Before publication and at applicable execution safeguards.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Reviewed source, permitted prepared source changes, generated artifact inputs, actual tarball/archives, and the sealed candidate evidence.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Preserve the reviewed source and permitted prepared-commit distinction. Build archives, derive the exact metadata/index consumed by the CLI, pack that input, and qualify the resulting artifacts before sealing their outer candidate identity. Check required notes, source state, package preview, local packed installation, selected validation, archive integrity, security, recovery, authentication/provenance path, and unresolved blockers under the profile. Apply evidence freshness rules and explicit deferral policy; no local or cached result replaces mandatory fresh public proof.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The existing release verification and immutable-candidate contracts, including the public-qualification obligations that remain for later observation. Emergency deferrals are explicit owner decisions outside ordinary routine automation; nondeferable identity, evidence, privacy, public verification, and recovery duties remain. No new test count or independent definition of package correctness is introduced.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The candidate summary binds reviewed/prepared source, allowed generated changes, actual CLI/archive bytes, profile, destination, configuration, and required observed checks to one candidate.\",\n    \"Required package preview and smoke concern the actual packed candidate and selected archives rather than a source checkout; missing contents, forbidden inclusions, stale evidence, or unresolved blockers prevent readiness.\",\n    \"Generated metadata and index precede the consuming CLI package, and outer artifact identities do not create self-referential digest inputs; later observations do not modify sealed inputs.\",\n    \"All applicable non-deferred checks pass with evidence applicable to the exact candidate; any exceptional deferral has its required owner, rationale, accepted risk, follow-up, and limit and cannot waive nondeferable duties.\",\n    \"Local and hosted release checks use their existing shared command ownership; preflight, dry-run, structural validity, or package-only success is not treated as full release or public proof.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-068\",\n    \"FUNC-069\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-08\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Release readiness must compose packaging, installed-consumer, security, and release evidence against the same candidate. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-09\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Release readiness must compose packaging, installed-consumer, security, and release evidence against the same candidate. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-12\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Release readiness must compose packaging, installed-consumer, security, and release evidence against the same candidate. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-16\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Release readiness must compose packaging, installed-consumer, security, and release evidence against the same candidate. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-23\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Release readiness must compose packaging, installed-consumer, security, and release evidence against the same candidate. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-24\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Release readiness must compose packaging, installed-consumer, security, and release evidence against the same candidate. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"user-request:2026-10-04-release-workflow-start-authority\",\n      \"basis\": \"User selects initiation of the authorized release workflow as publication authority, with no later routine approval. Refines the existing IR-010 need; exact candidate qualification, bounded authority and recovery remain. Design change only; running workflow adoption requires implementation.\"\n    }\n  ]\n}\n","identity":"sha256:ead1afb967844b9db53885912e86caa59b76b96a11935acda2f70577b17f78e6","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-069-qualify-the-exact-prepared-release-candidate/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-069","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-069 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:2cdcd8449d7d5073d9a4b63879ab8acd2d91010979590d50f90ada2dbe8d8041","path":"design/system/functions/FUNC-068-assess-release-preflight-and-qualification.json"},{"identity":"sha256:3fccdb9c28d3ce5be453e76118f715fd5338bb6839617b50e158072d5e3def62","path":"design/system/functions/FUNC-069-seal-a-qualified-immutable-release-candidate.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:75837ee278b87c2ae6ad15bb6a0b2e30a100ba76ff827ef7f3a37193da07c940","path":"design/requirements/scenarios/SCN-065-prepare-and-qualify-a-concrete-release-candidate.json"},{"identity":"sha256:7ee2dc137891c10f2c8c8d9d224e7ca153c3a805fea355fd0beb84d1e272321e","path":"design/requirements/scenarios/SCN-066-start-an-authorized-release-and-publish-the-qualified-packages.json"},{"identity":"sha256:25abac5d288035dd2f7402f66c4e6c4793f046846917f09d12227a291d9df814","path":"design/requirements/scenarios/SCN-069-prepare-an-approved-support-withdrawal-for-release.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qualified-rigorloop-releases-with-observed-outcomes.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-015 retained owner contract already define all concrete lower obligations for SR-070; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"Release revalidates event/source/configuration, retained package binding and applicable authority before each tag/assets/npm write; material drift blocks and requires a new qualified authorized start.","number":1,"state":"covered"},{"explanation":"The executor retrieves the retained artifact set without rebuilding or reading a new branch tip, checks public conflicts and writes only confirmed missing authorized work. Alternate publishers cannot bypass this boundary.","number":2,"state":"covered"},{"explanation":"IF-009 and IF-010 provide separate authority and support findings; Release retains qualification and execution. Neither permission nor a passing check supplies the other's required basis.","number":3,"state":"covered"},{"explanation":"Release preserves trusted-publishing/profile constraints, only specifically authorized fallback and honest provenance. Secret-bearing packages or unsafe diagnostics block rather than leaking credentials or weakening authentication.","number":4,"state":"covered"},{"explanation":"Serialized execution retains active-attempt protection, but duplicate events grant no authority. Unknown provider effects trigger authoritative state inspection; matching public bytes are not written again.","number":5,"state":"covered"},{"explanation":"The workflow-start contract conditionally authorizes the deterministic qualified output without a later reviewer/API gate. CI-only, PR, local and unsupported-trigger candidates cannot be promoted into publication permission.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-070\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Publish only the authorized immutable candidate\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall bind publication to applicable authorization for the exact qualified candidate, source, version/channel, destinations, and execution path, and shall stop on material changes, conflicting external identities, or unmet authentication and evidence requirements.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Authority to start one release can be incorrectly reused for a different source, changed packages or duplicate external writes.\",\n      \"desired_outcome\": \"The external operation publishes only the reviewed and authorized product identity with truthful authentication and provenance.\"\n    },\n    \"why\": {\n      \"rationale\": \"An artifact check and a favorable assessment do not grant publication permission or permit an altered publication subject.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project release decision owners\",\n        \"Release maintainers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Immediately before and during each publication attempt.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The retained candidate, authorization record, supported publication provider, tag, registry, and asset destinations.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Treat an authorized release workflow start as permission for the selected source, version/channel, destinations and execution policy. Bind the subsequently prepared candidate to that start and qualify its actual bytes. Recheck binding, evidence, public state and runtime authority before writes; publish retained packages without rebuilding. Failed checks stop execution. Material source, configuration or destination changes require a new authorized start and qualification; retries reuse the original candidate. No second routine approval is required.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Existing approved publication paths only. General manual fallback prose cannot override a profile requiring trusted publication; bounded token/2FA fallback needs its specific authority and does not waive checks. Serializing a workflow is neither a distributed publication lock nor permission to retry an uncertain write. Credentials and private environment data must not enter artifacts, evidence, or diagnostics.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The actual tag, registry, and asset operations match the authorized source, artifact identities, version/channel, destinations, and path; mismatched or changed inputs stop rather than being silently substituted.\",\n    \"Publication uses retained checked artifact bytes, and a conflicting existing tag or public artifact blocks without overwrite or an independent unguarded fallback publisher.\",\n    \"Authorization alone does not waive stale, incomplete, or failed required evidence, and passing checks do not create authorization.\",\n    \"The selected authentication and provenance policy is preserved; secret-bearing package contents or diagnostics block the unsafe operation.\",\n    \"Duplicate events do not confer fresh authority or duplicate writes; uncertain external outcomes are inspected under the recovery requirement.\",\n    \"An eligible authorized workflow start permits publication after qualification without a later human approval; a local check, PR validation run or unsupported trigger cannot grant that authority.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-069\",\n    \"FUNC-070\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-11\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. An artifact check and a favorable assessment do not grant publication permission or permit an altered publication subject. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-12\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. An artifact check and a favorable assessment do not grant publication permission or permit an altered publication subject. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-17\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. An artifact check and a favorable assessment do not grant publication permission or permit an altered publication subject. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-23\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. An artifact check and a favorable assessment do not grant publication permission or permit an altered publication subject. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"user-request:2026-10-04-release-workflow-start-authority\",\n      \"basis\": \"User selects initiation of the authorized release workflow as publication authority, with no later routine approval. Refines the existing IR-010 need; exact candidate qualification, bounded authority and recovery remain. Design change only; running workflow adoption requires implementation.\"\n    }\n  ]\n}\n","identity":"sha256:6e440519fe01ba815347443b2314e4d66adcec4606ba8a253aea0c305cb238c1","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-070-publish-only-the-authorized-immutable-candidate/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-070","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-070 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:3fccdb9c28d3ce5be453e76118f715fd5338bb6839617b50e158072d5e3def62","path":"design/system/functions/FUNC-069-seal-a-qualified-immutable-release-candidate.json"},{"identity":"sha256:417e1053c8fcafcdcf5ddf7a4f8a71958763c3215ff64419e675bee117d5cfe3","path":"design/system/functions/FUNC-070-publish-an-authorized-retained-candidate.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:7ee2dc137891c10f2c8c8d9d224e7ca153c3a805fea355fd0beb84d1e272321e","path":"design/requirements/scenarios/SCN-066-start-an-authorized-release-and-publish-the-qualified-packages.json"},{"identity":"sha256:68c4cf9511e65a1900ab7afbaa717e61092c22dbfe6ef612fe50af1560d504ba","path":"design/requirements/scenarios/SCN-068-resolve-an-uncertain-publication-before-retrying.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qualified-rigorloop-releases-with-observed-outcomes.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-015 retained owner contract already define all concrete lower obligations for SR-071; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"Release observes actual registry version/channel/integrity and hosted assets, then required fresh public CLI and target-install smoke; local candidate checks cannot supply these public facts.","number":1,"state":"covered"},{"explanation":"Version-scoped evidence in the configured durable ref binds initiating authority, candidate, checks and actual provider outcomes. Compare-and-swap updates preserve other attempts and privacy; expiring logs are supplementary.","number":2,"state":"covered"},{"explanation":"Closeout keeps unavailable required evidence pending and preserves failed-after-publication status and known effects. Observation gaps cannot become generated passes or erase prior public facts.","number":3,"state":"covered"},{"explanation":"Rerunnable closeout reads the same sealed candidate and public observations without modifying or republishing it. Reporting loss retains an observation bundle and incomplete closeout until reconciled.","number":4,"state":"covered"},{"explanation":"REL-SR-18 and FUNC-071 treat measured duration as diagnostic, report missing telemetry without fabricated values and reject malformed closed representations without conflating timing with correctness.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-071\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Record observed public release outcomes and bounded closeout\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall establish release closeout from actual public artifact, registry, and required fresh installed-product observations, preserving version-scoped evidence and explicit unavailable, failed, or incomplete outcomes without modifying the approved candidate.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Local success or generated expectations can be recorded as proof that users can obtain the intended public version.\",\n      \"desired_outcome\": \"Maintainers and users can inspect which exact version is publicly available, what was observed, and what remains unresolved.\"\n    },\n    \"why\": {\n      \"rationale\": \"Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Release maintainers\",\n        \"Reviewers assessing public availability\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"After an attempted publication and when closeout is retried.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Public registry and release assets, fresh consumer observations, and existing version-scoped release evidence.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Observe the public version/channel/integrity, hosted assets, and required fresh public version and target-install smoke. Preserve the source, candidate, approval, publication event, observations, and failure/follow-up basis in existing release evidence, distinct from generated intent. Make closeout rerunnable and leave pending evidence unchanged when required public information is unavailable apart from requested logs. Collect available duration diagnostics automatically without inventing times or using their absence as publication failure.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Existing Release evidence fields, routing, public-smoke representations, and freshness policy. Actual required identity and outcome evidence remains mandatory. Timing is diagnostic: malformed emitted timing is a format defect, while missing timing alone does not block an otherwise supported outcome. No registry observation is performed by authoring this requirement.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Closeout observes the intended public version/channel and exposed integrity, actual public assets, and required fresh installed CLI/target behavior before marking those results passed; local build results alone are insufficient.\",\n    \"Durable version-scoped evidence identifies exact source/candidate/approval, required checks, publication event/path, public observations, and recovery/follow-up without credentials or private context.\",\n    \"Unavailable required public evidence stays explicit and pending records are not turned into passes; failed public verification remains failed-after-publication until an applicable disposition.\",\n    \"Rerunning closeout does not alter sealed candidate inputs or publish again; missing reporting after a public write remains incomplete closeout.\",\n    \"Available phase durations are collected as observations; unavailable timing is reported honestly and cannot alone invalidate publication, while malformed emitted closed values remain a diagnostic error.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-071\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-10\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-13\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-14\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-17\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-18\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-19\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-24\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Public delivery requires observations at the public boundary and durable attribution separate from immutable candidate inputs. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:feea5c5f17383ef7a32a495b31412e21bdeb80fc5e236f877cf0b7d05609425f","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-071-record-observed-public-release-outcomes-and-bounded-closeout/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-071","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-071 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:e70013a4f8fb30f56ecee6c674167b9fb4345ed8990094bd7c589fe8e24c3c26","path":"design/system/functions/FUNC-071-observe-public-release-and-record-closeout.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:7ee2dc137891c10f2c8c8d9d224e7ca153c3a805fea355fd0beb84d1e272321e","path":"design/requirements/scenarios/SCN-066-start-an-authorized-release-and-publish-the-qualified-packages.json"},{"identity":"sha256:8831d7a437764db2dbe2f190c35a5f6f2d57f03784f10b7c039d9c290a6ac695","path":"design/requirements/scenarios/SCN-067-establish-the-observed-public-outcome-of-a-release-attempt.json"},{"identity":"sha256:68c4cf9511e65a1900ab7afbaa717e61092c22dbfe6ef612fe50af1560d504ba","path":"design/requirements/scenarios/SCN-068-resolve-an-uncertain-publication-before-retrying.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qualified-rigorloop-releases-with-observed-outcomes.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-015 retained owner contract already define all concrete lower obligations for SR-072; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"Release's recovery flow distinguishes no write from uncertain response and inspects each authoritative destination before deciding any missing work; serialization alone cannot justify retry.","number":1,"state":"covered"},{"explanation":"Failed smoke or reporting after a public write remains failed-after-publication with original candidate/public identity and actual known effects, never rewritten as prepublication failure.","number":2,"state":"covered"},{"explanation":"The contract preserves immutable published versions and failed evidence; fix-forward, channel correction or deprecation require their applicable owner authority and separately recorded outcomes.","number":3,"state":"covered"},{"explanation":"Exceptional deferral records name owner, rationale, risk, validation impact and follow-up while retaining all nondeferable identity, privacy, public verification and recovery duties. Ordinary retries cannot create an exception.","number":4,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-072\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Recover publication failures without overwriting public history\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall distinguish failure before, during uncertain, and after publication; inspect authoritative external state before retrying an uncertain write; and preserve the original published identities and failed evidence while applying only an authorized recovery disposition.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Blind retries or a fabricated rollback can duplicate publication, overwrite history, or hide a partial external success.\",\n      \"desired_outcome\": \"Maintainers know what happened and can choose a supported fix-forward, channel correction, deprecation, or follow-up without erasing the original outcome.\"\n    },\n    \"why\": {\n      \"rationale\": \"A failed or uncertain publication is an engineering state requiring evidence and authority, not permission to repeat external mutations.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Release maintainers\",\n        \"Decision owners approving exceptional recovery\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When publication or post-publication observation fails or has an uncertain outcome.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"External registry/tag/asset state, retained candidate identity, and durable failure/recovery evidence.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Record known effects and the before/during/after-publication phase. Inspect public state before a possible retry, preserve immutable versions, and use only supported authorized correction or deprecation paths. Keep failed evidence and unrelated state intact. Exceptional deferrals remain owned and open until completed or explicitly dispositioned; unavailable observations do not justify a retry or false success.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Existing release recovery and exception policy. No version overwrite, silent erasure, automatic rollback of public history, new staged-publication route, or guarantee that all remote writes are reversible is introduced.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A prepublication failure records no successful publish; an uncertain write records uncertainty and inspects authoritative external state before any retry.\",\n    \"A post-publication failure remains identified as such with public identity and known effects retained; it is not reclassified as no publication.\",\n    \"Recovery never overwrites a published version or erases failed evidence and records any authorized fix-forward, channel correction, deprecation, or follow-up outcome.\",\n    \"Exceptional deferrals retain their complete owner/risk/follow-up basis and do not waive nondeferable evidence, privacy, identity, public verification, or recovery obligations.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-072\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-14\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. A failed or uncertain publication is an engineering state requiring evidence and authority, not permission to repeat external mutations. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-15\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. A failed or uncertain publication is an engineering state requiring evidence and authority, not permission to repeat external mutations. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-16\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. A failed or uncertain publication is an engineering state requiring evidence and authority, not permission to repeat external mutations. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-23\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. A failed or uncertain publication is an engineering state requiring evidence and authority, not permission to repeat external mutations. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-24\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. A failed or uncertain publication is an engineering state requiring evidence and authority, not permission to repeat external mutations. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    }\n  ]\n}\n","identity":"sha256:1381d02f3403f0a71e31f135324ac42047529ef024397d5b25a2a5c80b93d653","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-072-recover-publication-failures-without-overwriting-public-history/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-072","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 4 canonical SR-072 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:327dc84e155b9d6798372a24d56aeff638d573fd0a784c7f92c8a933a0e617b1","path":"design/system/functions/FUNC-072-determine-publication-recovery-disposition.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:7ee2dc137891c10f2c8c8d9d224e7ca153c3a805fea355fd0beb84d1e272321e","path":"design/requirements/scenarios/SCN-066-start-an-authorized-release-and-publish-the-qualified-packages.json"},{"identity":"sha256:8831d7a437764db2dbe2f190c35a5f6f2d57f03784f10b7c039d9c290a6ac695","path":"design/requirements/scenarios/SCN-067-establish-the-observed-public-outcome-of-a-release-attempt.json"},{"identity":"sha256:68c4cf9511e65a1900ab7afbaa717e61092c22dbfe6ef612fe50af1560d504ba","path":"design/requirements/scenarios/SCN-068-resolve-an-uncertain-publication-before-retrying.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qualified-rigorloop-releases-with-observed-outcomes.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"FUNC allocations and MOD-015 retained owner contract already define all concrete lower obligations for SR-073; the MOD-019 allocation table identifies the applicable clauses and collaborating boundaries. No distinct missing responsibility warrants a duplicate AR. This is a reviewed no-additional-AR disposition, not absence of allocation.","state":"not-required"},"ar_children":[],"criteria":[{"explanation":"FUNC-073 composes automatic authoritative-input resolution, deterministic preparation, qualification, retained-byte publication and durable observation from one eligible start, with no manual hash transfer or second approval.","number":1,"state":"covered"},{"explanation":"Preparation and execution are separate jobs; failed/incomplete required checks prevent the dependent publisher even though initiation was authorized.","number":2,"state":"covered"},{"explanation":"The workflow manifest binds exact event source, allowed prepared diff, package/configuration/destinations and retained output to that run, avoiding mutable-branch replacement on execution or retry.","number":3,"state":"covered"},{"explanation":"The owner explicitly labels ordinary CI candidates nonpublishable and rejects local/PR/unrelated events at authority validation; assessment success cannot grant a release start.","number":4,"state":"covered"},{"explanation":"Retry retrieves original retained inputs and inspects existing public stages. Changed material scope requires new initiation/qualification; missing originals, conflicts or unknown state stop affected work.","number":5,"state":"covered"},{"explanation":"Version ambiguity, unsupported exceptional handling, credentials/protection mismatch and unavailable reporting are explicit owner-intervention outcomes, not invented inputs or a silent alternate workflow.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-073\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Coordinate routine releases from an authorized workflow start\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall coordinate preparation, qualification, publication, public verification and reporting for eligible reviewed release input from one authorized workflow start, without a subsequent routine human approval, while stopping for failed checks, unsupported decisions or unavailable prerequisites.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A nominally automated release can still require copying identities across files or manually coordinating every helper and result.\",\n      \"desired_outcome\": \"A maintainer initiates the authorized release operation and receives its actual result without a second confirmation or manual stage coordination.\"\n    },\n    \"why\": {\n      \"rationale\": \"Existing routine coordination promises remove repeated manual bookkeeping without removing engineering decisions, evidence, or publication authority.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Maintainers conducting supported routine releases\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"For a release eligible under the existing adopted routine automation path.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The bounded release coordinator and its existing preparation, validation, publication, observation, and reporting owners.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Bind release authority to the initiating source, supported configuration and execution path. Derive profiles, notes and evidence from reviewed inputs, qualify and retain the resulting packages, then publish and observe them automatically. Stop on failed checks or unsupported decisions; never replace a candidate during a retry or interpret a passing local check as authority.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Supported routine releases only. No new general workflow engine, public CLI command or optional approval mode. Credentials and source protection remain setup prerequisites. A future additional approval gate requires a separate requirement decision.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"An eligible authorized workflow start progresses through qualification to publication and reporting without a second human approval or manual profile/hash entry.\",\n    \"Failed or incomplete qualification prevents publication even though the workflow start was authorized.\",\n    \"Source, version, configuration and destinations are bound to initiation; the exact resulting checked packages are retained for publication and retry.\",\n    \"A local check, PR validation run or unrelated workflow start grants no publication authority.\",\n    \"Retries inspect public state and reuse the original candidate; changed material scope requires a new authorized start and qualification, not silent substitution.\",\n    \"Ambiguous version intent, unsupported special handling or unavailable prerequisites produces a precise intervention request.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-073\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-22\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Existing routine coordination promises remove repeated manual bookkeeping without removing engineering decisions, evidence, or publication authority. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-23\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Existing routine coordination promises remove repeated manual bookkeeping without removing engineering decisions, evidence, or publication authority. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md#REL-SR-24\",\n      \"basis\": \"IR-010 draft decomposition preserves this source obligation at the published-product boundary. Existing routine coordination promises remove repeated manual bookkeeping without removing engineering decisions, evidence, or publication authority. Detailed source formats and adopted-population limits retain their existing owner; this record does not migrate runtime behavior or establish publication evidence.\"\n    },\n    {\n      \"source\": \"SRC-PUBLISHED-RELEASE\",\n      \"locator\": \"user-request:2026-10-04-release-workflow-start-authority\",\n      \"basis\": \"User selects initiation of the authorized release workflow as publication authority, with no later routine approval. Refines the existing IR-010 need; exact candidate qualification, bounded authority and recovery remain. Design change only; running workflow adoption requires implementation.\"\n    }\n  ]\n}\n","identity":"sha256:051752f9dc910379863b7f6ca4f961305f2706c6210f366f302f087dbe3ace60","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-073-coordinate-routine-releases-from-an-authorized-workflow-start/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-073","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-073 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:9315f23b8bd91f9e5f2f9b5e74e112f14510451350703c19aba20be0ec30fac5","path":"design/system/functions/FUNC-073-coordinate-an-eligible-routine-release.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:75837ee278b87c2ae6ad15bb6a0b2e30a100ba76ff827ef7f3a37193da07c940","path":"design/requirements/scenarios/SCN-065-prepare-and-qualify-a-concrete-release-candidate.json"},{"identity":"sha256:7ee2dc137891c10f2c8c8d9d224e7ca153c3a805fea355fd0beb84d1e272321e","path":"design/requirements/scenarios/SCN-066-start-an-authorized-release-and-publish-the-qualified-packages.json"},{"identity":"sha256:1e461b49fafc57507ace48198b9f16f0d818b3f96e0e91341d3f0e35963f6f67","path":"design/system/features/FEAT-020-publish-qualified-rigorloop-releases-with-observed-outcomes.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-052"],"criteria":[{"explanation":"MOD-011 backup manifest binds project, captured incarnation/revision, backup/record/schema versions, complete selected Change/account/reference closure, required attachment membership and explicit external/excluded scope.","number":1,"state":"covered"},{"explanation":"The maintained admission fence drains ordinary database and payload leases, then holds exclusion across snapshot and artifact capture; known noncooperating writers require participant-established source quiescence or withheld capture.","number":2,"state":"covered"},{"explanation":"Required payload closure, file-kind/path containment, size/hash integrity and database/reference validation precede complete publication; missing/unreadable/corrupt required members identify gaps and withhold the marker/complete result.","number":3,"state":"covered"},{"explanation":"Owned staging beside an absent output and no replacement of existing backups preserve source/valid backups on interruption, cancellation or capacity failure.","number":4,"state":"covered"},{"explanation":"Selected nonempty Change sets retain each selected Change’s current closure, report excluded Changes/external model references, and do not reconstruct discarded runs, later writes, unselected files or unsaved work.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-074\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Create coherent recoverable operational backups\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall create an identifiable backup of the explicitly selected operational records and required retained evidence artifacts from a coherent project state, declaring its project association, supported interpretation, scope and integrity before reporting it complete.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Copying only records, or capturing changing records and artifacts at different states, can produce a backup that cannot restore its claimed scope.\",\n      \"desired_outcome\": \"A participant can distinguish a complete recoverable capture from an incomplete attempt and know which work it preserves.\"\n    },\n    \"why\": {\n      \"rationale\": \"The refined IR-003 need requires this independently assessable outcome while preserving historical meaning and current work.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized engineers\",\n        \"Engineering agents acting for the user\",\n        \"Reviewers relying on retained evidence\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a participant requests a backup while operational work may continue.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Selected project operational records, retained evidence and explicitly selected local source or destination scope.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit scope and state identities, preserve original meaning and unrelated work, and report complete, unavailable, conflicting or failed outcomes according to the criteria below. Physical storage, commands and allocation remain downstream decisions.\"\n    },\n    \"how_much\": {\n      \"scope\": \"One selected project and declared finite operational scope; no hosted storage, automatic history merging, recovery of destroyed copies, or numerical performance/recovery guarantee. Current-model understanding remains owned by SR-004/005.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"For a selected project state containing Changes, findings and retained artifacts, a complete backup identifies the captured state, project, interpretation version, included records and artifacts, and declared exclusions; all included references resolve within the retained scope or are explicitly external.\",\n    \"When recording continues during capture, the backup represents one coherent declared state or reports that capture could not complete; it never combines incompatible record and artifact versions as a complete backup.\",\n    \"If a required artifact is missing, unreadable or fails its recorded integrity check, backup creation reports the affected scope and does not declare a complete backup.\",\n    \"Interruption, cancellation or insufficient destination capacity leaves existing valid backups and source work unchanged and identifies any incomplete output as unusable for complete restoration.\",\n    \"An explicitly selected narrower scope identifies exclusions and cannot claim to preserve excluded evidence, post-capture work or unsaved content.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"A successful storage operation grants no engineering approval or action authority.\"\n  ],\n  \"confirms\": [\n    \"FUNC-074\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-074\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:c5fe6bbdc7d362a1aab7936faeaa1f2251291b63769163098d1dba8450fbf3bd","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-074-create-coherent-recoverable-operational-backups/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-074","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-074 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:a6c1436112bdc5b688d59af332dc3d28b56c2792d71836db7e460d6b2ada30af","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-074-create-coherent-recoverable-operational-backups/AR-052-capture-coherent-selected-operational-backups.json"},{"identity":"sha256:a8478d902b9a1dc890a29e0597d5a8b9a31bb1cbb5b29e3a9b1c1ac63efa8729","path":"design/system/functions/FUNC-074-create-a-coherent-operational-backup.json"},{"identity":"sha256:a11804067cf82110efab5c9aad3fbbf41700a3218f6408e9792276e17f233417","path":"design/system/features/FEAT-021-preserve-and-restore-operational-history.json"},{"identity":"sha256:bfe33b3a01fa5bf54a5b8e9ea55f9b01af0d2b439266a2649043d6d87d4ada5a","path":"design/requirements/scenarios/SCN-070-create-a-recoverable-operational-backup.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-053"],"criteria":[{"explanation":"The self-contained validated backup supplies original records, dispositions, subjects/revisions, provenance and managed payloads without the source store.","number":1,"state":"covered"},{"explanation":"Manifest/completion/project/version/content validation rejects wrong association, unsupported interpretation, corrupt members and missing required payloads before activation; unrelated destination and original backup remain untouched.","number":2,"state":"covered"},{"explanation":"Restoration preserves original engineering judgments and assessed subjects, while a new store incarnation invalidates old mutation tokens.","number":3,"state":"covered"},{"explanation":"Empty destination requires absent expectation and replacement disabled; occupied/unavailable destination requires separately authorized replacement and fresh exact observation, rechecked under exclusion.","number":4,"state":"covered"},{"explanation":"Durable maintenance manifest and fence span path installation/reopening/validation until activated marker.","number":5,"state":"covered"},{"explanation":"Missing/unusable backup or corrupt/unavailable store yields explicit unavailable/recovery-needed scope.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-075\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Restore operational history without changing its original meaning\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall restore an explicitly selected compatible operational backup into an authorized destination only after validating its project association, integrity, interpretation and required artifact coverage, preserving record identities, relationships and original assessment meaning and distinguishing complete restoration from failure.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Loss of a local operational store can erase resumption context; an apparently successful restore can silently omit evidence or renew old judgments.\",\n      \"desired_outcome\": \"An authorized participant can recover the declared retained work and identify every limitation before relying on it.\"\n    },\n    \"why\": {\n      \"rationale\": \"The refined IR-003 need requires this independently assessable outcome while preserving historical meaning and current work.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized engineers\",\n        \"Engineering agents acting for the user\",\n        \"Reviewers relying on retained evidence\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When restoring retained operational work, including after loss of the original store.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Selected project operational records, retained evidence and explicitly selected local source or destination scope.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit scope and state identities, preserve original meaning and unrelated work, and report complete, unavailable, conflicting or failed outcomes according to the criteria below. Physical storage, commands and allocation remain downstream decisions.\"\n    },\n    \"how_much\": {\n      \"scope\": \"One selected project and declared finite operational scope; no hosted storage, automatic history merging, recovery of destroyed copies, or numerical performance/recovery guarantee. Current-model understanding remains owned by SR-004/005.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"With the original store unavailable and a valid complete backup accessible, restore reproduces the selected records, finding dispositions, subjects and revisions, decisions, provenance and required artifact content in the declared project scope.\",\n    \"Wrong-project input, unsupported interpretation, corrupted content or missing required artifacts is rejected before destination activation; source backup and unrelated destination content remain unchanged.\",\n    \"Restored reviews and verification results retain their original subject identities and applicability; neither restoration nor a different current engineering revision renews approval or evidence freshness.\",\n    \"An occupied or changed destination causes an explicit conflict unless a separately authorized safe replacement is supported; restoration never silently merges divergent histories or overwrites newer work.\",\n    \"An interrupted restoration exposes no partially restored state as complete or ready for resumption; retry identifies the actual destination state and preserves existing usable content.\",\n    \"When no usable backup exists, restoration reports unavailable and does not initialize an empty history as successful recovery.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"A successful storage operation grants no engineering approval or action authority.\"\n  ],\n  \"confirms\": [\n    \"FUNC-075\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-075\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:44126953b43252bdb28cf64fdbab87e77da936c3609cc7a79cbbec587a46761b","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-075-restore-operational-history-without-changing-its-original-meaning/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-075","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-075 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:a06dd4ae91625654d2b1b8fd550b84ab711de41a4b510c9ab4a1ffd6788609a3","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-075-restore-operational-history-without-changing-its-original-meaning/AR-053-restore-only-validated-associated-operational-scope.json"},{"identity":"sha256:3c4b1b0f78d2474332d2788d3843e962524ed1d6a510db4b84f2ec032ddbdcba","path":"design/system/functions/FUNC-075-validate-and-restore-retained-operational-work.json"},{"identity":"sha256:a11804067cf82110efab5c9aad3fbbf41700a3218f6408e9792276e17f233417","path":"design/system/features/FEAT-021-preserve-and-restore-operational-history.json"},{"identity":"sha256:734ea5e6bb2c7ba547e1fdea4299ce0b4cdf32939ee32a95bfa1374955809238","path":"design/requirements/scenarios/SCN-071-restore-operational-history-after-local-store-loss.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-054"],"criteria":[{"explanation":"Sender backup and receiver preview/read expose exact project, captured state, selected records/artifacts and exclusions before activation.","number":1,"state":"covered"},{"explanation":"Explicit same-project configuration, complete transported backup and absent expectation with replacement disabled compose AR-052 capture and AR-053 restoration into an empty destination; no separate transfer operation is invented.","number":2,"state":"covered"},{"explanation":"Different project, occupied/divergent history or conflicting reused identities reject transfer without changing either side.","number":3,"state":"covered"},{"explanation":"Incoming selected scope/exclusions are visible before and after transfer and bound completeness.","number":4,"state":"covered"},{"explanation":"Copying the immutable backup leaves the source usable; receiver maintenance changes only admitted operational paths.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-076\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Transfer retained operational work with explicit project association\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall transfer an explicitly selected retained operational scope to another local environment with its project association, record and subject identities, provenance and required artifacts intact, validating the destination and reporting exclusions or conflicts without silently merging histories.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A copied engineering checkout does not contain private work history, and importing history into the wrong project can create false provenance.\",\n      \"desired_outcome\": \"Another local environment can inspect and resume the selected retained work with its original meaning and explicit limits.\"\n    },\n    \"why\": {\n      \"rationale\": \"The refined IR-003 need requires this independently assessable outcome while preserving historical meaning and current work.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized engineers\",\n        \"Engineering agents acting for the user\",\n        \"Reviewers relying on retained evidence\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a participant transfers recorded work to a second local environment.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Selected project operational records, retained evidence and explicitly selected local source or destination scope.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit scope and state identities, preserve original meaning and unrelated work, and report complete, unavailable, conflicting or failed outcomes according to the criteria below. Physical storage, commands and allocation remain downstream decisions.\"\n    },\n    \"how_much\": {\n      \"scope\": \"One selected project and declared finite operational scope; no hosted storage, automatic history merging, recovery of destroyed copies, or numerical performance/recovery guarantee. Current-model understanding remains owned by SR-004/005.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Transfer declares source project, retained scope, included artifacts and state identity; the receiving environment can inspect those facts before activation.\",\n    \"A matching project in an empty authorized destination receives the selected scope with the same identities and provenance through the backup/restoration integrity obligations of SR-074/075.\",\n    \"A different project identity, divergent existing history or reused record identity with different content causes a conflict and leaves both histories intact; project-name similarity does not establish identity.\",\n    \"Excluded records or artifacts are visible before reliance, and the receiving result does not claim completeness outside the declared transferable scope.\",\n    \"Transfer leaves the source usable, does not change engineering-model files, and does not silently refresh assessments to the destination checkout revision.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"A successful storage operation grants no engineering approval or action authority.\"\n  ],\n  \"confirms\": [\n    \"FUNC-075\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-076\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:120cc01f5b2ba455cf04d05f5738e7906253e35a3f678cf42f8a4a45d329db0e","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-076-transfer-retained-operational-work-with-explicit-project-association/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-076","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-076 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:215de102a96431d978388e38601896771ec8f987a1e5136fc235a98eeb256fb0","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-076-transfer-retained-operational-work-with-explicit-project-association/AR-054-transfer-selected-scope-through-explicit-project-association.json"},{"identity":"sha256:3c4b1b0f78d2474332d2788d3843e962524ed1d6a510db4b84f2ec032ddbdcba","path":"design/system/functions/FUNC-075-validate-and-restore-retained-operational-work.json"},{"identity":"sha256:a11804067cf82110efab5c9aad3fbbf41700a3218f6408e9792276e17f233417","path":"design/system/features/FEAT-021-preserve-and-restore-operational-history.json"},{"identity":"sha256:577e912d9b5114ef3ef0796499aa1e91d4bd3919b915fecf657c0da6953678ba","path":"design/requirements/scenarios/SCN-072-transfer-retained-work-to-another-local-environment.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-055"],"criteria":[{"explanation":"Qualified adapter mapping plus attributable per-record import/retain/block disposition covers the entire selected record/artifact inventory before publication.","number":1,"state":"covered"},{"explanation":"Mapped target preserves source identities/format/location/content, actor decisions, unresolved findings, relations and original assessed subjects.","number":2,"state":"covered"},{"explanation":"Unsupported history stays recoverable archival content only after active dependencies are resolved.","number":3,"state":"covered"},{"explanation":"Required originals package is published and verified before activation with exact bytes, paths, identities and required uncommitted material/artifacts.","number":4,"state":"covered"},{"explanation":"Legacy source owners establish and hold actual writer/payload quiescence through capture, final recheck and activation; destination fence alone is insufficient.","number":5,"state":"covered"},{"explanation":"One validated target becomes authoritative only after required source/consumer reconciliation; old writer remains excluded until retired from current use.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-077\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Migrate operational records with explicit preservation and disposition\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall migrate only explicitly supported operational source records into a selected replacement store with attributable source identities and a complete disposition of the selected scope, preserving meaning and required originals and preventing activation or retirement while unresolved dependencies would be lost.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A storage conversion can lose unsupported records, unresolved findings or exact evidence, or misrepresent old approvals as current.\",\n      \"desired_outcome\": \"Maintainers can account for every selected source and rely on one coherent operational destination without losing historical meaning.\"\n    },\n    \"why\": {\n      \"rationale\": \"The refined IR-003 need requires this independently assessable outcome while preserving historical meaning and current work.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized engineers\",\n        \"Engineering agents acting for the user\",\n        \"Reviewers relying on retained evidence\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When adopting a replacement operational storage representation.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Selected project operational records, retained evidence and explicitly selected local source or destination scope.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit scope and state identities, preserve original meaning and unrelated work, and report complete, unavailable, conflicting or failed outcomes according to the criteria below. Physical storage, commands and allocation remain downstream decisions.\"\n    },\n    \"how_much\": {\n      \"scope\": \"One selected project and declared finite operational scope; no hosted storage, automatic history merging, recovery of destroyed copies, or numerical performance/recovery guarantee. Current-model understanding remains owned by SR-004/005.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Before publication, migration identifies selected source content and identities and classifies each record as supported for import, retained archival evidence, or blocked pending disposition; counts alone do not establish semantic equivalence.\",\n    \"Imported records preserve stable identities, actor decisions, unresolved findings, relationships, original subject identities and assessment meaning; source format, original location and content identity remain attributable.\",\n    \"Unsupported historical formats remain archival and do not acquire runtime support or renewed approval; active work that depends on them blocks activation until a responsible disposition is recorded.\",\n    \"Required original bytes, uncommitted source content and required artifacts remain recoverable. Migrating records does not itself authorize source deletion; SR-024 governs retirement.\",\n    \"Changed source identity, interruption, conflicting destination content or an invalid final reference prevents partial activation and preserves sources and unrelated destination work. A retry cannot duplicate already imported identities or silently merge conflicts.\",\n    \"Activation identifies one authoritative operational destination and reconciles current readers and writers; no permanent dual-write or silent legacy fallback is established.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"A successful storage operation grants no engineering approval or action authority.\"\n  ],\n  \"confirms\": [\n    \"FUNC-076\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-077\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:f8aff524a22587d6aee52947a07847abb132c40bbc57852db2e96b04028fac95","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-077-migrate-operational-records-with-explicit-preservation-and-disposition/sr.json"},"limitations":["Design only; no implementation, executed verification or satisfaction. Delivery unchanged.","No maintenance/adoption execution or platform/source-adapter qualification. Fence controls cooperating writers only; source quiescence and consumer reconciliation precede activation.","Recovery needs intact retained scope or accessible backup outside failure boundary; no discarded/unsaved/unbacked-up/external-model recovery. Storage success does not renew authority or judgments."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-077","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-077 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:83a5da5a2332e5da113962fe2396642e09a5f0cf0040e50af2b70ec2823bb572","path":"schemas/targeted-recording-v2.schema.json"},{"identity":"sha256:aa678e0f86b857be5b57c30010f396852aa2755e7fc0d1f4572615b7b4d4dfc8","path":"schemas/rigorloop-records-v4.schema.json"},{"identity":"sha256:7fe3127e3ee2c61c5747f737988ec97fc5f97099d7adc3deff18e5596226254e","path":"design/requirements/IR-003-control-engineering-changes-and-recover-prior-states/SR-077-migrate-operational-records-with-explicit-preservation-and-disposition/AR-055-import-qualified-source-facts-with-preserved-originals.json"},{"identity":"sha256:f707b0a9a7397e67324a7f27c0bdb8fc3d4d7196c6bd60fcbb778803d00e1e82","path":"design/system/functions/FUNC-076-reconcile-and-migrate-selected-operational-records.json"},{"identity":"sha256:539b34dcfdb521197a5939b2b027e8c0338880dcf5363662092ec0b35082d24c","path":"design/system/features/FEAT-007-control-and-resume-engineering-changes.json"},{"identity":"sha256:8943ab95195de53c8582ec0c2ffcd86974d9d8f18575f21a182aa0f0780e294b","path":"design/requirements/scenarios/SCN-073-adopt-replacement-storage-for-retained-operational-work.json"}],"summary":"Design Covered; delivery unchanged."},{"actor":"requirements-design-review","allocation":{"explanation":"AR-086 assigns history state/selection to MOD-011; AR-087 assigns admission/presentation to MOD-010. Existing IF-003/004 preserve parent cooperation; no further AR is required.","state":"not-required"},"ar_children":["AR-086","AR-087"],"criteria":[{"explanation":"MOD-011 selects explicit project/namespace/stable-key associations or an exact recorded basis over the declared Change population. Each whole result unit preserves its Change, record, occurrence and original provenance; equal paths/names and unrelated records do not create matches.","number":1,"state":"covered"},{"explanation":"Literal supported finding/Verification filters intersect recorded values and explicit subject relationships. A multi-subject Review does not automatically associate every finding with every subject; missing associations remain coverage gaps.","number":2,"state":"covered"},{"explanation":"Captured coverage distinguishes supported retained no-match from absent, incompatible, unreadable, unmapped, compacted or partially retained material. Page exhaustion cannot erase these gaps or imply no work ever occurred.","number":3,"state":"covered"},{"explanation":"One read snapshot binds state, associations and facts. Authenticated continuation binds project, activation/generation, normalized selection/order/page bound and unique last tuple; changed state yields conflict with no page units. Atomic generations and fresh replacement activations prevent ABA/restoration token revival.","number":4,"state":"covered"},{"explanation":"Original occurrence path, state/content basis or explicit unavailable basis remains attached to the original assessment. Only an attributable recorded association can connect renamed/revised occurrences; lookup does not infer continuity from a path or retarget old judgments.","number":5,"state":"covered"},{"explanation":"Existing supported storage is acquired through qualified read-only access and maintenance exclusion. Conditions requiring writable initialization or recovery return unavailable. Lookup neither backfills associations nor initializes, repairs, migrates, modifies source/assessment or retains cursor state.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-078\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Query retained change history by selected engineering subject\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall return bounded explicitly selected retained Change history for a project-qualified engineering subject, with recorded relationships, original subject and assessment identities, declared selection and state scope, and accurate completeness or unavailability, without inferring engineering relevance or approval.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Per-Change reads alone do not let a participant identify recorded decisions and findings about the same subject across retained work.\",\n      \"desired_outcome\": \"Participants can inspect attributable cross-Change results without reading all history or mistaking partial retrieval for absence.\"\n    },\n    \"why\": {\n      \"rationale\": \"The refined IR-008 need requires this independently assessable outcome while preserving historical meaning and current work.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Project maintainers and authorized engineers\",\n        \"Engineering agents acting for the user\",\n        \"Reviewers relying on retained evidence\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When an actor requests retained Changes, decisions, findings or evidence related to an explicitly selected engineering subject.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"Selected project operational records, retained evidence and explicitly selected local source or destination scope.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Use explicit scope and state identities, preserve original meaning and unrelated work, and report complete, unavailable, conflicting or failed outcomes according to the criteria below. Physical storage, commands and allocation remain downstream decisions.\"\n    },\n    \"how_much\": {\n      \"scope\": \"One selected project and declared finite operational scope; no hosted storage, automatic history merging, recovery of destroyed copies, or numerical performance/recovery guarantee. Current-model understanding remains owned by SR-004/005.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Given retained Changes with explicit relationships to the selected subject and unrelated records, results include only matching records under the declared filters, each identifying its Change, original subject basis and provenance.\",\n    \"Filters for recorded finding disposition or verification outcome operate on recorded facts and do not infer current applicability, unresolved work or semantic relevance from prose.\",\n    \"An available supported history with no matches returns an empty complete selection; absent, unreadable, incompatible or partially retained history reports its distinct limitation and cannot claim no relevant work ever existed.\",\n    \"Bounded continuation binds the project, normalized selection, ordering and observed history state. If that state changes, continuation conflicts rather than silently omitting or duplicating results.\",\n    \"Historical subject paths or display names may differ while identity continues; the result preserves the recorded identity and revision instead of retargeting old assessments to the current definition.\",\n    \"A lookup performs no operational initialization, recovery, migration, source-model modification or assessment update.\"\n  ],\n  \"assumptions\": [\n    \"Required retained source material and supported interpretation information are accessible; failure of that premise is reported explicitly.\"\n  ],\n  \"constraints\": [\n    \"A successful storage operation grants no engineering approval or action authority.\"\n  ],\n  \"confirms\": [\n    \"FUNC-077\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-LOCAL-OPERATIONAL-ANALYSIS\",\n      \"locator\": \"SR-078\",\n      \"basis\": \"Draft derivation from the refined IRs and RR proposal; no approval, implementation or satisfaction claim.\"\n    }\n  ]\n}\n","identity":"sha256:7ebd9cd8729128c41367446a55b653064b9ccde5fa8cb917b61e96dad53b2190","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/sr.json"},"limitations":["Target Design only; no public command, schema/profile adoption, migration, executed query, implementation or verification is established. Existing v2/v4 ordinary queries remain unchanged.","Complete compatible writer/maintenance population, protected activation metadata and actually nonmutating read acquisition must be qualified before history capability advertisement.","Results expose explicit retained facts/associations and coverage limits; no exhaustive past, inferred identity/relevance, current approval, recovery of discarded data or runtime performance guarantee."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-078","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-078 criteria; separately proposed history Design.","state":"covered","subjects":[{"identity":"sha256:0f369ea622bb533f2d51e26efe1a11881d3671646f6e6be2b662af4c4afca819","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/history-selection.md"},{"identity":"sha256:57c186ae6288364f5f914b5d99615417207e404ac76bd9388515ee2bc85e10ca","path":"design/system/functions/FUNC-077-select-attributable-history-for-an-engineering-subject.json"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:a7ea6434133ae529b7dc4acd02a6375c4f0b98c23307063582f9d9d4c8011e8e","path":"design/architecture/modules/MOD-018-engineering-operations/module.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:d5bf5bf0990004d68c75a9cf5bdcfcc38a49b296deb02ad077575fcc871f85a3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/ir.json"},{"identity":"sha256:d6510422991181666250d097f795766408582e032f800016e02db2b1300f59e1","path":"design/system/features/FEAT-012-inspect-selected-engineering-work-through-command-line-queries.json"},{"identity":"sha256:1b09d668b36443dce465d605279296ff3c1c8b61f2c67ecf3fb4e2844cb8ef30","path":"design/requirements/scenarios/SCN-074-inspect-retained-change-history-for-an-engineering-subject.json"},{"identity":"sha256:637e3b1e7891ec3e759f1965e5f422eb0e4df907f5897397447dcd396242c166","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/AR-086-preserve-attributable-state-bound-subject-history.json"},{"identity":"sha256:7ce9338f55f45e6f0f8a349c703a76ea441fc53079478acb810039f985def4f3","path":"design/requirements/IR-008-operate-on-recorded-engineering-work-through-reliable-explicit-commands/SR-078-query-retained-change-history-by-selected-engineering-subject/AR-087-preserve-explicit-history-query-scope-and-outcomes.json"}],"summary":"Design Covered; runtime history capability remains unqualified."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-029, AR-030 allocate the required owner contributions without a new AR or duplicated authority.","state":"not-required"},"ar_children":["AR-029","AR-030"],"criteria":[{"explanation":"The requirement-analysis method retains attributable RR wording/source and separates a suggested technology from an actual required constraint without requiring another RR/proposal file.","number":1,"state":"covered"},{"explanation":"FUNC-053 and MOD-008 methods first compare existing owners and permit justified reuse as the complete proposed result, avoiding artificial edits or duplicate entities.","number":2,"state":"covered"},{"explanation":"Cross-need requests map to existing IR owners; identity-preserving refinement and justified distinct new needs follow canonical Requirement Analysis rather than implementation choices.","number":3,"state":"covered"},{"explanation":"Material exclusions/conflicts remain explicit with their responsible decision owner; source scope cannot be silently reduced to make reuse appear complete.","number":4,"state":"covered"},{"explanation":"The canonical method requires 5W2H, stakeholder Features/Scenarios and assessable SR criteria, while AR, Module and delivery decisions remain with later responsible design/planning activities.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-079\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Reconcile incoming requests with existing requirement owners\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall analyze each material part of an incoming request against the existing requirement model and record a justified reuse, refinement, creation or explicit unresolved disposition before proposing a requirement basis for review.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Incoming solution suggestions or proposal approvals can be mistaken for requirements, producing duplicate entities or hidden scope loss.\",\n      \"desired_outcome\": \"Reviewers can trace the requested outcomes to existing or proposed obligations and inspect every material exclusion or uncertainty.\"\n    },\n    \"why\": {\n      \"rationale\": \"The user-selected workflow must preserve traceability and independent judgment while assigning each engineering decision one owner and avoiding redundant approval cycles.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents\",\n        \"Independent reviewers and project decision owners\",\n        \"Maintainers of guidance, validation and recording tools\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When a request, proposal, issue or incident introduces or questions engineering needs, behavior or architecture.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The project-selected governed workflow and its scoped specialist activities, including portable isolated use where applicable.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the explicit ownership and dependency conditions in the criteria; record exact scope, decisions, exceptions and assessment basis without inferring approval from mechanics. Detailed Function, Module, Interface and storage realization belongs to subsequent design.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The selected requirement-first workflow within one Change and its affected dependencies. No new preliminary proposal gate, per-method approval, mandatory milestone approval or automatic external permission is introduced. Preparing successor definitions may precede their storage delivery; actual invocations retain their applicable current governance and recording requirements. This authoring or assessment obligation does not itself choose a storage technology. Workflow activation retains the compatible-recording and necessary-migration prerequisites owned by SR-083. Functional and architectural completeness are deliberately deferred to design; the Feature constraints express workflow conditions, not a completed behavior realization.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The original RR source and interpretation remain attributable without requiring a separate proposal or RR file; a technical suggestion is distinguished from an established required constraint.\",\n    \"If existing IRs and SRs cover the request under the same conditions, the proposed basis identifies them and explains reuse without manufacturing edits, new entities or a new IR.\",\n    \"A request spanning several needs maps to their existing owners. Refinement preserves identity where the same need continues; a new IR requires a distinct justified stakeholder need rather than a new implementation technology.\",\n    \"Material exclusions, unsupported portions, deferred decisions and conflicts remain visible with their responsible owner or decision need; the proposed basis cannot silently narrow the original request.\",\n    \"Proposed IR/SR changes include their applicable 5W2H analysis, supporting stakeholder Feature/Scenario analysis and assessable acceptance criteria. Architecture implications remain provisional; Requirement Analysis does not finalize Modules, Interfaces, AR allocation or implementation tasks.\"\n  ],\n  \"assumptions\": [\n    \"Existing governance and recording remain available until explicit coordinated adoption; target skill and CLI support is not assumed installed.\"\n  ],\n  \"constraints\": [\n    \"Draft authoring and structural validation do not establish independent review approval or activate the new workflow.\"\n  ],\n  \"constrains\": [\n    \"FEAT-016\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-079\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-079\",\n      \"basis\": \"Draft integrated design from the accepted requirement-first basis. This defines target responsibility and cooperation, not installed capability, design approval, runtime evidence or SQLite adoption.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-079 AC1–5; AR-029, AR-030\",\n      \"basis\": \"Proposed allocation composition: Canonical method selection/explanation supplies reuse and derivation rules; bounded specialist composition produces the attributable proposed basis and preserves unresolved scope. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-ADOPTION-DEPENDENCY-REFINEMENT\",\n      \"locator\": \"IR-009; SR-079–083; SCN-082\",\n      \"basis\": \"User-authorized scope refinement: compatible recording for selected work, historical import only when required by its dependencies, and blocked affected adoption when necessary migration is unavailable. Preserve identities, original judgments and separate portable authoring; no workflow activation or migration is performed.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-053\",\n    \"FUNC-032\",\n    \"FUNC-033\"\n  ]\n}\n","identity":"sha256:02947fd9d6cd22c0a949285f967e70bf0a7dd678650686a7a81aae7eca247852","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-079-reconcile-incoming-requests-with-existing-requirement-owners/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-079","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 5 canonical SR-079 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:aa83665c5155a32aa129ebb62e1179f03935efc4cb3b6a06613fe709deb02211","path":"design/system/functions/FUNC-053-guide-a-bounded-specialist-engineering-activity.json"},{"identity":"sha256:7616f27fa93749af2e127663bcfd04fef9579dff8d3ed0c5d00f63f872a245de","path":"design/system/functions/FUNC-032-select-canonical-guidance-for-an-authoring-activity.json"},{"identity":"sha256:92153a9115ae4d3b6e0184a95c89e6b3b6ade3f80793c097b715abbe4286c265","path":"design/system/functions/FUNC-033-explain-engineering-authoring-and-correction-steps.json"},{"identity":"sha256:2ec272e3096cdbb386b8df09cf75dd4e5a783232129f82782f4f4f8302f6c520","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-079-reconcile-incoming-requests-with-existing-requirement-owners/AR-029-guide-requirement-reuse-and-derivation.json"},{"identity":"sha256:ed56084ef2a88a485269589a825b609b4f74d5f357da4fd07263d22d884c7d86","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-079-reconcile-incoming-requests-with-existing-requirement-owners/AR-030-compose-an-attributable-proposed-requirement-basis.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:70a4616f23ca9fdf75a6dde55442266bdc7ffb1cd641dac6b3d14b588183eb71","path":"design/requirements/scenarios/SCN-075-reconcile-a-request-already-covered-by-existing-requirements.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-031, AR-032 allocate the required owner contributions without a new AR or duplicated authority.","state":"not-required"},"ar_children":["AR-031","AR-032"],"criteria":[{"explanation":"Requirement Review independently examines RR fidelity, owner reuse, exact requirement/supporting subjects, assessability and uncertainty; the author cannot claim independent approval of their own contribution.","number":1,"state":"covered"},{"explanation":"Both the method and MOD-012 workflow composition accept review of exact existing subjects plus a no-change rationale rather than demanding edited files.","number":2,"state":"covered"},{"explanation":"The first gate assesses sufficient requirements while Functions/ARs remain unfinished; later completeness belongs to integrated Design and does not retroactively invalidate sound requirements.","number":3,"state":"covered"},{"explanation":"The supplied judgment binds exact subjects, governing basis, provenance and limits through assurance preparation/recording; it enables only authorized Design reliance.","number":4,"state":"covered"},{"explanation":"Material subject changes require an applicability decision and affected review; old proposal approvals or successful recording cannot substitute for the current requirement judgment.","number":5,"state":"covered"},{"explanation":"Bounded feasibility may inform requirements, but remains an observation rather than approved detailed Design or implementation authorization.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-080\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Establish the reviewed requirement basis before dependent design\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall require independent Requirement Review of the proposed requirement basis as the first mandatory workflow approval, including justified reuse conclusions, and shall bind its judgment to the exact requested scope and assessed requirement and supporting analysis subjects.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A preliminary direction approval can be mistaken for accepted obligations, or a requirement gate can incorrectly demand design artifacts that it is meant to enable.\",\n      \"desired_outcome\": \"Accepted requirements can guide design without implying that the design, implementation or verification is complete.\"\n    },\n    \"why\": {\n      \"rationale\": \"The user-selected workflow must preserve traceability and independent judgment while assigning each engineering decision one owner and avoiding redundant approval cycles.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents\",\n        \"Independent reviewers and project decision owners\",\n        \"Maintainers of guidance, validation and recording tools\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"Before relying on a proposed requirement basis for dependent System or Architecture Design, and after material changes to that basis.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The project-selected governed workflow and its scoped specialist activities, including portable isolated use where applicable.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the explicit ownership and dependency conditions in the criteria; record exact scope, decisions, exceptions and assessment basis without inferring approval from mechanics. Detailed Function, Module, Interface and storage realization belongs to subsequent design.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The selected requirement-first workflow within one Change and its affected dependencies. No new preliminary proposal gate, per-method approval, mandatory milestone approval or automatic external permission is introduced. Preparing successor definitions may precede their storage delivery; actual invocations retain their applicable current governance and recording requirements. This authoring or assessment obligation does not itself choose a storage technology. Workflow activation retains the compatible-recording and necessary-migration prerequisites owned by SR-083. Functional and architectural completeness are deliberately deferred to design; the Feature constraints express workflow conditions, not a completed behavior realization.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Review assesses RR fidelity, existing-owner reuse, explicit scope, proposed IR/SR meaning, supporting Feature/Scenario coverage, assessability and material uncertainty; the author cannot independently approve the same subjects.\",\n    \"A no-change requirement conclusion receives review of its selected existing subjects and reuse rationale rather than being rejected for having no edited requirement files.\",\n    \"An otherwise sufficient requirement basis may be accepted while Functions, Module allocation and ARs remain unfinished. Their absence is reported as downstream work, not a requirement-validity failure.\",\n    \"Approval identifies the exact reviewed subjects and governing basis and permits reliance for design only; it does not imply design completeness, implementation authority, requirement satisfaction or permission for external actions.\",\n    \"Material requirement changes after approval require applicability reassessment and affected review before dependent reliance; an earlier proposal approval or successful save cannot substitute for this judgment.\",\n    \"Bounded feasibility investigation may inform the proposed basis before approval, but must not be presented as approved detailed design or authorized implementation.\"\n  ],\n  \"assumptions\": [\n    \"Existing governance and recording remain available until explicit coordinated adoption; target skill and CLI support is not assumed installed.\"\n  ],\n  \"constraints\": [\n    \"Draft authoring and structural validation do not establish independent review approval or activate the new workflow.\"\n  ],\n  \"constrains\": [\n    \"FEAT-016\",\n    \"FEAT-017\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-080\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-080\",\n      \"basis\": \"Draft integrated design from the accepted requirement-first basis. This defines target responsibility and cooperation, not installed capability, design approval, runtime evidence or SQLite adoption.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-080 AC1,2,4,5; AR-031, AR-032\",\n      \"basis\": \"Proposed allocation composition: Assurance preserves exact actor/subject/judgment scope; capability routing requires the applicable basis rather than a saved label or old Proposal review. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-080 AC3,6; AR-032 with AR-031\",\n      \"basis\": \"Proposed allocation composition: The routing boundary permits design from sufficient requirements without requiring completed Functions/ARs; feasibility remains bounded and cannot imply implementation authority. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-ADOPTION-DEPENDENCY-REFINEMENT\",\n      \"locator\": \"IR-009; SR-079–083; SCN-082\",\n      \"basis\": \"User-authorized scope refinement: compatible recording for selected work, historical import only when required by its dependencies, and blocked affected adoption when necessary migration is unavailable. Preserve identities, original judgments and separate portable authoring; no workflow activation or migration is performed.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-053\",\n    \"FUNC-054\",\n    \"FUNC-029\",\n    \"FUNC-030\",\n    \"FUNC-031\"\n  ]\n}\n","identity":"sha256:e49b224c096fe465471e511294eacff82bbeaa5e92d9d34948e15b02e025d1c5","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-080-establish-the-reviewed-requirement-basis-before-dependent-design/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-080","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 6 canonical SR-080 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:aa83665c5155a32aa129ebb62e1179f03935efc4cb3b6a06613fe709deb02211","path":"design/system/functions/FUNC-053-guide-a-bounded-specialist-engineering-activity.json"},{"identity":"sha256:72ed79db6e5aabe502b0d82ce6215409a69dfb1610502dcd458250607f97ba1a","path":"design/system/functions/FUNC-054-determine-an-applicable-engineering-handoff.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"},{"identity":"sha256:85db55d933a26a2b6840d630caab1172dc9c820486bfca845444ab3fdf81fc59","path":"design/system/functions/FUNC-030-expose-claim-criterion-coverage-and-contradictory-evidence.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"},{"identity":"sha256:03bd539cf1bcf3402fb03830a5fb7d809a57d9aa8af7ee7b8e535d64e6657415","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-080-establish-the-reviewed-requirement-basis-before-dependent-design/AR-031-preserve-exact-requirement-review-scope-and-basis.json"},{"identity":"sha256:76f3532f75698e7349cc880b00c817787addef8f6ad53f89ffcb05fa5686d585","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-080-establish-the-reviewed-requirement-basis-before-dependent-design/AR-032-route-design-from-an-applicable-requirement-basis.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:0e8b09dabe31b2558ddb289c2b3903cc1b6e158ffd56108ead22707ea57b8fd5","path":"design/requirements/scenarios/SCN-076-approve-a-requirement-basis-before-detailed-design-exists.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-033, AR-034 allocate the required owner contributions without a new AR or duplicated authority.","state":"not-required"},"ar_children":["AR-033","AR-034"],"criteria":[{"explanation":"Canonical methods and specialist entrypoints preserve requirement/stakeholder authorship separately from logical Functions and Feature/SR relationships.","number":1,"state":"covered"},{"explanation":"Architecture Allocation owns coherent Modules, Function allocation, Interfaces/exposure, state and realization; each justified AR has one SR parent and one Module, not a delivery-task substitute.","number":2,"state":"covered"},{"explanation":"System and Architecture Design can iterate, but an exposed new need returns to Requirement Analysis and affected review before dependent reliance.","number":3,"state":"covered"},{"explanation":"One integrated Design Review assesses the affected combined logical/architectural composition, including feasibility and ARs, rather than separate mandatory technique or 4+1 gates.","number":4,"state":"covered"},{"explanation":"Necessary missing behavior/allocation blocks Design completeness, not requirement validity. Quality constraints may reuse existing Functions and justified complete contracts without empty AR levels.","number":5,"state":"covered"},{"explanation":"Plan consumes accepted obligations and reviewed Design to allocate work/proof; an unassigned architectural responsibility is returned to its Design owner.","number":6,"state":"covered"},{"explanation":"5W2H, Scenario/Function/Interface analysis and views remain internal methods with distinct entity meaning; a diagram or method invocation cannot supply approval or satisfaction.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-081\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Preserve distinct authoring ownership and integrated design assessment\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall distinguish requirement authoring, logical System Design and Architecture Design responsibilities and require one integrated independent Design Review of their affected design composition against the accepted requirement basis before delivery planning relies on it.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Combined authoring contracts and per-technique approvals can duplicate authority, conceal missing behavior or allocations, and turn delivery tasks into substitutes for architectural obligations.\",\n      \"desired_outcome\": \"Participants can identify the responsible author and assess whether the combined design can satisfy accepted requirements.\"\n    },\n    \"why\": {\n      \"rationale\": \"The user-selected workflow must preserve traceability and independent judgment while assigning each engineering decision one owner and avoiding redundant approval cycles.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents\",\n        \"Independent reviewers and project decision owners\",\n        \"Maintainers of guidance, validation and recording tools\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During design development, integrated assessment, correction routing and handoff to delivery planning.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The project-selected governed workflow and its scoped specialist activities, including portable isolated use where applicable.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the explicit ownership and dependency conditions in the criteria; record exact scope, decisions, exceptions and assessment basis without inferring approval from mechanics. Detailed Function, Module, Interface and storage realization belongs to subsequent design.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The selected requirement-first workflow within one Change and its affected dependencies. No new preliminary proposal gate, per-method approval, mandatory milestone approval or automatic external permission is introduced. Preparing successor definitions may precede their storage delivery; actual invocations retain their applicable current governance and recording requirements. This authoring or assessment obligation does not itself choose a storage technology. Workflow activation retains the compatible-recording and necessary-migration prerequisites owned by SR-083. Functional and architectural completeness are deliberately deferred to design; the Feature constraints express workflow conditions, not a completed behavior realization.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Requirement Analysis owns IR/SR meaning and stakeholder Feature/Scenario intent. System Design owns logical Functions, their behavior and Feature/SR relationships; it does not silently redefine stakeholder intent.\",\n    \"Architecture Design owns accountable Module boundaries, Function allocation, Interfaces and exposure, state/data authority, material realization and AR derivation. Each AR remains a requirement beneath one SR with one accountable Module, not a delivery task or duplicate Module obligation.\",\n    \"System and Architecture Design may iterate. A newly discovered need or missing system obligation returns to Requirement Analysis and affected Requirement Review rather than being hidden in design or code.\",\n    \"One integrated Design Review assesses affected logical behavior, architectural allocation, Interfaces, ARs, material realization and cross-boundary feasibility against the exact accepted requirement basis. Separate mandatory System Design, architecture, AR or 4+1 approval gates are not introduced.\",\n    \"Missing Function or AR coverage blocks design-completeness claims where required, while previously accepted requirement validity remains distinct. One SR need not produce one Function, and a quality obligation may constrain existing behavior.\",\n    \"Planning consumes the accepted requirements and reviewed design and allocates delivery work and proof. A missing accountable architectural boundary returns to Architecture Design; a task assignment cannot substitute for an AR.\",\n    \"5W2H, Scenario Analysis, Functional Analysis, Architecture Allocation, Interface analysis and 4+1 views remain methods or tools inside their responsible activities. Views neither redefine black-box Scenarios nor establish approval or satisfaction.\"\n  ],\n  \"assumptions\": [\n    \"Existing governance and recording remain available until explicit coordinated adoption; target skill and CLI support is not assumed installed.\"\n  ],\n  \"constraints\": [\n    \"Draft authoring and structural validation do not establish independent review approval or activate the new workflow.\"\n  ],\n  \"constrains\": [\n    \"FEAT-016\",\n    \"FEAT-017\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-081\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-081\",\n      \"basis\": \"Draft integrated design from the accepted requirement-first basis. This defines target responsibility and cooperation, not installed capability, design approval, runtime evidence or SQLite adoption.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-081 AC1–3,5,7; AR-033, AR-034\",\n      \"basis\": \"Proposed allocation composition: Distinct canonical methods preserve ownership and design completeness; composition routes upstream gaps and combines affected outputs. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-081 AC4,6; AR-034\",\n      \"basis\": \"Proposed allocation composition: Integrated assessment is the single design reliance point before planning, which consumes architectural responsibility rather than inventing it. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-ADOPTION-DEPENDENCY-REFINEMENT\",\n      \"locator\": \"IR-009; SR-079–083; SCN-082\",\n      \"basis\": \"User-authorized scope refinement: compatible recording for selected work, historical import only when required by its dependencies, and blocked affected adoption when necessary migration is unavailable. Preserve identities, original judgments and separate portable authoring; no workflow activation or migration is performed.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-053\",\n    \"FUNC-054\",\n    \"FUNC-032\",\n    \"FUNC-033\"\n  ]\n}\n","identity":"sha256:7826faf5e602cafb5fa149f0ad5b6fa855635c0f594165fc8f976aa88a615f49","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-081-preserve-distinct-authoring-ownership-and-integrated-design-assessment/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-081","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 7 canonical SR-081 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:aa83665c5155a32aa129ebb62e1179f03935efc4cb3b6a06613fe709deb02211","path":"design/system/functions/FUNC-053-guide-a-bounded-specialist-engineering-activity.json"},{"identity":"sha256:72ed79db6e5aabe502b0d82ce6215409a69dfb1610502dcd458250607f97ba1a","path":"design/system/functions/FUNC-054-determine-an-applicable-engineering-handoff.json"},{"identity":"sha256:7616f27fa93749af2e127663bcfd04fef9579dff8d3ed0c5d00f63f872a245de","path":"design/system/functions/FUNC-032-select-canonical-guidance-for-an-authoring-activity.json"},{"identity":"sha256:92153a9115ae4d3b6e0184a95c89e6b3b6ade3f80793c097b715abbe4286c265","path":"design/system/functions/FUNC-033-explain-engineering-authoring-and-correction-steps.json"},{"identity":"sha256:c45222e41220bc77adefa93d87caac6d01d9930d24e9950ac36c03ebdd827f3c","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-081-preserve-distinct-authoring-ownership-and-integrated-design-assessment/AR-033-explain-distinct-requirement-and-design-authorship.json"},{"identity":"sha256:1e1b12b75f240ded3e1520a94aefcba4c215049429f42ddbc83eb9b12b140537","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-081-preserve-distinct-authoring-ownership-and-integrated-design-assessment/AR-034-compose-integrated-design-assessment-and-correction-handoffs.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:1f72dfaf51a009397a6f33aaceec7d28a6c0ce571a312e3165ae48266d2b6a42","path":"design/requirements/scenarios/SCN-077-assess-logical-and-architectural-design-as-one-integrated-basis.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-035, AR-036, AR-037 allocate the required owner contributions without a new AR or duplicated authority.","state":"not-required"},"ar_children":["AR-035","AR-036","AR-037"],"criteria":[{"explanation":"Work context keeps authorized milestone scope, checks and dependencies; completion of those facts permits the next eligible milestone without a review ID or clean-review label.","number":1,"state":"covered"},{"explanation":"Failed checks, uncovered authority, unresolved upstream decisions and material defects block affected continuation until owned correction or explicit valid disposition.","number":2,"state":"covered"},{"explanation":"Interim review is explicitly advisory yet retains actionable attributed findings; a clean advisory result never supplies whole-change approval or an automatic milestone gate.","number":3,"state":"covered"},{"explanation":"The governing whole-change method receives complete delivered scope, exact requirements/Design/delivery basis and current proof, including cross-milestone and noncode surfaces.","number":4,"state":"covered"},{"explanation":"Current assessments may replace superseded detail while preserving actionable open findings, original relied-on support and explicit disposition; corrections return for reassessment in the same gate.","number":5,"state":"covered"},{"explanation":"Assurance judges cumulative impact and complete current adequacy, reusing unchanged applicable support proportionately and broadening inspection when impact is uncertain.","number":6,"state":"covered"},{"explanation":"Distinct final Verify requires applicable whole-change approval and current evidence; tests, advisory feedback or the final milestone cannot replace it.","number":7,"state":"covered"},{"explanation":"Verify routes implementation and upstream defects to their owners and affected reviews; unchanged-subject collection failure permits scoped retry, while contradictory new evidence triggers applicability assessment.","number":8,"state":"covered"},{"explanation":"The parent postapproval table permits justified nonmaterial continuation with actual scope/impact reasoning, rejects edit-size/file-type inference and preserves reviewer judgment ownership.","number":9,"state":"covered"},{"explanation":"Isolated implementation ends at its authorized slice; no removal of milestone gates grants execution, merge, publication or external authority beyond the existing basis.","number":10,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-082\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Require one whole-change review gate after checked implementation\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall allow authorized implementation to proceed through checked milestones without mandatory milestone review approval, require one independent whole-change Code Review gate for the complete implementation scope before successful final Verify, and handle corrections and reassessments within that same gate without requiring a permanent attempt history.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Per-milestone approvals duplicate the final gate, while removing them without explicit completion and reassessment obligations can conceal defects or permit stale approval.\",\n      \"desired_outcome\": \"Implementation progresses in bounded checked work, receives early advice when useful and obtains applicable independent approval of the complete delivered scope before separate final verification.\"\n    },\n    \"why\": {\n      \"rationale\": \"The user-selected workflow must preserve traceability and independent judgment while assigning each engineering decision one owner and avoiding redundant approval cycles.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents\",\n        \"Independent reviewers and project decision owners\",\n        \"Maintainers of guidance, validation and recording tools\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"During implementation progress, optional advisory assessment, whole-change review, correction and final Verify.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The project-selected governed workflow and its scoped specialist activities, including portable isolated use where applicable.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the explicit ownership and dependency conditions in the criteria; record exact scope, decisions, exceptions and assessment basis without inferring approval from mechanics. Detailed Function, Module, Interface and storage realization belongs to subsequent design.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The selected requirement-first workflow within one Change and its affected dependencies. No new preliminary proposal gate, per-method approval, mandatory milestone approval or automatic external permission is introduced. Preparing successor definitions may precede their storage delivery; actual invocations retain their applicable current governance and recording requirements. This authoring or assessment obligation does not itself choose a storage technology. Workflow activation retains the compatible-recording and necessary-migration prerequisites owned by SR-083. Functional and architectural completeness are deliberately deferred to design; the Feature constraints express workflow conditions, not a completed behavior realization.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A milestone is complete only when its recorded implementation scope and required checks are complete. If another milestone is authorized and its dependencies are satisfied, it may proceed without reviewer assignment, a milestone review ID or a clean-review status.\",\n    \"Failed required checks, missing authority, an unresolved requirement or architectural decision, or a material safety issue blocks affected work. Known in-scope defects must be corrected or explicitly dispositioned under applicable authority before implementation is claimed complete.\",\n    \"An explicitly requested interim code review is advisory: its findings concern the inspected scope and cannot settle the whole-change gate, advance lifecycle approval or become an automatic milestone prerequisite. Material findings remain attributable and require responsible correction or disposition without duplicate dossiers.\",\n    \"Implementation completion supplies the complete delivered scope for independent whole-change assessment against accepted IR/SR, applicable ARs, reviewed System/Architecture Design, delivery intent and current evidence, including cross-milestone interactions and relevant code, tests, configuration, migrations, generated output, skills and documentation.\",\n    \"A changes-requested assessment keeps its actionable findings and basis until explicit disposition or reassessment. Owned corrections and relevant checks receive independent reassessment within the same whole-change gate. The current assessment may replace superseded detail without losing open obligations or falsely retargeting a judgment still relied upon.\",\n    \"Reassessment establishes adequate coverage of the complete current result, inspecting corrections and affected interactions and explicitly determining retained applicability. It need not reread unchanged files or rerun unaffected checks automatically; uncertain impact or broad changes may require broader assessment.\",\n    \"Final Verify requires applicable whole-change approval and current evidence and remains distinct from Code Review. A clean advisory review, passed tests or a single completed milestone cannot substitute. A one-milestone Change has one whole-change gate, not an additional milestone approval.\",\n    \"An implementation defect discovered during Verify returns to implementation and affected independent reassessment before renewed Verify; requirement/design defects return to their authoring and review owners. Evidence-collection failure without changed engineering subjects permits affected verification retry without automatic Code Review restart. New contradictory evidence requires approval-applicability assessment.\",\n    \"Operational bookkeeping, evidence retries and edits shown to have no material effect on assessed behavior, instructions, obligations or support can retain an approved whole-change Review with an explicit applicability disposition, without another Review attempt. Material changes require independent reassessment of affected subjects and interactions; uncertain impact remains unresolved until assessed. Route coordinates recorded handoffs but does not create reviewer judgments or infer harmlessness from edit size or file type.\",\n    \"An isolated request for one implementation slice ends at that authorized scope. Removal of milestone review gates grants no additional execution, merge, publication or other external-action authority.\"\n  ],\n  \"assumptions\": [\n    \"Existing governance and recording remain available until explicit coordinated adoption; target skill and CLI support is not assumed installed.\"\n  ],\n  \"constraints\": [\n    \"Draft authoring and structural validation do not establish independent review approval or activate the new workflow.\"\n  ],\n  \"constrains\": [\n    \"FEAT-016\",\n    \"FEAT-017\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-082\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-082\",\n      \"basis\": \"Draft integrated design from the accepted requirement-first basis. This defines target responsibility and cooperation, not installed capability, design approval, runtime evidence or SQLite adoption.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-082 AC1,2,10; AR-035, AR-037\",\n      \"basis\": \"Proposed allocation composition: Work context exposes checks, blockers and scope while coordination permits only authorized eligible continuation. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-082 AC3–9; AR-036, AR-037\",\n      \"basis\": \"Proposed allocation composition: Assurance preserves full-scope attempts and applicability; coordination distinguishes advice, the whole-change gate, correction ownership and final Verify. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-PROPORTIONATE-REVIEW\",\n      \"locator\": \"SR-082\",\n      \"basis\": \"User-directed refinement of review applicability after subsequent edits: preserve original judgments, allow justified harmless-change continuation and independently reassess material effects. Author-assessed design/requirement refinement only; no runtime adoption or independent approval is claimed.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-082\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    },\n    {\n      \"source\": \"SRC-ADOPTION-DEPENDENCY-REFINEMENT\",\n      \"locator\": \"IR-009; SR-079–083; SCN-082\",\n      \"basis\": \"User-authorized scope refinement: compatible recording for selected work, historical import only when required by its dependencies, and blocked affected adoption when necessary migration is unavailable. Preserve identities, original judgments and separate portable authoring; no workflow activation or migration is performed.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-025\",\n    \"FUNC-026\",\n    \"FUNC-029\",\n    \"FUNC-030\",\n    \"FUNC-031\",\n    \"FUNC-053\",\n    \"FUNC-054\"\n  ]\n}\n","identity":"sha256:b1f763a877947390ed6a24448c159dd370da5b341fbeca38e090291360c20a08","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-082-require-one-whole-change-review-gate-after-checked-implementation/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-082","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 10 canonical SR-082 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:b5bbfbf03874ea29120c3443bd5efc8160f8cbbf230286fde5316d5fee495ef1","path":"design/system/functions/FUNC-025-retain-and-retrieve-activity-specific-change-context.json"},{"identity":"sha256:e2d0fbfe210afa2888bbdd1061ab5a4b3783292b44a7ab374b73beaa3203d869","path":"design/system/functions/FUNC-026-determine-applicable-authority-before-governed-actions.json"},{"identity":"sha256:a52db28adb589ab258420815dfaccfc743876128145cd62404c5df7968eee51b","path":"design/system/functions/FUNC-029-assess-evidence-applicability-to-a-declared-claim.json"},{"identity":"sha256:85db55d933a26a2b6840d630caab1172dc9c820486bfca845444ab3fdf81fc59","path":"design/system/functions/FUNC-030-expose-claim-criterion-coverage-and-contradictory-evidence.json"},{"identity":"sha256:cdfb0de0bee02ac23889aec83011b1f10878f8f15f03afef1e50648b8b184381","path":"design/system/functions/FUNC-031-record-scoped-engineering-judgments-and-their-basis.json"},{"identity":"sha256:aa83665c5155a32aa129ebb62e1179f03935efc4cb3b6a06613fe709deb02211","path":"design/system/functions/FUNC-053-guide-a-bounded-specialist-engineering-activity.json"},{"identity":"sha256:72ed79db6e5aabe502b0d82ce6215409a69dfb1610502dcd458250607f97ba1a","path":"design/system/functions/FUNC-054-determine-an-applicable-engineering-handoff.json"},{"identity":"sha256:b3081a2f1fcdae4cf085da5588c8573e5e10a9936827c22d11455d2fb593f62c","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-082-require-one-whole-change-review-gate-after-checked-implementation/AR-035-retain-checked-work-progress-independently-of-review-approval.json"},{"identity":"sha256:7556595e9b9727f01d9dc27844d6bdc2a35ab5fac7a3c300a3b7baaaac3c0fbb","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-082-require-one-whole-change-review-gate-after-checked-implementation/AR-036-maintain-whole-change-review-standing-and-applicability.json"},{"identity":"sha256:59c1c7ea19e6b103c8fe13ad2cbd0267dadb5088e5507d6cadd63d4b4a47caad","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-082-require-one-whole-change-review-gate-after-checked-implementation/AR-037-coordinate-one-whole-change-gate-after-implementation.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:7d470899577acef11e8e9c0f817be868bbd4bee6e887107016dd1fee42ef3684","path":"design/requirements/scenarios/SCN-078-continue-authorized-implementation-after-a-checked-milestone.json"},{"identity":"sha256:a0a8d9afad839383f499dade6bd9418dc4998e69d59dd5c25c5596159244ae77","path":"design/requirements/scenarios/SCN-079-obtain-interim-advice-without-establishing-lifecycle-approval.json"},{"identity":"sha256:9b0bc205d3a89b4ed9faca138332e721a2360f841d2b7e3beec50a17f27bf2e9","path":"design/requirements/scenarios/SCN-080-reassess-corrections-within-one-whole-change-review-gate.json"},{"identity":"sha256:c492cf51bc2038dc8c0f48248d2b5af0282faa8d76adf4ece53cc7cae0d20a81","path":"design/requirements/scenarios/SCN-081-resolve-a-verification-problem-through-its-responsible-owner.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"}],"summary":"Design Covered within the stated contribution; no implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing AR-038–042 allocate Change-control disposition, guided invocation, current-record preservation, package coherence and explicit installation. The accepted narrowed obligation is now composed through these owners; no new AR or fallback backend is needed.","state":"not-required"},"ar_children":["AR-038","AR-039","AR-040","AR-041","AR-042"],"criteria":[{"explanation":"The adoption preparation contract inventories selected active work and live consumers across policy, methods, skills, templates, validators, recording and generated distributions before activation.","number":1,"state":"covered"},{"explanation":"The corrected source catalog and fixed replacement package exclude obsolete active proposal/combined-design routes while preserving original RR and approval meaning as history.","number":2,"state":"covered"},{"explanation":"FUNC-078/IF-011 requires explicit per-Change disposition of current bases, remaining work, blockers and still-applicable reviews; old milestone or proposal approvals cannot be relabeled.","number":3,"state":"covered"},{"explanation":"The selected v4 records distinguish progress, advisory/formal assessments and Verify with exact current support, allowing selective compaction without permanent attempt history or milestone approval records.","number":4,"state":"covered"},{"explanation":"Canonical methods, assurance and candidate validation distinguish format, requirement validity, design completeness and final support; structural success cannot confer engineering approval.","number":5,"state":"covered"},{"explanation":"FUNC-078 and IF-011 classify actual selected record dependencies under known project authority and target contract. Established new projects require supported recording without historical import; compatible work still requires fresh authority and dependency checks. Required unavailable, failed or uncertain migration blocks affected activation and preserves actual authority/work/history. Empty storage or omission of a relied-on dependency cannot bypass this disposition.","number":6,"state":"covered"},{"explanation":"Partial replacement preserves actual per-unit effects and old originals; activation requires coherent consumers/current work. Interrupted or incompatible scope is unavailable rather than a mixed valid workflow.","number":7,"state":"covered"},{"explanation":"Canonical REM methods have one authored source; package generation projects required versioned resources. Feature remains a stakeholder capability while milestones/work items carry delivery decomposition.","number":8,"state":"covered"},{"explanation":"Explore/Research and specialist invocations retain optional or isolated scope under project authority; they cannot create alternative requirement/Design gates, and PR keeps its separate authorization.","number":9,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-083\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Adopt replacement workflow contracts without reinterpreting history\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall activate the requirement-first workflow only through an explicit coordinated replacement of conflicting authority, guidance, validation and recording contracts, preserving historical judgments and resolving active-work dependencies through compatible recording support for the selected work and any migration required by that work.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A renamed skill or updated diagram can coexist with obsolete gate rules, invented commands, invalid active state or relabeled historical approval. An unconditional promise of migration-independent activation can admit work whose required earlier records are incompatible with the selected successor.\",\n      \"desired_outcome\": \"Participants receive one coherent active workflow with usable recording and truthful historical and current assessment boundaries.\"\n    },\n    \"why\": {\n      \"rationale\": \"The user-selected workflow must preserve traceability and independent judgment while assigning each engineering decision one owner and avoiding redundant approval cycles. Required record dependencies must be preserved without forcing unrelated historical imports.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Engineers and engineering agents\",\n        \"Independent reviewers and project decision owners\",\n        \"Maintainers of guidance, validation and recording tools\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When preparing, adopting or recovering a transition from the proposal-first and milestone-gated workflow.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"The project-selected governed workflow and its scoped specialist activities, including portable isolated use where applicable.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Apply the explicit ownership and dependency conditions in the criteria; record exact scope, decisions, exceptions and assessment basis without inferring approval from mechanics. Detailed Function, Module, Interface and storage realization belongs to subsequent design. Classify selected work by its actual recording compatibility and retained dependencies before activation; required unavailable migration blocks only affected adoption.\"\n    },\n    \"how_much\": {\n      \"scope\": \"The selected requirement-first workflow and its affected dependencies. A new project without earlier records requires no historical import; compatible existing work still requires authority and dependency checks. Work depending on incompatible earlier records requires qualified migration before activation. Unrelated history is not automatically imported. No new preliminary proposal gate, per-method approval, mandatory milestone approval or automatic external permission is introduced. Portable or isolated authoring remains governed by its own applicable scope; activation has the separately selected recording prerequisites.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The adoption scope identifies and reconciles the Constitution, Workflow/Assessment, specialist skills and conditional references, templates, routing/automation, validators, recording interfaces and generated distributions that consume the replaced responsibilities.\",\n    \"The active proposal/proposal-review responsibilities are replaced by requirement-analysis/requirement-review, and combined design authoring by the three selected authors. The old meanings do not remain as parallel active public routes; retained RR proposal material and historical approvals preserve their original meaning.\",\n    \"Every active Change within the selected adoption scope receives an explicit disposition of its requirement basis, remaining work, blockers, gate state and still-applicable review evidence. Missing approvals are not fabricated and old milestone reviews are not relabeled as whole-change approval.\",\n    \"Supported records distinguish milestone progress, advisory feedback, current formal review standing and distinct final Verify. Retain the subjects, attribution and rationale needed for current decisions and compact completion; neither milestone approval records nor permanent assessment-attempt history is required.\",\n    \"Validators distinguish record structure, requirement-review adequacy, design completeness and final evidence sufficiency. Passing a schema or storing a result grants no engineering approval; missing downstream design cannot by itself reject an otherwise sufficient requirement basis. Canonical requirement and System Design methods apply Function-coverage completeness at the design stage, not as a prerequisite for accepting the requirement basis.\",\n    \"Skills use the actually supported scoped CLI interface for governed recording, without direct SQL or invented commands. Adoption requires compatible recording for selected work: a new project without earlier records needs no historical import; existing compatible work may adopt after authority and dependency checks; work depending on incompatible earlier records requires qualified migration. When necessary migration is unavailable, affected adoption remains blocked and actual active authority, work and historical judgments remain identifiable and preserved. An empty store does not discharge existing dependencies, and unrelated history is not automatically imported.\",\n    \"A partial or failed transition does not expose conflicting contracts as one valid active workflow or destroy current work. Existing active authority remains identifiable until a coherent adoption or supported recovery is established.\",\n    \"Canonical REM methods have one authored owner, with only the needed material included in versioned generated skill distributions. Feature retains its stakeholder-capability meaning; delivery decomposition uses milestones or work items, not a competing Feature hierarchy.\",\n    \"Explore, Research and specialist activities remain scoped support or isolated invocations; they do not create alternative requirement/design authority or mandatory extra gates. PR remains optional and separately authorized.\"\n  ],\n  \"assumptions\": [\n    \"Existing governance and recording remain available until explicit coordinated adoption; target skill and CLI support is not assumed installed.\"\n  ],\n  \"constraints\": [\n    \"Draft authoring and structural validation do not establish independent review approval or activate the new workflow.\"\n  ],\n  \"constrains\": [\n    \"FEAT-015\",\n    \"FEAT-017\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-REQUIREMENT-FIRST-WORKFLOW\",\n      \"locator\": \"SR-083\",\n      \"basis\": \"User-selected requirement-first workflow and one mandatory whole-change Code Review gate. Proposed requirement analysis only; existing product contracts remain active until coordinated adoption. No new Function, AR, implementation or approval is inferred.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-REQUIREMENT-REVIEW\",\n      \"locator\": \"design/requirements/sources.md#src-workflow-requirement-review\",\n      \"basis\": \"Author assessment reconciles stage-specific Function coverage and limits active-Change disposition to the explicitly selected adoption scope.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-083\",\n      \"basis\": \"Draft integrated design from the accepted requirement-first basis. This defines target responsibility and cooperation, not installed capability, design approval, runtime evidence or SQLite adoption.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-083 AC1–3,7; AR-038, AR-039, AR-041, AR-042\",\n      \"basis\": \"Proposed allocation composition: Adoption disposition spans selected work and consumers; package and installation facts are necessary inputs, not activation or review judgments. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-083 AC4–6; AR-039, AR-040\",\n      \"basis\": \"Proposed allocation composition: Guidance supplies explicit supported operations and stage decisions; persistence preserves exact work/attempt facts and guarded publication without semantic approval. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-WORKFLOW-DESIGN\",\n      \"locator\": \"SR-083 AC8,9; AR-039, AR-041\",\n      \"basis\": \"Proposed allocation composition: One canonical method source is distributed coherently while portable specialist use, support activities and external-action authority retain their limits. This is a design argument, not executed satisfaction evidence.\"\n    },\n    {\n      \"source\": \"SRC-CURRENT-HANDOFF\",\n      \"locator\": \"SR-083\",\n      \"basis\": \"User-selected current handoff and selective retention refinement. Reuse existing identity and responsibility; no runtime adoption or independent approval is asserted.\"\n    },\n    {\n      \"source\": \"SRC-ADOPTION-DEPENDENCY-REFINEMENT\",\n      \"locator\": \"IR-009; SR-079–083; SCN-082\",\n      \"basis\": \"User-authorized scope refinement: compatible recording for selected work, historical import only when required by its dependencies, and blocked affected adoption when necessary migration is unavailable. Preserve identities, original judgments and separate portable authoring; no workflow activation or migration is performed.\"\n    }\n  ],\n  \"confirms\": [\n    \"FUNC-078\",\n    \"FUNC-023\",\n    \"FUNC-024\",\n    \"FUNC-051\",\n    \"FUNC-052\",\n    \"FUNC-055\",\n    \"FUNC-044\",\n    \"FUNC-045\",\n    \"FUNC-046\",\n    \"FUNC-060\",\n    \"FUNC-064\"\n  ]\n}\n","identity":"sha256:b506771574be31c9d33ef38b8f27fa5c83b03ceefdcf8975eecc405eadf634b6","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/sr.json"},"limitations":["Design assessment only; no runtime implementation, verification, executed adoption, package qualification or external-action authority is claimed.","Current source entrypoints, installed capabilities, project-selected authority and supported recording are distinct. A portable invocation cannot bypass an applicable governed contract; malformed governance is not permission to fall back.","Adoption requires compatible recording for selected work. Established new projects need no historical import; compatible work still needs authority/dependency checks; necessary unavailable migration blocks affected activation while preserving actual authority and history."],"outcome_basis":null,"reported_at":"2026-10-06T07:59:52Z","requirement":"SR-083","review":{"change":"2026-10-04-system-requirements-view-design","id":"ir010-integrated-design"},"scope":"All 9 canonical SR-083 criteria; integrated Design contribution with explicit failure, ownership and applicability limits.","state":"covered","subjects":[{"identity":"sha256:05f2cf53125f83fca4a85ab6c25c6d9cda699e20d20732a7042dc2730cb7accc","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/module.json"},{"identity":"sha256:396489911ab6101e34638b257c875effad9895cb87ef711fe29615d114e5d238","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/README.md"},{"identity":"sha256:dc2586d2d4c135693a8d8211f244133a9430a37c68173b25b7943a59c8782684","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/capability-contract.md"},{"identity":"sha256:a08e94ba682a7f58b320393b65b538cea19758b5c069e02a91ed7a4f85753b0b","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-012-published-engineering-capability-guidance/realization/software.json"},{"identity":"sha256:cd8d9be56ab4874f55cff54168f1cf3cc693de2bc40c17baf0dd034b4b2fd9c5","path":"design/architecture/modules/MOD-018-engineering-operations/README.md"},{"identity":"sha256:57770a58d93ee0bb6b875cb4de871a43ba33811dfe85b6205c2440a433e86623","path":"design/architecture/interfaces/IF-004-scoped-public-command-execution/interface.json"},{"identity":"sha256:bb60b1073280d894443e6098e497bc163800f43fbb3c08f8e55d09bb4ee36336","path":"design/architecture/interfaces/IF-008-applicable-engineering-authoring-guidance/interface.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:41e4298457e86fe690b4027327571f75c8e8cb98e10468f4ae157e3dbac31dd0","path":"design/architecture/interfaces/IF-011-engineering-work-context-and-workflow-adoption/interface.json"},{"identity":"sha256:965b1f491fd98cb1864153f13d0a52ae73877ec5b8485bccbe4a670e02876e36","path":"design/architecture/interfaces/IF-014-assurance-content-preparation/interface.json"},{"identity":"sha256:8d5fd4b8c33d938deca10af6cfb9ae6cc22a2e554a02d2b62b0b9c737851eb5f","path":"design/system/functions/FUNC-078-prepare-and-reconcile-workflow-adoption.json"},{"identity":"sha256:8985e5e5c42ec020c0b2d188d84ad38fb9e11a68701cf956767f9dc9e5cd3304","path":"design/system/functions/FUNC-023-record-controlled-change-transitions-and-provenance.json"},{"identity":"sha256:a1950aba542f169c423b1352b1533716ef92894a540bf9c339a02f2a5d908de4","path":"design/system/functions/FUNC-024-assess-and-apply-retirement-of-current-view-material.json"},{"identity":"sha256:c8152391e8dc91c31d65e24620ef5380cf62f0c1088be69833e9db0b0923ab16","path":"design/system/functions/FUNC-051-prepare-a-portable-or-governed-capability-invocation.json"},{"identity":"sha256:61b35b781e3b5fbc866a359b9fd4bd1b56e7570de824f410bf71514680fc5641","path":"design/system/functions/FUNC-052-resolve-resources-for-a-selected-capability-path.json"},{"identity":"sha256:b60652833ad97e4ba54d70e04ffbcb50943eec3c64417d4d1de7b21d5b57c93e","path":"design/system/functions/FUNC-055-prepare-and-interpret-governed-recording-operations.json"},{"identity":"sha256:08ebb8b4277641cf25e8a4513093c053cc6ddc5740fdb9c6fb53660f8f27ede8","path":"design/system/functions/FUNC-044-validate-registered-recording-candidates-and-preservation-rules.json"},{"identity":"sha256:727fa9085fec8f699361fc73b5e16db4a695ea168c91ffaffe5b5b56d5ee1b46","path":"design/system/functions/FUNC-045-construct-lossless-candidates-from-explicit-record-edits.json"},{"identity":"sha256:baddee11461c8f1fed6430cc5e0709c002aa3b406905220d7118f4996e06165c","path":"design/system/functions/FUNC-046-publish-fresh-record-candidates-as-coherent-transactions.json"},{"identity":"sha256:d71c9c7b3fe1dac754cb00c3f8ac78a8af838bc345aa4eff004b59c7412d988c","path":"design/system/functions/FUNC-060-build-supported-product-candidates.json"},{"identity":"sha256:7129691ef0d18646c943bc73209c91cccfff73b302bdbfa3287b19a1ab315c03","path":"design/system/functions/FUNC-064-apply-bounded-skill-installation-and-replacement.json"},{"identity":"sha256:c5d13d14f623676911bc02a08ffb5ef06c5b8229abe59c6635e6c2ed37381a74","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/AR-038-reconcile-bounded-workflow-adoption-and-recovery.json"},{"identity":"sha256:68d3bc974117e86fe6e691ab8562f676bfc9b709840da5a73a74e1f753a394ee","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/AR-039-use-a-coherent-adopted-workflow-through-supported-capabilities.json"},{"identity":"sha256:eae1e871e668ba0d51aa531282711f58e55056a49f71382fe736baa4f6bb668e","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/AR-040-preserve-work-and-assessment-facts-through-workflow-record-changes.json"},{"identity":"sha256:15fe688e8c98750eaee8e4f2c576b80438b46bfa41d226ec2b1f47fa378da059","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/AR-041-produce-a-coherent-replacement-capability-distribution.json"},{"identity":"sha256:ad9bc82663c72c9750e1920183812043a2d1778a9d7a253fd4834b9644b0d502","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/SR-083-adopt-replacement-workflow-contracts-without-reinterpreting-history/AR-042-apply-replacement-guidance-without-falsely-activating-workflow.json"},{"identity":"sha256:bb2650cfde6ebaefafcff7d9de36e37cf70af74b62ead75242c0ca2a806b2624","path":"design/requirements/IR-009-carry-out-portable-guided-engineering-work-across-the-project-lifecycle/ir.json"},{"identity":"sha256:1184535985d90fbc9371a25a25ed8e1517896cce292c1dbf68eb389c662b267e","path":"design/system/features/FEAT-015-select-and-invoke-portable-engineering-capabilities.json"},{"identity":"sha256:2227de4b85ff4515494b5485360af453a51c109ab188b5e8ffffb5abcac292f3","path":"design/system/features/FEAT-016-carry-out-guided-specialist-engineering-work.json"},{"identity":"sha256:9387e8897027b8855a20927212f86f760b24f7a1d9df934d8279bbf41b2263b3","path":"design/system/features/FEAT-017-coordinate-engineering-activity-handoffs-and-recording.json"},{"identity":"sha256:97b6e7c46e0bcf4d0a9c623173659796be5d8838634b3de5339367e1907eca8f","path":"design/requirements/scenarios/SCN-082-adopt-the-requirement-first-workflow-for-active-work.json"},{"identity":"sha256:37cda3d53b5041ac563370cfb00effc0c5b2fc3d51c3af5273249e9061af9e4c","path":"design/architecture/modules/MOD-017-engineering-governance/README.md"},{"identity":"sha256:9b77090a51b9d33af6a038261e36743682bca6b5cad4b293b99bb1989c2c3e36","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/module.json"},{"identity":"sha256:fc6351e15674dd1cd14b07972e3b89f57756758294b2c2a10cf3483a562180ae","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/README.md"},{"identity":"sha256:966ab13210fd36f3c44388d748827a1e36e1e2a6dc3b58b83f7afe46da077beb","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-006-engineering-change-control/workflow.md"},{"identity":"sha256:33306e44a1bd0ae1eae9b7b51c30dcf6bd261619207069e6974a6b3496864572","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/module.json"},{"identity":"sha256:d9bef4aadbfd845fc788a4e81a8c9ffb6f33cc7225a6d0acdd72d0e1992ef80f","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/README.md"},{"identity":"sha256:62bcaa4c905652e7287c4419c4f7a3422016c6d4f84b2b0a2782b0087c1bce12","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assessment.md"},{"identity":"sha256:9f6b3398a5cbbbc67e9cf98d2daf5d23978ac5174e8275983b0f39bab9af1481","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-007-engineering-verification-and-assurance/assurance-content.md"},{"identity":"sha256:43b41da458486e4bedc4801aee579e6de43d62f6527821ad0f7167d01240ce10","path":"design/architecture/modules/MOD-017-engineering-governance/modules/MOD-008-engineering-authoring-guidance/guidance.md"},{"identity":"sha256:bb597226b2064d47ab81b5ccfb4b8f97c1232ac72384a858a928362901432e6b","path":"CONSTITUTION.md"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:8826cafce61e450491f674a84da5ba1bcc8717a2f3328f2e6a2db1c29bccce23","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/module.json"},{"identity":"sha256:59d599b2614481294c8ba32be965dc82e9099e98d702e1d085fc71a4e2ce9c5f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:7c613a1991e886ef07d9c8232ad8a0c6e39706f15fc8811a73165ca7959b502f","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/module.json"},{"identity":"sha256:ce3cf826ac64c9b18bd826f10edd84c42165a2d2942ea3cdcefc13667f8b2575","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/README.md"},{"identity":"sha256:3456dd8482b1b09d027fcfb47f06ca254702c3b26558e044c390ec3281b45428","path":"design/architecture/interfaces/IF-003-operational-record-access-and-publication/interface.json"},{"identity":"sha256:8f6e4111c20a920b850e63107c7b39cafc51685e45bd0e4c5d9b9e8e7e0247c1","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/command-contract.md"},{"identity":"sha256:8acfe8a596f2e5c4542635113f4bddf7db03806cf50e748e287b161cac0e03e8","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-011-operational-record-persistence/record-contract.md"},{"identity":"sha256:6d82acd0a1443577c34296308b2c0cddf22e29b7fbc5324ab52a759914a634fe","path":"design/architecture/modules/MOD-017-engineering-governance/test-design.md"},{"identity":"sha256:536af7f9e97979b7afd41f8f5b66296e6091a243f1dfd3f9019f0ed2d3554782","path":"design/requirements/sources.md"}],"summary":"Design Covered against the explicitly refined adoption obligation; original negative assessment is preserved. No implementation or verification conclusion."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-043","AR-044","AR-045"],"criteria":[{"explanation":"FUNC-079/080/081 and MOD-004 Input, Five-view, Shared engine and Reusable template contracts explicitly accept the fixed supported model format with arbitrary project IDs, supply all five entry points and treat RigorLoop panels/catalogues as optional project data.","number":1,"state":"covered"},{"explanation":"IF-001 capture binds membership, bytes and profile to immutable selected input; MOD-004 snapshot identity/reader data and MOD-010 browser-v1 results carry project/profile, content and generator/renderer/resource identities and generation scope.","number":2,"state":"covered"},{"explanation":"IF-002 interpretation and AR-044 retain declared-profile meaning and explicit unsupported/missing/ambiguous outcomes.","number":3,"state":"covered"},{"explanation":"FUNC-079 and IF-001 require a demonstrably immutable selection or captured export with complete membership/digests; unstable/insufficient capture rejects before publication.","number":4,"state":"covered"},{"explanation":"FUNC-080 and MOD-004 input/view/data contracts distinguish optional missing realization/explanation from invalid required data.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-084\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Generate architecture views for a selected customer model\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall let a customer generate a read-only architecture browser for one explicitly selected supported project model state without requiring the RigorLoop source checkout or its project-specific content.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Repository-specific tooling may fail on customer inputs.\",\n      \"desired_outcome\": \"let a customer generate a read-only architecture browser for one explicitly selected supported project model state without requiring the RigorLoop source checkout or its project-specific content.\"\n    },\n    \"why\": {\n      \"rationale\": \"Customer use needs attributable, portable views and truthful boundaries beyond repository-local demonstration.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer model authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading or qualifying the selected architecture browser capability.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"One selected customer project/state and explicitly selected output; declared product generation and reading environments.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Assess the stated observable outcomes against explicit supported profiles, selected source identity and actual artifacts; preserve ownership and diagnose unavailable or incomplete results.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Read-only local generation and portable snapshot reading. No live editor, hosted-service requirement, cross-project aggregation, automatic publication or invented performance target. Detailed realization and platform support are downstream design decisions.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"A minimal supported customer model using its own entity IDs can produce Logical, Process, Development, Physical and Scenario entry points without RigorLoop-specific records, contribution tables or local operational history.\",\n    \"The result identifies selected project, declared profile, input content identity, generator version and generation scope. A Git revision alone does not identify changed working-tree content.\",\n    \"Missing, ambiguous or unsupported profile selection yields a specific diagnostic without silently applying another profile; invalid required content prevents publication of a successful snapshot.\",\n    \"If input changes during collection, either use a demonstrably coherent captured selection or report failure; never combine different states under one unqualified identity.\",\n    \"An absent optional view fact remains an explicit absence or limitation rather than making the supported minimal model invalid.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-079\",\n    \"FUNC-012\",\n    \"FUNC-013\",\n    \"FUNC-080\",\n    \"FUNC-081\"\n  ],\n  \"constrains\": [\n    \"FEAT-022\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"SR-084\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"SR-084\",\n      \"basis\": \"System and Architecture Design from SR-084\\u2013088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:04d46256b799f5ba92f3481ef6692ca5ecbab5c632ea507dc8f7fbcaa32f132a","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-084","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 5 canonical SR-084 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:6edf5726ab6d760956942141036b874a21934635a926169cb18d036c5303485f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-043-capture-attributable-customer-model-inputs.json"},{"identity":"sha256:d63539c2f78036f0df7d6ef45a9cf1cb726c55d1b833bd273be2192e8a48b2e4","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-044-interpret-the-selected-browser-model-profile.json"},{"identity":"sha256:7fbb360f4c9304bea3481d357750eff651b24061a4c702a317aae0c4dea94266","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-084-generate-architecture-views-for-a-selected-customer-model/AR-045-compose-customer-architecture-snapshot-content.json"},{"identity":"sha256:a1259ad3b6ad455744b9d4b1b0e7381f57e2955cd3258e2ca0f04978ed9d078a","path":"design/system/features/FEAT-022-generate-and-share-attributable-architecture-views.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":["AR-046"],"criteria":[{"explanation":"FUNC007 separates definition completeness from rationale availability/applicability. FUNC009 defines typed navigation; FUNC081 supplies readable keyboard overview/detail navigation. MOD004 Reader questions, Module page content, Rationale/source disclosure and reusable template define concrete reading flow.","number":1,"state":"covered"},{"explanation":"FUNC080 and MOD004 five-view contract keep logical, runtime, software and physical bases distinct; parent/direct and descendant allocation are separate.","number":2,"state":"covered"},{"explanation":"FUNC080 admits ordered interaction only from established semantics; MOD004 Process distinguishes topology, interactions and state, explicitly preserving unavailable/unsupported behavioral details as text.","number":3,"state":"covered"},{"explanation":"FUNC080 keys topic by owner/facet/qualification/kind/local name; MOD004 reading/source contract preserves qualification in listings/details/deep links and source identity.","number":4,"state":"covered"},{"explanation":"MOD004 Scenario contract and FUNC009 separate stakeholder situation/declared participation from reachability, coverage, approval or satisfaction.","number":5,"state":"covered"},{"explanation":"FUNC007/009/080 preserve missing/incomplete/unsupported distinctions; MOD004 browser-data and Module-content rules distinguish absent optional detail, missing required explanation and invalid required output.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-085\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Preserve engineering meaning across architecture views\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall present the five architecture views and their selected details as attributable projections of the selected model, preserving ownership, relationship meaning, qualification and completeness limits.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A view may misrepresent facts or hide incomplete interpretation.\",\n      \"desired_outcome\": \"present the five architecture views and their selected details as attributable projections of the selected model, preserving ownership, relationship meaning, qualification and completeness limits.\"\n    },\n    \"why\": {\n      \"rationale\": \"Customer use needs attributable, portable views and truthful boundaries beyond repository-local demonstration.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer model authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading or qualifying the selected architecture browser capability.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"One selected customer project/state and explicitly selected output; declared product generation and reading environments.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Assess the stated observable outcomes against explicit supported profiles, selected source identity and actual artifacts; preserve ownership and diagnose unavailable or incomplete results.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Read-only local generation and portable snapshot reading. No live editor, hosted-service requirement, cross-project aggregation, automatic publication or invented performance target. Detailed realization and platform support are downstream design decisions.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Readers can navigate each available view from an overview to relevant definitions, relationships and applicable rationale, using readable labels and keyboard-accessible navigation.\",\n    \"Logical ownership and containment remain distinct from execution and deployment; a shared source file does not merge logical responsibilities.\",\n    \"Process topology does not imply execution order or concurrency. Selected activity, interaction and lifecycle details appear only where authoritative semantics establish them.\",\n    \"Proposed and observed facts remain distinguishable in overviews and details, even when names are identical; each detail exposes its selected-state source basis.\",\n    \"Scenario navigation retains stakeholder meaning and identified architecture participation without turning reachability or rendering into coverage, approval or satisfaction.\",\n    \"Missing required explanation and incomplete selections remain explicit; absent details are not fabricated and view success does not establish a complete design.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-007\",\n    \"FUNC-009\",\n    \"FUNC-080\",\n    \"FUNC-081\"\n  ],\n  \"constrains\": [\n    \"FEAT-022\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"SR-085\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"SR-085\",\n      \"basis\": \"System and Architecture Design from SR-084\\u2013088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:bd4a159c76fca8c27594707ebd2d95bd43a07a76b27b0e06f022b823beaa9f94","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-085-preserve-engineering-meaning-across-architecture-views/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Target coherent capture/traversal is not proved by repository navigation or schemas; system proof composes MOD-001/003/004/010.","AR-046 historical delivery remains unchanged and may be stale. SR-084/086/087/088 capture, portability, publication and qualification stay separate."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-085","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 6 canonical SR-085 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:1dee4e8814f45c1943675afcd28d2facd53586f7e18bb85d9d7caca8b269233f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-085-preserve-engineering-meaning-across-architecture-views/AR-046-preserve-meaning-and-attribution-across-browser-views.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:98c94da392584be5a65a45b09120621d96fa4d26e157ae0e7294414d3b64ddb3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-tree.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:45912f18331be67d938c93c65e5b28d8ac182799d9355e522c7c3cbd3a106162","path":"design/system/README.md"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:2469f00338b83e9a8a666c90c83cb079a52ea834241f9d0ec01c010066a50951","path":"design/system/functions/FUNC-007-present-current-engineering-definition-and-applicable-rationale.json"},{"identity":"sha256:aae67cc581c3ca34f3fa3b157f4114bdd9153c2a347968973c90759461c46fc4","path":"design/system/functions/FUNC-009-traverse-selected-engineering-relationships.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:a1259ad3b6ad455744b9d4b1b0e7381f57e2955cd3258e2ca0f04978ed9d078a","path":"design/system/features/FEAT-022-generate-and-share-attributable-architecture-views.json"},{"identity":"sha256:4995ceb3acb232d01b84a136a529ff5e4bcc101117da8f9691bfda30c59dbda3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/traversal.md"},{"identity":"sha256:c4d3e474cac43a225dc240a6b4032d69d61c7e7b445653eafac232a232986f24","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/browser-views.toml"},{"identity":"sha256:d688c65d40931d2b370e0e6a7e79eafc6caf75612abf297f1103bab5729d472f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-009-traverse-selected-engineering-relationships-with-explicit-completeness/AR-056-preserve-scoped-traversal-completeness-and-attribution.json"},{"identity":"sha256:c564b776b2408686fcc6373b85be88f0836698f9345260c1abf0a63729a29646","path":"design/architecture/interfaces/IF-013-scoped-engineering-relationship-traversal/interface.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:96441c50dce42b25ad8992615c0a75370e6c89072694171a7491fa6caa2867d7","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/README.md"},{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:6d1115211378f3b231a2127484f809fb5fa67b16a9986f082275e07d690882df","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-002-engineering-model-authoring/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:b0f95105d84590f3a7b84f103adfd1023e7e59ef86ea6a8708438a6c461d9f5f","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-057-prepare-single-authority-relationship-changes.json"},{"identity":"sha256:1cbc3bddd53985b81cd16ef7825e2fa097893a8830c4a82964abe31094be3f7b","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-058-check-relationship-candidates-in-their-declared-scope.json"},{"identity":"sha256:cd6e9dcea5e26cccae5a0a368759dba57613675ecf59c54813ca4c0e29582434","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-008-author-engineering-relationships-once-and-derive-inverse-views/AR-059-retain-state-bound-relationship-changes.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:ee1303ac9c01e11d53b3d6af2c47fc915d37488f8db490d9de524c106bc7f9f3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-delivery-format.md"},{"identity":"sha256:915876f00dba078b8ffefdcd17f951997f444485c5545548d679d2f2d1d2f477","path":"design/support/requirement-delivery-v2.schema.json"},{"identity":"sha256:740c7e8a8398bce4a2046ef49f685d37bf516875e7d562ae102464bff8579f1b","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-evaluation.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-047"],"criteria":[{"explanation":"FUNC-081 and MOD-004 assembly/template/Physical contracts package complete local resources and copied version roots, embed required model/diagram/explanation content and keep all navigation in the browser.","number":1,"state":"covered"},{"explanation":"MOD-004 source/rationale disclosure and browser-data contracts include required definitions, explanation, diagrams, qualification and source identity within the artifact.","number":2,"state":"covered"},{"explanation":"The reader receives static HTML/CSS/JavaScript and admitted self-contained SVG/resources. FUNC-081, MOD-004 technical/physical design and MOD-013 boundary exclude Node/Rust/Python/D2, remote fonts/CDNs, a hosted service and operational database from reading.","number":3,"state":"covered"},{"explanation":"Snapshot/manifest identity covers project/profile, exact model membership/content and tool/resource provenance.","number":4,"state":"covered"},{"explanation":"The reader changes only local reading state and has no mutation/generator service connection. Capture/publication contracts forbid source modification or upload. Copying/opening does not grant external publication authority; release/publication remains separately explicit.","number":5,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-086\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Read portable architecture snapshots offline\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall let a reader inspect a complete generated architecture snapshot offline without the generation tools, original project checkout or operational database, while identifying the snapshot scope and its limits of currency.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A shared page may depend on unavailable source files or network services.\",\n      \"desired_outcome\": \"let a reader inspect a complete generated architecture snapshot offline without the generation tools, original project checkout or operational database, while identifying the snapshot scope and its limits of currency.\"\n    },\n    \"why\": {\n      \"rationale\": \"Customer use needs attributable, portable views and truthful boundaries beyond repository-local demonstration.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer model authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading or qualifying the selected architecture browser capability.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"One selected customer project/state and explicitly selected output; declared product generation and reading environments.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Assess the stated observable outcomes against explicit supported profiles, selected source identity and actual artifacts; preserve ownership and diagnose unavailable or incomplete results.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Read-only local generation and portable snapshot reading. No live editor, hosted-service requirement, cross-project aggregation, automatic publication or invented performance target. Detailed realization and platform support are downstream design decisions.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Copy the complete output to another supported reading environment, make the source checkout unavailable and disable network access; required navigation, diagrams, definitions and included rationale remain usable.\",\n    \"The snapshot contains the reading resources and source detail needed to understand its selected scope; unavailable optional external links do not replace required explanations.\",\n    \"Reading requires no generator, rendering compiler, remote fonts or script CDN, hosted service or local operational database.\",\n    \"The reader can identify project/profile, input content identity and generator provenance; the snapshot does not claim live freshness without a fresh comparison.\",\n    \"Opening or copying the snapshot does not alter engineering sources or grant permission to publish customer information.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-081\"\n  ],\n  \"constrains\": [\n    \"FEAT-022\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"SR-086\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"SR-086\",\n      \"basis\": \"System and Architecture Design from SR-084\\u2013088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:a449de0f92f9099ffef32cf3f6b42e39f06f6569ceedccfd2736a1487152ac39","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-086-read-portable-architecture-snapshots-offline/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-086","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 5 canonical SR-086 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:7cc7f61a3b2c12b5606b03c8ecf3ed719744b62cd23495e7cfe18b850109e7d6","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-086-read-portable-architecture-snapshots-offline/AR-047-provide-portable-offline-architecture-reading.json"},{"identity":"sha256:a1259ad3b6ad455744b9d4b1b0e7381f57e2955cd3258e2ca0f04978ed9d078a","path":"design/system/features/FEAT-022-generate-and-share-attributable-architecture-views.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"},{"identity":"sha256:ee1303ac9c01e11d53b3d6af2c47fc915d37488f8db490d9de524c106bc7f9f3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-delivery-format.md"},{"identity":"sha256:915876f00dba078b8ffefdcd17f951997f444485c5545548d679d2f2d1d2f477","path":"design/support/requirement-delivery-v2.schema.json"},{"identity":"sha256:740c7e8a8398bce4a2046ef49f685d37bf516875e7d562ae102464bff8579f1b","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/requirement-evaluation.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":{"explanation":"Existing allocated ARs cover this SR; collaborator ownership and scope remain distinct.","state":"not-required"},"ar_children":["AR-048"],"criteria":[{"explanation":"FUNC-082 and MOD-004 Physical publication contract reject input/output overlap, symlink escape, installation-root writes, unknown ownership and unexpected output files before publication.","number":1,"state":"covered"},{"explanation":"Preparation fully validates candidate resources before publication. Immutable versions preserve existing readable assets; exclusive ownership and one atomic entry switch define commit, with directory durability before success. Recovery inspects exact old/candidate/entry identities, preserves bytes and reports unknown state instead of claiming completion or blindly retrying.","number":2,"state":"covered"},{"explanation":"IF-001/FUNC-079 capture only profile-declared members and selected permitted explanation from immutable input; private operational history, credentials and unrelated workspace traversal are excluded.","number":3,"state":"covered"},{"explanation":"MOD-004 diagram admission, browser-data and engine protocol constrain source-owned D2, escape text, admit structured safe links and sanitized self-contained SVG, reject source/output escapes and external resources, and never launch model-supplied commands.","number":4,"state":"covered"},{"explanation":"FUNC-082 and IF-012 are local derived-output responsibilities and explicitly perform no external upload.","number":5,"state":"covered"},{"explanation":"Snapshot identity and stable serialization/rendering bind ordered membership/content, declared profile, generator/renderer/resources and options while excluding machine paths, wall-clock timestamps and random operation IDs from deterministic content.","number":6,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-087\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Generate architecture snapshots within safe output boundaries\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall generate a selected architecture snapshot without modifying engineering sources, unrelated files or a prior readable snapshot on rejected or failed generation, and shall report truthful output and recovery outcomes.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"Generation may corrupt prior output, change sources or disclose unrelated information.\",\n      \"desired_outcome\": \"generate a selected architecture snapshot without modifying engineering sources, unrelated files or a prior readable snapshot on rejected or failed generation, and shall report truthful output and recovery outcomes.\"\n    },\n    \"why\": {\n      \"rationale\": \"Customer use needs attributable, portable views and truthful boundaries beyond repository-local demonstration.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer model authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading or qualifying the selected architecture browser capability.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"One selected customer project/state and explicitly selected output; declared product generation and reading environments.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Assess the stated observable outcomes against explicit supported profiles, selected source identity and actual artifacts; preserve ownership and diagnose unavailable or incomplete results.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Read-only local generation and portable snapshot reading. No live editor, hosted-service requirement, cross-project aggregation, automatic publication or invented performance target. Detailed realization and platform support are downstream design decisions.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"Reject an output selection overlapping authoritative input or requiring replacement of unrelated files before mutation; replacement is confined to explicitly selected generated output.\",\n    \"For invalid input, rendering failure or interrupted generation, preserve the prior complete readable snapshot or restore it through the declared recovery procedure before reporting successful replacement; an unresolved partial state is reported and never called complete.\",\n    \"Generation leaves canonical model bytes unchanged and includes only selected model content and necessary reading resources, excluding unrelated workspace content and private operational history.\",\n    \"Hostile text, links and paths cannot execute supplied script, escape the selected output boundary or cause undeclared resource acquisition.\",\n    \"Generation and reading do not publish or upload content. Publication requires a separate explicit action and applicable authority.\",\n    \"Equivalent declared inputs and tool versions produce equivalent declared snapshot content; actual provenance observations are identified separately from deterministic content.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-079\",\n    \"FUNC-081\",\n    \"FUNC-082\"\n  ],\n  \"constrains\": [\n    \"FEAT-022\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"SR-087\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"SR-087\",\n      \"basis\": \"System and Architecture Design from SR-084\\u2013088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:2844f7d466b58a52365f9e337cdb07f46da798a17e8edf3a64ca81b241d3b0f3","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-087-generate-architecture-snapshots-within-safe-output-boundaries/sr.json"},"limitations":["Design only; this judgment does not assess implementation, executed verification or requirement satisfaction.","Repository Python rendering lacks full target immutable capture/publication. Customer-tool, package and release qualification remain separately owned proof."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-087","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 6 canonical SR-087 criteria; single-owner contribution where allocated.","state":"covered","subjects":[{"identity":"sha256:264c5c99e22837edd8f3b4472a691c9a0c9c1fea05aa13adc7f1e0adc7eb8bab","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-001-engineering-model-storage/module.json"},{"identity":"sha256:3df0b81ddc90cf5abc6d4b8f8239e75a70a11e7ede9bc3de74ec1ce0e966f67f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-003-engineering-model-conformance/module.json"},{"identity":"sha256:aa5307eebf251ad71ac5200d76509e3666fad4fccd89384fc189364bd7a12e10","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/module.json"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:08c55f688ee6e79439514ffbfc2160403f6bbc950cf6e36aac252eeeea6a4164","path":"design/architecture/modules/MOD-016-engineering-model-management/module.json"},{"identity":"sha256:7ed00afc1e82ff6fe2e273ccdc6c2d239a3d78ca21bd2db5e560960098090437","path":"design/architecture/interfaces/IF-001-engineering-definition-access/interface.json"},{"identity":"sha256:89dd5bbc3fa01ee2c8b18a90bddcb9ae5f06246adfcf2d911deec9395f45daf7","path":"design/architecture/interfaces/IF-002-engineering-model-interpretation-and-identity-checks/interface.json"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:68352a450b4ca4b1a7266f0ba894b9109437f9854160663974bb102ac1025c70","path":"design/system/functions/FUNC-079-capture-a-coherent-engineering-input-selection.json"},{"identity":"sha256:f16de85c3a67275f674b7e5d55df8c112c2d3859a25242f86488a2317e6029f2","path":"design/system/functions/FUNC-080-compose-qualified-architecture-view-projections.json"},{"identity":"sha256:5105226d06d027c5eb2b120c278ac2abc690b1e6913eb817be912117db664e79","path":"design/system/functions/FUNC-081-assemble-portable-architecture-reading-artifacts.json"},{"identity":"sha256:1b8bcc6048d4d21d2a439c811b2e59aa999a97f51dc41573b39f35f9abde685a","path":"design/system/functions/FUNC-082-publish-and-recover-selected-architecture-snapshots.json"},{"identity":"sha256:a327031b563b664a224cc8c9831322c3a4dbb19aea07a12418c4eec62d740b31","path":"design/system/functions/FUNC-012-interpret-a-model-with-its-declared-metamodel.json"},{"identity":"sha256:366e64579de24c6dface24f677f51a2710ff222d1453d6bf195c31c142899921","path":"design/system/functions/FUNC-013-diagnose-model-conformance-against-declared-rules.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:70a045bc5b7268265fafe19156f801ce0dd629b0305d7c948caf163cbf8f0368","path":"design/architecture/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:8c4e30b58e355580d1693a2c0fca19a572d660b2c1419f24887fd3c958533d4c","path":"design/requirements/IR-002-trace-engineering-obligations-and-responsibilities/SR-087-generate-architecture-snapshots-within-safe-output-boundaries/AR-048-preserve-source-and-output-boundaries-during-snapshot-publication.json"},{"identity":"sha256:a1259ad3b6ad455744b9d4b1b0e7381f57e2955cd3258e2ca0f04978ed9d078a","path":"design/system/features/FEAT-022-generate-and-share-attributable-architecture-views.json"},{"identity":"sha256:adcba795929cd96ff98cfffa6bc478e9972b15de44c9b12699e73e32e4436ee3","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/allocation-and-impact.md"}],"summary":"Design Covered; Implementation and Verification are assessed separately."},{"actor":"requirements-design-review","allocation":null,"ar_children":["AR-049","AR-050","AR-051"],"criteria":[{"explanation":"MOD-013's browser candidate contract declares exact generator, fixed profile, template/data resources, Rust engine, D2 binaries/licenses and configuration identities in the actual CLI inventory under IF-005.","number":1,"state":"covered"},{"explanation":"FUNC-083 qualifies the installed candidate with an independent minimal model through the public command boundary, without checkout imports, Python/Cargo, install hooks or undeclared acquisition; the reference repository is an additional first-project case.","number":2,"state":"covered"},{"explanation":"Qualification copies a complete snapshot and exercises offline reading in declared browsers. MOD-010 checks platform/resources before writer acquisition and preserves incompatibility or response-loss outcomes instead of claiming success.","number":3,"state":"covered"},{"explanation":"Browser acquisition/update uses the existing trusted package-manager path into an isolated tool prefix, outside model/output roots. No hooks rewrite snapshots; clean-prefix negative cases observe actual effects and content preservation.","number":4,"state":"covered"},{"explanation":"The first Linux x86-64/Node24/engine/D2 target freezes exact runtime and reader versions per candidate; combined dependency/protocol/filesystem qualification is mandatory and other configurations remain unsupported.","number":5,"state":"covered"},{"explanation":"MOD-013/015 distinguish reusable candidate and reference snapshot identities and evidence. Source-tree tests or a hosted sample establish neither complete customer support nor public availability.","number":6,"state":"covered"},{"explanation":"MOD-015 consumes exact browser qualification through IF-005 and applies existing immutable-candidate authority, public observation and recovery rules. Qualification itself grants no publication permission.","number":7,"state":"covered"}],"definition":{"content":"{\n  \"id\": \"SR-088\",\n  \"type\": \"system-requirement\",\n  \"title\": \"Qualify complete customer architecture browser artifacts\",\n  \"status\": \"draft\",\n  \"statement\": \"The system shall qualify the actual distributed architecture browser capability for its declared profiles and execution environments using an independent customer project, with complete resources, explicit dependencies and safe acquisition and update behavior.\",\n  \"analysis\": {\n    \"method\": \"5W2H\",\n    \"what\": {\n      \"problem\": \"A sample page does not prove the shipped generator is complete and compatible.\",\n      \"desired_outcome\": \"qualify the actual distributed architecture browser capability for its declared profiles and execution environments using an independent customer project, with complete resources, explicit dependencies and safe acquisition and update behavior.\"\n    },\n    \"why\": {\n      \"rationale\": \"Customer use needs attributable, portable views and truthful boundaries beyond repository-local demonstration.\"\n    },\n    \"who\": {\n      \"stakeholders\": [\n        \"Customer model authors and readers\",\n        \"Product maintainers and reviewers\"\n      ]\n    },\n    \"when\": {\n      \"conditions\": [\n        \"When generating, reading or qualifying the selected architecture browser capability.\"\n      ]\n    },\n    \"where\": {\n      \"contexts\": [\n        \"One selected customer project/state and explicitly selected output; declared product generation and reading environments.\"\n      ]\n    },\n    \"how\": {\n      \"approach\": \"Assess the stated observable outcomes against explicit supported profiles, selected source identity and actual artifacts; preserve ownership and diagnose unavailable or incomplete results.\"\n    },\n    \"how_much\": {\n      \"scope\": \"Read-only local generation and portable snapshot reading. No live editor, hosted-service requirement, cross-project aggregation, automatic publication or invented performance target. Detailed realization and platform support are downstream design decisions.\"\n    }\n  },\n  \"acceptance_criteria\": [\n    \"The candidate inventory identifies generator, supported profile definitions, projection and reading resources, relevant licenses and all required generation/runtime dependencies, bound to actual artifact identity.\",\n    \"In a clean declared generation environment, the acquired candidate generates views for a minimal customer project without the RigorLoop source checkout, undeclared build steps or hidden downloads.\",\n    \"Qualification includes reading a copied output offline in the declared browser environment; dependency and profile incompatibilities produce explicit diagnostics rather than a false successful result.\",\n    \"Acquisition or update verifies the selected artifact through the declared trust/integrity mechanism and preserves customer engineering definitions, unrelated files and existing shared snapshots; failed operations report actual effects and recovery limits.\",\n    \"Generator, profile, reading environment and dependency compatibility are declared and assessed together for each supported configuration; unsupported configurations are not implied by a generic download.\",\n    \"The reusable tool artifact and RigorLoop reference-documentation snapshot have separately identifiable content and qualification. A hosted sample or successful local build does not establish customer-tool support or public availability.\",\n    \"Publication remains governed by the existing exact-candidate authorization and observed-outcome obligations; no public release is implied by qualification.\"\n  ],\n  \"assumptions\": [],\n  \"constraints\": [],\n  \"confirms\": [\n    \"FUNC-040\",\n    \"FUNC-048\",\n    \"FUNC-060\",\n    \"FUNC-061\",\n    \"FUNC-083\",\n    \"FUNC-068\",\n    \"FUNC-070\",\n    \"FUNC-071\"\n  ],\n  \"constrains\": [\n    \"FEAT-018\"\n  ],\n  \"sources\": [\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-REQUIREMENTS\",\n      \"locator\": \"SR-088\",\n      \"basis\": \"User-requested reusable customer architecture browser; requirement-level author analysis. Current records remain draft; no implemented, published or independently approved behavior is claimed.\"\n    },\n    {\n      \"source\": \"SRC-CUSTOMER-BROWSER-DESIGN\",\n      \"locator\": \"SR-088\",\n      \"basis\": \"System and Architecture Design from SR-084\\u2013088 and refined SR-060; proposed responsibility, contract and realization only. No implementation, platform qualification or product availability is established.\"\n    }\n  ]\n}\n","identity":"sha256:e54e6164b2031abaad4a91defa6784121b05573c5e2bbba2a9dc5114ce8565bd","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/sr.json"},"limitations":["Design coverage only; no implemented, verified, installed, published or requirement-satisfaction result is asserted.","Exact-candidate executable proof, applicable platform/environment qualification and actual public observations remain separate; static source mappings and repository browser checks do not establish them.","Known default-output conformance, packed-boundary assertion, dependency mapping and hosted setup gaps remain attributable to their owners. No global installer writer exclusion, whole-project rollback or unsupported platform is promised."],"outcome_basis":null,"reported_at":"2026-10-06T12:12:35Z","requirement":"SR-088","review":{"change":"2026-10-04-system-requirements-view-design","id":"evaluation-implementation-design"},"scope":"All 7 canonical SR-088 criteria at System/Architecture Design scope, with current child contracts and declared realization limits.","state":"covered","subjects":[{"identity":"sha256:cffaaf9d5b2293fdad6c8b9d258954ac0bf3a7e8233225b945d2aa6f47b4029d","path":"design/architecture/modules/MOD-019-product-delivery/README.md"},{"identity":"sha256:8eae71f7fa1f85446ae5d0829410778aa54547d2e6376713f3639273ee38a4bc","path":"design/architecture/modules/MOD-019-product-delivery/module.json"},{"identity":"sha256:17c4e9a2ab55a2e87f055fb409f436ce69e5efe6d740d962dd6b5516540fda41","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/module.json"},{"identity":"sha256:7211adfe0f4f67ecdd4b1b54d5a2db8c1f4448b56904492fefd686d18ac45e17","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/README.md"},{"identity":"sha256:552c944fe260d7afda11f459b3285c40cc34b5b87b640c50915c4e994c979bf8","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/release.md"},{"identity":"sha256:561d3f2599b324f13e65bfb71b745b4a3a7241da1446664868dc5181d08eeb6e","path":"design/architecture/interfaces/IF-005-verifiable-product-candidate-artifacts/interface.json"},{"identity":"sha256:8cd48470112d1d1948365f950b015e92df117ac302661f26311de28f9b3e2b27","path":"design/system/functions/FUNC-040-admit-explicit-requests-under-declared-command-contracts.json"},{"identity":"sha256:302fb1f00c393413ca968a5be04118d06d452a75f31da200675fbe56bcbf27dd","path":"design/system/functions/FUNC-048-project-bounded-command-results-without-changing-meaning.json"},{"identity":"sha256:d71c9c7b3fe1dac754cb00c3f8ac78a8af838bc345aa4eff004b59c7412d988c","path":"design/system/functions/FUNC-060-build-supported-product-candidates.json"},{"identity":"sha256:d5a10410e8ad94a7c146d73ddabfaa18ac048ff056a918c46276c8fe38305a36","path":"design/system/functions/FUNC-061-derive-artifact-integrity-metadata.json"},{"identity":"sha256:ae5ea04bf84064fdccca4a7330ccd69fb35e7b79b8b3629c2151c5ce97e7353d","path":"design/system/functions/FUNC-083-qualify-browser-candidates-for-customer-generation-and-reading.json"},{"identity":"sha256:2cdcd8449d7d5073d9a4b63879ab8acd2d91010979590d50f90ada2dbe8d8041","path":"design/system/functions/FUNC-068-assess-release-preflight-and-qualification.json"},{"identity":"sha256:417e1053c8fcafcdcf5ddf7a4f8a71958763c3215ff64419e675bee117d5cfe3","path":"design/system/functions/FUNC-070-publish-an-authorized-retained-candidate.json"},{"identity":"sha256:e70013a4f8fb30f56ecee6c674167b9fb4345ed8990094bd7c589fe8e24c3c26","path":"design/system/functions/FUNC-071-observe-public-release-and-record-closeout.json"},{"identity":"sha256:c5f2bacaea51dbddc3bb23988c2cf98b8850770b8e7ba99cee8884191e8e0dc3","path":"design/architecture/interfaces/IF-009-applicable-governed-action-authority/interface.json"},{"identity":"sha256:a40e99dcc2b2ef9df4d63cd83064a726ebc2b76d2e045588cbbd59551e295332","path":"design/architecture/interfaces/IF-010-claim-evidence-applicability-and-coverage/interface.json"},{"identity":"sha256:087a6060d60599627ce23303f6330acea87ffa8e988c6c6b6157d65d3f98db42","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-015-product-release-coordination/test-design/test-design.md"},{"identity":"sha256:84d2501aacde5bae93ea812c58724e727adcbac02a360a497ef54332937cff1e","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/packaging.md"},{"identity":"sha256:0359b90bf4d3bb76cce6140aaee28b6641f49b41469d6ebd6780d8d1c614155c","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-014-verified-skill-installation/installation.md"},{"identity":"sha256:a46554a9d89539fa9c40f21bd4b1f58bede833ca148065554a9abd311a992c6f","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/module.json"},{"identity":"sha256:d02da6a994a304a3b45c6fb6f7197efc3fbf9796e6487996c592ea9406404a08","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/README.md"},{"identity":"sha256:8b16ad56639575b8c7b13dc5afaa72aecc19a53b59d205e9e6961311543d8666","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/README.md"},{"identity":"sha256:497bc4cddf19fe61749b013dc94d07190982d0331ca50e99a54c62b04b2309b2","path":"design/architecture/modules/MOD-018-engineering-operations/modules/MOD-010-engineering-command-interface/module.json"},{"identity":"sha256:705977004fbc8037699b3af0210641e5ebef9b8404abe990e9e2bc55d2520e5f","path":"design/architecture/modules/MOD-016-engineering-model-management/modules/MOD-004-engineering-context-and-traceability/README.md"},{"identity":"sha256:255f6436bd599296daae51cf42707b1127e8474985950fc9a47411d2faaf8d76","path":"design/architecture/interfaces/IF-012-qualified-architecture-snapshot-generation/interface.json"},{"identity":"sha256:82066c3e9bcd225911a63d1e7e94ca165fc61f0e31ceff04af4607dc21dc6190","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/deployment.json"},{"identity":"sha256:0599f8c7b958658757f82b63dc636ac22851c3ea38bbfacffa9ebaaf8475e6fc","path":"design/architecture/modules/MOD-019-product-delivery/modules/MOD-013-product-package-production/realization/software.json"},{"identity":"sha256:5394828ba4abc2042ce94228db1eb66e7391b05164a2f96bd808861c46271ffe","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/AR-049-qualify-complete-browser-product-resources.json"},{"identity":"sha256:a7903402d24d6ecc6e59c26c8cf88fa42884caaee6152c367c5cfe96ee1c4e50","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/AR-050-keep-browser-qualification-and-publication-authority-distinct.json"},{"identity":"sha256:680f2ce92cd94db8393b8d8167b57802f9e69b965db00363c7dd46d868d339d6","path":"design/requirements/IR-010-obtain-trustworthy-compatible-rigorloop-tools/SR-088-qualify-complete-customer-architecture-browser-artifacts/AR-051-reject-unsupported-browser-invocation-environments.json"},{"identity":"sha256:bb3149c4b43c80fc689383a5da427d48e91e10620e6a0f27bb98ceb0329ce05b","path":"design/requirements/scenarios/SCN-087-qualify-a-browser-candidate-for-independent-customer-use.json"},{"identity":"sha256:ce25a82dcdbe97ebafcecc4e55781b17a424c27bb1bc19d4e9d0239cdc43d5ea","path":"design/system/features/FEAT-018-produce-reproducible-rigorloop-product-candidates.json"}],"summary":"Covered in Design through the existing accountable Functions, retained owner contract and MOD-019 composition; execution and public qualification remain distinct."}]}
