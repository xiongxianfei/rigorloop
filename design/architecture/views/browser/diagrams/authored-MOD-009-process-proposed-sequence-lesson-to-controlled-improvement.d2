shape: sequence_diagram
participant: "Lesson maintainer"
procedure: "Skill procedures\nMOD-012"
learning: "IF-017\nMOD-009 via MOD-017"
control: "Change control\nIF-009 / IF-016"
owner: "Authorized artifact\nand decision owner"
participant -> procedure: "Finding, observations, inferred cause and context"
procedure -> learning: "Characterize supported reuse or local correction"
learning -> procedure: "Source-bound lesson, limits and confirmation dependencies"
participant -> procedure: "Proposed behavior, subjects, owner and criteria"
procedure -> learning: "Prepare accountable improvement"
learning -> procedure: "Exact proposal or missing readiness context"
procedure -> control: "Inspect actual authority and prepare controlled action"
control -> procedure: "Applicable grant and transition basis or unresolved scope"
procedure -> owner: "Bounded authorized handoff; no implied execution"
owner -> participant: "Actual decision and owner-produced result when performed"
participant -> procedure: "Associate lesson, proposal, decision and adopted scope"
procedure -> learning: "Prepare exact disposition; effectiveness still unassessed"
