  n_5072657061726564206a6f75726e616c: "Prepared journal" {
    link: "#process/lifecycle/coordination"
    tooltip: "A validated retained journal has phase=prepared and exact before/candidate evidence. Targets may match a mixture of retained before and candidate values during an unfinished transaction; that mixture is not usable current state."
    style.fill: "#EEF6F1"
    style.stroke: "#597390"
    style.font-color: "#24364A"
    style.font-size: 16
    style.border-radius: 7
