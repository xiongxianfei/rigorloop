shape: sequence_diagram
participant: "Work participant\nand improvement observer"
procedure: "Skill procedures\nMOD-012"
learning: "IF-017\nMOD-009 via MOD-017"
assurance: "Assurance\nIF-010 / IF-014"
retention: "Selected artifact writer\nor IF-004 records"
participant -> procedure: "Planned activity, available lessons and decision basis"
procedure -> learning: "Compare context, exclusions and adoption applicability"
learning -> procedure: "Relevant lessons or explicit no-match/unavailable/context gaps"
procedure -> participant: "Bounded guidance; no new policy or authority"
participant -> procedure: "Adopted version, prepared criteria and actual opportunities"
procedure -> learning: "Compare reproduction and later comparable observations"
learning -> procedure: "Recurrence, intended effect, adverse results or unassessed scope"
procedure -> assurance: "Prepare supplied observations and accountable judgment"
assurance -> procedure: "Exact content, applicability and reliance limits"
procedure -> retention: "Explicit authorized retention when selected"
retention -> procedure: "Actual confirmed or unresolved retained effect"
procedure -> participant: "Observed scope and reassessment need; saved status separate"
